   "uk": "У нього кашель."
  },
  {
   "id": "en-classic-r1:07.13",
   "target": "She has a headache.",
   "ru": "У неё болит голова.",
   "uk": "У неї болить голова."
  },
  {
   "id": "en-classic-r1:07.14",
   "target": "We have an appointment.",
   "ru": "У нас запись на приём.",
   "uk": "У нас призначений прийом."
  },
  {
   "id": "en-classic-r1:07.15",
   "target": "My daughter has a cold.",
   "ru": "У моей дочери простуда.",
