 "phrases": [
  {
   "id": "en-classic-r1:13.01",
   "target": "I will wait outside.",
   "ru": "Я подожду снаружи.",
   "uk": "Я почекаю надворі."
  },
  {
   "id": "en-classic-r1:13.02",
   "target": "She will call later.",
   "ru": "Она позвонит позже.",
   "uk": "Вона подзвонить пізніше."
  },
  {
   "id": "en-classic-r1:13.03",
   "target": "We will bring the cups.",
   "ru": "Мы принесем чашки.",
   "uk": "Ми принесемо чашки."
  },
  {
   "id": "en-classic-r1:13.04",
   "target": "He will open the gate.",
   "ru": "Он откроет ворота.",
   "uk": "Він відчинить ворота."
  },
  {
   "id": "en-classic-r1:13.05",
   "target": "They will meet us here.",
   "ru": "Они встретят нас здесь.",
   "uk": "Вони зустрінуть нас тут."
  },
  {
   "id": "en-classic-r1:13.06",
   "target": "I will take this bag.",
   "ru": "Я возьму эту сумку.",
   "uk": "Я візьму цю сумку."
  },
  {
   "id": "en-classic-r1:13.07",
   "target": "We will pay by card.",
   "ru": "Мы заплатим картой.",
   "uk": "Ми заплатимо карткою."
  },
  {
   "id": "en-classic-r1:13.08",
   "target": "She will send a photo.",
   "ru": "Она пришлет фотографию.",
   "uk": "Вона надішле фото."
  },
  {
   "id": "en-classic-r1:13.09",
   "target": "He will check the lock.",
   "ru": "Он проверит замок.",
   "uk": "Він перевірить замок."
  },
  {
   "id": "en-classic-r1:13.10",
   "target": "I will write it down.",
   "ru": "Я запишу это.",
   "uk": "Я запишу це."
  },
  {
   "id": "en-classic-r1:13.11",
   "target": "I will get you a towel.",
   "ru": "Я принесу тебе полотенце.",
   "uk": "Я принесу тобі рушник."
  },
  {
   "id": "en-classic-r1:13.12",
   "target": "I will carry the heavy box.",
   "ru": "Я понесу тяжелую коробку.",
   "uk": "Я понесу важку коробку."
  },
  {
   "id": "en-classic-r1:13.13",
   "target": "We will keep a seat for you.",
   "ru": "Мы займём для вас место.",
   "uk": "Ми збережемо для вас місце."
  },
  {
   "id": "en-classic-r1:13.14",
   "target": "I will help you upstairs.",
   "ru": "Я помогу вам подняться наверх.",
   "uk": "Я допоможу вам піднятися нагору."
  },
  {
   "id": "en-classic-r1:13.15",
   "target": "She will show you the room.",
   "ru": "Она покажет вам комнату.",
   "uk": "Вона покаже вам кімнату."
  },
  {
   "id": "en-classic-r1:13.16",
   "target": "I will answer the phone.",
   "ru": "Я возьму трубку.",
   "uk": "Я візьму слухавку."
  },
  {
   "id": "en-classic-r1:13.17",
   "target": "We will split the bill.",
   "ru": "Мы разделим счет.",
   "uk": "Ми розділимо рахунок."
  },
  {
   "id": "en-classic-r1:13.18",
   "target": "I will ask about luggage storage.",
   "ru": "Я спрошу о хранении багажа.",
   "uk": "Я запитаю про камеру схову багажу."
  },
  {
   "id": "en-classic-r1:13.19",
   "target": "There will be a small fee for delivery.",
   "ru": "За доставку будет небольшая плата.",
   "uk": "За доставку буде невелика плата."
  },
  {
   "id": "en-classic-r1:13.20",
   "target": "I will put the kettle on.",
   "ru": "Я поставлю чайник.",
   "uk": "Я поставлю чайник."
  },
  {
   "id": "en-classic-r1:13.21",
   "target": "I will not be late.",
   "ru": "Я не опоздаю.",
   "uk": "Я не запізнюся."
  },
  {
   "id": "en-classic-r1:13.22",
   "target": "We will not need a taxi.",
   "ru": "Нам не понадобится такси.",
   "uk": "Нам не знадобиться таксі."
  },
  {
   "id": "en-classic-r1:13.23",
   "target": "She will not forget the key.",
   "ru": "Она не забудет ключ.",
   "uk": "Вона не забуде ключ."
  },
  {
   "id": "en-classic-r1:13.24",
   "target": "He will not stay overnight.",
   "ru": "Он не останется на ночь.",
   "uk": "Він не залишиться на ніч."
  },
  {
   "id": "en-classic-r1:13.25",
   "target": "They will not charge you for delivery.",
   "ru": "За доставку с вас не возьмут плату.",
   "uk": "Вони не братимуть з вас плату за доставку."
  },
  {
   "id": "en-classic-r1:13.26",
   "target": "I will not share your number.",
   "ru": "Я не буду сообщать ваш номер.",
   "uk": "Я не поділюся вашим номером."
  },
  {
   "id": "en-classic-r1:13.27",
   "target": "We will not leave without you.",
   "ru": "Мы не уйдем без вас.",
   "uk": "Ми не підемо без вас."
  },
  {
   "id": "en-classic-r1:13.28",
   "target": "The shop will not open tomorrow.",
   "ru": "Магазин завтра не откроется.",
   "uk": "Магазин не відкриється завтра."
  },
  {
   "id": "en-classic-r1:13.29",
   "target": "This bag will not fit in the locker.",
   "ru": "Эта сумка не поместится в шкафчик.",
   "uk": "Ця сумка не поміститься в шафку."
  },
  {
   "id": "en-classic-r1:13.30",
   "target": "The battery will not last all day.",
   "ru": "Батарея не продержится весь день.",
   "uk": "Батареї не вистачить на весь день."
  },
  {
   "id": "en-classic-r1:13.31",
   "target": "Will you be home tonight?",
   "ru": "Вы будете дома сегодня вечером?",
   "uk": "Ви будете вдома сьогодні ввечері?"
  },
  {
   "id": "en-classic-r1:13.32",
   "target": "Will she need a lift?",
   "ru": "Её нужно будет подвезти?",
   "uk": "Чи треба буде її підвезти?"
  },
  {
   "id": "en-classic-r1:13.33",
   "target": "Will the price change?",
   "ru": "Цена изменится?",
   "uk": "Чи зміниться ціна?"
  },
  {
   "id": "en-classic-r1:13.34",
   "target": "Will it rain tomorrow?",
   "ru": "Завтра будет дождь?",
   "uk": "Чи буде завтра дощ?"
  },
  {
   "id": "en-classic-r1:13.35",
   "target": "Will they send a receipt?",
   "ru": "Пришлют ли квитанцию?",
   "uk": "Чи надішлють вони квитанцію?"
  },
  {
   "id": "en-classic-r1:13.36",
   "target": "Will we have enough time?",
   "ru": "У нас будет достаточно времени?",
   "uk": "Чи буде у нас достатньо часу?"
  },
  {
   "id": "en-classic-r1:13.37",
   "target": "Will the driver wait for us?",
   "ru": "Водитель будет нас ждать?",
   "uk": "Водій чекатиме на нас?"
  },
  {
   "id": "en-classic-r1:13.38",
   "target": "When will the parcel arrive?",
   "ru": "Когда придет посылка?",
   "uk": "Коли прибуде посилка?"
  },
  {
   "id": "en-classic-r1:13.39",
   "target": "Where will you meet the group?",
   "ru": "Где вы встретите группу?",
   "uk": "Де ви зустрінете групу?"
  },
  {
   "id": "en-classic-r1:13.40",
   "target": "How much will it cost?",
   "ru": "Сколько это будет стоить?",
   "uk": "Скільки це коштуватиме?"
  },
  {
   "id": "en-classic-r1:13.41",
   "target": "I think the train will be busy.",
   "ru": "Думаю, в поезде будет много народу.",
   "uk": "Думаю, у поїзді буде багато людей."
  },
  {
   "id": "en-classic-r1:13.42",
   "target": "The soup will be ready soon.",
   "ru": "Суп скоро будет готов.",
   "uk": "Суп скоро буде готовий."
  },
  {
   "id": "en-classic-r1:13.43",
   "target": "Your ticket will arrive by email.",
   "ru": "Ваш билет придет по электронной почте.",
   "uk": "Ваш квиток надійде електронною поштою."
  },
  {
   "id": "en-classic-r1:13.44",
   "target": "The new timetable will start next month.",
   "ru": "Новое расписание начнет действовать в следующем месяце.",
   "uk": "Новий розклад почне діяти наступного місяця."
  },
  {
   "id": "en-classic-r1:13.45",
   "target": "The forecast says it will rain after lunch.",
   "ru": "По прогнозу, после обеда будет дождь.",
   "uk": "Прогноз погоди обіцяє дощ після обіду."
  },
  {
   "id": "en-classic-r1:13.46",
   "target": "This light will turn green in a moment.",
   "ru": "Этот светофор через мгновение загорится зеленым.",
   "uk": "Цей світлофор за мить загориться зеленим."
  },
  {
   "id": "en-classic-r1:13.47",
   "target": "My brother will collect the keys tomorrow.",
   "ru": "Мой брат заберет ключи завтра.",
   "uk": "Мій брат забере ключі завтра."
  },
  {
   "id": "en-classic-r1:13.48",
   "target": "We will see the sign on the left.",
   "ru": "Мы увидим знак слева.",
   "uk": "Ми побачимо знак ліворуч."
  },
  {
   "id": "en-classic-r1:13.49",
   "target": "Do not worry; I will lock up.",
   "ru": "Не волнуйся, я всё закрою.",
   "uk": "Не хвилюйся, я все зачиню."
  },
  {
   "id": "en-classic-r1:13.50",
   "target": "I will call you after my shift.",
   "ru": "Я позвоню тебе после смены.",
   "uk": "Я подзвоню тобі після зміни."
  }
 ],
