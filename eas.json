{
  "cli": {
    "version": ">= 18.7.0",
    "appVersionSource": "local",
    "requireCommit": true
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_DISABLE_EXPO_UPDATES": "1"
      }
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "environment": "production",
      "channel": "production",
      "autoIncrement": false,
      "buildArtifactPaths": [
        "android/app/build/outputs/mapping/release/mapping.txt",
        "android/app/build/intermediates/merged_native_libs/release/mergeReleaseNativeLibs/out/lib/**/*"
      ],
      "env": {
        "EXPO_PUBLIC_STORE_RELEASE": "1",
        "EXPO_PUBLIC_AI_DIALOG_ENABLED": "true",
        "EXPO_PUBLIC_EXPLAIN_ENABLED": "true"
      }
    },
    "ios-account-v2-proof": {
      "distribution": "internal",
      "environment": "production",
      "autoIncrement": false,
      "ios": {
        "buildConfiguration": "Release"
      },
      "env": {
        "EXPO_PUBLIC_ACCOUNT_V2_IOS_PROOF": "1",
        "EXPO_PUBLIC_DISABLE_EXPO_UPDATES": "1",
        "EXPO_PUBLIC_STORE_RELEASE": "0"
      }
    },
    "testflight-dev": {
      "environment": "production",
      "channel": "testflight-dev",
      "autoIncrement": false,
      "env": {
        "EXPO_PUBLIC_STORE_RELEASE": "0",
        "EXPO_PUBLIC_TESTFLIGHT_DEV_TOOLS": "1",
        "EXPO_PUBLIC_AI_DIALOG_ENABLED": "true",
        "EXPO_PUBLIC_EXPLAIN_ENABLED": "true"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./service-account.json",
        "track": "production"
      },
      "ios": {
        "ascAppId": "6764800879"
      }
    },
    "testflight-dev": {
      "ios": {
        "ascAppId": "6764800879"
      }
    }
  }
}
