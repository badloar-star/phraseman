import Ionicons from '@expo/vector-icons/Ionicons';
import React, { useMemo, useRef, useState } from 'react';
import { FlatList, StyleSheet, Text, View, useWindowDimensions } from 'react-native';
import Animated, { FadeInDown } from 'react-native-reanimated';
import { ALL_ACHIEVEMENTS, achievementNameForLang, type Achievement } from '../../app/achievements';
import type { Lang } from '../../constants/i18n';
import { KIT_MOTION } from '../../constants/motionHybrid';
import { useReduceMotion } from '../../hooks/use_reduce_motion';
import { toggleShowcaseAward, type ShowcasePreference } from '../../shared/profile_card_showcase';
import AchievementArt from '../AchievementArt';
import DuoPressable from '../DuoPressable';
import PressableHybrid from '../PressableHybrid';
import SheetSwipeClose from '../modal_fx/SheetSwipeClose';
import { useProfileSheetPaint } from './profile_card_sheet_paint';
import { showcaseCopy } from './profile_card_showcase_copy';

export type ShowcaseSheetProps = Readonly<{
  mode: 'settings' | 'awards'; lang: Lang; preference: ShowcasePreference;
  earned: ReadonlySet<string>; loading: boolean; loadFailed: boolean; saving: boolean; bottomInset: number;
  onSave: (value: ShowcasePreference) => Promise<boolean>; onChoose: () => void;
  onClose: () => void; onRetry: () => void;
}>;

/** Inline sheet inside the existing profile Modal: no second native Modal. */
export default function ProfileCardShowcaseSheet(props: ShowcaseSheetProps) {
  const { mode, lang, preference, earned, loading, loadFailed, saving, bottomInset, onSave, onClose, onChoose, onRetry } = props;
  const p = useProfileSheetPaint();
  const copy = showcaseCopy(lang);
  const reduceMotion = useReduceMotion();
  const { height, width } = useWindowDimensions();
  const [selected, setSelected] = useState(preference.awardIds);
  const [error, setError] = useState('');
  const committing = useRef(false);
  const items = useMemo(() => ALL_ACHIEVEMENTS.filter((award) => earned.has(award.id)), [earned]);
  const shownIds = mode === 'awards' ? selected : preference.awardIds;
  const commit = async (value: ShowcasePreference, close: boolean) => {
    if (committing.current) return;
    committing.current = true;
    setError('');
    try {
      const ok = await onSave(value);
      if (ok && close) onClose();
      else if (!ok) setError(copy.failed);
    } catch { setError(copy.failed); }
    finally { committing.current = false; }
  };
  const toggle = (id: string) => {
    const next = toggleShowcaseAward(selected, id);
    setError(next === selected ? copy.limit : '');
    setSelected(next);
  };
  const renderAward = ({ item }: { item: Achievement }) => {
    const checked = selected.includes(item.id);
    const name = achievementNameForLang(item, lang);
    return <PressableHybrid testID={`showcase-choice-${item.id}`} accessibilityRole="checkbox" accessibilityLabel={name}
      accessibilityState={{ checked, disabled: saving }} disabled={saving} onPress={() => toggle(item.id)}
      style={styles.itemWrap} contentStyle={[styles.item, { backgroundColor: checked ? p.button.altBg : p.field }]}>
      <View style={styles.checkIcon}><Ionicons name={checked ? 'checkbox' : 'square-outline'} size={24} color={p.title} /></View>
      <AchievementArt achievementId={item.id} size={Math.min(100, (width - 100) / 2)} tintColor={p.title} />
      <Text style={[styles.itemTitle, { color: p.title }]}>{name}</Text>
    </PressableHybrid>;
  };
  const header = <>
    <View style={styles.header}>
      <Text accessibilityRole="header" style={[styles.title, { color: p.title }]}>{mode === 'awards' ? copy.choose : copy.visible}</Text>
      <PressableHybrid testID="showcase-sheet-close" accessibilityRole="button" accessibilityLabel={mode === 'awards' ? copy.back : copy.close}
        disabled={saving} onPress={onClose} contentStyle={[styles.close, { backgroundColor: p.field }]}>
        <Ionicons name={mode === 'awards' ? 'arrow-back' : 'close'} size={23} color={p.title} />
      </PressableHybrid>
    </View>
    <Text style={[styles.hint, { color: p.hint }]}>{copy.hint}</Text>
    <View style={styles.slots}>{[0, 1, 2].map((index) => <View key={index} style={[styles.slot, { backgroundColor: p.field }]}>
      {shownIds[index] ? <AchievementArt achievementId={shownIds[index]} size={68} tintColor={p.title} /> : <Text style={[styles.emptySlot, { color: p.hint }]}>{index + 1}</Text>}
    </View>)}</View>
    <Text accessibilityLiveRegion="polite" style={[styles.status, { color: error ? p.warn : p.hint }]}>{error || `${copy.selected} ${shownIds.length} ${copy.of} 3`}</Text>
  </>;
  return <SheetSwipeClose name="profile-card-showcase" enabled={!saving} onClose={onClose} follow={false}>
    <Animated.View testID={`showcase-${mode}-sheet`} accessibilityViewIsModal
      entering={reduceMotion ? undefined : FadeInDown.duration(KIT_MOTION.sheetMs)}
      style={[styles.sheet, { maxHeight: height * KIT_MOTION.sheetMaxHeight, backgroundColor: p.sheet, paddingBottom: Math.max(20, bottomInset + 12) }]}>
      {mode === 'awards' ? <>
        <FlatList data={loading || loadFailed ? [] : items} keyExtractor={(item) => item.id} numColumns={2} renderItem={renderAward}
          extraData={selected} contentContainerStyle={styles.list} columnWrapperStyle={styles.columns} ListHeaderComponent={header}
          ListEmptyComponent={<View style={styles.empty}><Text style={[styles.hint, { color: p.hint }]}>{loading ? copy.loading : loadFailed ? copy.loadFailed : copy.empty}</Text>
            {loadFailed ? <PressableHybrid onPress={onRetry} accessibilityRole="button" contentStyle={styles.retry}><Text style={{ color: p.title }}>{copy.retry}</Text></PressableHybrid> : null}</View>}
        />
        <DuoPressable testID="showcase-awards-save" disabled={saving || loading || loadFailed} onPress={() => { void commit({ ...preference, awardIds: selected }, true); }}
          accessibilityLabel={copy.save} style={[styles.save, { backgroundColor: p.button.primaryBg }]} edgeHeight={4} edgeColor={p.shadow} wrapStyle={styles.saveWrap}>
          <Text style={[styles.saveText, { color: p.button.primaryInk }]}>{`${copy.save} · ${selected.length} ${copy.of} 3`}</Text>
        </DuoPressable>
      </> : <FlatList data={[]} renderItem={() => null} contentContainerStyle={styles.list} ListHeaderComponent={<>{header}
        <PressableHybrid testID="showcase-open-awards" accessibilityRole="button" onPress={onChoose} disabled={saving || loading || loadFailed} contentStyle={[styles.choose, { backgroundColor: p.field }]}>
          <Text style={[styles.saveText, { color: p.title }]}>{copy.choose}</Text>
        </PressableHybrid>
        <PressableHybrid testID="showcase-show-streak" accessibilityRole="checkbox" accessibilityLabel={copy.showStreak}
          accessibilityState={{ checked: preference.showStreak, disabled: saving || loading || loadFailed }} disabled={saving || loading || loadFailed}
          onPress={() => { void commit({ ...preference, showStreak: !preference.showStreak }, false); }} contentStyle={styles.toggle}>
          <Ionicons name={preference.showStreak ? 'checkbox' : 'square-outline'} size={26} color={p.title} />
          <Text style={[styles.toggleText, { color: p.title }]}>{copy.showStreak}</Text>
        </PressableHybrid>
        {loading || loadFailed ? <Text style={[styles.hint, { color: p.hint }]}>{loading ? copy.loading : copy.loadFailed}</Text> : null}
        {loadFailed ? <PressableHybrid onPress={onRetry} accessibilityRole="button" contentStyle={styles.retry}><Text style={{ color: p.title }}>{copy.retry}</Text></PressableHybrid> : null}
      </>} />}
    </Animated.View>
  </SheetSwipeClose>;
}

const styles = StyleSheet.create({
  sheet: { position: 'absolute', left: 0, right: 0, bottom: 0, borderTopLeftRadius: 32, borderTopRightRadius: 32, paddingTop: 16, zIndex: 30 },
  list: { paddingHorizontal: 22, paddingBottom: 14 },
  header: { flexDirection: 'row', alignItems: 'center', gap: 8, marginBottom: 8 },
  title: { flex: 1, fontSize: 24, lineHeight: 30, fontWeight: '700' },
  close: { height: 48, width: 48, borderRadius: 24, alignItems: 'center', justifyContent: 'center' },
  hint: { fontSize: 15, lineHeight: 22, fontWeight: '400' },
  slots: { flexDirection: 'row', gap: 10, marginTop: 18 },
  slot: { flex: 1, height: 80, borderRadius: 18, alignItems: 'center', justifyContent: 'center' },
  emptySlot: { fontSize: 22, fontWeight: '700' },
  status: { fontSize: 14, lineHeight: 20, marginVertical: 14 },
  columns: { gap: 10 }, itemWrap: { flex: 1, maxWidth: '50%', marginBottom: 10 },
  item: { flex: 1, padding: 12, borderRadius: 20, alignItems: 'center', minHeight: 160 },
  itemTitle: { fontSize: 14, lineHeight: 19, fontWeight: '700', alignSelf: 'stretch', marginTop: 8 },
  checkIcon: { position: 'absolute', right: 10, top: 10, zIndex: 1 },
  save: { minHeight: 52, borderRadius: 26, alignItems: 'center', justifyContent: 'center', padding: 12 },
  saveWrap: { marginHorizontal: 22, marginTop: 10 }, saveText: { fontSize: 16, lineHeight: 22, fontWeight: '700' },
  choose: { minHeight: 52, borderRadius: 18, alignItems: 'center', justifyContent: 'center', padding: 12 },
  toggle: { minHeight: 64, flexDirection: 'row', gap: 12, alignItems: 'center', paddingVertical: 18 },
  toggleText: { flex: 1, fontSize: 16, lineHeight: 22, fontWeight: '700' },
  empty: { paddingVertical: 24 }, retry: { minHeight: 48, justifyContent: 'center', alignItems: 'center' },
});
