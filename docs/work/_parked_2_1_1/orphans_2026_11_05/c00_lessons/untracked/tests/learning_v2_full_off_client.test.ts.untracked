const mockStorage = {
  getItem: jest.fn(async () => '{"preserve":"exact bytes"}'),
  setItem: jest.fn(async () => undefined),
  removeItem: jest.fn(async () => undefined),
};

jest.mock('@react-native-async-storage/async-storage', () => mockStorage);
jest.mock('../app/cloud_sync', () => ({ ensureAnonUser: jest.fn(), ensureStableAuthLink: jest.fn(), repairStableAuthLinkAfterIdentityFailure: jest.fn() }));
jest.mock('../app/stable_id', () => ({ peekStableId: jest.fn(() => null) }));
jest.mock('../app/interactive_network_quiet', () => ({ withBackgroundNetworkLease: jest.fn() }));
jest.mock('@react-native-firebase/app', () => ({ getApp: jest.fn() }));
jest.mock('@react-native-firebase/functions', () => ({ getFunctions: jest.fn(), httpsCallable: jest.fn() }));

import {
  bundledLearningV2CourseSessionMaterialV3,
  clearLearningV2CourseReleasedSessionCacheV3,
  hydrateLearningV2CourseReleasedSessionCacheV3,
  peekCurrentLearningV2CourseReleasedSessionV3,
  preloadCurrentLearningV2CourseReleasedSessionV3,
  previewLearningV2CourseSessionMaterialV3,
  waitForCurrentLearningV2CourseReleasedSessionPreloadV3,
} from '../app/learning_v2_course_released_session_client_v3';

const locator = {
  environment: 'production' as const,
  targetLanguage: 'en',
  studyTarget: 'en',
  learnerSourceLocale: 'ru',
  seasonId: 'learning-v2',
  lessonOrdinal: 1,
  sessionOrdinal: 1,
};

describe('Learning V2 full-off public client boundary', () => {
  beforeEach(() => jest.clearAllMocks());

  it('does not materialize, hydrate, preload, peek, or delete cached progress bytes', async () => {
    expect(peekCurrentLearningV2CourseReleasedSessionV3(locator)).toBeNull();
    expect(bundledLearningV2CourseSessionMaterialV3(locator)).toBeNull();
    expect(previewLearningV2CourseSessionMaterialV3(locator)).toBeNull();
    await expect(hydrateLearningV2CourseReleasedSessionCacheV3()).resolves.toBeUndefined();
    await expect(preloadCurrentLearningV2CourseReleasedSessionV3(locator)).resolves.toBeUndefined();
    expect(waitForCurrentLearningV2CourseReleasedSessionPreloadV3(locator)).toBeNull();
    await expect(clearLearningV2CourseReleasedSessionCacheV3()).resolves.toBeUndefined();

    expect(mockStorage.getItem).not.toHaveBeenCalled();
    expect(mockStorage.setItem).not.toHaveBeenCalled();
    expect(mockStorage.removeItem).not.toHaveBeenCalled();
  });
});
