<?xml version="1.0" encoding="utf-8"?>
<!--
  Static preview shown in the widget picker before placement (and the initial
  loading view). The live widget is rendered by Glance; this is only the picker
  thumbnail. It is painted in the DEFAULT dark theme so the gallery thumbnail and
  the placement flash match the real placed widget — not a foreign light/purple
  card. Colors mirror daily_phrase_chrome.ts `dark` chrome.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="14dp"
    android:paddingVertical="8dp"
    android:background="@color/phrase_widget_bg">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/phrase_widget_kicker"
        android:textColor="@color/phrase_widget_kicker"
        android:textStyle="bold"
        android:textSize="10sp"
        android:letterSpacing="0.06" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Break the ice"
        android:textColor="@color/phrase_widget_primary"
        android:textStyle="bold"
        android:textSize="18sp"
        android:maxLines="2"
        android:ellipsize="end" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="Растопить лёд — снять напряжение"
        android:textColor="@color/phrase_widget_secondary"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
