 "phrases": [
  {
   "id": "en-classic-r1:08.01",
   "target": "I start at seven.",
   "ru": "Я начинаю в семь.",
   "uk": "Я починаю о сьомій."
  },
  {
   "id": "en-classic-r1:08.02",
   "target": "She starts at noon.",
   "ru": "Она начинает в полдень.",
   "uk": "Вона починає опівдні."
  },
  {
   "id": "en-classic-r1:08.03",
   "target": "We meet on Tuesday.",
   "ru": "Мы встречаемся во вторник.",
   "uk": "Ми зустрічаємося у вівторок."
  },
  {
   "id": "en-classic-r1:08.04",
   "target": "He works on Fridays.",
   "ru": "Он работает по пятницам.",
   "uk": "Він працює по п'ятницях."
  },
  {
   "id": "en-classic-r1:08.05",
   "target": "I travel in July.",
   "ru": "Я путешествую в июле.",
   "uk": "Я подорожую в липні."
  },
  {
   "id": "en-classic-r1:08.06",
   "target": "She studies in the evening.",
   "ru": "Она учится вечером.",
   "uk": "Вона навчається ввечері."
  },
  {
   "id": "en-classic-r1:08.07",
   "target": "We finish at midnight.",
   "ru": "Мы заканчиваем в полночь.",
   "uk": "Ми закінчуємо опівночі."
  },
  {
   "id": "en-classic-r1:08.08",
   "target": "They arrive on Monday.",
   "ru": "Они приезжают в понедельник.",
   "uk": "Вони прибувають у понеділок."
  },
  {
   "id": "en-classic-r1:08.09",
   "target": "I walk in the morning.",
   "ru": "Я гуляю утром.",
   "uk": "Я гуляю вранці."
  },
  {
   "id": "en-classic-r1:08.10",
   "target": "He works at night.",
   "ru": "Он работает ночью.",
   "uk": "Він працює вночі."
  },
  {
   "id": "en-classic-r1:08.11",
   "target": "The gate opens at half past six.",
   "ru": "Ворота открываются в половине седьмого.",
   "uk": "Ворота відчиняються о пів на сьому."
  },
  {
   "id": "en-classic-r1:08.12",
   "target": "The train leaves at a quarter past eight.",
   "ru": "Поезд отправляется в четверть девятого.",
   "uk": "Поїзд відправляється о чверть на дев'яту."
  },
  {
   "id": "en-classic-r1:08.13",
   "target": "Lunch starts at one.",
   "ru": "Обед начинается в час дня.",
   "uk": "Обід починається о першій."
  },
  {
   "id": "en-classic-r1:08.14",
   "target": "The desk closes at half past four.",
   "ru": "Стойка регистрации закрывается в половине пятого.",
   "uk": "Стійка зачиняється о пів на п'яту."
  },
  {
   "id": "en-classic-r1:08.15",
   "target": "We meet at lunchtime.",
   "ru": "Мы встречаемся в обеденное время.",
   "uk": "Ми зустрічаємося під час обіду."
  },
  {
   "id": "en-classic-r1:08.16",
   "target": "The concert starts at eight fifteen.",
   "ru": "Концерт начинается в восемь пятнадцать.",
   "uk": "Концерт починається о восьмій п'ятнадцять."
  },
  {
   "id": "en-classic-r1:08.17",
   "target": "The alarm rings at six thirty.",
   "ru": "Будильник звонит в шесть тридцать.",
   "uk": "Будильник дзвонить о шостій тридцять."
  },
  {
   "id": "en-classic-r1:08.18",
   "target": "The bakery opens at dawn.",
   "ru": "Пекарня открывается на рассвете.",
   "uk": "Пекарня відкривається на світанку."
  },
  {
   "id": "en-classic-r1:08.19",
   "target": "The shift changes at ten.",
   "ru": "Пересменка в десять.",
   "uk": "Перезмінка о десятій."
  },
  {
   "id": "en-classic-r1:08.20",
   "target": "The bell rings at midday.",
   "ru": "Звонок звенит в полдень.",
   "uk": "Дзвінок дзвонить опівдні."
  },
  {
   "id": "en-classic-r1:08.21",
   "target": "The office closes on public holidays.",
   "ru": "Офис закрыт в праздничные дни.",
   "uk": "Офіс зачиняється у святкові дні."
  },
  {
   "id": "en-classic-r1:08.22",
   "target": "We train on Wednesday evenings.",
   "ru": "Мы тренируемся по средам вечером.",
   "uk": "Ми тренуємося по середах ввечері."
  },
  {
   "id": "en-classic-r1:08.23",
   "target": "The bill is due on Friday.",
   "ru": "Счет нужно оплатить в пятницу.",
   "uk": "Рахунок має бути сплачений у п'ятницю."
  },
  {
   "id": "en-classic-r1:08.24",
   "target": "My appointment is on Thursday morning.",
   "ru": "Моя встреча назначена на утро четверга.",
   "uk": "Моя зустріч у четвер вранці."
  },
  {
   "id": "en-classic-r1:08.25",
   "target": "The market opens on Saturdays.",
   "ru": "Рынок открыт по субботам.",
   "uk": "Ринок відкривається по суботах."
  },
  {
   "id": "en-classic-r1:08.26",
   "target": "The parcel arrives on Monday afternoon.",
   "ru": "Посылка прибудет в понедельник днем.",
   "uk": "Посилка прибуває в понеділок вдень."
  },
  {
