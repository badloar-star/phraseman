 "phrases": [
  {
   "id": "en-classic-r1:29.01",
   "target": "I used to drive to work.",
   "ru": "Раньше я ездил на работу на машине.",
   "uk": "Я раніше їздив на роботу на машині."
  },
  {
   "id": "en-classic-r1:29.02",
   "target": "She used to live upstairs.",
   "ru": "Она раньше жила наверху.",
   "uk": "Вона раніше жила нагорі."
  },
  {
   "id": "en-classic-r1:29.03",
   "target": "We used to share a flat.",
   "ru": "Мы раньше снимали квартиру вместе.",
   "uk": "Ми раніше ділили квартиру."
  },
  {
   "id": "en-classic-r1:29.04",
   "target": "He used to wear glasses.",
   "ru": "Раньше он носил очки.",
   "uk": "Раніше він носив окуляри."
  },
  {
   "id": "en-classic-r1:29.05",
   "target": "They used to open early.",
   "ru": "Раньше они открывались рано.",
   "uk": "Раніше вони відкривалися рано."
  },
  {
   "id": "en-classic-r1:29.06",
   "target": "I used to work in a warehouse.",
   "ru": "Я раньше работал на складе.",
   "uk": "Я раніше працював на складі."
  },
  {
   "id": "en-classic-r1:29.07",
   "target": "She used to take the bus.",
   "ru": "Раньше она ездила на автобусе.",
   "uk": "Раніше вона їздила автобусом."
  },
  {
   "id": "en-classic-r1:29.08",
   "target": "We used to walk home together.",
   "ru": "Мы раньше ходили домой вместе пешком.",
   "uk": "Ми раніше ходили додому разом пішки."
  },
  {
   "id": "en-classic-r1:29.09",
   "target": "He used to carry cash.",
   "ru": "Раньше он носил с собой наличные.",
   "uk": "Раніше він носив із собою готівку."
  },
  {
   "id": "en-classic-r1:29.10",
   "target": "They used to meet at the playground.",
   "ru": "Раньше они встречались на детской площадке.",
   "uk": "Раніше вони зустрічалися на дитячому майданчику."
  },
  {
   "id": "en-classic-r1:29.11",
   "target": "There used to be a factory here.",
   "ru": "Здесь раньше был завод.",
   "uk": "Тут колись був завод."
  },
  {
   "id": "en-classic-r1:29.12",
   "target": "There used to be a cinema on this corner.",
   "ru": "На этом углу раньше был кинотеатр.",
   "uk": "На цьому розі колись був кінотеатр."
  },
  {
   "id": "en-classic-r1:29.13",
   "target": "There used to be two entrances.",
   "ru": "Раньше было два входа.",
   "uk": "Колись було два входи."
  },
  {
   "id": "en-classic-r1:29.14",
   "target": "There used to be a gate by the bridge.",
   "ru": "Раньше у моста были ворота.",
   "uk": "Колись біля мосту були ворота."
  },
  {
   "id": "en-classic-r1:29.15",
   "target": "There used to be a clock above the door.",
   "ru": "Раньше над дверью висели часы.",
   "uk": "Колись над дверима був годинник."
  },
  {
   "id": "en-classic-r1:29.16",
   "target": "This street used to be quieter.",
   "ru": "Раньше на этой улице было тише.",
   "uk": "Колись ця вулиця була тихішою."
  },
  {
   "id": "en-classic-r1:29.17",
   "target": "The tickets used to be cheaper.",
   "ru": "Раньше билеты были дешевле.",
   "uk": "Колись квитки були дешевші."
  },
  {
   "id": "en-classic-r1:29.18",
   "target": "Our kitchen used to be downstairs.",
   "ru": "Раньше наша кухня была внизу.",
   "uk": "Наша кухня колись була внизу."
  },
  {
   "id": "en-classic-r1:29.19",
   "target": "The library used to close at five.",
   "ru": "Раньше библиотека закрывалась в пять.",
   "uk": "Бібліотека колись закривалася о п'ятій."
  },
  {
   "id": "en-classic-r1:29.20",
   "target": "The tram used to stop here.",
   "ru": "Раньше здесь останавливался трамвай.",
   "uk": "Трамвай колись зупинявся тут."
  },
  {
   "id": "en-classic-r1:29.21",
   "target": "I did not use to drink coffee.",
   "ru": "Раньше я не пил кофе.",
   "uk": "Я колись не пив каву."
  },
  {
   "id": "en-classic-r1:29.22",
   "target": "She did not use to work weekends.",
   "ru": "Раньше она не работала по выходным.",
   "uk": "Вона колись не працювала у вихідні."
  },
  {
   "id": "en-classic-r1:29.23",
   "target": "We did not use to need a code.",
   "ru": "Раньше нам не нужен был код.",
   "uk": "Нам колись не потрібен був код."
  },
  {
   "id": "en-classic-r1:29.24",
   "target": "He did not use to like cooking.",
   "ru": "Раньше он не любил готовить.",
   "uk": "Він колись не любив готувати."
  },
  {
   "id": "en-classic-r1:29.25",
   "target": "They did not use to take bookings.",
   "ru": "Раньше они не принимали бронирования.",
   "uk": "Вони колись не приймали бронювання."
  },
  {
   "id": "en-classic-r1:29.26",
   "target": "This bus did not use to run on Sundays.",
   "ru": "Этот автобус раньше не ходил по воскресеньям.",
   "uk": "Цей автобус раніше не курсував по неділях."
  },
  {
   "id": "en-classic-r1:29.27",
   "target": "I did not use to check the timetable.",
   "ru": "Я раньше не проверял расписание.",
   "uk": "Раніше я не перевіряв розклад."
  },
  {
   "id": "en-classic-r1:29.28",
   "target": "She did not use to wear a uniform.",
   "ru": "Она раньше не носила униформу.",
   "uk": "Вона раніше не носила уніформу."
  },
  {
   "id": "en-classic-r1:29.29",
   "target": "The warehouse did not use to have heating.",
   "ru": "На складе раньше не было отопления.",
   "uk": "На складі раніше не було опалення."
  },
  {
   "id": "en-classic-r1:29.30",
   "target": "The road did not use to be this busy.",
   "ru": "Дорога раньше не была такой оживлённой.",
   "uk": "Дорога раніше не була такою жвавою."
  },
  {
   "id": "en-classic-r1:29.31",
   "target": "Did you use to live near here?",
   "ru": "Вы раньше жили неподалеку?",
   "uk": "Ви колись жили поруч?"
  },
  {
   "id": "en-classic-r1:29.32",
   "target": "Did she use to work at reception?",
   "ru": "Она раньше работала на ресепшене?",
   "uk": "Вона колись працювала на рецепції?"
  },
  {
   "id": "en-classic-r1:29.33",
   "target": "Did he use to drive a van?",
   "ru": "Он раньше водил фургон?",
   "uk": "Він колись водив фургон?"
  },
  {
   "id": "en-classic-r1:29.34",
   "target": "Did they use to deliver on Saturdays?",
   "ru": "Они раньше доставляли по субботам?",
   "uk": "Вони колись доставляли по суботах?"
  },
  {
   "id": "en-classic-r1:29.35",
   "target": "Where did you use to buy your tickets?",
   "ru": "Где вы раньше покупали билеты?",
   "uk": "Де ви раніше купували квитки?"
  },
  {
   "id": "en-classic-r1:29.36",
   "target": "Who did you use to share a flat with?",
   "ru": "С кем вы раньше снимали квартиру?",
   "uk": "З ким ви колись ділили квартиру?"
  },
  {
   "id": "en-classic-r1:29.37",
   "target": "What time did the last train use to leave?",
   "ru": "Во сколько обычно отправлялся последний поезд?",
   "uk": "О котрій годині зазвичай відправлявся останній поїзд?"
  },
  {
   "id": "en-classic-r1:29.38",
   "target": "How much did a room here use to cost?",
   "ru": "Сколько раньше стоила комната здесь?",
   "uk": "Скільки раніше коштувала кімната тут?"
  },
  {
   "id": "en-classic-r1:29.39",
   "target": "Was this the shop you used to visit?",
   "ru": "Это был тот магазин, в который вы раньше ходили?",
   "uk": "Це був той магазин, який ви раніше відвідували?"
  },
  {
   "id": "en-classic-r1:29.40",
   "target": "Did there use to be a bakery here?",
   "ru": "Здесь раньше была пекарня?",
   "uk": "Тут раніше була пекарня?"
  },
  {
   "id": "en-classic-r1:29.41",
   "target": "I used to drive, but now I cycle.",
   "ru": "Раньше я водил машину, а теперь езжу на велосипеде.",
   "uk": "Раніше я їздив за кермом, але тепер їжджу на велосипеді."
  },
  {
   "id": "en-classic-r1:29.42",
   "target": "She used to work nights, but now she starts at eight.",
   "ru": "Раньше она работала по ночам, а теперь начинает в восемь.",
   "uk": "Вона раніше працювала вночі, але тепер починає о восьмій."
  },
  {
   "id": "en-classic-r1:29.43",
   "target": "We used to rent; now we own our flat.",
   "ru": "Раньше мы снимали квартиру, а теперь владеем ею.",
   "uk": "Раніше ми орендували житло, а тепер маємо власну квартиру."
  },
  {
   "id": "en-classic-r1:29.44",
   "target": "He used to print every ticket; now he uses his phone.",
   "ru": "Раньше он печатал каждый билет, а теперь пользуется телефоном.",
   "uk": "Він раніше роздруковував кожен квиток; тепер він користується своїм телефоном."
  },
  {
   "id": "en-classic-r1:29.45",
   "target": "I am used to getting up early now.",
   "ru": "Теперь я привык рано вставать.",
   "uk": "Тепер я звик рано вставати."
  },
  {
   "id": "en-classic-r1:29.46",
   "target": "She is not used to driving on the left.",
   "ru": "Она не привыкла ездить по левой стороне дороги.",
   "uk": "Вона не звикла їздити ліворуч."
  },
  {
   "id": "en-classic-r1:29.47",
   "target": "We are getting used to the new timetable.",
   "ru": "Мы привыкаем к новому расписанию.",
   "uk": "Ми звикаємо до нового розкладу."
  },
  {
   "id": "en-classic-r1:29.48",
   "target": "I used to hate the early shift, but I am used to it now.",
   "ru": "Раньше я ненавидел раннюю смену, а теперь привык.",
   "uk": "Раніше я ненавидів ранню зміну, але тепер я до неї звик."
  },
  {
   "id": "en-classic-r1:29.49",
   "target": "It took me a week to get used to the noise.",
   "ru": "Мне потребовалась неделя, чтобы привыкнуть к шуму.",
   "uk": "Мені знадобився тиждень, щоб звикнути до шуму."
  },
  {
   "id": "en-classic-r1:29.50",
   "target": "Did you get used to working from home?",
   "ru": "Вы привыкли работать из дома?",
   "uk": "Ви звикли працювати з дому?"
  }
