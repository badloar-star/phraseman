import fs from 'node:fs';
import path from 'node:path';
import React from 'react';
import { render } from '@testing-library/react-native';

const mockPrepare = jest.fn(async () => ({ sessionRunId: 'run-1', handle: null }));
const mockSchedule = jest.fn(() => jest.fn());
const mockStage = jest.fn();
const mockStorage = {
  getItem: jest.fn(),
  setItem: jest.fn(),
  removeItem: jest.fn(),
  multiGet: jest.fn(),
  multiSet: jest.fn(),
  multiRemove: jest.fn(),
};

jest.mock('@react-native-async-storage/async-storage', () => mockStorage);
jest.mock('../app/account_owner_change', () => ({ onAccountOwnerChanged: jest.fn() }));
jest.mock('../app/events', () => ({ emitAppEvent: jest.fn() }));
jest.mock('../app/lesson_prep_store', () => ({ beginLessonPrep: jest.fn(), endLessonPrep: jest.fn(), markLessonPrepFinishing: jest.fn() }));
jest.mock('../components/lesson_prep/prep_cta_copy', () => ({ prepHintToastFields: jest.fn(() => ({})) }));
jest.mock('../app/learning_v2_session_launch_v1', () => ({
  learningV2SessionHrefV1: jest.fn(() => '/learning-v2/session/lesson-01:session:01'),
  logLearningV2PrepareFailureV1: jest.fn(),
  parseLearningV2ReleaseEnvironmentV1: jest.fn(() => 'production'),
  prepareLearningV2SessionRunV1: (...args: unknown[]) => mockPrepare(...args),
  scheduleLearningV2SessionPrewarmV1: (...args: unknown[]) => mockSchedule(...args),
  stageLearningV2ReadyHandoffV1: (...args: unknown[]) => mockStage(...args),
}));

import {
  launchHomeContinueV2,
  useHomeContinueV2Prewarm,
} from '../app/learning_v2_home_continue_route';

const route = {
  id: 'lesson-01:session:01',
  lessonOrdinal: '1',
  sessionOrdinal: '1',
  releaseEnvironment: 'production',
  releaseSeasonId: 'learning-v2',
};

function PrewarmProbe() {
  useHomeContinueV2Prewarm(route, 'ru', 'en', true);
  return null;
}

describe('Learning V2 full-off preparation boundary', () => {
  beforeEach(() => {
    jest.clearAllMocks();
    jest.spyOn(console, 'log').mockImplementation(() => undefined);
    jest.spyOn(console, 'warn').mockImplementation(() => undefined);
  });

  afterEach(() => jest.restoreAllMocks());

  it('does not schedule a hidden Home prewarm even if a stale V2 marker is supplied', async () => {
    await render(<PrewarmProbe />);
    expect(mockSchedule).not.toHaveBeenCalled();
  });

  it('does not prepare, stage, navigate, or mutate storage through the direct Home launcher', async () => {
    const push = jest.fn();
    await launchHomeContinueV2(route, { lang: 'ru', studyTarget: 'en', push, homeCta: true });
    expect(mockPrepare).not.toHaveBeenCalled();
    expect(mockStage).not.toHaveBeenCalled();
    expect(push).not.toHaveBeenCalled();
    expect(mockStorage.setItem).not.toHaveBeenCalled();
    expect(mockStorage.removeItem).not.toHaveBeenCalled();
    expect(mockStorage.multiSet).not.toHaveBeenCalled();
    expect(mockStorage.multiRemove).not.toHaveBeenCalled();
  });

  it('does not expose the friend lesson action before acknowledgement or claim side effects', () => {
    const source = fs.readFileSync(path.join(__dirname, '..', 'app/(tabs)/friends.tsx'), 'utf8');
    expect(source).toContain("friendsTogetherUiEnabled && !LEARNING_V2_HIDDEN && studyInvite?.event.lesson");
  });
});
