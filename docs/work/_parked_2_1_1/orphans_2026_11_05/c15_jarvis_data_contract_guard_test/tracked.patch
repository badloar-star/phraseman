+describe('Peak collectible data boundary', () => {
+  test('the new stage remains inside existing private achievement state, with server-only promotion facts', () => {
+    const repo = path.resolve(__dirname, '../../..');
+    const read = (file: string) => fs.readFileSync(path.join(repo, file), 'utf8');
+    expect(read('app/achievements.ts')).toContain('spirePromotedAt?: string');
+    expect(read('app/cloud_sync.ts')).toContain("data['achievements_state'] = achievementsV1");
+    expect(read('app/achievement_restore_diff.ts')).toContain('row.spirePromotedAt = dates[0]');
+    expect(read('firestore.rules')).toMatch(/match \/spire_week_results\/\{resultId\}\s*\{\s*allow read:\s*if userDocOwnerMatchesAuth\(userId\);\s*allow write:\s*if false;/);
+    const fetchers = fs.readdirSync(path.join(repo, 'functions/src/jarvis')).filter(file => file.endsWith('_firestore_fetcher.ts')).map(file => read(`functions/src/jarvis/${file}`)).join('\n');
+    expect(fetchers).not.toContain('spirePromotedAt');
+  });
+});
+
+describe('floor record data boundary', () => {
+  test('records stay private behind membership checks and are erased with the owner', () => {
+    const root = path.resolve(__dirname, '../../..');
+    const rules = fs.readFileSync(path.join(root, 'firestore.rules'), 'utf8');
+    const writer = fs.readFileSync(path.join(root, 'functions/src/spire_floor_records.ts'), 'utf8');
+    const deletion = fs.readFileSync(path.join(root, 'functions/src/account_delete.ts'), 'utf8');
+    for (const collection of ['spire_floor_records', 'spire_floor_record_attempts', 'spire_floor_record_results']) {
+      expect(rules).toContain(`match /${collection}/{id} { allow read, write: if false; }`);
+      expect(rules).toContain(`&& collection != '${collection}'`);
+      expect(writer).toContain(`collection('${collection}')`);
+      expect(deletion).toContain(`'${collection}'`);
+    }
+    expect(writer).toContain('record_room_membership');
+    expect(writer).toContain('stepRecordKey(floor, step)');
+    expect(writer).toContain('step-v2_${groupId}');
+    expect(writer).toContain('accepted.receipt');
+    expect(writer).toContain('floorRecordServerEnabled(configSnap.data())');
+    expect(writer).toContain('participantUids');
+    expect(writer).not.toContain("collection('users')");
+    // Jarvis does not consume the new competitive records; existing progress fields remain unchanged.
+  });
+});
