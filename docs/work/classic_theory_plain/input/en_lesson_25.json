  {
   "id": "en-classic-r1:25.01",
   "target": "I was reading.",
   "ru": "Я читала.",
   "uk": "Я читала."
  },
  {
   "id": "en-classic-r1:25.02",
   "target": "She was driving.",
   "ru": "Она была за рулем.",
   "uk": "Вона була за кермом."
  },
  {
   "id": "en-classic-r1:25.03",
   "target": "We were waiting.",
   "ru": "Мы ждали.",
   "uk": "Ми чекали."
  },
  {
   "id": "en-classic-r1:25.04",
   "target": "They were packing.",
   "ru": "Они собирали вещи.",
   "uk": "Вони пакували речі."
  },
  {
   "id": "en-classic-r1:25.05",
   "target": "He was cooking dinner.",
   "ru": "Он готовил ужин.",
   "uk": "Він готував вечерю."
  },
  {
   "id": "en-classic-r1:25.06",
   "target": "I was checking the address in my notebook.",
   "ru": "Я проверял адрес в блокноте.",
   "uk": "Я перевіряв адресу у своєму блокноті."
  },
  {
   "id": "en-classic-r1:25.07",
   "target": "She was carrying two bags.",
   "ru": "Она несла две сумки.",
   "uk": "Вона несла дві сумки."
  },
  {
   "id": "en-classic-r1:25.08",
   "target": "You were standing by the lift.",
   "ru": "Вы стояли у лифта.",
   "uk": "Ви стояли біля ліфта."
  },
  {
   "id": "en-classic-r1:25.09",
   "target": "The phone was charging.",
   "ru": "Телефон заряжался.",
   "uk": "Телефон заряджався."
  },
  {
   "id": "en-classic-r1:25.10",
   "target": "The children were sleeping.",
   "ru": "Дети спали.",
   "uk": "Діти спали."
  },
  {
   "id": "en-classic-r1:25.11",
   "target": "At six, I was walking home.",
   "ru": "В шесть я шла домой.",
   "uk": "О шостій я йшла додому."
  },
  {
   "id": "en-classic-r1:25.12",
   "target": "At eight, she was still working.",
   "ru": "В восемь она все еще работала.",
   "uk": "О восьмій вона ще працювала."
  },
  {
   "id": "en-classic-r1:25.13",
   "target": "We were having breakfast at seven.",
   "ru": "Мы завтракали в семь.",
   "uk": "Ми снідали о сьомій."
  },
  {
   "id": "en-classic-r1:25.14",
   "target": "He was waiting near the barrier.",
   "ru": "Он ждал у шлагбаума.",
   "uk": "Він чекав біля шлагбаума."
  },
  {
   "id": "en-classic-r1:25.15",
   "target": "They were travelling all afternoon.",
   "ru": "Они ехали всю вторую половину дня.",
   "uk": "Вони їхали всю другу половину дня."
  },
  {
   "id": "en-classic-r1:25.16",
   "target": "I was wearing a waterproof jacket that day.",
   "ru": "В тот день на мне была водонепроницаемая куртка.",
   "uk": "Того дня на мені була водонепроникна куртка."
  },
  {
   "id": "en-classic-r1:25.17",
   "target": "The rain was dripping through the ceiling.",
   "ru": "Дождь капал сквозь потолок.",
   "uk": "Дощ капав крізь стелю."
  },
  {
   "id": "en-classic-r1:25.18",
   "target": "The dog was barking by the handrail.",
   "ru": "Собака лаяла у поручня.",
   "uk": "Собака гавкала біля поручня."
  },
  {
   "id": "en-classic-r1:25.19",
   "target": "The driver was checking the brakes.",
   "ru": "Водитель проверял тормоза.",
   "uk": "Водій перевіряв гальма."
  },
  {
   "id": "en-classic-r1:25.20",
   "target": "My neighbour was moving boxes upstairs.",
   "ru": "Мой сосед переносил коробки наверх.",
   "uk": "Мій сусід переносив коробки нагору."
  },
  {
   "id": "en-classic-r1:25.21",
   "target": "I was reading when the phone rang.",
   "ru": "Я читала, когда зазвонил телефон.",
   "uk": "Я читала, коли задзвонив телефон."
  },
  {
   "id": "en-classic-r1:25.22",
   "target": "She was cooking when the lights went out.",
   "ru": "Она готовила, когда погас свет.",
   "uk": "Вона готувала, коли згасло світло."
  },
  {
   "id": "en-classic-r1:25.23",
   "target": "We were waiting when the taxi arrived.",
   "ru": "Мы ждали, и тут приехало такси.",
   "uk": "Ми чекали, коли приїхало таксі."
  },
  {
   "id": "en-classic-r1:25.24",
   "target": "He was walking home when it started to rain.",
   "ru": "Он шел домой, когда начался дождь.",
   "uk": "Він йшов додому, коли почався дощ."
  },
  {
   "id": "en-classic-r1:25.25",
   "target": "They were eating when someone knocked.",
   "ru": "Они ели, когда кто-то постучал.",
   "uk": "Вони їли, коли хтось постукав."
  },
  {
   "id": "en-classic-r1:25.26",
   "target": "I dropped my keys while I was running.",
   "ru": "Я уронил ключи, когда бежал.",
   "uk": "Я впустив ключі, бігаючи."
  },
  {
   "id": "en-classic-r1:25.27",
   "target": "She saw the sign while she was crossing the road.",
   "ru": "Она увидела знак, переходя дорогу.",
   "uk": "Вона побачила знак, коли переходила дорогу."
  },
  {
   "id": "en-classic-r1:25.28",
   "target": "We heard a bang while we were packing.",
   "ru": "Мы услышали хлопок, когда собирали вещи.",
   "uk": "Ми почули гуркіт, коли пакували речі."
  },
  {
   "id": "en-classic-r1:25.29",
   "target": "The ferry left while I was buying a ticket.",
   "ru": "Паром отплыл, пока я покупал билет.",
   "uk": "Пором відплив, поки я купував квиток."
  },
  {
   "id": "en-classic-r1:25.30",
   "target": "He found the receipt while he was cleaning the car.",
   "ru": "Он нашел квитанцию, когда мыл машину.",
   "uk": "Він знайшов чек, коли мив машину."
  },
  {
   "id": "en-classic-r1:25.31",
   "target": "Were you working at nine?",
   "ru": "Вы работали в девять?",
   "uk": "Ви працювали о дев'ятій?"
  },
  {
   "id": "en-classic-r1:25.32",
   "target": "Was she waiting for the driver?",
   "ru": "Она ждала водителя?",
   "uk": "Вона чекала на водія?"
  },
  {
   "id": "en-classic-r1:25.33",
   "target": "What were they carrying?",
   "ru": "Что они везли?",
   "uk": "Що вони перевозили?"
  },
  {
   "id": "en-classic-r1:25.34",
   "target": "Where were you sitting?",
   "ru": "Где вы сидели?",
   "uk": "Де ви сиділи?"
  },
  {
   "id": "en-classic-r1:25.35",
   "target": "Who was using the printer?",
   "ru": "Кто пользовался принтером?",
   "uk": "Хто користувався принтером?"
  },
  {
   "id": "en-classic-r1:25.36",
   "target": "Why was the smoke alarm ringing?",
   "ru": "Почему звенела пожарная сигнализация?",
   "uk": "Чому дзвонила пожежна сигналізація?"
  },
  {
   "id": "en-classic-r1:25.37",
   "target": "I was not looking at my phone.",
   "ru": "Я не смотрел в телефон.",
   "uk": "Я не дивився на телефон."
  },
  {
   "id": "en-classic-r1:25.38",
   "target": "He was not listening to the announcement.",
   "ru": "Он не слушал объявление.",
   "uk": "Він не слухав оголошення."
  },
  {
   "id": "en-classic-r1:25.39",
   "target": "We were not blocking the entrance.",
   "ru": "Мы не загораживали вход.",
   "uk": "Ми не блокували вхід."
  },
  {
   "id": "en-classic-r1:25.40",
   "target": "The lights were not working that evening.",
   "ru": "В тот вечер не работал свет.",
   "uk": "Того вечора не працювало світло."
  },
  {
   "id": "en-classic-r1:25.41",
   "target": "While I was parking, she was paying for the tickets.",
   "ru": "Пока я парковался, она платила за билеты.",
   "uk": "Поки я паркувався, вона платила за квитки."
  },
  {
   "id": "en-classic-r1:25.42",
   "target": "While he was reading, I was cooking our meal.",
   "ru": "Пока он читал, я готовил нам поесть.",
   "uk": "Поки він читав, я готував нам поїсти."
  },
  {
   "id": "en-classic-r1:25.43",
   "target": "We were talking when the doors opened.",
   "ru": "Мы разговаривали, когда открылись двери.",
   "uk": "Ми розмовляли, коли двері відчинилися."
  },
  {
   "id": "en-classic-r1:25.44",
   "target": "She was trying on shoes when I called.",
   "ru": "Она примеряла обувь, когда я позвонил.",
   "uk": "Вона приміряла взуття, коли я подзвонив."
  },
  {
   "id": "en-classic-r1:25.45",
   "target": "I was still filling in the form when they closed the desk.",
   "ru": "Я все еще заполнял форму, когда закрыли стойку.",
   "uk": "Я все ще заповнював форму, коли вони зачинили стійку."
  },
  {
   "id": "en-classic-r1:25.46",
   "target": "The driver waved while we were crossing.",
   "ru": "Водитель помахал нам рукой, когда мы переходили дорогу.",
   "uk": "Водій помахав рукою, коли ми переходили дорогу."
  },
  {
   "id": "en-classic-r1:25.47",
   "target": "I missed the announcement because I was wearing headphones.",
   "ru": "Я пропустил объявление, потому что был в наушниках.",
   "uk": "Я пропустив оголошення, бо був у навушниках."
  },
  {
   "id": "en-classic-r1:25.48",
   "target": "The shop was closing as we arrived.",
   "ru": "Магазин закрывался, когда мы приехали.",
   "uk": "Магазин закривався, коли ми приїхали."
  },
  {
   "id": "en-classic-r1:25.49",
   "target": "I was washing my hands when the tap broke.",
   "ru": "Я мыл руки, когда сломался кран.",
   "uk": "Я мив руки, коли зламався кран."
  },
  {
   "id": "en-classic-r1:25.50",
   "target": "They were looking for shelter when the rain stopped.",
   "ru": "Они искали укрытие, когда дождь прекратился.",
   "uk": "Вони шукали прихистку, коли дощ припинився."
  }
