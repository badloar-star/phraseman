  {
   "id": "en-classic-r1:17.23",
   "target": "Are they waiting outside?",
   "ru": "Они ждут снаружи?",
   "uk": "Вони чекають надворі?"
  },
  {
   "id": "en-classic-r1:17.24",
   "target": "What are you cooking?",
   "ru": "Что ты готовишь?",
   "uk": "Що ти готуєш?"
  },
  {
   "id": "en-classic-r1:17.25",
   "target": "Who is calling you?",
   "ru": "Кто тебе звонит?",
   "uk": "Хто тобі телефонує?"
  },
  {
   "id": "en-classic-r1:17.26",
   "target": "Where are we going?",
   "ru": "Куда мы идём?",
   "uk": "Куди ми йдемо?"
  },
  {
   "id": "en-classic-r1:17.27",
   "target": "Why is the light flashing?",
   "ru": "Почему мигает свет?",
   "uk": "Чому блимає світло?"
  },
  {
   "id": "en-classic-r1:17.28",
   "target": "Is the kettle boiling?",
   "ru": "Чайник кипит?",
   "uk": "Чайник кипить?"
  },
  {
   "id": "en-classic-r1:17.29",
   "target": "What are they looking for?",
   "ru": "Что они ищут?",
   "uk": "Що вони шукають?"
  },
  {
   "id": "en-classic-r1:17.30",
   "target": "Are you using this chair?",
   "ru": "Вы пользуетесь этим стулом?",
   "uk": "Ви користуєтеся цим стільцем?"
  },
  {
   "id": "en-classic-r1:17.31",
   "target": "I am not ignoring you.",
   "ru": "Я вас не игнорирую.",
   "uk": "Я вас не ігнорую."
  },
  {
   "id": "en-classic-r1:17.32",
   "target": "She is not feeling well.",
