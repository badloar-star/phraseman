import { reconcileSpireHistory, spireFactsFromWeekResult } from '../modules/spire/achievement_reconcile';
import { applySpireAchievementFact, type SpireAchievementState } from '../modules/spire/achievement_progress';

const atMs = Date.parse('2026-09-01T10:00:00Z');
const result = { schema: 'spire-week-result.v1', prevTier: 0, newTier: 1, promoted: true, demoted: false, steps: 135, reachedAtMs: atMs, finalizedAt: { toMillis: () => atMs + 1000 } };

it('recovers both stages from an old server result without participation/card caches', async () => {
  let state: SpireAchievementState | undefined;
  const read = jest.fn().mockResolvedValueOnce({ rows: [{ ...result, steps: 10 }], next: 'old-result' }).mockResolvedValueOnce({ rows: [result], next: null });
  expect(await reconcileSpireHistory(read, async (fact) => { state = applySpireAchievementFact(state, fact)?.state ?? state; return true; }, () => true)).toBe(true);
  expect(read).toHaveBeenNthCalledWith(2, 'old-result');
  expect(state).toMatchObject({ id: 'spire_summit_granite', unlockedAt: new Date(atMs).toISOString(), spirePromotedAt: new Date(atMs + 1000).toISOString() });
});

it.each([
  { promoted: 'true' }, { demoted: true }, { newTier: 3 }, { prevTier: 11, newTier: 12 }, { prevTier: -1 }, { prevTier: 0.5 }, { finalizedAt: null },
])('rejects malformed promotion %j', (patch) => {
  expect(spireFactsFromWeekResult({ ...result, ...patch }).filter(f => f.kind === 'promotion')).toEqual([]);
});

it('does not advance to another page after a failed durable save; retry replays the first page', async () => {
  const read = jest.fn().mockResolvedValue({ rows: [result], next: 'more' });
  expect(await reconcileSpireHistory(read, async () => false, () => true)).toBe(false);
  expect(read).toHaveBeenCalledTimes(1);
  expect(await reconcileSpireHistory(read, async () => false, () => true)).toBe(false);
  expect(read.mock.calls).toEqual([[null], [null]]);
});

it('a delayed page from A cannot deliver any facts after account changes to B', async () => {
  let current = true;
  const apply = jest.fn();
  expect(await reconcileSpireHistory(async () => { current = false; return { rows: [result], next: null }; }, apply, () => current)).toBe(false);
  expect(apply).not.toHaveBeenCalled();
});
