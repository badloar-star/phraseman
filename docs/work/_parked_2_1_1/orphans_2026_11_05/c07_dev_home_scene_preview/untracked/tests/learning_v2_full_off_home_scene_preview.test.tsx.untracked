import {
  projectDevHomeSceneDecisionForOwnerFullOff,
  projectDevHomeScenePreviewPlaceForOwnerFullOff,
  projectDevHomeSceneSpecialCopyForOwnerFullOff,
} from '../app/dev_home_scene_preview';
import { buildHomeSceneCopy } from '../components/home/v2/scene/home_scene_copy';
import {
  HOME_SCENE_PREVIEW_STATES,
  homeScenePreviewPlace,
  homeScenePreviewSetup,
} from '../components/home/v2/scene/home_scene_preview_fixtures';
import { HOME_SCENE_SPECIAL_STATES } from '../components/home/v2/scene/home_scene_special';
import { buildHomeSceneSpecialCopy } from '../components/home/v2/scene/home_scene_special_copy';
import { pickHomeSceneState } from '../components/home/v2/scene/home_scene_state';

jest.mock('@expo/vector-icons/Ionicons', () => () => null);
jest.mock('expo-image', () => ({ Image: () => null }));
jest.mock('expo-router', () => ({ Redirect: () => null, useLocalSearchParams: () => ({}) }));
jest.mock('react-native', () => ({
  ScrollView: () => null,
  StyleSheet: { create: <T,>(styles: T): T => styles },
  View: () => null,
}));
jest.mock('../components/ScreenGradient', () => ({ __esModule: true, default: ({ children }: { children: unknown }) => children }));
jest.mock('../components/LangContext', () => ({ useLang: () => ({ lang: 'ru' }) }));
jest.mock('../components/ThemeContext', () => ({ useTheme: () => ({ liquidGlassAppearance: 'dark' }) }));
jest.mock('../components/coins/coin_rank_display', () => ({ coinRankDisplaySource: () => ({}) }));
jest.mock('../components/home/v2/HomeV2Header', () => ({ __esModule: true, default: () => null }));
jest.mock('../components/home/v2/scene/HomeScene', () => ({ HomeSceneView: () => null }));
jest.mock('../components/home/v2/scene/HomeSceneEnergy', () => ({ HomeSceneEnergyView: () => null }));
jest.mock('../components/v2/ShadowSurface', () => ({ nestedBoxShadow: () => '', useShadowGlass: () => ({}) }));
jest.mock('../components/v2/plateAlpha', () => ({ colorWithAlpha: () => 'transparent' }));
jest.mock('../components/v2/useV2Palette', () => ({ useV2Palette: () => ({ glassRaised: '#000', textSecondary: '#000', iconTint: '#000' }) }));
jest.mock('../app/config', () => ({ ENABLE_DEV_TOOLS: true, IS_STORE_RELEASE: false }));
jest.mock('../app/dev_appearance_override', () => ({
  getDevAppearance: () => null,
  getDevThemeChoice: () => null,
  setDevAppearance: () => undefined,
  setDevThemeChoice: () => undefined,
}));
jest.mock('../app/stable_safe_area_metrics', () => ({ useStableSafeAreaInsets: () => ({ top: 0 }) }));

describe('Home Scene preview never offers Learning V2 while owner full-off is active', () => {
  const forbiddenV2Copy = /Learning V2|\bV2\b|Эпизод|Епізод|Episode|Episodio|Episódio|Tập|Bölüm|Odcinek|экзамен главы|новые эпизоды/i;

  it.each(HOME_SCENE_PREVIEW_STATES)('projects the actual %s scene copy to Classic-only content', (state) => {
    const setup = homeScenePreviewSetup(state, false);
    const raw = homeScenePreviewPlace('ru', setup, (_lang, lesson, episode) =>
      `Learning V2 · Урок ${lesson} · Эпизод ${episode}`,
    );

    const place = projectDevHomeScenePreviewPlaceForOwnerFullOff(raw, setup.lesson);
    const decision = projectDevHomeSceneDecisionForOwnerFullOff(pickHomeSceneState(setup.input));
    const copy = buildHomeSceneCopy({
      lang: 'ru',
      state: decision.state,
      zeroEnergyNote: decision.zeroEnergyNote,
      badge: place.badge,
      episode: place.episode,
      title: place.title,
      progress: place.done !== null && place.total !== null ? { done: place.done, total: place.total } : null,
      streakDays: setup.streakDays,
      minutesToMidnight: setup.minutesToMidnight,
      daysAway: setup.daysAway,
      energyMinutes: setup.energyMinutes,
      theoryAvailable: place.theoryLessonId !== null,
      wordsAvailable: false,
      lostStreakDays: setup.lostStreakDays,
      ctaTarget: place.ctaTarget,
      lessonNo: place.lessonNo,
    });

    expect(place.episode).toBeNull();
    expect(place.theoryLessonId).toBeNull();
    expect(place.done).toBeNull();
    expect(place.total).toBeNull();
    expect(place.ctaTarget).not.toBe('v2');
    expect(place.title).not.toMatch(/Learning V2|Эпизод/i);
    expect(copy.bar).toBeNull();
    if (state === 'continue' || state === 'offline') expect(copy.line).toBeNull();

    if (raw.episode === null) {
      expect(place.ctaTarget).toBe('unknown');
      expect(place.lessonNo).toBeNull();
      expect(place.title).toBe(raw.title);
    } else {
      expect(place.ctaTarget).toBe('legacy');
      expect(place.lessonNo).toBe(setup.lesson);
      expect(place.title).toBe(raw.badge);
    }

    expect(Object.values(copy).filter((value): value is string => typeof value === 'string').join(' | ')).not.toMatch(forbiddenV2Copy);
  });

  it.each(HOME_SCENE_SPECIAL_STATES)('projects the actual %s special copy to Classic-only content', (special) => {
    const raw = buildHomeSceneSpecialCopy({
      lang: 'ru',
      special,
      n: 15,
      best: 40,
      today: 30,
      friendName: 'Аня',
      placeTo: 4,
      right: 'I am ready.',
      phrase: 'Small steps count.',
      phraseTr: 'Маленькие шаги важны.',
      holiday: 'halloween',
      milestoneKey: 'phrases_100',
      place: 'Урок 1 · Эпизод 12',
      weekDays: 5,
    });

    const copy = projectDevHomeSceneSpecialCopyForOwnerFullOff(raw);

    expect(Object.values(copy).filter((value): value is string => typeof value === 'string').join(' | ')).not.toMatch(forbiddenV2Copy);
  });
});
