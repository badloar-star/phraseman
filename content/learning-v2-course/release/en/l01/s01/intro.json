    {
      "pageOrdinal": 1,
      "pageId": "en:lesson-01:session-01:intro1",
      "kind": "concept",
      "titleByLocale": {
        "ru": "Два слова, с которых начинается разговор о себе"
      },
      "bodyByLocale": {
        "ru": "`I` — это «я». `am` — маленькая скрепка. По-русски мы её пропускаем: «я\nздесь», «я готов». По-английски без неё фраза разваливается, как стул без\nодной ножки.\n\n`I am here` — «я здесь». Скажите вслух. Всё, вы только что произнесли\nпервое английское предложение, и оно правильное."
      },
      "question": {
        "interactionId": "en:lesson-01:session-01:intro1:q",
        "promptByLocale": {
          "ru": "Вы зашли в офис. Все обернулись. Скажите «я здесь»."
        },
        "choicesByLocale": {
          "ru": [
            {
              "responseId": "en:lesson-01:session-01:intro1:r1",
              "text": "I am here."
            },
            {
              "responseId": "en:lesson-01:session-01:intro1:r2",
              "text": "I here."
            },
            {
              "responseId": "en:lesson-01:session-01:intro1:r3",
              "text": "Am here."
            }
          ]
        },
        "accessibilityLabelByLocale": {
          "ru": "Вы зашли в офис. Все обернулись. Скажите «я здесь»."
        }
      }
    },
    {
      "pageOrdinal": 2,
      "pageId": "en:lesson-01:session-01:intro2",
      "kind": "formula",
      "titleByLocale": {
        "ru": "I am + одно слово о себе"
      },
      "bodyByLocale": {
        "ru": "`I am ready` — «я готов». `I am fine` — «у меня всё хорошо». Меняется\nтолько последнее слово, `I am` стоит как приклеенное.\n\nСамый надёжный конструктор в английском: два первых кубика всегда те же.\nДальше подставляйте что хотите."
      },
      "question": {
        "interactionId": "en:lesson-01:session-01:intro2:q",
        "promptByLocale": {
          "ru": "Начальник спрашивает: «Ready?» Ответьте «я готов»."
        },
        "choicesByLocale": {
          "ru": [
            {
              "responseId": "en:lesson-01:session-01:intro2:r1",
              "text": "I am ready."
            },
            {
              "responseId": "en:lesson-01:session-01:intro2:r2",
              "text": "I ready am."
            },
            {
              "responseId": "en:lesson-01:session-01:intro2:r3",
              "text": "Ready am I."
            }
          ]
        },
        "accessibilityLabelByLocale": {
          "ru": "Начальник спрашивает: «Ready?» Ответьте «я готов»."
        }
      }
    },
    {
      "pageOrdinal": 3,
      "pageId": "en:lesson-01:session-01:intro3",
      "kind": "trap",
      "titleByLocale": {
        "ru": "Am хочется выбросить — не давайте"
      },
      "bodyByLocale": {
        "ru": "Главная ошибка первого дня: `I fine`, `I happy`. Тянет ведь: по-русски «я\nв порядке» — без всякого «есть».\n\nПроверка простая: после `I` идёт слово о вас — между ними обязано стоять\n`am`. `I am fine`. Одно лишнее слово — и вас понимает весь мир."
      },
      "question": {
        "interactionId": "en:lesson-01:session-01:intro3:q",
        "promptByLocale": {
          "ru": "Коллега спрашивает, как вы. Всё хорошо. Скажите это."
        },
        "choicesByLocale": {
          "ru": [
            {
              "responseId": "en:lesson-01:session-01:intro3:r1",
              "text": "I am fine."
            },
            {
              "responseId": "en:lesson-01:session-01:intro3:r2",
              "text": "I fine."
            },
            {
              "responseId": "en:lesson-01:session-01:intro3:r3",
              "text": "I is fine."
            }
          ]
        },
        "accessibilityLabelByLocale": {
          "ru": "Коллега спрашивает, как вы. Всё хорошо. Скажите это."
        }
      }
    }
  ],
