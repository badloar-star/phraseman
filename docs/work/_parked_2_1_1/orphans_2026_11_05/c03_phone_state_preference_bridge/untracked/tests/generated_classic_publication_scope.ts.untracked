// Generated verbatim cutover core; actual API/projection + verbatim token type. Native view/flag boundaries are typed declarations, not implementations.
import type {PersonalProgressApi} from '../modules/phone-state/domains/progress_api';
import type {PersonalProgressProjection} from '../modules/phone-state/domains/progress_projection';
export type AccountGenerationToken = Readonly<{
  generation: number;
  stableId: string | null;
  phase: 'uninitialized' | 'active' | 'transitioning';
}>;
declare function assignPhoneStateCohort(owner:string,percent:number):boolean;
declare function getRemoteBool(key:string):boolean;
declare function getRemoteNumber(key:string):number;
declare function isPhoneStateHealthCutoverAllowed():boolean;
declare function publishPersonalProgressProjection(projection:PersonalProgressProjection,source:'phone_state'|'legacy'):void;
let progressApi: PersonalProgressApi | null = null;
type PublicationScope = Readonly<{token:AccountGenerationToken;isCurrent():boolean}>;
type PendingPublication = {api:PersonalProgressApi;stableUid:string;scope:PublicationScope;inFlight:boolean};
let pendingPublication:PendingPublication|null=null;
const publicationCurrent = (scope:PublicationScope):boolean => {try{return scope.isCurrent();}catch{return false;}};
const reportPublicationFailure = ():void => {console.warn('[PROGRESS-CUTOVER] durable commit retained; view publication failed, refresh pending');};
function publishCommittedProjection(api:PersonalProgressApi,stableUid:string,projection:PersonalProgressProjection,scope:PublicationScope|null):void{
  if(progressApi!==api)return;
  try{
    publishPersonalProgressProjection(projection,'phone_state');
    if(pendingPublication?.api===api&&pendingPublication.stableUid===stableUid)pendingPublication=null;
  }catch{
    if(scope&&publicationCurrent(scope)&&progressApi===api)pendingPublication={api,stableUid,scope,inFlight:false};
    reportPublicationFailure();
  }
}
export async function retryPendingPhoneStateProgressPublication(stableUid:string,token:AccountGenerationToken):Promise<boolean>{
  const pending=pendingPublication;
  if(!pending||pending.inFlight||pending.stableUid!==stableUid||pending.scope.token.generation!==token.generation||pending.scope.token.stableId!==token.stableId||pending.scope.token.phase!==token.phase||progressApi!==pending.api||!publicationCurrent(pending.scope))return false;
  pending.inFlight=true;
  try{
    const projection=await pending.api.read();
    if(pendingPublication!==pending||progressApi!==pending.api||!publicationCurrent(pending.scope))return false;
    publishPersonalProgressProjection(projection,'phone_state');
    if(pendingPublication===pending)pendingPublication=null;
    return true;
  }catch{
    if(pendingPublication===pending&&progressApi===pending.api&&publicationCurrent(pending.scope))reportPublicationFailure();
    return false;
  }finally{pending.inFlight=false;}
}
export function configurePhoneStateProgressCutover(api: PersonalProgressApi | null): void {
  progressApi = api;
  pendingPublication = null;
}
export function getPhoneStateProgressApi(): PersonalProgressApi | null {
  return progressApi;
}
export function isPhoneStateCutoverEnabled(stableUid: string | null): boolean {
  return Boolean(
    progressApi
    && stableUid
    && getRemoteBool('phone_state_sync_enabled')
    && !getRemoteBool('phone_state_emergency_stop')
    && isPhoneStateHealthCutoverAllowed()
    && assignPhoneStateCohort(stableUid, getRemoteNumber('phone_state_cutover_percent')),
  );
}
export async function trySubmitProgressThroughPhoneState(
  stableUid: string | null,
  input: Readonly<{
    eventId: string;
    type: string;
    payload: Readonly<Record<string, unknown>>;
  }>,
  options?: Readonly<{ requireDurableCommit: true; originalCreatedAtMs: number; publicationScope?: PublicationScope }>,
): Promise<PersonalProgressProjection | null> {
  if(options && (input.type!=='lesson_complete' || input.payload.studyTarget!=='en' || !Number.isSafeInteger(options.originalCreatedAtMs) || options.originalCreatedAtMs<0))throw Error('phone_state_progress_input_invalid');
  const originalCreatedAtMs=options?.originalCreatedAtMs;
  const publicationScope=options?.publicationScope?Object.freeze({...options.publicationScope}):null;
  if(publicationScope&&!publicationCurrent(publicationScope))throw Error('phone_state_progress_owner_stale');
  const api = progressApi;
  if (!api || !isPhoneStateCutoverEnabled(stableUid) || input.type === 'wager_win') return null;
  try {
    if (input.type === 'lesson_complete') {
      const lessonId = input.payload.lessonId ?? input.payload.lessonNumber;
      if (typeof lessonId !== 'string' && typeof lessonId !== 'number') {
        if(options?.requireDurableCommit)throw Error('phone_state_progress_input_invalid');
        return null;
      }
      const bestCandidate = Number(input.payload.bestPct ?? input.payload.bestScore);
      const bestPct = Number.isFinite(bestCandidate) ? bestCandidate : undefined;
      const projection = await api.completeLesson({
        eventId: input.eventId,
        lessonId: String(lessonId),
        ...(bestPct === undefined ? {} : { bestPct }),
      }, originalCreatedAtMs===undefined ? undefined : {originalCreatedAtMs});
      if(options?.requireDurableCommit){
        if(publicationScope&&!publicationCurrent(publicationScope))throw Error('phone_state_progress_owner_stale');
        publishCommittedProjection(api,stableUid!,projection,publicationScope);
      }else publishPersonalProgressProjection(projection, 'phone_state');
      return projection;
    }
    if (input.type === 'exam_complete') {
      const examId = input.payload.examId ?? input.payload.level ?? input.payload.lessonId;
      const bestPct = Number(input.payload.bestPct ?? input.payload.pct ?? input.payload.score);
      if ((typeof examId !== 'string' && typeof examId !== 'number') || !Number.isFinite(bestPct)) {
        return null;
      }
      const projection = await api.completeExam({ eventId: input.eventId, examId: String(examId), bestPct });
      publishPersonalProgressProjection(projection, 'phone_state');
      return projection;
    }
    return api.read();
  } catch (error) {
    if(options?.requireDurableCommit)throw error;
    // зачем (PM-215 preflight, 03.10): немой catch молча переключал прогресс на сетевую ветку —
    // причина отказа phone-state обязана быть в журнале. Поведение прежнее (null → сетевая ветка).
    console.warn('[PROGRESS-CUTOVER] phone_state submit failed — fallback to network path', String((error as Error)?.message ?? error).slice(0, 160));
    return null;
  }
}
