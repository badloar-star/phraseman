  },
  {
   "id": "en-classic-r1:17.21",
   "target": "Are you listening?",
   "ru": "Ты слушаешь?",
   "uk": "Ти слухаєш?"
  },
  {
   "id": "en-classic-r1:17.22",
   "target": "Is she coming with us?",
