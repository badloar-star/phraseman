 },
 {
  "id": "fr:18:07",
  "fr": "J’ai acheté du pain.",
  "ru": "жэ ашёте́ дю пэн",
  "uk": "же ашьоте́ дю пен"
 },
 {
  "id": "fr:19:12",
  "fr": "Léa est allée à la banque.",
