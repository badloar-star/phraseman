{
  "expo": {
    "name": "Phraseman",
    "owner": "badloar",
    "slug": "phraseman",
    "version": "1.6.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "phraseman",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": "1.5.53",
    "updates": {
      "enabled": true,
      "url": "https://u.expo.dev/87b454d9-0384-4213-8c26-fc12162e73d2",
      "checkAutomatically": "ON_ERROR_RECOVERY",
      "fallbackToCacheTimeout": 0,
      "assetPatternsToBeBundled": [
        "node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/Ionicons.ttf",
        "node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/MaterialIcons.ttf",
        "assets/fonts/*.ttf",
        "assets/images/achievement_categories/*",
        "assets/images/achievements/streak_3.webp",
        "assets/images/achievements/streak_7.webp",
        "assets/images/achievements/perfect_week.webp",
        "assets/images/achievements/lesson_1.webp",
        "assets/images/achievements/lesson_3.webp",
        "assets/images/achievements/lesson_5.webp",
        "assets/images/achievements/lesson_perfect.webp",
        "assets/images/achievements/xp_100.webp",
        "assets/images/achievements/xp_250.webp",
        "assets/images/achievements/xp_500.webp",
        "assets/images/achievements/combo_3.webp",
        "assets/images/achievements/combo_10.webp",
        "assets/images/achievements/daily_task_first.webp",
        "assets/images/achievements/all_daily.webp",
        "assets/images/achievements/daily_phrase_first.webp",
        "assets/images/achievements/login_7.webp",
        "assets/images/achievements/comeback.webp",
        "assets/images/achievements/diagnosis.webp",
        "assets/images/achievements/exam_first.webp",
        "assets/images/achievements/flashcards_session.webp",
        "assets/images/achievements/recall_first.webp",
        "assets/images/achievements/shards_100.webp",
        "assets/images/achievements/energy_refill_first.webp",
        "assets/images/achievements/league_result_first.webp",
        "assets/images/avatars/*",
        "assets/images/daily_task_icons/**/*",
        "assets/images/energy/*",
        "assets/images/flashcard_backs/*",
        "assets/images/friends/*",
        "assets/images/home/*",
        "assets/images/header_glyphs/*",
        "assets/images/home_menu/*",
        "assets/images/league/league_crown.webp",
        "assets/images/league_bonus/*",
        "assets/images/lesson_cycle_end_modal/*",
        "assets/images/levels/league-v4-icons/*",
        "assets/images/levels/league-v4/*",
        "assets/images/levels/league-v5-heraldry/*.png",
        "assets/images/levels/league-v5-heraldry/*.webp",
        "assets/images/levels/league-v6-icons/*.webp",
        "assets/images/levels/league-v6-cards/*.webp",
        "assets/images/levels/generated-v5-dalle/*.webp",
        "assets/images/levels/*.webp",
        "assets/images/lesson_intro/*",
        "assets/images/lessons/*",
        "assets/images/level_gift_reward_icons/*",
        "assets/images/messages/*",
        "assets/images/onboarding/*",
        "assets/images/reward_modals/*",
        "assets/images/settings/**/*",
        "assets/images/currency/*",
        "assets/images/statistics/*.webp",
        "assets/images/statistics/cards/**/*",
        "assets/images/splash-icon.png",
        "assets/images/streak_overlays/*.webp",
        "assets/images/theo/*",
        "assets/images/weekly_boon_icons/png/**/*",
        "assets/images/trainer_theme_icons/**/*.webp"
      ]
    },
    "android": {
      "package": "app.phraseman",
      "googleServicesFile": "./google-services.json",
      "versionCode": 104,
      "allowBackup": true,
      "adaptiveIcon": {
        "backgroundColor": "#06141B",
        "foregroundImage": "./assets/images/icon.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "knowlyapps.com",
              "pathPrefix": "/phraseman/invite"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "com.google.android.gms.permission.AD_ID",
        "android.permission.ACCESS_ADSERVICES_AD_ID",
        "android.permission.ACCESS_ADSERVICES_ATTRIBUTION",
        "android.permission.ACCESS_ADSERVICES_TOPICS",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "ios": {
      "bundleIdentifier": "app.phraseman",
      "icon": "./assets/images/ios-icon.png",
      "buildNumber": "104",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:knowlyapps.com"
      ],
      "googleServicesFile": "./GoogleService-Info.plist",
      "entitlements": {
        "com.apple.security.application-groups": ["group.app.phraseman.widget"],
        "com.apple.developer.devicecheck.appattest-environment": "production"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Inter",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Inter-Regular.ttf",
                    "weight": 400
                  }
                ]
              },
              {
                "fontFamily": "Inter-SemiBold",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Inter-SemiBold.ttf",
                    "weight": 600
                  }
                ]
              },
              {
                "fontFamily": "Inter-Bold",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Inter-Bold.ttf",
                    "weight": 700
                  }
                ]
              },
              {
                "fontFamily": "Inter-Black",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Inter-Black.ttf",
                    "weight": 900
                  }
                ]
              }
            ]
          },
          "ios": [
            "./assets/fonts/Inter-Regular.ttf",
            "./assets/fonts/Inter-SemiBold.ttf",
            "./assets/fonts/Inter-Bold.ttf",
            "./assets/fonts/Inter-Black.ttf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#101214",
          "dark": {
            "backgroundColor": "#101214"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-foreground.png",
          "color": "#06141B"
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/crashlytics",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "buildReactNativeFromSource": true,
            "forceStaticLinking": [
              "RNFBApp",
              "RNFBAnalytics",
              "RNFBAppCheck",
              "RNFBAuth",
              "RNFBCrashlytics",
              "RNFBFirestore",
              "RNFBFunctions"
            ]
          },
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "useLegacyPackaging": true,
            "minSdkVersion": 24,
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a"
            ],
            "lintOptions": {
              "abortOnError": false
            },
            "extraProguardRules": "-keep class expo.modules.kotlin.** { *; }\n-keep class expo.modules.imagepicker.** { *; }\n-keep class expo.modules.applepayauthentication.** { *; }\n-keep class expo.modules.applesignin.** { *; }\n-keep class com.google.android.gms.auth.api.signin.** { *; }\n-keep class com.google.android.gms.common.api.** { *; }\n-keep class com.google.firebase.auth.** { *; }\n-keep class com.googlesignin.** { *; }\n-dontwarn expo.modules.kotlin.**\n-dontwarn expo.modules.imagepicker.**"
          }
        }
      ],
      "expo-secure-store",
      "expo-apple-authentication",
      "@react-native-google-signin/google-signin",
      "./plugins/withAndroidBackupRules",
      "./plugins/withAndroidLargeScreenSupport",
      "./plugins/withAndroidDevCleartext",
      "./plugins/withAndroidDevServer127",
      "./plugins/withAndroidDevClientAutoMetro",
      "./plugins/withProductionAndroidBundleHygiene",
      "./plugins/withAndroidSplashWindowBackground",
      "./plugins/withIosFirebaseEarlyConfigure",
      "./plugins/withAndroidDailyPhraseWidget",
      "@bacons/apple-targets",
      "./plugins/withIosDailyPhraseWidgetAppGroup"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "87b454d9-0384-4213-8c26-fc12162e73d2"
      }
    }
  }
}
