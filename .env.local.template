# RevenueCat API Keys (from https://dashboard.revenuecat.com)
# Get your API keys and add them here
# Then rename this file to .env.local (remove .template)

# Локально: отключить подтягивание JS с Expo Update-сервера (старое интерфейс без правок из репозитория).
# Включено по умолчанию в npm run android / dev через cross-env; при сборке только из Gradle выставь здесь вручную:
# EXPO_PUBLIC_DISABLE_EXPO_UPDATES=1

# QA: повтор «матрица»-интро при каждом открытии меню урока 1 (__DEV__/DEV_MODE в dev-client часто недоступны).
# Раскомментируй и перезапусти Metro (при кэше — npx expo start --clear).
# EXPO_PUBLIC_QA_REPEAT_LESSON1_INTRO=1

# iOS RevenueCat API Key (префикс appl_ — Apple / App Store)
EXPO_PUBLIC_RC_IOS=your_ios_api_key_here

# Android RevenueCat API Key
EXPO_PUBLIC_RC_ANDROID=your_android_api_key_here

# EAS Build (.env.local на сервер не попадает): задайте те же имена переменных
# в дашборде Expo (Environment variables) или через CLI, например:
#   eas env:create --name EXPO_PUBLIC_RC_IOS --value appl_xxx --environment production
#   eas env:create --name EXPO_PUBLIC_RC_ANDROID --value goog_xxx --environment production
# В eas.json у профиля production должно быть "environment": "production" — иначе сборка может
# взять переменные из preview, и в iOS попадёт неверный ключ. Проверка: eas env:list --environment production

# Sign in with Apple на Android (Services ID из Apple Developer + тот же ID в Firebase Auth → Apple).
# Return URL в Apple Developer должен совпадать с redirect: по умолчанию deep link из Linking.createURL('apple-auth'),
# либо задайте явно:
# EXPO_PUBLIC_APPLE_ANDROID_SERVICE_ID=com.example.phraseman.siwa
# EXPO_PUBLIC_APPLE_ANDROID_REDIRECT_URI=phraseman://apple-auth
