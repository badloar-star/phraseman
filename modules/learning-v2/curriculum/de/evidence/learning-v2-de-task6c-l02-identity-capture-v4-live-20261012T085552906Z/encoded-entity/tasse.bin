   },
   {
      "@context" : "https://schema.org",
      "@type" : "DefinedTerm",
      "description" : "[metonymisch] Getränk in einer Tasse",
      "inDefinedTermSet" : {
         "@type" : "DefinedTermSet",
         "name" : "DWDS-Wörterbuch",
         "url" : "https://www.dwds.de/d/wb-dwdswb"
      },
      "name" : "Tasse",
      "url" : "https://www.dwds.de/wb/Tasse"
   },
   {
      "@context" : "https://schema.org",
      "@type" : "DefinedTerm",
      "description" : "[metonymisch] Menge einer Substanz, die man mit einer Tasse abmisst",
      "inDefinedTermSet" : {
         "@type" : "DefinedTermSet",
         "name" : "DWDS-Wörterbuch",
         "url" : "https://www.dwds.de/d/wb-dwdswb"
      },
      "name" : "Tasse",
      "url" : "https://www.dwds.de/wb/Tasse"
   },
   {
      "@context" : "https://schema.org",
      "@type" : "DefinedTerm",
      "description" : "[A] flache Schale, Wanne, Untertasse, Platte o. Ä.",
      "inDefinedTermSet" : {
         "@type" : "DefinedTermSet",
         "name" : "DWDS-Wörterbuch",
         "url" : "https://www.dwds.de/d/wb-dwdswb"
      },
      "name" : "Tasse",
      "url" : "https://www.dwds.de/wb/Tasse"
   },
   {
      "@context" : "https://schema.org",
      "@type" : "Quotation",
      "isPartOf" : {
         "@type" : "Periodical",
         "name" : "Döbelner Allgemeine Zeitung, 19.04.2023"
      },
      "text" : "Aus Colditz kommen Farbpigmente für die keramische Industrie, etwa für Teller und Tassen aus Meißner Porzellan."
   },
   {
      "@context" : "https://schema.org",
      "@type" : "Quotation",
      "isPartOf" : {
         "@type" : "Periodical",
         "name" : "Thüringer Allgemeine, 21.12.2020"
      },
      "text" : "Jeder bekam eine Tasse mit dem Motiv des Turms der Haineck und selbst gebackene Plätzchen."
   },
   {
      "@context" : "https://schema.org",
      "@type" : "Quotation",
      "isPartOf" : {
         "@type" : "Periodical",
         "name" : "Neue Westfälische, 01.12.2017"
      },
      "text" : "Im Gemeindehaus klappern ab 15 Uhr wieder Tassen und Teller für den Kaffee oder Tee am Nachmittag."
   },
   {
      "@context" : "https://schema.org",
      "@type" : "Quotation",
      "isPartOf" : {
         "@type" : "Periodical",
         "name" : "Mittelbayerische, 21.10.2017"
      },
      "text" : "Ein Kaffeeservice für sechs Personen, zierliche Tassen mit Untertassen, dazu Kuchenteller, Milchkännchen und Zuckerdose."
   },
   {
      "@context" : "https://schema.org",
      "@type" : "Quotation",
      "isPartOf" : {
         "@type" : "Periodical",
         "name" : "Der Standard, 11.03.2016"
      },
      "text" : "Aus einer großen silbernen Kanne wird Schwarztee in weiße Tassen eingeschenkt."
   },
   {
      "@context" : "https://schema.org",
      "@type" : "Quotation",
      "isPartOf" : {
         "@type" : "Periodical",
         "name" : "Döbelner Allgemeine Zeitung, 17.06.2023"
      },
      "text" : "Auf dem Tablett türmen sich ein Teller mit Apfelstrudel, zwei Tassen Tee, ein Eisbecher und eine kleine Flasche Wasser."
   },
   {
      "@context" : "https://schema.org",
      "@type" : "Quotation",
      "isPartOf" : {
         "@type" : "Periodical",
         "name" : "Neue Zürcher Zeitung, 26.05.2023"
      },
      "text" : "Die Schweiz ist ein Land von Kaffeetrinkern. Fast 1.100 Tassen pro Kopf und Jahr konsumiert die Bevölkerung. Auch Deutschland gehört mit rund 1.300 Tassen weltweit zu den Spitzenreitern."
   },
   {
      "@context" : "https://schema.org",
      "@type" : "Quotation",
      "author" : {
         "@type" : "Person",
         "name" : "Maria Bunina"
      },
      "datePublished" : "2019-12-03",
      "isPartOf" : {
         "@type" : "WebPage",
         "name" : "Drei schnelle und leckere russische Kuchenrezepte",
         "url" : "https://de.rbth.com/russische-kueche/82795-rezepte-schnelle-leckere-kuchen"
      },
      "text" : "Zubereitung: Eier (3 Stück), Backpulver (1 TL), Honig (3 EL) und 1 Tasse Zucker unter starker Hitze in einer beschichteten Pfanne miteinander verrühren."
   },
   {
      "@context" : "https://schema.org",
      "@type" : "Quotation",
      "isPartOf" : {
         "@type" : "Periodical",
         "name" : "Hamburger Abendblatt, 31.08.2019"
      },
      "text" : "Für zwei Euro können Kunden eine Tasse Koffein tanken, das Kännchen kostet vier Euro, ein Stück Obst- oder Schokokuchen zwei Euro."
   },
   {
      "@context" : "https://schema.org",
      "@type" : "Quotation",
      "datePublished" : "2014-01-21",
      "isPartOf" : {
         "@type" : "WebPage",
         "name" : "»Zu Besuch bei Freunden« – SPD Rhein-Kreis Neuss",
         "url" : "https://www.spd-kreis-neuss.de/zu-besuch-bei-freunden/"
      },
      "text" : "Auf die Einladung beim Abschied, doch gelegentlich noch einmal auf eine Tasse Tee vorbeizuschauen, wird sicher der eine oder andere von uns gerne zurückkommen."
   },
   {
      "@context" : "https://schema.org",
      "@type" : "Quotation",
      "isPartOf" : {
         "@type" : "Periodical",
         "name" : "Wiener Zeitung, 18.09.2021"
      },
      "text" : "Der legendäre Herr Ferry brachte uns in serviler Akkuratesse die polierten Silbertassen mit den Kaffeeschalen und den Gläsern Wasser. Meine Freundin stellte nach einem Schluck Wasser ihr Glas nicht auf die Tasse zurück, sondern auf den Marmor des Tisches. Herr Ferry packte das Wasserglas und knallte es, knapp am Zerbersten, wortlos auf die zugehörige Tasse."
   },
   {
      "@context" : "https://schema.org",
      "@type" : "Quotation",
      "isPartOf" : {
         "@type" : "Periodical",
         "name" : "Niederösterreichische Nachrichten, 13.05.2014"
      },
      "text" : "Die wortkarge (einzige) Kellnerin gibt uns zu verstehen, dass es »Küche erst ab 18 Uhr« gebe, während eine Frau Tassen mit Torten und Süßigkeiten aus dem offenbar gut gefüllten Extrazimmer nach draußen (zu ihrem Auto?) trägt."
   },
   {
      "@context" : "https://schema.org",
      "@type" : "Quotation",
      "isPartOf" : {
         "@type" : "Periodical",
         "name" : "Kurier, 02.05.2013"
      },
      "text" : "Ich kann Obst schön foliert in der Tasse kaufen oder das gleiche Obst unverpackt im Körberl mitnehmen."
   },
   {
      "@context" : "https://schema.org",
      "@type" : "Quotation",
      "isPartOf" : {
         "@type" : "Periodical",
         "name" : "Der Standard, 29.04.2008"
      },
      "text" : "Auch bei Fisch und Fleisch lässt sich mit geübtem Blick Qualität leicht erkennen: So gibt etwa frisches Fleisch auf Fingerdruck nach. Nach dem Loslassen darf keine Delle zurückbleiben. Bei Fleisch wie auch bei Geflügel ist zudem Blut oder getrockneter Fleischsaft in der Tasse ein Zeichen für zu lange Lagerung."
   },
   {
      "@context" : "https://schema.org",
      "@type" : "Quotation",
      "isPartOf" : {
         "@type" : "Periodical",
         "name" : "Saarbrücker Zeitung, 19.11.1999"
      },
      "text" : "Dabei beim betreuten Wohnen handele es sich beispielsweise um Wohnungen, deren Türen breiter als normal und mit dem Rollstuhl befahrbar sind. Die Duschen würden ohne Tasse installiert und Fahrstühle eingerichtet."
   },
   {
      "@context" : "https://schema.org",
      "@type" : "Quotation",
      "isPartOf" : {
         "@type" : "Periodical",
         "name" : "o. A.: Die grosse Welt der Getränke, Hamburg: Tschibo Frisch-Röst-Kaffee Max Herz 1977, S. 265"
      },
      "text" : "Da kommt zu drei Vierteln Milch nur ein Viertel Kaffee in die Tasse."
   },
   {
      "@context" : "https://schema.org",
      "@type" : "Quotation",
      "isPartOf" : {
         "@type" : "Periodical",
         "name" : "Kölling, Alfred: Fachbuch für Kellner, Leipzig: Fachbuchverl. VEB 1962 [1956], S. 337"
      },
      "text" : "Auch das Abwinkeln der Tasse über dem Teller gilt als unfachlich."
   },
   {
      "@context" : "https://schema.org",
      "@type" : "Quotation",
      "isPartOf" : {
         "@type" : "Periodical",
         "name" : "Die Zeit, 23.03.2000"
      },
      "text" : "Der Mann habe, hieß es, nicht alle Tassen im Schrank."
   },
   {
      "@context" : "https://schema.org",
      "@type" : "Quotation",
      "isPartOf" : {
         "@type" : "Periodical",
         "name" : "Die Zeit, 26.01.1996"
      },
      "text" : "Obwohl es draußen dunkel ist, zeigt die Uhr erst halb fünf nachmittags, beste Zeit für eine gepflegte Tasse Tee."
   },
   {
      "@context" : "https://schema.org",
      "@type" : "Quotation",
      "isPartOf" : {
         "@type" : "Periodical",
         "name" : "Glavinic, Thomas: Die Arbeit der Nacht, München Wien: Carl Hanser Verlag 2006, S. 147"
      },
      "text" : "Mit der dampfenden Tasse in der Hand stellte er sich ans Fenster."
   },
   {
      "@context" : "https://schema.org",
      "@type" : "Quotation",
      "isPartOf" : {
         "@type" : "Periodical",
         "name" : "Bach, Tamara: Marsmädchen, Hamburg: Verlag Friedrich Oetinger 2003, S. 31"
      },
      "text" : "Dann schüttet sie Kaffee in die anderen beiden Tassen und füllt mit Milch auf."
   },
   {
      "@context" : "https://schema.org",
      "@type" : "Quotation",
      "isPartOf" : {
         "@type" : "Periodical",
         "name" : "Die Zeit, 05.06.2013 (online)"
      },
      "text" : "Das Unternehmen bat deswegen seine Kunden, die Tassen nicht mehr zu benutzen."
   },
   {
      "@context" : "https://schema.org",
      "@type" : "Quotation",
      "isPartOf" : {
         "@type" : "Periodical",
         "name" : "Die Zeit, 18.02.2013"
      },
      "text" : "Für den Abfall ist die Tasse voll kindlichem Blut, das sie enthält, eigentlich zu schade."
   },
   {
      "@context" : "https://schema.org",
      "@type" : "Quotation",
      "isPartOf" : {
         "@type" : "Periodical",
         "name" : "Olbrich, Harald (Hg.): Lexikon der Kunst. Berlin: Directmedia 2001 [1994]"
      },
      "text" : "Es gibt nur eine Tasse mit geraden Wänden im Louis-seize-Stil."
   },
   {
      "@context" : "https://schema.org",
      "@type" : "Quotation",
      "isPartOf" : {
         "@type" : "Periodical",
         "name" : "Olbrich, Harald (Hg.): Lexikon der Kunst. Berlin: Directmedia 2001 [1989]"
      },
      "text" : "Service und Tassen zeugen von hohem Geschmack, Masse und Glasur sind einwandfrei."
   }
]

  </script>
          

          

          
