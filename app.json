{
  "expo": {
    "name": "Phraseman",
    "owner": "badloar",
    "slug": "phraseman",
    "version": "1.6.14",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "phraseman",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": "1.6.14",
    "updates": {
      "enabled": true,
      "url": "https://u.expo.dev/87b454d9-0384-4213-8c26-fc12162e73d2",
      "checkAutomatically": "ON_ERROR_RECOVERY",
      "fallbackToCacheTimeout": 0,
      "assetPatternsToBeBundled": [
        "assets/audio/learning-v2/lesson1/*.m4a",
        "node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/Ionicons.ttf",
        "node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/MaterialIcons.ttf",
        "assets/fonts/*.ttf",
        "assets/images/achievement_categories/*",
        "assets/images/achievements/streak_3.webp",
        "assets/images/achievements/streak_7.webp",
        "assets/images/achievements/xp_100.webp",
        "assets/images/achievements/xp_250.webp",
        "assets/images/achievements/xp_500.webp",
        "assets/images/achievements/comeback.webp",
        "assets/images/achievements/shards_100.webp",
        "assets/images/avatars/*",
        "assets/images/energy/*",
        "assets/images/flashcard_backs/*",
        "assets/images/header_glyphs/*",
        "assets/images/home_menu/**/*",
        "assets/images/league/league_crown.webp",
        "assets/images/levels/league-v6-icons/*.webp",
        "assets/images/levels/generated-v5-dalle/*.webp",
        "assets/images/levels/*.webp",
        "assets/images/lesson_intro/*",
        "assets/images/settings/**/*",
        "assets/images/currency/*",
        "assets/images/splash-icon.png",
        "assets/images/streak_overlays/*.webp",
        "assets/images/theo/*",
        "assets/images/tournament/themes/**/*.webp"
      ]
    },
    "android": {
      "package": "app.phraseman",
      "googleServicesFile": "./google-services.json",
      "versionCode": 120,
      "allowBackup": true,
      "adaptiveIcon": {
        "backgroundColor": "#06141B",
        "foregroundImage": "./assets/images/icon.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "knowlyapps.com",
              "pathPrefix": "/phraseman/invite"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "blockedPermissions": [
        "com.google.android.gms.permission.AD_ID",
        "android.permission.ACCESS_ADSERVICES_AD_ID",
        "android.permission.ACCESS_ADSERVICES_ATTRIBUTION",
        "android.permission.ACCESS_ADSERVICES_TOPICS",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "ios": {
      "bundleIdentifier": "app.phraseman",
      "icon": "./assets/images/ios-icon.png",
      "buildNumber": "120",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:knowlyapps.com"
      ],
      "googleServicesFile": "./GoogleService-Info.plist",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.app.phraseman.widget"
        ],
        "com.apple.developer.devicecheck.appattest-environment": "production"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Phraseman не открывает вашу медиатеку. Разрешение запрашивается только если вы сами решите сохранить изображение с результатами обучения.",
        "NSMicrophoneUsageDescription": "Микрофон нужен, чтобы проверять ваше произношение английских фраз и вести голосовой диалог с ИИ-собеседником.",
        "NSSpeechRecognitionUsageDescription": "Распознавание речи проверяет, насколько верно вы произнесли английскую фразу, и позволяет отвечать голосом в диалогах.",
        "NSFaceIDUsageDescription": "Face ID защищает сохранённые данные вашего аккаунта на устройстве.",
        "NSCameraUsageDescription": "Phraseman не снимает фото и видео. Разрешение требуется библиотекой голосовых звонков, через которую работает разговор с ИИ-учителем: она использует только микрофон.",
        "NSMotionUsageDescription": "Phraseman не отслеживает ваши движения и шаги. Разрешение требуется библиотекой анимаций интерфейса, которая содержит модуль датчиков движения, но приложение его не включает."
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Inter",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Inter-Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Inter-SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/Inter-Bold.ttf",
                    "weight": 700
                  },
                  {
                    "path": "./assets/fonts/Inter-Black.ttf",
                    "weight": 900
                  }
                ]
              }
            ]
          },
          "ios": [
            "./assets/fonts/Inter-Regular.ttf",
            "./assets/fonts/Inter-SemiBold.ttf",
            "./assets/fonts/Inter-Bold.ttf",
            "./assets/fonts/Inter-Black.ttf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#101214",
          "dark": {
            "backgroundColor": "#101214"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-foreground.png",
          "color": "#06141B"
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/crashlytics",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "buildReactNativeFromSource": true,
            "forceStaticLinking": [
              "RNFBApp",
              "RNFBAnalytics",
              "RNFBAppCheck",
              "RNFBAuth",
              "RNFBCrashlytics",
              "RNFBFirestore",
              "RNFBFunctions"
            ]
          },
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "useLegacyPackaging": true,
            "minSdkVersion": 24,
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a"
            ],
            "lintOptions": {
              "abortOnError": false
            },
            "extraProguardRules": "-keep class expo.modules.kotlin.** { *; }\n-keep class expo.modules.imagepicker.** { *; }\n-keep class expo.modules.applepayauthentication.** { *; }\n-keep class expo.modules.applesignin.** { *; }\n-keep class com.google.android.gms.auth.api.signin.** { *; }\n-keep class com.google.android.gms.common.api.** { *; }\n-keep class com.google.firebase.auth.** { *; }\n-keep class com.googlesignin.** { *; }\n-dontwarn expo.modules.kotlin.**\n-dontwarn expo.modules.imagepicker.**"
          }
        }
      ],
      "expo-secure-store",
      "expo-apple-authentication",
      "@react-native-google-signin/google-signin",
      "./plugins/withAndroidBackupRules",
      "./plugins/withAndroidLargeScreenSupport",
      "./plugins/withAndroidDevCleartext",
      "./plugins/withAndroidDevServer127",
      "./plugins/withAndroidDevClientAutoMetro",
      "./plugins/withProductionAndroidBundleHygiene",
      "./plugins/withAsyncStorageCapacity",
      "./plugins/withAndroidSplashWindowBackground",
      "./plugins/withIosFirebaseEarlyConfigure",
      "./plugins/withAndroidDailyPhraseWidget",
      "@bacons/apple-targets",
      "./plugins/withIosDailyPhraseWidgetAppGroup",
      "./plugins/withIosFirebaseFunctionsSwift63Workaround",
      "./plugins/withIosFirebaseCrashlyticsUpload",
      "./plugins/with_async_storage_db_size.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "87b454d9-0384-4213-8c26-fc12162e73d2"
      }
    }
  }
}
