                'level_exam_final_best_pct',
                'level_exams_v2::fr::level_exam_final_best_pct',
                'level_exam_final_passed',
                'level_exams_v2::fr::level_exam_final_passed',
                'level_exam_final_pass_count',
                'level_exams_v2::fr::level_exam_final_pass_count',
                'level_exam_final_completed_at',
                'level_exams_v2::fr::level_exam_final_completed_at',
              ]);
    }

    function newUserDocOwnerMatchesAuth(userId) {
      return isAdmin()
        || isOwner(userId)
        || (
          request.auth != null
          && !exists(/databases/$(database)/documents/account_deletion_auth_markers/$(request.auth.uid))
          && request.resource.data.keys().hasAny(['firebaseAuthUid'])
          && request.resource.data.firebaseAuthUid is string
          && request.resource.data.firebaseAuthUid == request.auth.uid
        );
    }

    // Create-вариант premium-гарда. На create нет resource (старого документа), поэтому
    // diff невозможен — проверяем НАЛИЧИЕ запрещённых ключей в самом новом progress.
    // Закрывает дыру: раньше allow create не звал premium-гард, и кастомный клиент мог
    // при ПЕРВОМ создании users/{id} сразу вписать vip_until/premium_plan и выдать себе
    // доступ (легальный клиент эти поля в progress не пишет — cloud_sync.ts вырезает
    // PREMIUM_PROGRESS_KEYS из исходящего патча, см. строку ~1379).
    function newDocHasNoPremiumWrites() {
      return isAdmin()
        || !request.resource.data.get('progress', {})
              .keys().hasAny(blockedPremiumProgressKeys());
    }

    // â”€â”€ Referral: Ð·Ð°Ð¿Ð¸ÑÑŒ Ñ‚Ð¾Ð»ÑŒÐºÐ¾ CF; Ñ‡Ñ‚ÐµÐ½Ð¸Ðµ â€” Ð¿Ð°Ð½ÐµÐ»ÑŒ admin (custom claim admin) â”€
    match /referral_codes/{code} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /referral_owners/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // Чтение клиентом — только через callable referralListMyInvites (CF проверяет auth_links).
    // Прямой клиентский read закрыт; запись — только Admin SDK (referralApply/referralClaimVipReward).
    match /referral_attributions/{id} {
      allow read: if isAdmin();
      allow update: if isAdmin();
      allow create, delete: if false;
    }

    // â”€â”€ User data â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    // ÐšÐ¾Ñ€Ð½ÐµÐ²Ð¾Ð¹ users/{userId}: Ñ‚Ð¾Ð»ÑŒÐºÐ¾ Ð²Ð»Ð°Ð´ÐµÐ»ÐµÑ†/Ð°Ð´Ð¼Ð¸Ð½. ÐŸÐ¾Ð´Ð´ÐµÑ€Ð¶Ð¸Ð²Ð°ÐµÐ¼ Ð¾Ð±Ðµ ÑÑ…ÐµÐ¼Ñ‹:
    //  - userId == request.auth.uid
    //  - stableId-Ð´Ð¾ÐºÑƒÐ¼ÐµÐ½Ñ‚ Ñ Ð¿Ð¾Ð»ÐµÐ¼ firebaseAuthUid == request.auth.uid
    // ÐœÐ¾Ð´ÐµÑ€Ð°Ñ†Ð¸Ñ/Ð±Ð°Ð½/Ñ€ÐµÐ¿Ð¾Ñ€Ñ‚Ñ‹: Ñ‚Ð¾Ð»ÑŒÐºÐ¾ isAdmin() (ÑÐ¼. admin/index.html, email+claim).
    match /account_deletion_tombstones/{userId} {
      allow read, write: if false;
    }

    match /account_deletion_auth_markers/{authUid} {
      allow read: if request.auth != null && request.auth.uid == authUid;
      allow write: if false;
    }

    // Recovery secrets, rate-limit state, and audit events are server-only.
    // Cloud Functions use the Admin SDK, which bypasses Firestore Rules.
    match /auth_recovery_codes/{document=**} {
      allow read, write: if false;
    }

    match /auth_recovery_rate_limits/{document=**} {
      allow read, write: if false;
    }

    match /auth_recovery_events/{document=**} {
      allow read, write: if false;
    }

    match /auth_recovery_challenges/{document=**} {
      allow read, write: if false;
    }

    match /auth_recovery_delivery_intents/{document=**} {
      allow read, write: if false;
    }

    match /auth_recovery_idempotency/{document=**} {
      allow read, write: if false;
    }

    match /auth_recovery_clean_rate_limits/{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      // read: владелец/админ ИЛИ документа ещё нет (пустое чтение безопасно и
      // не валит клиентскую транзакцию входа на новом localStableId — см.
      // userDocMissing выше). delete остаётся строго для владельца/админа.
      allow read: if userDocOwnerMatchesAuth(userId) || userDocMissing(userId);
      allow delete: if userDocOwnerMatchesAuth(userId) && userDocHasNoServerIdentity();
      // Клиент может обновлять свой документ, но personal shard projection закрыт
      // даже для browser-admin; audited callables append external facts instead.
      allow update: if userDocOwnerMatchesAuth(userId)
        && (isAdmin() || authLinkMapsToUser(userId))
        && accountDeletionNotPending(userId)
        && hasNoServerIdentityWrites()
        && progressHasNoPremiumWrites()
        && hasNoShardWrites()
        && hasNoServerGiftPerkWrites()
        && hasNoProgressAuthorityMarkerWrites()
        && hasNoLevelRewardSpinWrites();
      // authEnsureStableLink bootstraps users/{stableId} and auth_links atomically
      // with Admin SDK. A client must never recreate a missing/orphaned identity.
      allow create: if false;

      match /community_seller_inbox/{eventId} {
        allow read, write: if false;
      }

      // Durable roulette credits and the server-owned migration marker are
      // written only by Cloud Functions through Admin SDK. Clients consume the
      // callable projection instead of reading or mutating ledger documents.
      match /referral_spin_credit_ledger/{creditId} {
        allow read: if false;
        allow create, update, delete: if false;
      }

      match /level_spin_credits/{creditId} {
        allow read, write: if false;
      }

      match /level_spin_results/{requestId} {
        allow read, write: if false;
      }

      // Инбокс решений по идеям. Создаёт только сервер (adminDecideUserIdea, Admin SDK).
      // Владелец читает свои решения (приложение показывает модалку на старте) и может
      // пометить seen — но не создавать/удалять и не подменять текст/решение.
      match /idea_inbox/{eventId} {
        allow read: if userDocOwnerMatchesAuth(userId);
        allow update: if userDocOwnerMatchesAuth(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen', 'seenAt']);
        allow create, delete: if false;
      }

      match /shard_log/{logId} {
        allow read, create: if userDocOwnerMatchesAuth(userId);
        allow update, delete: if false;
      }

      // Small server-owned live entitlement projection. Clients may observe
      // their current access without subscribing to the giant users/{uid} doc.
      match /access_projection/current {
        allow read: if userDocOwnerMatchesAuth(userId);
        allow create, update, delete: if false;
      }

      // Phone-authoritative personal state: clients append immutable, bounded
      // transport documents. The server persists them but never recalculates or
      // rejects an ordinary local result based on a server-side projection.
      match /personal_sync_segments/{segmentId} {
        allow read: if userDocOwnerMatchesAuth(userId);
        allow create: if userDocOwnerMatchesAuth(userId)
          && authLinkMapsToUser(userId)
          && accountDeletionNotPending(userId)
          && request.resource.data.keys().hasAll([
            'schemaVersion', 'stableUid', 'accountGeneration', 'deviceId',
            'firstSequence', 'lastSequence', 'operationCount', 'byteSize',
            'createdAtMs', 'payloadCanonical', 'fingerprint'
          ])
          && request.resource.data.keys().hasOnly([
            'schemaVersion', 'stableUid', 'accountGeneration', 'deviceId',
            'firstSequence', 'lastSequence', 'operationCount', 'byteSize',
            'createdAtMs', 'payloadCanonical', 'fingerprint'
          ])
          && request.resource.data.schemaVersion == 'personal-sync-segment.v1'
          && request.resource.data.stableUid == userId
          && request.resource.data.accountGeneration is int
          && request.resource.data.accountGeneration >= 0
          && request.resource.data.deviceId is string
          && request.resource.data.deviceId.matches('^[A-Za-z0-9_-]{16,80}$')
          && segmentId.matches('^[A-Za-z0-9_-]{16,80}_[0-9]{16,}$')
          && request.resource.data.firstSequence is int
          && request.resource.data.firstSequence > 0
          && request.resource.data.lastSequence is int
          && request.resource.data.lastSequence >= request.resource.data.firstSequence
          && request.resource.data.operationCount is int
          && request.resource.data.operationCount > 0
          && request.resource.data.operationCount <= 50
          && request.resource.data.lastSequence - request.resource.data.firstSequence + 1
            == request.resource.data.operationCount
          && request.resource.data.byteSize is int
          && request.resource.data.byteSize > 0
          && request.resource.data.byteSize <= 65536
          && request.resource.data.createdAtMs is int
          && request.resource.data.createdAtMs >= 0
          && request.resource.data.payloadCanonical is string
          && request.resource.data.payloadCanonical.size() <= 65536
          && request.resource.data.fingerprint is string
          && request.resource.data.fingerprint.matches('^[a-f0-9]{64}$');
        allow update: if userDocOwnerMatchesAuth(userId)
          && request.resource.data == resource.data;
        allow delete: if false;
      }

      match /personal_sync_checkpoints/{checkpointId} {
        allow read: if userDocOwnerMatchesAuth(userId);
        allow create: if userDocOwnerMatchesAuth(userId)
          && authLinkMapsToUser(userId)
          && accountDeletionNotPending(userId)
          && request.resource.data.keys().hasAll([
            'schemaVersion', 'stableUid', 'accountGeneration', 'checkpointId',
            'reducerVersions', 'vector', 'projectionsCanonical', 'byteSize',
            'createdAtMs', 'fingerprint'
          ])
          && request.resource.data.keys().hasOnly([
            'schemaVersion', 'stableUid', 'accountGeneration', 'checkpointId',
            'reducerVersions', 'vector', 'projectionsCanonical', 'byteSize',
            'createdAtMs', 'fingerprint'
          ])
          && request.resource.data.schemaVersion == 'personal-sync-checkpoint.v1'
          && request.resource.data.stableUid == userId
          && request.resource.data.accountGeneration is int
          && request.resource.data.accountGeneration >= 0
          && request.resource.data.checkpointId == checkpointId
          && checkpointId.matches('^[A-Za-z0-9_-]{8,160}$')
          && request.resource.data.reducerVersions is map
          && request.resource.data.vector is map
          && request.resource.data.projectionsCanonical is string
          && request.resource.data.projectionsCanonical.size() <= 524288
          && request.resource.data.byteSize is int
          && request.resource.data.byteSize > 0
          && request.resource.data.byteSize <= 524288
          && request.resource.data.createdAtMs is int
          && request.resource.data.createdAtMs >= 0
          && request.resource.data.fingerprint is string
          && request.resource.data.fingerprint.matches('^[a-f0-9]{64}$');
        allow update: if userDocOwnerMatchesAuth(userId)
          && request.resource.data == resource.data;
        allow delete: if false;
      }

      // Discovery only. No mutable cursor/head is allowed in this manifest.
      match /sync_devices/{deviceId} {
        allow read: if userDocOwnerMatchesAuth(userId);
        allow create: if userDocOwnerMatchesAuth(userId)
          && authLinkMapsToUser(userId)
          && accountDeletionNotPending(userId)
          && request.resource.data.keys().hasAll([
            'schemaVersion', 'stableUid', 'accountGeneration', 'deviceId',
            'createdAtMs', 'fingerprint'
          ])
          && request.resource.data.keys().hasOnly([
            'schemaVersion', 'stableUid', 'accountGeneration', 'deviceId',
            'createdAtMs', 'fingerprint'
          ])
          && request.resource.data.schemaVersion == 'personal-sync-device.v1'
          && request.resource.data.stableUid == userId
          && request.resource.data.accountGeneration is int
          && request.resource.data.accountGeneration >= 0
          && request.resource.data.deviceId == deviceId
          && deviceId.matches('^[A-Za-z0-9_-]{16,80}$')
          && request.resource.data.createdAtMs is int
          && request.resource.data.createdAtMs >= 0
          && request.resource.data.fingerprint is string
          && request.resource.data.fingerprint.matches('^[a-f0-9]{64}$');
        allow update: if userDocOwnerMatchesAuth(userId)
          && request.resource.data == resource.data;
        allow delete: if false;
      }

      match /personal_external_events/{eventId} {
        allow read: if userDocOwnerMatchesAuth(userId);
        allow create, update, delete: if false;
      }

      match /personal_sync_server_state/{documentId} {
        allow read, write: if false;
      }

      // Personal economy is client-authoritative. The client publishes one
      // immutable composite operation only after its exact local result is
      // durable. Firestore stores the journal; it never approves a spend and
      // never writes a balance back to the device.
      match /client_economy_operations/{operationId} {
        allow read: if userDocOwnerMatchesAuth(userId);
        allow create: if personalEconomyOwnerMatchesAuth(userId)
          && personalEconomyAccountActive(userId)
          && request.resource.data.keys().hasAll([
            'schemaVersion', 'operationId', 'ownerStableId', 'authority', 'direction',
            'amount', 'delta', 'revision', 'balanceBefore', 'balanceAfter',
            'reason', 'grant', 'createdAtMs', 'requestFingerprint'
          ])
          && request.resource.data.keys().hasOnly([
            'schemaVersion', 'operationId', 'ownerStableId', 'authority', 'direction',
            'amount', 'delta', 'revision', 'balanceBefore', 'balanceAfter',
            'reason', 'grant', 'createdAtMs', 'requestFingerprint'
          ])
          && request.resource.data.schemaVersion == 'client-shard-operation.v1'
          && request.resource.data.operationId == operationId
          && request.resource.data.ownerStableId == userId
          && request.resource.data.authority == 'client'
          && operationId.matches('^[A-Za-z0-9_:-]{8,80}$')
          && request.resource.data.direction in ['debit', 'credit']
          && request.resource.data.amount is int
          && request.resource.data.amount > 0
          && request.resource.data.delta is int
          && (
            (request.resource.data.direction == 'debit'
              && request.resource.data.delta == -request.resource.data.amount)
            || (request.resource.data.direction == 'credit'
              && request.resource.data.delta == request.resource.data.amount)
          )
          && request.resource.data.revision is int
          && request.resource.data.revision > 0
          && request.resource.data.balanceBefore is int
          && request.resource.data.balanceAfter is int
          && request.resource.data.balanceAfter
            == request.resource.data.balanceBefore + request.resource.data.delta
          && request.resource.data.reason is string
          && request.resource.data.reason.size() > 0
          && request.resource.data.reason.size() <= 64
          && request.resource.data.grant is map
          && request.resource.data.grant.keys().hasAll(['kind', 'subjectId'])
          && request.resource.data.grant.keys().hasOnly(['kind', 'subjectId', 'payload'])
          && request.resource.data.grant.kind is string
          && request.resource.data.grant.kind.size() > 0
          && request.resource.data.grant.kind.size() <= 160
          && request.resource.data.grant.subjectId is string
          && request.resource.data.grant.subjectId.size() > 0
          && request.resource.data.grant.subjectId.size() <= 160
          && request.resource.data.createdAtMs is int
          && request.resource.data.createdAtMs > 0
          && request.resource.data.requestFingerprint is string
          && request.resource.data.requestFingerprint.matches('^[a-f0-9]{64}$');
        // An exact retry is idempotent. Any changed byte is rejected forever.
        allow update: if personalEconomyOwnerMatchesAuth(userId)
          && request.resource.data == resource.data;
        allow delete: if false;
      }

      // One immutable legacy snapshot anchors the union of device journals.
      match /client_economy_opening/{version} {
        allow read: if userDocOwnerMatchesAuth(userId);
        allow create: if version == 'v1'
          && personalEconomyOwnerMatchesAuth(userId)
          && personalEconomyAccountActive(userId)
          && request.resource.data.keys().hasAll([
            'schemaVersion', 'ownerStableId', 'openingBalance', 'createdAtMs'
          ])
          && request.resource.data.keys().hasOnly([
            'schemaVersion', 'ownerStableId', 'openingBalance', 'createdAtMs'
          ])
          && request.resource.data.schemaVersion == 'client-economy-opening.v1'
          && request.resource.data.ownerStableId == userId
          && request.resource.data.openingBalance is int
          && request.resource.data.openingBalance >= 0
          && request.resource.data.createdAtMs is int
          && request.resource.data.createdAtMs > 0;
        allow update: if personalEconomyOwnerMatchesAuth(userId)
          && request.resource.data == resource.data;
        allow delete: if false;
      }

      // Payments/refunds, person-to-person transfers, admin awards and
      // competitions are isolated external facts. Only trusted backend code
      // may append them; clients can inspect but can never forge or mutate.
      match /external_economy_events/{eventId} {
        allow read: if userDocOwnerMatchesAuth(userId);
        allow create, update, delete: if false;
      }

      match /reward_claims/{claimId} {
        allow read: if userDocOwnerMatchesAuth(userId);
        allow create: if false;
        allow update, delete: if false;
      }

      match /gift_perk_consumptions/{receiptId} {
        allow read: if userDocOwnerMatchesAuth(userId);
        allow create, update, delete: if false;
      }

      match /tournament_receipts/{receiptId} {
        allow read: if userDocOwnerMatchesAuth(userId);
        allow write: if false;
      }

      // Arena V2 economy is a separate server-authoritative ledger. Clients
      // may inspect their projections, but can never mint stars, rating, spin
      // credits/results, receipts, or season claims directly.
      match /arena_v2_seasons/{seasonId} {
        allow read: if userDocOwnerMatchesAuth(userId);
        allow write: if false;
      }
      match /arena_v2_receipts/{matchId} {
        // xpBreakdown is private owner-visible settlement evidence. It is
        // authored only by the Arena transaction and never exposed publicly.
        allow read: if userDocOwnerMatchesAuth(userId);
        allow write: if false;
      }
      match /arena_v2_spin_credits/{creditId} {
        allow read: if userDocOwnerMatchesAuth(userId);
        allow write: if false;
      }
      match /arena_v2_spin_results/{requestId} {
        allow read: if userDocOwnerMatchesAuth(userId);
        allow write: if false;
      }
      match /arena_v2_season_claims/{claimId} {
        allow read: if userDocOwnerMatchesAuth(userId);
        allow write: if false;
      }
      // Sealed attempts/evidence stay callable-only. Only compact sanitized
      // review and economy projections are readable by their owner.
      match /arena_v2_daily_attempts/{attemptId} {
        allow read, write: if false;
      }
      match /arena_v2_expansion_runs/{runId} {
        allow read, write: if false;
      }
      match /arena_v2_mastery_signatures/{signatureId} {
        allow read, write: if false;
      }
      match /arena_v2_activity_days/{dayKey} {
        allow read, write: if false;
      }
      match /arena_v2_match_labs/{matchId} {
        allow read: if userDocOwnerMatchesAuth(userId);
        allow write: if false;
      }
      match /arena_v2_partner_weeks/{weekKey} {
        allow read: if userDocOwnerMatchesAuth(userId);
        allow write: if false;
      }
      match /arena_v2_star_ledger/{receiptId} {
        allow read: if userDocOwnerMatchesAuth(userId);
        allow write: if false;
      }
      // Расписки единого журнала звёзд. Владелец видит свою историю начислений
      // и трат — это и есть объяснение «почему 7, а не 14». Пишет только сервер
      // (functions/src/stars_ledger.ts) внутри той же транзакции, что и баланс.
      match /star_operations/{opId} {
        allow read: if userDocOwnerMatchesAuth(userId);
        allow write: if false;
      }
      match /arena_v2_entitlements/{itemId} {
        allow read: if userDocOwnerMatchesAuth(userId);
        allow write: if false;
      }
      match /arena_v2_expansion_receipts/{requestId} {
        allow read, write: if false;
      }

      // Idempotency receipts for shardsApplyDelta are written only by Admin SDK.
      // Clients must not pre-create a receipt to bypass a spend operation.
      match /shard_operation_receipts/{opId} {
        allow read, write: if false;
      }

      // UTC-day anti-farm budgets for shardsApplyDelta. Admin SDK only.
      match /shard_earn_daily_counters/{dayKey} {
        allow read, write: if false;
      }

      // Append-only журнал V2 access-звёзд (биржа монет→звёзд). Только Admin SDK.
      match /v2_star_journal/{entryId} {
        allow read, write: if false;
      }

      // Source receipts for Learning V2 wallet redemption. Server callables
      // write them atomically with the originating economic decision (coin
      // exchange or bounded required-session performance improvement); clients
      // receive only the request identity and cannot read or forge protected bytes.
      match /v2_wallet_reward_receipts/{rewardId} {
        allow read, write: if false;
      }

      // Protected authorization for one exact Learning V2 course-session
      // unlock. The app receives only the bounded request reference and must
      // resolve canonical bytes through the authenticated callable.
      match /v2_course_unlock_receipts/{unlockId} {
        allow read, write: if false;
      }

      // Маркеры активации промокодов. Пишет ТОЛЬКО сервер (promoCodeRedeem, Admin SDK).
      // Владелец может прочитать (приложение видит, что код уже активирован), но не
      // создавать/менять — иначе обход «один код на юзера» и самовыдача премиума.
      match /promo_redemptions/{code} {
        allow read: if userDocOwnerMatchesAuth(userId);
        allow create, update, delete: if false;
      }

      match /app_message_states/{messageId} {
        allow read, create, update, delete: if userDocOwnerMatchesAuth(userId);
      }

      // Персональные сообщения (ответы на репорты с наградой к клейму). Пишет ТОЛЬКО
      // сервер: adminReplyToReport создаёт, claimReportReward переключает claimed —
      // открытая клиентская запись позволила бы накрутить shards повторным клеймом.
      match /user_messages/{messageId} {
        allow read: if userDocOwnerMatchesAuth(userId);
        allow create, update, delete: if false;
      }

      match /shard_rewards/{rewardId} {
        allow read:   if userDocOwnerMatchesAuth(userId);
        allow update: if userDocOwnerMatchesAuth(userId)
          && request.resource.data.seen == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen', 'seenAt']);
        // Награды (включая QA) пишет только сервер через Admin SDK в обход rules.
        // Клиент может только отметить существующую награду как просмотренную.
        allow create: if false;
        allow delete: if false;
      }

      match /league_week_results/{weekId} {
        // Пишет только leagueFinalizeCron (Admin SDK, в обход rules).
        // Клиент читает чтобы показать честный итог недели вместо локального пересчёта.
        allow read:   if userDocOwnerMatchesAuth(userId);
        allow write:  if false;
      }
    }

    // â”€â”€ Arena profiles â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /arena_profiles/{userId} {
      allow read, write: if false;

      match /match_history/{matchId} {
        allow read, write: if false;
      }
    }

    // â”€â”€ Leaderboard â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /leaderboard/{userId} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin();
      allow delete: if userDocOwnerMatchesAuth(userId);
    }

    // Top Helpers board projection. Written ONLY by Cloud Function adminReplyToReport
    // and scripts/reply_to_reports.mjs (Admin SDK) when a report is confirmed; clients
    // read the top-10 (same read policy as leaderboard). No client writes (anti-cheat).
    match /top_helpers/{userId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /public_profiles/{userId} {
      allow read: if request.auth != null;
      // Server-authoritative projection only. Clients may choose cosmetics via
      // publicProfileProjectMine, but cannot claim progress or entitlements.
      allow update: if false;
      allow create, delete: if false;
    }

    // Public aggregate percentile thresholds written by Cloud Functions.
    match /leaderboard_stats/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Friend activity likes: server-owned writes, client-readable counters.
    match /users/{userId}/friend_activity_like_daily_limits/{dayId} {
      allow read: if canonicalUserMatchesAuth(userId);
      allow create, update, delete: if isAdmin();
    }

    // Persistent per-target/per-event likes. Cloud Functions own counters and
    // writes; the sender may read their records to restore filled hearts.
    match /users/{userId}/friend_activity_likes_sent/{likeId} {
      allow read: if canonicalUserMatchesAuth(userId);
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId}/activity_like_stats/{docId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId}/activity_likes_received/{likeId} {
      allow read: if canonicalUserMatchesAuth(userId);
      allow create, update, delete: if isAdmin();
    }

    // Единый центр событий (колокольчик на главной): пишут только cloud functions.
    // Владелец читает, помечает прочитанным (только read/readAt/updatedAt) и удаляет.
    match /users/{userId}/notifications/{notificationId} {
      allow read: if canonicalUserMatchesAuth(userId);
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        canonicalUserMatchesAuth(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt', 'updatedAt'])
      );
      allow delete: if isAdmin() || canonicalUserMatchesAuth(userId);
    }

    // â”€â”€ Banned users â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    // Legacy/bundled flashcard marketplace metadata. Clients query only
    // published packs; writes stay server/admin-only.
    match /card_packs/{packId} {
      allow read: if isAdmin() || resource.data.status == 'published';
      allow create, update, delete: if isAdmin();
    }

    match /banned_users/{docId} {
      allow read:  if isAdmin() || (request.auth != null && request.auth.uid == docId);
      allow write: if isAdmin();
    }

    // â”€â”€ Admin config (alerts settings, admin-only) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    // admin_config/alerts holds Telegram alert settings (chatId, enabled, types).
    // Read/write only by admin from the panel. The alert Cloud Functions use the
    // Admin SDK (bypasses rules) to read config and write bookkeeping fields.
    match /admin_config/{docId} {
      allow read: if isAdmin();
      // support_inbox contains the live auto-reply kill switch and quotas;
      // writes must go through the revisioned/audited callable.
      allow write: if isAdmin() && docId != 'support_inbox';
    }

    // Remote Config changelog — admin-only audit trail of config saves.
    match /remote_config_history/{docId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // Product charter history — immutable version log of the Phraseman charter
    // (owner, 2026-08-16). Writes go through adminSaveProductCharter with the
    // Admin SDK; update/delete stay closed so a saved version can always be
    // restored. Deny is explicit: it documents that immutability is intended.
    match /product_charter_history/{docId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // â”€â”€ User warnings â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /user_warnings/{docId} {
      allow read:   if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // â”€â”€ User reports (Ð¶Ð°Ð»Ð¾Ð±Ñ‹ Ð½Ð° Ð´Ñ€ÑƒÐ³Ð¸Ñ… Ð¿Ð¾Ð»ÑŒÐ·Ð¾Ð²Ð°Ñ‚ÐµÐ»ÐµÐ¹) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /user_reports/{docId} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    // ── AI safety flags (self-harm/suicide/abuse detected in AI dialogue) ──
    // Пишет ТОЛЬКО сервер; админ читает/обрабатывает только через permission-gated callables.
    match /safety_flags/{docId} {
      allow read, write: if false;
    }

    // MAX durable review receipts contain only a bounded learning projection.
    // They are server-owned: clients receive them through the authenticated,
    // ownership-checked maxVoiceFinalize callable and cannot enumerate them.
    match /voice_call_reviews/{docId} {
      allow read, write: if false;
    }

    // MAX learning memory is personal and callable-only. The server resolves
    // identity and sanitizes every field; direct browser access would bypass
    // both controls, including for browser admins.
    match /voice_tutor_memory/{docId} {
      allow read, write: if false;
    }

    // MAX quota documents contain account ownership plus the nested opaque
    // safetyGuard. Both are Admin-SDK-only, including for browser admins.
    match /voice_call_quotas/{docId} {
      allow read, write: if false;
    }

    // Content-free operational aggregates, including bounded pre-reservation
    // rejection buckets, are read only by bounded server callables and Jarvis.
    // Direct reads still reveal internal reliability and cost data, so the
    // browser never receives collection access.
    match /max_voice_ops_daily/{docId} {
      allow read, write: if false;
    }

    // ── Возраст + согласия (для accountability/учёта в админке) ──
    // Документ ключуется stableId; владелец может читать свой, читать агрегаты —
    // только admin. Запись — ТОЛЬКО через Cloud Functions (Admin SDK, которые
    // правила не ограничивают): record_age_consent_snapshot.ts,
    // record_ai_consent_factory.ts (aiExplainConsent/aiDialogConsent). Клиент
    // никогда не пишет сюда напрямую — этот документ служит датой/фактом
    // согласия пользователя (accountability), поэтому его нельзя переписать
    // прямым вызовом Firestore SDK в обход валидации на сервере.
    match /user_consents/{userId} {
      allow read: if isAdmin() || isOwner(userId) || stableUserMatchesAuth(userId);
      allow write: if false;
    }

    // â”€â”€ Community pack reports (UGC content moderation, Apple Guideline 1.2) â”€â”€
    // Ð›ÑŽÐ±Ð¾Ð¹ Ð°Ð²Ñ‚Ð¾Ñ€Ð¸Ð·Ð¾Ð²Ð°Ð½Ð½Ñ‹Ð¹ ÑŽÐ·ÐµÑ€ Ð¼Ð¾Ð¶ÐµÑ‚ Ð¿Ð¾Ð¶Ð°Ð»Ð¾Ð²Ð°Ñ‚ÑŒÑÑ Ð½Ð° community-Ð¿Ð°Ðº;
    // Ñ‡Ð¸Ñ‚Ð°Ñ‚ÑŒ/Ð¼Ð¾Ð´ÐµÑ€Ð¸Ñ€Ð¾Ð²Ð°Ñ‚ÑŒ â€” Ñ‚Ð¾Ð»ÑŒÐºÐ¾ admin (Ñ‡ÐµÑ€ÐµÐ· admin/index.html â†’ custom claim).
    match /community_pack_reports/{docId} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    // â”€â”€ Error reports (Ð±Ð°Ð³-Ñ€ÐµÐ¿Ð¾Ñ€Ñ‚Ñ‹) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /error_reports/{docId} {
      allow create: if isAdmin();
      allow read, update, delete: if isAdmin();
    }

    match /app_errors/{docId} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    match /app_activity/{docId} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    match /subscription_cancel_surveys/{docId} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    match /website_contact_inbox/{docId} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    match /website_contact_rate_limits/{docId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /site_stats/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /site_stats_rate_limits/{docId} {
      allow read, delete: if isAdmin();
      allow create, update: if false;
    }

    // Website checkout admin surface (admin/site.html). The public /start/
    // paywall reads prices through the webPrices Cloud Function; browser writes
    // are admin-only.
    match /web_checkout/{docId} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }

    match /web_premium_orders/{orderId} {
      allow read, update: if isAdmin();
      allow create, delete: if false;
    }

    match /email_contacts/{docId} {
      allow read, update, delete: if isAdmin();
      allow create: if false;
    }

    match /email_campaigns/{docId} {
      allow read, update, delete: if isAdmin();
      allow create: if false;
    }

    match /client_report_rate_limits/{docId} {
      allow read, create, update, delete: if isAdmin();
    }

    // User ideas: created only via submitUserIdea (Admin SDK), moderated by admin.
    match /user_ideas/{docId} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    // Отзывы о звонке MAX: пишутся только через submitMaxVoiceFeedback (Admin
    // SDK), читаются только админом через adminListMaxVoiceFeedback.
    match /max_voice_feedback/{docId} {
      allow read, write: if false;
    }

    // Обобщённые отзывы (урок/словарь/диалог/арена): пишутся только через
    // submitFeedbackEntry (Admin SDK), читаются только админом через
    // adminListFeedbackEntries.
    match /feedback_entries/{docId} {
      allow read, write: if false;
    }

    // AI-сводки отзывов по разделу (feedback_summary.ts): пишутся только
    // сервером (adminSummarizeFeedback), читаются только админом.
    match /feedback_summary_cache/{docId} {
      allow read, write: if false;
    }

    // Atomic per-user/day feedback quota. Only the submit callable may read or
    // mutate counters; browser-admin credentials must use audited callables.
    match /feedback_submission_quotas/{docId} {
      allow read, write: if false;
    }

    match /user_idea_rate_limits/{docId} {
      allow read, create, update, delete: if isAdmin();
    }

    // â”€â”€ Ð“Ð»Ð¾Ð±Ð°Ð»ÑŒÐ½Ñ‹Ðµ Ð¾Ð´Ð½Ð¾Ñ€Ð°Ð·Ð¾Ð²Ñ‹Ðµ Ð¼Ð¾Ð´Ð°Ð»ÐºÐ¸ (Ð°Ð´Ð¼Ð¸Ð½-Ñ€Ð°ÑÑÑ‹Ð»ÐºÐ° Ð´Ð»Ñ Ð²ÑÐµÑ… Ð¿Ð¾Ð»ÑŒÐ·Ð¾Ð²Ð°Ñ‚ÐµÐ»ÐµÐ¹) â”€â”€
    match /global_broadcast_modals/{docId} {
      allow read, create, update, delete: if false;
    }

    function appMessagePollVoteOk(messageId, userId) {
      let message = get(/databases/$(database)/documents/app_messages/$(messageId)).data;
      return userDocOwnerMatchesAuth(userId)
        && message.active == true
        && (!message.keys().hasAny(['expiresAtMs']) || message.expiresAtMs > request.time.toMillis())
        && message.keys().hasAny(['poll'])
        && message.poll is map
        && message.poll.keys().hasAny(['optionIds'])
        && message.poll.optionIds is list
        && request.resource.data.keys().hasOnly(['messageId', 'userId', 'optionId', 'updatedAtMs'])
        && request.resource.data.messageId == messageId
        && request.resource.data.userId == userId
        && request.resource.data.optionId is string
        && request.resource.data.optionId in message.poll.optionIds
        && (request.resource.data.updatedAtMs is int || request.resource.data.updatedAtMs is float)
        && request.resource.data.updatedAtMs > 0
        && request.resource.data.updatedAtMs < 10000000000000;
    }

    // Remote Config: admin-tuned runtime flags (limits, energy, A/B split).
    // Read by any signed-in client (remote_config_client.ts); written only from
    // the admin panel (custom claim admin). Docs: `app`, `paywall_ab`.
    match /remote_config/{docId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // Server-published YouTube catalog. Clients follow one public pointer and
    // can never inspect a building/old version or mutate server-owned state.
    match /youtube_catalog/{docId} {
      allow read: if (docId == 'public' && request.auth != null)
        || (docId in ['config', 'sync_state'] && isAdmin());
      allow create, update, delete: if false;
    }

    match /youtube_catalog_snapshots/{version} {
      allow read: if isActiveYoutubeSnapshot(version)
        && resource.data.status == 'ready';
      allow create, update, delete: if false;

      match /{document=**} {
        allow read: if isReadyYoutubeSnapshot(version);
        allow create, update, delete: if false;
      }
    }

    match /youtube_catalog_history/{document=**} {
      allow read, write: if false;
    }

    // Воронка пейвол-эксперимента (app/paywall_funnel.ts → admin/paywall_ab.html).
    // Клиент только создаёт компактные события фиксированной формы; читает админ.
    match /paywall_funnel/{docId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['step', 'variant', 'context', 'plan', 'obColor', 'price', 'day', 'ts', 'uidh', 'dev', 'expireAt'])
        && request.resource.data.step in ['shown', 'cta_click', 'trial_started', 'purchase_completed', 'purchase_failed', 'purchase_cancelled', 'restore_completed', 'close']
        && request.resource.data.variant in ['v1', 'v2', 'A', 'B', 'C', 'D', 'E', 'F', 'G']
        && request.resource.data.context is string
        && request.resource.data.context.size() <= 40
        && (request.resource.data.plan == null || request.resource.data.plan in ['monthly', 'yearly', 'lifetime'])
        && (request.resource.data.obColor == null || request.resource.data.obColor in ['blue', 'green', 'main'])
        && (request.resource.data.price == null || (request.resource.data.price is string && request.resource.data.price.size() <= 24))
        && request.resource.data.day is string
        && request.resource.data.day.size() == 10
        && (request.resource.data.ts is int || request.resource.data.ts is float)
        && request.resource.data.uidh is string
        && request.resource.data.uidh.size() <= 16
        && request.resource.data.dev is bool;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /app_messages/{messageId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();

      match /reactions/{userId} {
        allow read: if isAdmin();
        allow create, update: if userDocOwnerMatchesAuth(userId)
          && request.resource.data.keys().hasOnly(['messageId', 'userId', 'reaction', 'updatedAtMs'])
          && request.resource.data.messageId == messageId
          && request.resource.data.userId == userId
          && request.resource.data.reaction in ['like', 'dislike'];
        allow delete: if isAdmin() || userDocOwnerMatchesAuth(userId);
      }

      match /poll_votes/{userId} {
        allow read: if isAdmin();
        allow create, update: if appMessagePollVoteOk(messageId, userId);
        allow delete: if isAdmin() || userDocOwnerMatchesAuth(userId);
      }

      match /fixed_poll_votes/{userId} {
        allow read: if isAdmin();
        allow create, update, delete: if false;
      }
    }

    match /review_promo_claims/{docId} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    match /vip_survey_responses/{userId} {
      allow read: if isAdmin() || userDocOwnerMatchesAuth(userId);
      allow create, update, delete: if isAdmin();
    }

    // Опросы за осколки (shard-survey). Все записи идут через callable (Admin SDK
    // обходит rules); прямой клиентский доступ запрещён. Админка читает конфиги/
    // ответы/агрегаты напрямую под isAdmin(). Rate-limits — только сервер.
    match /shard_surveys/{surveyId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /shard_survey_responses/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /shard_survey_stats/{surveyId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /shard_survey_rate_limits/{uid} {
      allow read, write: if false;
    }

    match /daily_phrases/{phraseId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    match /daily_phrase_save_counts/{phraseId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    match /daily_phrase_saves/{saveId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // â”€â”€ Arena sessions â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /arena_sessions/{sessionId} {
      allow read, write: if false;
    }

    // â”€â”€ Session players â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /session_players/{docId} {
      allow read, write: if false;
    }

    // â”€â”€ Arena rooms (friend invite flow) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /arena_rooms/{roomId} {
      allow read, write: if false;
    }

    // â”€â”€ Arena invites (legacy friend-invite docs) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    // Ð Ð°Ð·Ñ€ÐµÑˆÐ°ÐµÐ¼ Ñ‚Ð¾Ð»ÑŒÐºÐ¾ ÑÐ¼ÐµÐ½Ñƒ ÑÑ‚Ð°Ñ‚ÑƒÑÐ° Ð¸ Ñ‚Ð¾Ð»ÑŒÐºÐ¾ ÑƒÑ‡Ð°ÑÑ‚Ð½Ð¸ÐºÐ°Ð¼ Ð¸Ð½Ð²Ð°Ð¹Ñ‚Ð°.
    match /arena_invites/{inviteId} {
      allow read, write: if false;
    }

    // â”€â”€ Arena computed per-user match results â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /arena_session_results/{resultId} {
      allow read, write: if false;
    }

    // â”€â”€ Matchmaking queue â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    // Ð¢Ð¾Ð»ÑŒÐºÐ¾ Ð¿Ð¾Ð»Ñ Ð¾Ñ‡ÐµÑ€ÐµÐ´Ð¸: Ð±ÐµÐ· sessionId/matchedAt (Ð¸Ñ… Ð¿Ð¸ÑˆÐµÑ‚ Ñ‚Ð¾Ð»ÑŒÐºÐ¾ CF).
    // Ð”Ð¾ÐºÑƒÐ¼ÐµÐ½Ñ‚: matchmaking_queue/{userId} â€” id ÑÐ¾Ð²Ð¿Ð°Ð´Ð°ÐµÑ‚ Ñ userId.
    function matchmakingQueueDocOk(entryId) {
      let d = request.resource.data;
      return d.userId is string
        && d.userId == request.auth.uid
        && entryId == d.userId
        // RN/JS ÑˆÐ»Ñ‘Ñ‚ Ñ‡Ð°ÑÑ‚Ð¾ double; ÐºÐ°Ðº joinedAt â€” Ð¿Ñ€Ð¸Ð½Ð¸Ð¼Ð°ÐµÐ¼ int | float.
        && (d.size is int || d.size is float)
        && (d.size == 2 || d.size == 4)
        // ÐšÐ»Ð¸ÐµÐ½Ñ‚ (RN/JS) Ñ‡Ð°ÑÑ‚Ð¾ ÑˆÐ»Ñ‘Ñ‚ millis ÐºÐ°Ðº number/double â€” ÑÑ‚Ñ€Ð¾Ð³Ð¸Ð¹ is int Ð»Ð¾Ð¼Ð°Ð» join.
        && (d.joinedAt is int || d.joinedAt is float)
        && d.joinedAt > 0
        && d.joinedAt < 10000000000000
        && d.rankTier is string
        && d.keys().hasOnly([
          'userId', 'rankTier', 'size', 'joinedAt',
          'rankIndex', 'searchRange', 'expoPushToken', 'displayName'
        ])
        && (!('rankIndex' in d) || ((d.rankIndex is int || d.rankIndex is float) && d.rankIndex >= 0 && d.rankIndex <= 23))
        && (!('searchRange' in d) || ((d.searchRange is int || d.searchRange is float) && d.searchRange >= 1 && d.searchRange <= 8))
        && (!('expoPushToken' in d) || d.expoPushToken is string)
        && (!('displayName' in d) || d.displayName is string);
    }

    match /matchmaking_queue/{entryId} {
      allow read, write: if false;
    }

    match /arena_questions/{qId} {
      allow read, write: if false;
    }

    // Retired Arena server-owned collections remain sealed while historical
    // records are retained for account-deletion cleanup and audit continuity.
    match /arena_question_history/{userId} {
      allow read, write: if false;
    }

    match /arena_question_pool_publications/{publicationId} {
      allow read, write: if false;
    }

    match /arena_hill_player_wins/{winId} {
      allow read, write: if false;
    }

    match /arena_hill_throne_rewards/{dayKey} {
      allow read, write: if false;
    }


    // â”€â”€ Name index (unique nickname reservation) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /name_index/{nameKey} {
      allow read:  if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // Счётчики «сколько уже таких имён» для ников вида «Имя N».
    // Пишет только сервер (nameGenerateAndReserve через Admin SDK); клиентам
    // ни читать, ни писать — иначе можно подсмотреть, сколько раз встречается имя.
    match /name_counters/{nameKey} {
      allow read, write: if false;
    }

    // Friend code reverse index. Doc id = 6-char code; data = { uid, createdAt }.
    match /friend_code_index/{code} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // Friend requests: users/{targetUid}/friend_requests/{senderUid}.
    match /users/{targetUid}/friend_requests/{senderUid} {
      allow read: if canonicalUserMatchesAuth(targetUid) || canonicalUserMatchesAuth(senderUid);
      allow create: if request.auth != null
        && canonicalUserMatchesAuth(senderUid)
        && targetUid != senderUid
        && !exists(/databases/$(database)/documents/banned_users/$(senderUid))
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is number
        && (!request.resource.data.keys().hasAny(['fromName'])
          || (request.resource.data.fromName is string
            && request.resource.data.fromName.size() > 0
            && request.resource.data.fromName.size() <= 40));
      allow update: if canonicalUserMatchesAuth(targetUid)
        && request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['accepted', 'declined'];
      allow delete: if canonicalUserMatchesAuth(targetUid) || canonicalUserMatchesAuth(senderUid);
    }

    // Обратный индекс исходящих заявок: users/{senderUid}/friend_requests_sent/{toUid}.
    //
    // зачем: сама заявка лежит у ПОЛУЧАТЕЛЯ и названа uid отправителя, поэтому
    // свои исходящие заявки невозможно найти запросом (documentId в
    // collection-group сравнивается по полному пути). Из-за этого удаление
    // аккаунта перебирало всю коллекцию users — сотни тысяч чтений и таймаут
    // при росте базы. Отметка живёт под СВОИМ uid, никакого PII не несёт
    // (только адресат и время) и читается лишь владельцем и админом.
    // Договор имён: shared/friend_requests_index_contract.ts.
    match /users/{senderUid}/friend_requests_sent/{toUid} {
      allow read: if canonicalUserMatchesAuth(senderUid) || isAdmin();
      // зачем без тернарника: во всём этом файле нет ни одного `? :` — не
      // рискуем конструкцией, которую проект ни разу не проверял на боевом
      // деплое. Обычное ИЛИ читается так же и точно компилируется.
      allow create, update: if canonicalUserMatchesAuth(senderUid)
        && request.resource.data.createdAt is number
        && (
          // Служебный маркер «аккаунт ведёт индекс»: только время, без адресата.
          (toUid == '__index__'
            && request.resource.data.keys().hasOnly(['createdAt']))
          // Обычная отметка: id документа обязан совпасть с полем toUid.
          || (toUid != '__index__'
            && toUid != senderUid
            && request.resource.data.toUid == toUid
            && request.resource.data.keys().hasOnly(['toUid', 'createdAt']))
        );
      allow delete: if canonicalUserMatchesAuth(senderUid);
    }

    // Friends list: users/{ownerUid}/friends/{friendUid}.
    // Read is scoped to the list owner OR the friend named in the doc (whose id is
    // their own uid) — the latter keeps legitimate reverse-edge reads
    // users/{friendUid}/friends/{myUid} working (friend-list dedupe/repair, arena
    // invites). A blanket `request.auth != null` here let ANY signed-in user
    // enumerate every user's whole social graph + friend display names (IDOR).
    match /users/{ownerUid}/friends/{friendUid} {
      allow read: if canonicalUserMatchesAuth(ownerUid)
        || canonicalUserMatchesAuth(friendUid)
        || isAdmin();
      allow create: if request.auth != null && ownerUid != friendUid && (
        canonicalUserMatchesAuth(ownerUid) ||
        (canonicalUserMatchesAuth(friendUid) &&
         exists(/databases/$(database)/documents/users/$(friendUid)/friend_requests/$(ownerUid)) &&
         get(/databases/$(database)/documents/users/$(friendUid)/friend_requests/$(ownerUid)).data.status in ['pending', 'accepted'])
      );
      allow update: if false;
      allow delete: if canonicalUserMatchesAuth(ownerUid) || canonicalUserMatchesAuth(friendUid);
    }

    // Reverse auth-edge so a friend can be addressed inside rules by their AUTH uid.
    // Firestore rules cannot map request.auth.uid -> the requester's stableId (no reverse
    // index), so a friend reading users/{owner}/my_events cannot be verified directly.
    // Fix: the READER self-registers users/{ownerUid}/friend_auth_edges/{readerAuthUid}
    // before reading the feed. The create-gate proves all three of:
    //   (a) request.auth.uid == readerAuthUid        — you can only register yourself;
    //   (b) the reader truly owns the claimed stableId (forward firebaseAuthUid check);
    //   (c) the owner->reader friendship edge exists  — they really are friends
    //       (that edge can only have been created via the validated accept flow above).
    // readerStableId is supplied in the doc body so the rule can name the friendship edge.
    match /users/{ownerUid}/friend_auth_edges/{readerAuthUid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == readerAuthUid
        && request.resource.data.readerStableId is string
        && exists(/databases/$(database)/documents/users/$(request.resource.data.readerStableId))
        && get(/databases/$(database)/documents/users/$(request.resource.data.readerStableId)).data.firebaseAuthUid == request.auth.uid
        && exists(/databases/$(database)/documents/users/$(ownerUid)/friends/$(request.resource.data.readerStableId));
      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid == readerAuthUid;
    }

    // users/{stableUid}/my_events/{eventId} — серверные события-якоря для лайков
    // (сегодня: буст лиговой группы, league_groups.ts). Лента активности друзей удалена
    // 2026-08-16; коллекция и правило остаются ради этих якорей и старых документов.
    // Readable by: the owner, an admin, or a confirmed friend (via friend_auth_edges above).
    match /users/{userId}/my_events/{eventId} {
      allow read: if canonicalUserMatchesAuth(userId)
        || isAdmin()
        || (request.auth != null
            && exists(/databases/$(database)/documents/users/$(userId)/friend_auth_edges/$(request.auth.uid)));
      allow create, update, delete: if isAdmin();
    }

    // Лог спинов рулетки Plus (пишет ТОЛЬКО сервер, referral_spin.ts).
    match /users/{userId}/referral_spins/{spinId} {
      allow read: if canonicalUserMatchesAuth(userId) || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ── «Вместе» (docs/plans/2026-08-16-friends-together-implementation.ru.md §2.3) ──
    // friend_pairs/{pairId}: pairId = [a,b].sort().join('__'), data.uids = [a,b].
    // Читают ОБА участника (свой stableUid должен встречаться в uids); пишет только
    // сервер (friends_together.ts / applyReferralPairBonus), Admin SDK обходит правила.
    match /friend_pairs/{pairId} {
      allow read: if request.auth != null && resource.data.uids is list
        && (
          (resource.data.uids[0] is string && canonicalUserMatchesAuth(resource.data.uids[0]))
          || (resource.data.uids.size() > 1 && resource.data.uids[1] is string && canonicalUserMatchesAuth(resource.data.uids[1]))
        );
      allow write: if false;
    }

    // Клеймы сундука недели «Вместе» — читает только владелец, пишет только сервер
    // (friendsClaimWeeklyChest, транзакционно, идемпотентно по weekKey=docId).
    match /users/{userId}/friends_chest_claims/{weekKey} {
      allow read: if canonicalUserMatchesAuth(userId);
      allow write: if false;
    }

    // «Позвать» — дневные лимиты/receipts обеих сторон в доке владельца (friendsNudge).
    // Читает только владелец (та же модель, что friend_activity_like_daily_limits выше).
    match /users/{userId}/friend_nudges/{dayKey} {
      allow read: if canonicalUserMatchesAuth(userId);
      allow write: if false;
    }

    // â”€â”€ League / clubs (Ð½ÐµÐ´ÐµÐ»ÑŒÐ½Ñ‹Ðµ Ð¼Ð¸Ð½Ð¸-Ð³Ñ€ÑƒÐ¿Ð¿Ñ‹) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    // ÐšÐ»Ð¸ÐµÐ½Ñ‚: ÐºÐ°Ðº leaderboard â€” Ð²Ð¾ÑˆÐµÐ´ÑˆÐ¸Ðµ Ð¿Ð¾Ð»ÑŒÐ·Ð¾Ð²Ð°Ñ‚ÐµÐ»Ð¸. ÐÐ´Ð¼Ð¸Ð½ÐºÐ° index.html: ÑÐ¿Ð¸ÑÐ¾Ðº Ð³Ñ€ÑƒÐ¿Ð¿.
    match /league_groups/{groupId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // â”€â”€ Auth links (Google/Apple â†’ stable_id mapping) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    // Doc id = providerUid (Google sub / Apple sub).
    // Ð˜ÑÐ¿Ð¾Ð»ÑŒÐ·ÑƒÐµÑ‚ÑÑ Ð¿Ñ€Ð¸ Ð»Ð¾Ð³Ð¸Ð½Ðµ Ð½Ð° Ð½Ð¾Ð²Ð¾Ð¼ ÑƒÑÑ‚Ñ€Ð¾Ð¹ÑÑ‚Ð²Ðµ: query auth_links/{providerUid}
    // Ñ‡Ñ‚Ð¾Ð±Ñ‹ Ð²Ð¾ÑÑÑ‚Ð°Ð½Ð¾Ð²Ð¸Ñ‚ÑŒ stable_id Ð¸ Ð¿Ð¾Ð´Ñ‚ÑÐ½ÑƒÑ‚ÑŒ Ð¿Ñ€Ð¾Ð³Ñ€ÐµÑÑ.
    match /auth_links/{providerUid} {
      function ownsAuthLinkDoc() {
        return request.auth != null
          && request.auth.uid == providerUid
          && !exists(/databases/$(database)/documents/account_deletion_auth_markers/$(request.auth.uid));
      }

      // The app only needs to read the link for the provider account that is
      // currently signed in. Broad authenticated reads expose account mappings.
      allow read: if isAdmin() || ownsAuthLinkDoc();
      // Identity anchors are server-owned. Browser clients, including admins,
      // must use a callable; Admin SDK writes bypass Firestore Rules.
      allow create, update, delete: if false;

    }

    // ÐÐ³Ñ€ÐµÐ³Ð°Ñ‚Ñ‹ Ð´Ð»Ñ UI (ÑÑ‡Ñ‘Ñ‚Ñ‡Ð¸Ðº Ð¾Ñ‡ÐµÑ€ÐµÐ´Ð¸ Ð°Ñ€ÐµÐ½Ñ‹ â€” Ð¿Ð¸ÑˆÐµÑ‚ Ñ‚Ð¾Ð»ÑŒÐºÐ¾ Cloud Function)
    match /app_meta/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // â”€â”€ Admin audit log â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /admin_log/{docId} {
      allow read: if canReadAdminAuditLog();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /telegram_premium_orders/{orderId} {
      allow read: if isAdmin();
      // Payment-linked activation is server-authoritative. Even admins must use
      // adminActivateTelegramPremiumOrder so payment, recipient and audit commit atomically.
      allow create, update, delete: if false;
    }

    // Dead-letter необработанных Telegram-апдейтов (в т.ч. оплат). Пишет ТОЛЬКО
    // Cloud Function через Admin SDK. Клиент сюда не лезет; админ может читать/чистить.
    match /telegram_premium_dead_letter/{docId} {
      allow read, update: if isAdmin();
      allow create, delete: if false;
    }

    match /telegram_premium_bot/{docId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // â”€â”€ Community (UGC) packs â€” Ð·Ð°Ð¿Ð¸ÑÑŒ Ñ‚Ð¾Ð»ÑŒÐºÐ¾ Ñ‡ÐµÑ€ÐµÐ· Cloud Functions â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    // Cards 2.1 §2: клиенту разрешены ТОЛЬКО соц-счётчики набора (likesCount / addedCount)
    // и только шагом ±1; название, карточки, статус модерации остаются за Cloud Functions.
    function communityPackCounterDelta(field) {
      return request.resource.data.get(field, 0) - resource.data.get(field, 0);
    }

    function communityPackSocialCountersOnly() {
      return request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'addedCount'])
        && request.resource.data.get('likesCount', 0) >= 0
        && request.resource.data.get('addedCount', 0) >= 0
        && communityPackCounterDelta('likesCount') >= -1
        && communityPackCounterDelta('likesCount') <= 1
        && communityPackCounterDelta('addedCount') >= 0
        && communityPackCounterDelta('addedCount') <= 1;
    }

    match /community_packs/{packId} {
      allow read: if request.auth != null;
      allow create, delete: if false;
      allow update: if communityPackSocialCountersOnly();

      // «Кто лайкнул»: один пользователь — один лайк, повторное нажатие снимает.
      // зачем: без likeUserId == auth.uid любой залогиненный мог лайкнуть/снять
      // лайк от чужого имени (IDOR, аудит безопасности 2026-08-22) — докид всегда
      // равен своему uid (см. app/community_packs/packSocialFirestore.ts membershipRef).
      match /pack_likes/{likeUserId} {
        allow read: if request.auth != null;
        allow create, delete: if request.auth != null && likeUserId == request.auth.uid;
        allow update: if false;
      }

      // «Кто добавил себе»: дедупликация счётчика добавлений (снять добавление нельзя).
      match /pack_adds/{addUserId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && addUserId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /community_pack_submissions/{submissionId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /community_pack_drafts/{draftId} {
      allow read, write: if false;
    }

    match /community_pack_purchases/{purchaseId} {
      allow read, update: if isAdmin();
      allow create, delete: if false;
    }

    match /community_pack_ratings/{ratingId} {
      allow read, write: if false;
    }

    // Arena ghost challenges: async shareable arena replays.
    match /arena_ghost_challenges/{challengeId} {
      allow read, write: if false;
    }

    match /arena_hill_thrones/{dayKey} {
      allow read, write: if false;
    }

    match /arena_hill_attempts/{attemptId} {
      allow read, write: if false;
    }

    // ── Сезоны Арены ───────────────────────────────────────────────────────────
    // Сезонный лидерборд (топ-100): читать всем, ПИСАТЬ только сервер (Admin SDK —
    // и PvP onArenaSessionFinished, и бот-CF arenaBotMatchRecord). Клиент не пишет
    // вообще — как и в arena_profiles (анти-накрутка SR/ранга).
    match /arena_season_leaderboard/{seasonId}/entries/{uid} {
      allow read, write: if false;
    }
    // Мета сезона, источники наград (claims), зал славы — только сервер.
    match /arena_seasons/{seasonId} {
      allow read, write: if false;
    }
    match /arena_season_claims/{claimId} {
      allow read, write: if false;
    }
    match /arena_season_hall/{seasonId} {
      allow read, write: if false;
    }

    match /arena_club_events/{eventId} {
      allow read, write: if false;
    }

    match /arena_club_contributions/{contributionId} {
      allow read, write: if false;
    }

    match /arena_rooms_live/{roomCode} {
      allow read, write: if false;
    }

    match /arena_room_runs/{runId} {
      allow read, write: if false;
    }

    // ── Arena room members (lobby participants) ────────────────────────────────
    // Все записи создаёт/обновляет Cloud Function (Admin SDK).
    // Клиент читает участников своей комнаты.
    match /arena_room_members/{memberId} {
      allow read, write: if false;
    }

    match /arena_pulse_events/{eventId} {
      allow read, write: if false;
    }

    match /league_chest_events/{eventId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /league_crowns/{crownId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /league_chest_claims/{claimId} {
      allow read: if isAdmin()
        || (request.auth != null && resource.data.authUid == request.auth.uid);
      allow write: if false;
    }

    // ── Explain like I'm five (Phase 5) ────────────────────────────────────────
    // Публичный кэш объяснений: ЛЮБОЙ может читать готовое объяснение напрямую (быстро,
    // без CF, 0 токенов), но писать КОНТЕНТ — ТОЛЬКО Admin SDK из Cloud Function (explainPhrase).
    // Клиент НИКОГДА не пишет публичный контент (инвариант аудита SECURITY_AUDIT_2026-06-07).
    // delete: isAdmin() — кнопка «Сбросить объяснение» в админке (раздел «Непонятно объяснили»):
    // удаление дока ⇒ следующий запрос фразы генерирует заново. Создавать/менять контент
    // из браузера (включая админа) по-прежнему НЕЛЬЗЯ.
    match /phrase_explanations/{phraseHash} {
      allow read: if true;
      allow create, update: if false;
      allow delete: if isAdmin();
    }

    // Объяснения вариантов упражнения «Выбери фразу» (explainChoice). Та же модель:
    // публичное чтение прогретого кэша ($0), запись только сервер (Admin SDK), удаление —
    // только админ (удаление дока ⇒ следующий ответ сгенерирует батч заново).
    match /choice_explanations/{choiceHash} {
      allow read: if true;
      allow create, update: if false;
      allow delete: if isAdmin();
    }
    match /choice_explain_billing/{docId} {
      allow read: if false;
      allow write: if false;
    }

    // Разбор ошибки урока содержит ответ ученика в сгенерированном тексте.
    // Все чтения/записи идут через callable/Admin SDK; админский reset остаётся delete-only.
    match /mistake_explanations/{mistakeHash} {
      allow read: if false;
      allow create, update: if false;
      allow delete: if isAdmin();
    }
    match /mistake_explain_billing/{docId} {
      allow read: if false;
      allow write: if false;
    }

    // Исторический кэш и биллинг удалённого Quiz остаются полностью закрытыми.
    // Retired-данные доступны только Admin SDK для обязательной серверной очистки.
    match /quiz_explanations/{quizHash} {
      allow read, write: if false;
    }

    // Образцы живого голоса владельца: пары «письмо клиента → ответ
    // владельца», на которых учится поддержка (2026-08-16).
    //
    // зачем полный deny, а не isAdmin(): внутри лежит переписка с
    // конкретными людьми — тексты их обращений и ответы про их случаи.
    // Читает и пишет только сервер через Admin SDK; браузерной админке
    // это не нужно, а держать чужую переписку доступной панели незачем.
    match /support_owner_style_examples/{docId} {
      allow read, write: if false;
    }
    // зачем эти правила ВЕРНУЛИ (аудит 2026-08-16, вторая итерация):
    // сначала я их снёс с обоснованием «общий deny в конце файла всё
    // закроет». Обоснование НЕВЕРНОЕ: правила Firestore объединяются через
    // ИЛИ, и админский catch-all `match /{collection}/{document=**}` ниже
    // разрешает admin'у любую коллекцию, которой нет в его списке
    // исключений. Сняв явный `if false`, я понизил эти коллекции с
    // «запечатано навсегда» до «доступно браузерной админке» — то есть
    // ослабил защиту, а не убрал мёртвый код.
    //
    // Явный deny здесь — не дубликат финального catch-all, а единственное,
    // что реально держит коллекцию закрытой поверх админского allow.
    // Это ровно тот же урок, что дал legacy_agent_rules_guard для agent_*.
    match /quiz_explain_billing/{docId} {
      allow read, write: if false;
    }
    // compass_briefings: функция удалена. Раньше здесь стояло
    // `allow read: if true` — коллекция без владельца была открыта на
    // чтение кому угодно. Публичное чтение убрано, доступ запечатан.
    match /compass_briefings/{hash} {
      allow read, write: if false;
    }
    match /compass_why_cache/{docId} {
      allow read, write: if false;
    }
    match /compass_why_rate_limits/{docId} {
      allow read, write: if false;
    }
    match /compass_why_daily_budget/{docId} {
      allow read, write: if false;
    }
    match /compass_why_billing/{docId} {
      allow read, write: if false;
    }
    match /content_mode_templates/{docId} {
      allow read, write: if false;
    }
    match /content_mode_template_draft_revisions/{docId} {
      allow read, write: if false;
    }
    match /content_studio_review_queue/{docId} {
      allow read, write: if false;
    }
    match /content_studio_localization_units/{docId} {
      allow read, write: if false;
    }
    match /content_studio_waivers/{docId} {
      allow read, write: if false;
    }
    match /content_studio_preview_sessions/{docId} {
      allow read, write: if false;
    }
    match /content_studio_preview_receipts/{docId} {
      allow read, write: if false;
    }

    // Исторический биллинг голосовой части Компаса остаётся закрытым.
    match /compass_billing/{docId} {
      allow read: if false;
      allow write: if false;
    }

    // Compass why-now AI is callable-only. Cache is account-scoped on the server;
    // rate, budget, and billing records must never be readable or writable by apps.

    // Внутренние CF-only коллекции фичи: бюджет/лимиты/биллинг. Всё пишет и читает только
    // сервер (Admin SDK). НЕ через isAdmin(): эти коллекции НЕ открыты admin-панели
    // (в отличие от referral_owners), поэтому read И write = false.
    match /explain_global_budget/{docId} {
      allow read: if false;
      allow write: if false;
    }
    match /explain_user_limits/{docId} {
      allow read: if false;
      allow write: if false;
    }
    match /explain_billing/{docId} {
      allow read: if false;
      allow write: if false;
    }

    // Произношение: функция scorePronunciationAttempt снесена, но правила
    // остаются намеренно — см. разбор выше про админский catch-all. Без
    // явного deny эти коллекции стали бы доступны браузерной админке.
    match /pronunciation_score_rate_limits/{docId} {
      allow read, write: if false;
    }
    match /pronunciation_score_daily_quota/{docId} {
      allow read, write: if false;
    }
    match /pronunciation_global_budget/{docId} {
      allow read, write: if false;
    }

    // Жалобы «Непонятно объяснили»: ПИШЕТ только CF submitExplainReport (Admin SDK), а
    // админ-панель ЧИТАЕТ и разбирает их (раздел «Непонятно объяснили») — паттерн user_reports.
    // explain_reports — счётчик «сколько РАЗНЫХ юзеров пожаловались» по фразе
    // (delete = админ сбрасывает счётчик после починки фразы).
    match /explain_reports/{docId} {
      allow read, delete: if isAdmin();
      allow create, update: if false;
    }
    // explain_report_entries — лента жалоб, по записи на каждую отправку
    // (update = пометить разобранной, delete = убрать мусор).
    match /explain_report_entries/{docId} {
      allow read, update, delete: if isAdmin();
      allow create: if false;
    }

    // Промокоды-награды: админ создаёт/правит из «Пульта», читает статистику.
    // Активация идёт через CF promoCodeRedeem (Admin SDK) — клиентам прямой доступ
    // не нужен и запрещён (нельзя подсмотреть/подменить rewardDays/usedCount).
    match /promo_codes/{code} {
      allow read, write: if false;
    }

    // Certificate records and idempotency receipts are server-owned. The live
    // admin receives bounded projections only through permission-checked callables.
    match /gift_certificate_deliveries/{document=**} {
      allow read, write: if false;
    }
    match /admin_gift_certificate_batch_operations/{document=**} {
      allow read, write: if false;
    }
    match /gift_certificate_archive/{document=**} {
      allow read, write: if false;
    }
    match /admin_user_briefs_rate_limits/{document=**} {
      allow read, write: if false;
    }

    // â”€â”€ CATCH-ALL â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    // Agent Office is a server-owned control ledger. Canonical records are
    // reachable only through role-checked Cloud Functions using Admin SDK.
    // Одноразовые approval-токены Джарвиса. Полностью закрыты браузеру:
    // документ содержит хеш nonce, и даже чтение помогло бы подбору.
    match /jarvis_approval_tokens/{document=**} {
      allow read, write: if false;
    }
    // Журнал подтверждений: admin читает (в этом его смысл), пишет только
    // сервер — иначе запись можно было бы подделать из браузера.
    match /jarvis_approval_audit/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Guarded support auto-reply quota receipts/counters are server-only.
    // They contain hashes and policy state, and browser admins never need to
    // mutate them directly; configuration goes through an audited callable.
    match /support_auto_reply_reservations/{document=**} {
      allow read, write: if false;
    }
    match /support_auto_reply_counters/{document=**} {
      allow read, write: if false;
    }
    // Support mail, sealed SMTP operations and Telegram review state are
    // server-owned. The admin panel uses permission-checked callables; direct
    // browser writes could otherwise bypass revision/CAS and send stale text.
    match /support_telegram_reviews/{document=**} {
      allow read, write: if false;
    }
    match /support_telegram_edit_sessions/{document=**} {
      allow read, write: if false;
    }
    match /support_telegram_reply_jobs/{document=**} {
      allow read, write: if false;
    }
    match /support_reply_operations/{document=**} {
      allow read, write: if false;
    }
    match /support_reply_batches/{document=**} {
      allow read, write: if false;
    }
    match /support_conversations/{document=**} {
      allow read, write: if false;
    }
    match /support_email_message_index/{document=**} {
      allow read, write: if false;
    }
    match /admin_command_operations/{document=**} {
      allow read, write: if false;
    }
    // Availability overrides for the server-backed cosmetic archive. Clients
    // receive a validated compact manifest through a callable; writes are
    // guarded, idempotent and audited by the admin callable only.
    match /cosmetic_asset_archive_overrides/{document=**} {
      allow read, write: if false;
    }
    // Выключатель Джарвиса: admin видит режим в панели, меняет только сервер
    // (через callable с проверкой прав) — иначе режим правился бы из консоли
    // браузера в обход журнала.
    match /jarvis_control/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // Счётчик трат на LLM-обогатитель Джарвиса: admin видит, сколько уже
    // потрачено (панель может показать остаток бюджета), пишет только сервер
    // транзакцией — иначе счётчик можно было бы подделать из браузера и
    // обойти денежный потолок.
    match /jarvis_llm_budget/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // Кэш идемпотентности обогатителя: строго служебные данные (хеш решения →
    // резервация/результат), владельцу здесь смотреть нечего — narrative он
    // видит через саму сводку/панель, а не через этот internal-кэш.
    match /jarvis_llm_enrichment_cache/{document=**} {
      allow read, write: if false;
    }
    // Раздел «Планы»: постоянный архив находок Джарвиса. Владелец читает и
    // управляет статусом (resolved/archived) через admin-callable — тот
    // проверяет adminRole сам, прямой доступ из браузера не нужен.
    match /jarvis_plans/{document=**} {
      allow read, write: if false;
    }
    // Действия Джарвиса и их исходящий буфер. Пишет и читает только сервер.
    // зачем закрыто наглухо: в jarvis_actions лежит право изменить чужой
    // документ, а в буфере — текст, который однажды уйдёт наружу. Доступ из
    // браузера не нужен ни в одном сценарии: владелец работает через
    // admin-callable, которые проверяют роль сами.
    match /jarvis_actions/{document=**} {
      allow read, write: if false;
    }
    match /jarvis_github_outbox/{document=**} {
      allow read, write: if false;
    }

    // Джарвис (новый слой): история стадии бизнеса, достигнутый пик и агрегат
    // по урокам. Читаются ТОЛЬКО через callable с проверкой ролей — прямой
    // браузерный доступ закрыт, как и у всего остального агентного слоя.
    match /business_tier_history/{document=**} {
      allow read, write: if false;
    }
    match /business_tier_peak/{document=**} {
      allow read, write: if false;
    }
    match /business_tier_backfill_state/{document=**} {
      allow read, write: if false;
    }
    match /lesson_stats/{document=**} {
      allow read, write: if false;
    }
    // Learning retention markers and aggregates are written/read only through
    // role-checked Cloud Functions. Browser clients, including admins, never
    // receive member hashes or mutate aggregate counters directly.
    match /jarvis_learning_cohort_members/{document=**} {
      allow read, write: if false;
    }
    match /jarvis_learning_cohorts/{document=**} {
      allow read, write: if false;
    }
    // Daily signup totals contain no UID/PII, but remain server-only so a
    // modified client cannot inflate Jarvis growth evidence.
    match /jarvis_growth_daily/{document=**} {
      allow read, write: if false;
    }
    // Release-aware quality counters and hashed distinct-user markers are
    // server-owned. Jarvis receives only aggregate event counts and buckets.
    match /jarvis_quality_daily/{document=**} {
      allow read, write: if false;
    }

    // Биржа «монеты → звёзды»: курс, история и журнал сделок — строго серверные.
    match /economy/{document=**} {
      allow read, write: if false;
    }
    match /economy_exchange_history/{document=**} {
      allow read, write: if false;
    }
    match /coin_exchange_trades/{document=**} {
      allow read, write: if false;
    }
    // Журнал разовой миграции осколков→монет — строго серверный.
    match /coin_migrations/{document=**} {
      allow read, write: if false;
    }

    // Снесённые агентные слои: код удалён, но правила остаются
    // намеренно. Явный deny — это документированное «закрыто навсегда»,
    // его охраняет legacy_agent_rules_guard. Общий deny в конце файла
    // выглядит так же, но не выражает намерения и молча исчезнет, если
    // кто-то добавит разрешающее правило выше.
    match /agent_cases/{document=**} {
      allow read, write: if false;
    }
    match /agent_recommendations/{document=**} {
      allow read, write: if false;
    }
    match /agent_approvals/{document=**} {
      allow read, write: if false;
    }
    match /agent_tasks/{document=**} {
      allow read, write: if false;
    }
    match /agent_audit_events/{document=**} {
      allow read, write: if false;
    }
    match /agent_office_control/{document=**} {
      allow read, write: if false;
    }
    match /agent_telegram_tokens/{document=**} {
      allow read, write: if false;
    }
    match /agent_observation_receipts/{document=**} {
      allow read, write: if false;
    }
    match /agent_manager_agents/{document=**} {
      allow read, write: if false;
    }
    match /agent_manager_tasks/{document=**} {
      allow read, write: if false;
    }
    match /agent_manager_task_events/{document=**} {
      allow read, write: if false;
    }
    match /agent_manager_approvals/{document=**} {
      allow read, write: if false;
    }
    match /agent_manager_execution_jobs/{document=**} {
      allow read, write: if false;
    }
    match /agent_manager_inbox_links/{document=**} {
      allow read, write: if false;
    }
    match /agent_manager_telegram_tokens/{document=**} {
      allow read, write: if false;
    }
    match /agent_manager_telegram_publication_receipts/{document=**} {
      allow read, write: if false;
    }
    match /agent_manager_local_runner_pairings/{document=**} {
      allow read, write: if false;
    }
    match /agent_manager_local_runner_capabilities/{document=**} {
      allow read, write: if false;
    }
    match /agent_manager_local_runner_leases/{document=**} {
      allow read, write: if false;
    }
    match /agent_manager_support_draft_operations/{document=**} {
      allow read, write: if false;
    }
    // Real-money shard refund receipts contain account and transaction identity.
    // Browser admins consume only the bounded, redacted callable projection.
    match /revenuecat_shard_refunds/{document=**} {
      allow read, write: if false;
    }

    match /{collection}/{document=**} {
      allow read, write: if isAdmin()
        && collection != 'users'
        && collection != 'account_deletion_tombstones'
        && collection != 'account_deletion_auth_markers'
        && collection != 'account_deletion_permanent_denials'
        && collection != 'account_identity_owner_map'
        && collection != 'account_merge_outbox'
        && collection != 'revenuecat_premium_events'
        && collection != 'revenuecat_premium_lineages'
        && collection != 'revenuecat_premium_denials'
        && collection != 'revenuecat_shard_refunds'
        && collection != 'jarvis_approval_tokens'
        && collection != 'admin_log'
        && collection != 'safety_flags'
        && collection != 'voice_call_reviews'
        && collection != 'voice_tutor_memory'
        && collection != 'voice_call_quotas'
        && collection != 'max_voice_ops_daily'
        && collection != 'promo_codes'
        && collection != 'gift_certificate_deliveries'
        && collection != 'admin_gift_certificate_batch_operations'
        && collection != 'gift_certificate_archive'
        && collection != 'admin_user_briefs_rate_limits'
        && !isServerOwnedFeedbackRoot(collection)
        && !isRetiredArenaRoot(collection)
        && !isServerOwnedAgentRoot(collection)
        && !isServerOwnedAuthRoot(collection)
        && !isServerOwnedSupportRoot(collection)
        && collection != 'business_tier_history'
        && collection != 'business_tier_peak'
        && collection != 'business_tier_backfill_state'
        && collection != 'lesson_stats'
        && collection != 'jarvis_learning_cohort_members'
        && collection != 'jarvis_learning_cohorts'
        && collection != 'jarvis_growth_daily'
        && collection != 'jarvis_quality_daily'
        && collection != 'economy'
        && collection != 'youtube_catalog'
        && collection != 'youtube_catalog_snapshots'
        && collection != 'youtube_catalog_history'
        && collection != 'economy_exchange_history'
        && collection != 'coin_exchange_trades'
        && collection != 'coin_migrations'
        && !isServerOwnedContentStudioRoot(collection)
        && !isBrowserAdminExcludedTournamentRoot(collection)
        // Retired Quiz/Arena collections remain sealed even for browser admins.
        // Firestore overlapping matches are OR-combined, so every retired root
        // must also be excluded from this legacy compatibility catch-all.
        && collection != 'session_players'
        && collection != 'matchmaking_queue'
        // Mistake explanation content and billing remain callable/Admin-SDK only.
        // Overlapping Firestore matches are OR-combined, so the legacy browser-admin
        // catch-all must explicitly exclude both roots.
        && collection != 'mistake_explanations'
        && collection != 'mistake_explain_billing'
        && collection != 'quiz_explanations'
        && collection != 'quiz_explain_billing';
    }
    // Legacy browser-admin compatibility. These rules mirror only operations
    // that admin/legacy.html performs directly; do not replace them with a
    // recursive or prefix-wide admin grant.
    match /admin_digest_runs/{runId} {
      allow list: if isAdmin();
    }
    match /admin_digests/{dayKey} {
      allow get: if isAdmin();
    }
    match /support_inbox/{messageId} {
      allow read, write: if false;
    }
    match /admin_push_jobs/{jobId} {
      allow list, create: if isAdmin();
    }
    match /revenuecat_premium_events/{eventId} {
      allow list: if isAdmin();
    }
    match /account_deletion_permanent_denials/{denialId} {
      allow read, write: if false;
    }
    match /account_identity_owner_map/{aliasId} {
      allow read, write: if false;
    }
    match /account_merge_outbox/{mergeId} {
      allow read, write: if false;
    }
    match /revenuecat_premium_lineages/{docId} {
      allow read, write: if false;
    }
    match /revenuecat_premium_denials/{docId} {
      allow read, write: if false;
    }
    match /revenuecat_shard_transactions/{transactionId} {
      allow list: if isAdmin();
    }
    match /users_dedup_archive/{userId} {
      allow create, update: if isAdmin();
    }
    match /adminContentDrafts/fr/quiz/{version} {
      allow create, update: if isAdmin();
    }
    match /adminContentRollbacks/fr/quiz/{version} {
      allow create, update: if isAdmin();
    }

    // Legacy admin collection-group queries need a collection-group match;
    // the nested users/{userId}/... rules continue to govern document writes.
    match /{path=**}/app_message_states/{messageId} {
      allow list: if isAdmin();
    }
    match /{path=**}/promo_redemptions/{code} {
      allow list: if isAdmin();
    }

    // Learning V2 Content Studio authoring state is callable/Admin-SDK only.
    // Firestore allow expressions are OR-combined across overlapping matches,
    // so these exact deny blocks rely on the final catch-all also being deny-only.
    match /content_mode_template_versions/{docId} {
      allow read, write: if false;
    }
    match /content_mode_template_lifecycle/{docId} {
      allow read, write: if false;
    }
    match /content_mode_template_lifecycle_audit/{docId} {
      allow read, write: if false;
    }
    match /content_mode_template_lifecycle_operations/{docId} {
      allow read, write: if false;
    }
    match /content_season_drafts/{docId} {
      allow read, write: if false;
    }
    match /content_season_revisions/{docId} {
      allow read, write: if false;
    }
    match /content_season_lifecycle/{docId} {
      allow read, write: if false;
    }
    match /content_season_episode_pins/{docId} {
      allow read, write: if false;
    }
    match /content_season_lifecycle_operations/{docId} {
      allow read, write: if false;
    }
    match /content_season_pin_cleanup_audits/{docId} {
      allow read, write: if false;
    }
    match /content_episode_drafts/{docId} {
      allow read, write: if false;
    }
    match /content_episode_revisions/{docId} {
      allow read, write: if false;
    }
    match /content_episode_lifecycle/{docId} {
      allow read, write: if false;
    }
    match /content_episode_lifecycle_audit/{docId} {
      allow read, write: if false;
    }
    match /content_episode_lifecycle_operations/{docId} {
      allow read, write: if false;
    }
    match /content_studio_review_receipts/{docId} {
      allow read, write: if false;
    }
    match /content_studio_validation_receipts/{docId} {
      allow read, write: if false;
    }
    match /content_studio_localization_receipts/{docId} {
      allow read, write: if false;
    }
    match /content_studio_voice_receipts/{docId} {
      allow read, write: if false;
    }
    match /content_studio_gate_receipts/{docId} {
      allow read, write: if false;
    }
    match /content_studio_season_approval_receipts/{docId} {
      allow read, write: if false;
    }
    match /content_studio_episode_review_operations/{docId} {
      allow read, write: if false;
    }
    match /content_studio_episode_validation_operations/{docId} {
      allow read, write: if false;
    }
    match /content_studio_episode_localization_operations/{docId} {
      allow read, write: if false;
    }
    match /content_studio_episode_voice_operations/{docId} {
      allow read, write: if false;
    }
    match /content_studio_gate_operations/{docId} {
      allow read, write: if false;
    }
    match /content_app_support_manifests/{docId} {
      allow read, write: if false;
    }
    match /content_decision_registries/{docId} {
      allow read, write: if false;
    }
    match /content_factory_stages/{docId} {
      allow read, write: if false;
    }

    match /content_v2_owner_episode_confirmations/{docId} {
      allow read, write: if false;
    }
    match /content_v2_unified_course_release_heads/{docId} {
      allow read, write: if false;
    }
    match /content_v2_unified_course_release_roots/{docId} {
      allow read, write: if false;
    }
    match /content_v2_unified_course_release_heads_v3/{docId} {
      allow read, write: if false;
    }
    match /content_v2_unified_course_release_roots_v3/{docId} {
      allow read, write: if false;
    }
    // Authenticated repository evidence is Firebase-Admin-only. These roots
    // are reserved before the adapter is wired so no browser credential can
    // forge a published profile, a repository claim, or a durable stage pin.
    match /content_language_profile_versions/{docId} {
      allow read, write: if false;
    }
    match /content_language_profile_lifecycle/{docId} {
      allow read, write: if false;
    }
    match /content_speech_profile_versions/{docId} {
      allow read, write: if false;
    }
    match /content_speech_profile_lifecycle/{docId} {
      allow read, write: if false;
    }
    match /content_voice_generation_profile_versions/{docId} {
      allow read, write: if false;
    }
    match /content_voice_generation_profile_lifecycle/{docId} {
      allow read, write: if false;
    }
    match /content_v2_repository_auth/{docId} {
      allow read, write: if false;
    }
    match /content_v2_voice_human_reviews/{docId} {
      allow read, write: if false;
    }
    match /content_v2_stage_repository_commits/{docId} {
      allow read, write: if false;
    }
    match /content_v2_stage_candidate_pins/{docId} {
      allow read, write: if false;
    }
    // Published required-session bytes are release authority for server-side
    // progress settlement. Browser admins and clients must use reviewed
    // callables; direct writes could mint arbitrary course/task coordinates.
    match /content_v2_required_session_sets/{docId} {
      allow read, write: if false;
    }

    match /content_v2_required_session_answer_manifests/{docId} {
      allow read, write: if false;
    }
    // The V2 Season pointer is the final root-last publication coordinate.
    // Even browser-admin tokens must go through the audited server CAS.
    match /content_v2_season_release_pointers/{docId} {
      allow read, write: if false;
    }
    match /content_v2_season_release_manifests/{docId} {
      allow read, write: if false;
    }
    match /content_v2_activity_auxiliary_release_pointers/{docId} {
      allow read, write: if false;
    }
    match /content_v2_activity_learner_core_release_pointers/{docId} {
      allow read, write: if false;
    }
    match /content_v2_activity_server_evaluator_release_pointers/{docId} {
      allow read, write: if false;
    }

    // Required-session counters and settled projections are transaction-owned.
    // They are deliberately not client-readable: the callable returns only the
    // accepted projection while protected economic receipts use another seam.
    match /users/{uid}/v2_required_session_runs/{docId} {
      allow read, write: if false;
    }
    match /users/{uid}/v2_required_session_task_attempts/{docId} {
      allow read, write: if false;
    }
    match /users/{uid}/v2_required_session_settlements/{docId} {
      allow read, write: if false;
    }
    // Monotonic best-of-12 award state and its per-completion decisions are
    // server-only. Direct reads would expose another device's economic
    // history; direct writes could mint or suppress access-star deltas.
    match /users/{uid}/v2_required_session_performance_awards/{docId} {
      allow read, write: if false;
    }
    match /users/{uid}/v2_required_session_performance_award_decisions/{docId} {
      allow read, write: if false;
    }
    match /users/{uid}/v2_required_session_course_awards/{docId} {
      allow read, write: if false;
    }
    // Completed offline sessions are uploaded through the App Check protected
    // callable only. Direct client access could bypass immutable catalog and
    // account-generation cross-checks or expose another device's pending data.
    match /users/{uid}/v2_required_session_completion_inbox/{docId} {
      allow read, write: if false;
    }
    // Released Activity completions are accepted only by the App Check/Auth
    // callable after active-release and account-generation reconciliation.
    // Direct client access could forge completion coordinates or inspect a
    // different device's pending post-session verification record.
    match /users/{uid}/v2_activity_released_completion_inbox/{docId} {
      allow read, write: if false;
    }

    // Learning V2 post-session answer batches and server evaluations are
    // server-only. Clients receive only the narrow callable receipt.
    match /users/{uid}/v2_activity_released_submission_inbox/{docId} {
      allow read, write: if false;
    }
    // The settlement decision binds one evaluated released submission to the
    // shared required-session economy state and protected reward receipt.
    // It is transaction-owned and never a client-mintable progress record.
    match /users/{uid}/v2_activity_released_settlement_decisions/{docId} {
      allow read, write: if false;
    }

    // Learning V2 delayed evidence is server-owned. Clients must use the
    // callable; direct reads/writes would bypass assignment, timing and
    // idempotency checks. Admin SDK writes are unaffected by these rules.
    match /learning_v2_assignments/{docId} {
      allow read, write: if false;
    }
    match /learning_v2_launches/{docId} {
      allow read, write: if false;
    }
    match /learning_v2_timing_receipts/{docId} {
      allow read, write: if false;
    }
    match /learning_v2_failure_receipts/{docId} {
      allow read, write: if false;
    }
    match /learning_v2_receipt_operations/{docId} {
      allow read, write: if false;
    }

    // ── Турниры (Фаза 1 MVP, спека docs/tournaments/2026-07-21-tournaments-mode-spec.md) ──
    // Все записи — только через Cloud Functions (Admin SDK). Клиенты читают
    // комнаты/сезон/банк/ботов; задания отдаёт только сервер по seed.
    // Compatibility for rooms deployed before participantAuthUids existed.
    // The fixed room cap is 16, so exact indexed checks preserve document
    // listeners for real participants without granting a collection-wide read.
    function legacyTournamentHasPlayerId(room, uid) {
      return (room.players.size() > 0 && room.players[0].isBot == false && room.players[0].id == uid)
        || (room.players.size() > 1 && room.players[1].isBot == false && room.players[1].id == uid)
        || (room.players.size() > 2 && room.players[2].isBot == false && room.players[2].id == uid)
        || (room.players.size() > 3 && room.players[3].isBot == false && room.players[3].id == uid)
        || (room.players.size() > 4 && room.players[4].isBot == false && room.players[4].id == uid)
        || (room.players.size() > 5 && room.players[5].isBot == false && room.players[5].id == uid)
        || (room.players.size() > 6 && room.players[6].isBot == false && room.players[6].id == uid)
        || (room.players.size() > 7 && room.players[7].isBot == false && room.players[7].id == uid)
        || (room.players.size() > 8 && room.players[8].isBot == false && room.players[8].id == uid)
        || (room.players.size() > 9 && room.players[9].isBot == false && room.players[9].id == uid)
        || (room.players.size() > 10 && room.players[10].isBot == false && room.players[10].id == uid)
        || (room.players.size() > 11 && room.players[11].isBot == false && room.players[11].id == uid)
        || (room.players.size() > 12 && room.players[12].isBot == false && room.players[12].id == uid)
        || (room.players.size() > 13 && room.players[13].isBot == false && room.players[13].id == uid)
        || (room.players.size() > 14 && room.players[14].isBot == false && room.players[14].id == uid)
        || (room.players.size() > 15 && room.players[15].isBot == false && room.players[15].id == uid);
    }

    function isLegacyTournamentParticipant(room) {
      return request.auth != null
        && room.players is list
        && (legacyTournamentHasPlayerId(room, request.auth.uid)
          || (exists(/databases/$(database)/documents/auth_links/$(request.auth.uid))
            && legacyTournamentHasPlayerId(
              room,
              get(/databases/$(database)/documents/auth_links/$(request.auth.uid)).data.stable_id
            )));
    }

    match /tournamentSchedule/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /tournamentRooms/{roomId} {
      // зачем: зрители (решение владельца 2026-07-26) — любой вошедший может
      // смотреть табло идущего турнира. Это безопасно: правильные ответы лежат
      // в закрытой подколлекции taskSecrets, а сам документ комнаты содержит
      // только имена, аватары, очки и состояние. Зритель не отнимает место у
      // игрока: смотреть можно лишь ПОСЛЕ закрытия входа (состояния round/
      // table/final), пока лобби открыто — только играть.
      // зачем 2026-08-02 (владелец: «при входе в турнир сразу — не удалось
      // войти»): вход в режим был сломан НАГЛУХО. Клиент вычисляет id комнаты
      // слота сам, по формуле, не читая базу (осознанная экономия — см.
      // parseTournamentRoomId в tournaments.ts), а сам документ комнаты
      // создаётся сервером только В МОМЕНТ входа. То есть подписка стартует
      // на ещё НЕ СУЩЕСТВУЮЩИЙ документ — а у него нет resource.data, поэтому
      // первое же условие ниже падало и Firestore отвечал PERMISSION_DENIED.
      // Клиент трактовал это как отказ входа и показывал «Не удалось войти.
      // Попробуйте ещё раз», хотя вход даже не начинался и повтор не помогал.
      //
      // resource == null безопасно: у несуществующего документа читать нечего,
      // клиент получит пустой снапшот и дождётся создания комнаты сервером.
      allow read: if request.auth != null
        && (resource == null
          || resource.data.state in ['scheduled', 'lobby']
          || resource.data.state.matches('round[1-4]')
          || resource.data.state.matches('table[1-3]')
          || resource.data.state in ['final', 'results']
          || (resource.data.get('participantAuthUidsComplete', false) == true
            && request.auth.uid in resource.data.get('participantAuthUids', []))
          || (resource.data.get('participantAuthUidsComplete', false) != true
            && (request.auth.uid in resource.data.get('participantAuthUids', [])
              || isLegacyTournamentParticipant(resource.data))));
      allow write: if false;
    }
    match /tournamentRooms/{roomId}/taskSecrets/{taskId} {
      allow read, write: if false;
    }
    // зачем 2026-07-27 (владелец: «анимации эмодзи нет, как было задумано на
    // макетах — чтобы они отправлялись, улетали вверх и все их видели»):
    // реакция это ОДИН документ на игрока, а не запись на каждый тап. Игрок
    // перезаписывает свой док, остальные видят изменение через подписку —
    // так стоимость не растёт от частоты тапов (кулдаун держит и клиент).
    // Пишет только сам автор и только в свой документ; чужой перебить нельзя.
    // Читают все, кому открыта комната, — реакции не секрет, ответы лежат
    // в закрытой taskSecrets и сюда не попадают.
    match /tournamentRooms/{roomId}/reactions/{authUid} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/tournamentRooms/$(roomId));
      allow write: if request.auth != null
        && request.auth.uid == authUid
        && request.resource.data.keys().hasOnly(['emoji', 'atMs', 'name'])
        && request.resource.data.emoji is string
        && request.resource.data.emoji.size() <= 8
        && request.resource.data.atMs is int;
    }
    match /tournamentTasks/{taskId} {
      allow read, write: if false;
    }
    // V11 semantic candidates, raw two-pass verdict evidence, resumable job
    // state, and unpublished bundles are Admin-SDK/callable only. Recursive
    // denies are required because every nested checkpoint/evidence/task must
    // remain sealed from ordinary and browser-admin credentials alike.
    match /tournament_semantic_jobs/{document=**} {
      allow read, write: if false;
    }
    match /tournament_semantic_review_receipts/{document=**} {
      allow read, write: if false;
    }
    match /tournament_pool_v11_bundles/{document=**} {
      allow read, write: if false;
    }
    match /tournamentSeasons/{weekId} {
      allow read: if request.auth != null;
      allow write: if false;
      match /entries/{uid} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }
    match /tournamentBank/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /botProfiles/{botId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── Arena V2 ────────────────────────────────────────────────────────────
    // Old Arena roots above remain permanently sealed. Arena V2 uses distinct
    // versioned collections and Admin-SDK-only writes. During play the client
    // owns exactly one queue-document listener, then exactly one public match
    // listener. Correct answers, bot blueprints and answer receipts never
    // leave arena_v2_match_private.
    match /arena_v2_config/{configId} {
      allow read, write: if false;
    }
    match /arena_v2_profiles/{userId} {
      allow read: if userDocOwnerMatchesAuth(userId);
      allow write: if false;
    }
    match /arena_v2_queue/{userId} {
      allow read: if request.auth != null
        && resource != null
        && resource.data.get('authUid', '') == request.auth.uid;
      allow write: if false;
    }
    match /arena_v2_matches/{matchId} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/arena_v2_matches/$(matchId)/arena_v2_members/$(request.auth.uid));
      allow write: if false;

      // A participant may inspect only their own opaque seat marker. Keeping
      // membership outside the public match avoids exposing the opponent's
      // Firebase Auth or stable UID through the one live match listener.
      match /arena_v2_members/{authUid} {
        allow read: if request.auth != null && request.auth.uid == authUid;
        allow write: if false;
      }
    }
    function arenaLiveTickOk(tick, schemaVersion) {
      return schemaVersion in ['arena-live.v1', 'arena-live.v2']
        && tick is map
        && tick.keys().hasAll(['taskIndex', 'correct', 'raceElapsedMs'])
        // matchStars is additive in v1 so already-installed v1 readers keep
        // accepting the document while ignoring the unknown display field.
        && tick.keys().hasOnly(['taskIndex', 'correct', 'raceElapsedMs', 'matchStars'])
        && tick.taskIndex is int
        && tick.taskIndex >= 0 && tick.taskIndex < 10
        && tick.correct is bool
        && tick.raceElapsedMs is int
        && tick.raceElapsedMs >= 0 && tick.raceElapsedMs <= 600000
        && (!tick.keys().hasAny(['matchStars']) || (
          tick.matchStars is int
          && tick.matchStars >= 0 && tick.matchStars <= 40
        ));
    }
    function arenaLiveTicksOk(ticks, schemaVersion) {
      return ticks is list
        && ticks.size() <= 10
        && (ticks.size() <= 0 || arenaLiveTickOk(ticks[0], schemaVersion))
        && (ticks.size() <= 1 || arenaLiveTickOk(ticks[1], schemaVersion))
        && (ticks.size() <= 2 || arenaLiveTickOk(ticks[2], schemaVersion))
        && (ticks.size() <= 3 || arenaLiveTickOk(ticks[3], schemaVersion))
        && (ticks.size() <= 4 || arenaLiveTickOk(ticks[4], schemaVersion))
        && (ticks.size() <= 5 || arenaLiveTickOk(ticks[5], schemaVersion))
        && (ticks.size() <= 6 || arenaLiveTickOk(ticks[6], schemaVersion))
        && (ticks.size() <= 7 || arenaLiveTickOk(ticks[7], schemaVersion))
        && (ticks.size() <= 8 || arenaLiveTickOk(ticks[8], schemaVersion))
        && (ticks.size() <= 9 || arenaLiveTickOk(ticks[9], schemaVersion));
    }
    /**
     * Живой прогресс соперника во время матча.
     *
     * Единственное место во всей Арене, куда пишет САМ клиент. Пускать его сюда
     * приходится потому, что индикатор «соперник ответил» обязан срабатывать
     * мгновенно, а любой серверный посредник — это задержка, которую владелец
     * запретил.
     *
     * Опасности в этом нет: канал не участвует в начислении. Итог матча
     * пересчитывает сервер по запечатанным заданиям, а сюда попадают только
     * номер задания, признак «верно» и время. Ответов здесь нет.
     *
     * Ключ документа — МЕСТО ЗА СТОЛОМ, а не идентификатор игрока. Иначе, чтобы
     * прочитать соперника, пришлось бы знать его uid, а он намеренно спрятан:
     * ради этого и заведены отдельные метки участия.
     */
    match /arena_v2_match_live/{matchId}/seats/{seatId} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/arena_v2_matches/$(matchId)/arena_v2_members/$(request.auth.uid));
      // Писать можно ТОЛЬКО в своё место: метка участия называет его явно.
      allow create, update: if request.auth != null
        && (seatId == 'a' || seatId == 'b')
        && get(/databases/$(database)/documents/arena_v2_matches/$(matchId)/arena_v2_members/$(request.auth.uid)).data.seatId == seatId
        // Канал не принимает произвольные поля. В частности, ответ или
        // идентификатор игрока нельзя случайно опубликовать сопернику даже
        // при регрессии клиента.
        && request.resource.data.keys().hasAll(['schemaVersion', 'ticks', 'finished', 'updatedAtMs'])
        && request.resource.data.keys().hasOnly(['schemaVersion', 'ticks', 'finished', 'updatedAtMs'])
        && request.resource.data.schemaVersion in ['arena-live.v1', 'arena-live.v2']
        && arenaLiveTicksOk(request.resource.data.ticks, request.resource.data.schemaVersion)
        // Метка времени обязательна: по ней почасовая уборка находит
        // протухшие каналы. Без неё документ остался бы навсегда.
        && request.resource.data.finished is bool
        && request.resource.data.updatedAtMs is number;
      allow delete: if false;
    }
    match /arena_v2_match_live/{matchId} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/arena_v2_matches/$(matchId)/arena_v2_members/$(request.auth.uid));
      allow write: if false;
    }
    match /arena_v2_invites/{inviteId} {
      allow read, write: if false;
    }
    match /arena_v2_queue_locks/{lockId} {
      allow read, write: if false;
    }
    match /arena_v2_pair_limits/{pairId} {
      allow read, write: if false;
    }
    match /arena_v2_match_private/{matchId} {
      allow read, write: if false;
    }
    // Expansion coordination and sealed content are callable-only. These
    // roots can contain identities, task envelopes or social moderation state.
    match /arena_v2_daily_private/{challengeId} {
      allow read, write: if false;
    }
    match /arena_v2_ghosts/{ghostId} {
      allow read, write: if false;
    }
    match /arena_v2_series/{seriesId} {
      allow read, write: if false;
    }
    match /arena_v2_partnerships/{partnershipId} {
      allow read, write: if false;
    }
    match /users/{uid}/reward_claims/{claimId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /users/{uid}/tournament_receipts/{receiptId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
