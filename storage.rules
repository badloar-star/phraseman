rules_version = '2';

// Firebase Storage security rules for Phraseman.
//
// Audio for in-app phrase pronunciation (OpenAI TTS, voice "fable") lives under
// /phrase-audio/**. These clips are public learning content (not secret), so any
// client may READ them. WRITES are denied to all clients — audio is uploaded only
// by the offline generator script / admin tooling via the Firebase Admin SDK,
// which bypasses these rules. This prevents users from injecting or overwriting
// audio assets.
//
// Everything else is locked down by default.

service firebase.storage {
  match /b/{bucket}/o {

    // Public, read-only phrase pronunciation audio.
    match /phrase-audio/{allPaths=**} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    // Published Learning V2 voice assets. Exact object coordinates arrive only
    // through the authenticated active-release descriptor. The app reads one
    // immutable object by exact path, verifies byte size + SHA-256 and stores no
    // token URL. Browsing/listing and every client write remain forbidden.
    match /learning-v2/voice-audio/{allPaths=**} {
      allow get: if request.auth != null;
      allow list: if false;
      allow write: if false;
    }

    // Public, read-only course-pack content (manifest.json, index.json and rows).
    // Same model as the audio buckets: the app fetches
    // these over HTTPS, sha256-verifies them, and disk-caches them so heavy content
    // can be served from the server instead of shipping inside the native binary.
    // Uploaded only by trusted Admin/OAuth tooling that bypasses rules. READ is
    // public because pack content is learning material,
    // not secret; the bundled copy remains the offline fallback.
    match /course-packs/{allPaths=**} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    // Public, read-only collectible card art (one webp per cardId). Same model as
    // the audio buckets: streamed to the app over HTTPS and disk-cached so the
    // ~71 MB of card images no longer ship inside the native binary (compressed to
    // ~13 MB and served on demand; inline SVG is the offline fallback). Uploaded
    // only by scripts/upload_collectible_images_to_storage.mjs (bypasses rules).
    match /collectible-images/{allPaths=**} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    // Public, read-only achievement art (one webp per achievement id). Та же
    // модель, что у collectible-images: стрим по HTTPS + дисковый кэш, чтобы
    // 6.63 MB иконок не ехали в нативный бинарь (сжато до ~3.4 MB и отдаётся по
    // требованию). «Ядро» первых достижений остаётся в бандле и работает офлайн
    // (constants/achievementCoreArt.ts), поэтому заглушка пользователю не видна.
    // Заливает только scripts/upload_achievement_images_to_storage.mjs (в обход правил).
    match /achievement-images/{allPaths=**} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    // Public, read-only avatar aura art (base/flow/accents webp per aura id).
    // Та же модель, что у achievement-images: стрим по HTTPS + дисковый кэш,
    // чтобы 117 слоёв колец (2.5 MB) не ехали в нативный бинарь. Слои заливаются
    // БЕЗ пережатия, байт-в-байт с репозиторием — их sha256 и геометрию 320×320
    // сторожит tests/avatar_aura_v2_assets.test.ts. Ауры подписки (aura-plus /
    // aura-pro) остаются в бандле и работают офлайн
    // (constants/avatar_aura_core_art.ts), поэтому пустого кольца не бывает.
    // Заливает только scripts/upload_avatar_aura_images_to_storage.mjs (в обход правил).
    match /aura-images/{allPaths=**} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    // Default deny for any other path.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
