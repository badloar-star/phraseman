 "instructions": "docs/work/classic_plain_explanation_standard_2026-11-05.md",
 "phrases": [
  {
   "id": "en-classic-r1:16.01",
   "target": "Wake up, Tom.",
   "ru": "Проснись, Том.",
   "uk": "Прокидайся, Томе."
  },
  {
   "id": "en-classic-r1:16.02",
   "target": "I get up at seven.",
   "ru": "Я встаю в семь.",
   "uk": "Я встаю о сьомій."
  },
  {
   "id": "en-classic-r1:16.03",
   "target": "She gets up before six.",
   "ru": "Она встает до шести.",
   "uk": "Вона встає раніше шостої."
  },
  {
   "id": "en-classic-r1:16.04",
   "target": "The children wake up early.",
   "ru": "Дети просыпаются рано.",
   "uk": "Діти прокидаються рано."
  },
  {
   "id": "en-classic-r1:16.05",
   "target": "We set off for the harbour before lunch.",
   "ru": "Мы отправились в порт до обеда.",
   "uk": "Ми вирушили до гавані до обіду."
  },
  {
   "id": "en-classic-r1:16.06",
   "target": "The train pulls in at noon.",
   "ru": "Поезд прибывает в полдень.",
   "uk": "Поїзд прибуває опівдні."
  },
  {
   "id": "en-classic-r1:16.07",
   "target": "Please come in.",
   "ru": "Пожалуйста, войдите.",
   "uk": "Будь ласка, заходьте."
  },
  {
   "id": "en-classic-r1:16.08",
   "target": "Come back after the rehearsal.",
   "ru": "Вернитесь после репетиции.",
   "uk": "Повертайтеся після репетиції."
  },
  {
   "id": "en-classic-r1:16.09",
   "target": "I get on at the station.",
   "ru": "Я сажусь на станции.",
   "uk": "Я сідаю на станції."
  },
  {
   "id": "en-classic-r1:16.10",
   "target": "She gets off at the next stop.",
   "ru": "Она выходит на следующей остановке.",
   "uk": "Вона виходить на наступній зупинці."
  },
  {
   "id": "en-classic-r1:16.11",
   "target": "Turn on the lamp.",
   "ru": "Включите лампу.",
   "uk": "Увімкніть лампу."
  },
  {
   "id": "en-classic-r1:16.12",
   "target": "Turn the oven on.",
   "ru": "Включите духовку.",
   "uk": "Увімкніть духовку."
  },
  {
   "id": "en-classic-r1:16.13",
   "target": "Turn it on.",
   "ru": "Включите её.",
   "uk": "Увімкніть її."
  },
  {
   "id": "en-classic-r1:16.14",
   "target": "Turn off the fan.",
   "ru": "Выключите вентилятор.",
   "uk": "Вимкніть вентилятор."
  },
  {
   "id": "en-classic-r1:16.15",
   "target": "Turn the heater off.",
   "ru": "Выключите обогреватель.",
   "uk": "Вимкніть обігрівач."
  },
  {
   "id": "en-classic-r1:16.16",
   "target": "Turn it off.",
   "ru": "Выключите его.",
   "uk": "Вимкніть його."
  },
  {
   "id": "en-classic-r1:16.17",
   "target": "Pick up the phone.",
   "ru": "Поднимите трубку.",
   "uk": "Візьміть слухавку."
  },
  {
   "id": "en-classic-r1:16.18",
   "target": "Pick it up.",
   "ru": "Возьмите её.",
   "uk": "Візьміть її."
  },
  {
   "id": "en-classic-r1:16.19",
   "target": "Put down the box.",
   "ru": "Поставьте коробку.",
   "uk": "Покладіть коробку."
  },
  {
   "id": "en-classic-r1:16.20",
   "target": "Put it down here.",
   "ru": "Поставьте её сюда.",
   "uk": "Покладіть її сюди."
  },
  {
   "id": "en-classic-r1:16.21",
   "target": "I wrote down the number.",
   "ru": "Я записал номер.",
   "uk": "Я записав номер."
  },
  {
   "id": "en-classic-r1:16.22",
   "target": "She wrote it down.",
   "ru": "Она записала его.",
   "uk": "Вона записала його."
  },
  {
   "id": "en-classic-r1:16.23",
   "target": "We looked up the address.",
   "ru": "Мы поискали адрес.",
   "uk": "Ми пошукали адресу."
  },
  {
   "id": "en-classic-r1:16.24",
   "target": "He looked it up.",
   "ru": "Он это поискал.",
   "uk": "Він це пошукав."
  },
  {
   "id": "en-classic-r1:16.25",
   "target": "They filled in the form.",
   "ru": "Они заполнили форму.",
   "uk": "Вони заповнили форму."
  },
  {
   "id": "en-classic-r1:16.26",
   "target": "I filled it in.",
   "ru": "Я заполнил её.",
   "uk": "Я її заповнив."
  },
  {
   "id": "en-classic-r1:16.27",
   "target": "She handed in the keys.",
   "ru": "Она сдала ключи.",
   "uk": "Вона здала ключі."
  },
  {
   "id": "en-classic-r1:16.28",
   "target": "He handed them in.",
   "ru": "Он сдал их.",
   "uk": "Він їх здав."
  },
  {
   "id": "en-classic-r1:16.29",
   "target": "I tried on the jacket.",
   "ru": "Я примерил куртку.",
   "uk": "Я приміряв куртку."
  },
  {
   "id": "en-classic-r1:16.30",
   "target": "She tried it on.",
   "ru": "Она примерила её.",
   "uk": "Вона приміряла її."
  },
  {
   "id": "en-classic-r1:16.31",
   "target": "I look after my nephew.",
   "ru": "Я присматриваю за своим племянником.",
   "uk": "Я доглядаю за своїм племінником."
  },
  {
   "id": "en-classic-r1:16.32",
   "target": "She looks after the children.",
   "ru": "Она присматривает за детьми.",
   "uk": "Вона доглядає за дітьми."
  },
  {
   "id": "en-classic-r1:16.33",
   "target": "We are looking for a flat.",
   "ru": "Мы ищем квартиру.",
   "uk": "Ми шукаємо квартиру."
  },
  {
   "id": "en-classic-r1:16.34",
   "target": "He looked for his wallet.",
   "ru": "Он искал свой бумажник.",
   "uk": "Він шукав свій гаманець."
  },
  {
   "id": "en-classic-r1:16.35",
   "target": "Can you look after my bag?",
   "ru": "Вы можете присмотреть за моей сумкой?",
   "uk": "Ви можете наглянути за моєю сумкою?"
  },
  {
   "id": "en-classic-r1:16.36",
   "target": "Did you look for it downstairs?",
   "ru": "Ты искал её внизу?",
   "uk": "Ти шукав її внизу?"
  },
  {
   "id": "en-classic-r1:16.37",
   "target": "We ran out of milk.",
   "ru": "У нас закончилось молоко.",
   "uk": "У нас закінчилося молоко."
  },
  {
   "id": "en-classic-r1:16.38",
   "target": "She ran out of paper.",
   "ru": "У неё закончилась бумага.",
   "uk": "У неї закінчився папір."
  },
  {
   "id": "en-classic-r1:16.39",
   "target": "I came across an old photo.",
   "ru": "Я наткнулся на старую фотографию.",
   "uk": "Я натрапив на стару фотографію."
  },
  {
   "id": "en-classic-r1:16.40",
   "target": "He got over his cold.",
   "ru": "Он оправился от простуды.",
   "uk": "Він одужав від застуди."
  },
  {
   "id": "en-classic-r1:16.41",
   "target": "Please take your shoes off.",
   "ru": "Пожалуйста, снимите обувь.",
   "uk": "Будь ласка, зніміть взуття."
  },
  {
   "id": "en-classic-r1:16.42",
   "target": "She put her coat on.",
   "ru": "Она надела пальто.",
   "uk": "Вона одягла пальто."
  },
  {
   "id": "en-classic-r1:16.43",
   "target": "Can you pick me up at six?",
   "ru": "Можешь забрать меня в шесть?",
   "uk": "Можеш заїхати за мною о шостій?"
  },
  {
   "id": "en-classic-r1:16.44",
   "target": "I will drop you off outside.",
   "ru": "Я высажу тебя у входа.",
   "uk": "Я висаджу тебе біля входу."
  },
  {
   "id": "en-classic-r1:16.45",
   "target": "We need to find out the fare.",
   "ru": "Нам нужно узнать стоимость проезда.",
   "uk": "Нам потрібно дізнатися вартість проїзду."
  },
  {
   "id": "en-classic-r1:16.46",
   "target": "She gave the book back.",
   "ru": "Она вернула книгу.",
   "uk": "Вона повернула книгу."
  },
  {
   "id": "en-classic-r1:16.47",
   "target": "Can I give it back tomorrow?",
   "ru": "Могу я вернуть её завтра?",
   "uk": "Чи можу я повернути її завтра?"
  },
  {
   "id": "en-classic-r1:16.48",
   "target": "The meeting went on until lunch.",
   "ru": "Встреча продолжалась до обеда.",
   "uk": "Зустріч тривала до обіду."
  },
  {
   "id": "en-classic-r1:16.49",
   "target": "The alarm went off at five.",
   "ru": "Будильник зазвонил в пять.",
   "uk": "Будильник задзвонив о п'ятій."
  },
  {
   "id": "en-classic-r1:16.50",
   "target": "Please put the milk away.",
   "ru": "Пожалуйста, убери молоко.",
   "uk": "Будь ласка, прибери молоко."
  }
 ],
