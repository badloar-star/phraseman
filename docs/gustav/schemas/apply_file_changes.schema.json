{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phraseman.local/gustav/apply_file_changes.schema.json",
  "title": "GUSTAV Apply File Changes",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceRunId", "approvalStatus", "files"],
  "properties": {
    "schemaVersion": { "const": "gustav-apply-file-changes-v0" },
    "sourceRunId": { "type": "string", "minLength": 1 },
    "approvalStatus": { "enum": ["not_requested", "approved", "rejected"] },
    "approvedBy": { "type": "string" },
    "approvedAt": { "type": "string" },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "action",
          "reason",
          "sourceArtifactPath",
          "ownerArea",
          "risk",
          "testsRequired",
          "rollbackAction"
        ],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "action": { "enum": ["add", "modify", "delete"] },
          "reason": { "type": "string", "minLength": 1 },
          "sourceArtifactPath": { "type": "string", "minLength": 1 },
          "ownerArea": {
            "enum": [
              "course",
              "quiz",
              "source_locale",
              "study_target",
              "trainer",
              "personal_practice",
              "storage",
              "ui",
              "heisenberg",
              "tests",
              "admin",
              "unknown"
            ]
          },
          "risk": { "enum": ["low", "medium", "high", "blocker"] },
          "testsRequired": {
            "type": "array",
            "items": { "type": "string" }
          },
          "rollbackAction": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
