+test('spire step-v2 and legacy records are both scrubbed idempotently before membership removal', async () => {
+  const { db, store } = makeDb({
+    spire_groups: { g1: { liveMemberCount: 2, members: { [STABLE]: { name: 'Аня' }, other: { name: 'Bob' } } } },
+    spire_floor_records: {
+      g1: {
+        records: { 1: { uid: STABLE, durationMs: 900 }, 2: { uid: 'other', durationMs: 1200 } },
+        personal: { [STABLE]: { 1: { uid: STABLE, durationMs: 900 } }, other: { 2: { uid: 'other', durationMs: 1200 } } },
+      },
+      'step-v2_g1': {
+        version: 'step-record-v2',
+        participantUids: [STABLE, 'other'],
+        records: { '1:1': { uid: STABLE, durationMs: 700 }, '1:2': { uid: 'other', durationMs: 800 } },
+        personal: { [STABLE]: { '1:1': { uid: STABLE, durationMs: 700 } }, other: { '1:2': { uid: 'other', durationMs: 800 } } },
+      },
+    },
+  });
+
+  await removeFromSpireGroups(db, STABLE, stats());
+  await removeFromSpireGroups(db, STABLE, stats());
+
+  const legacy = store.spire_floor_records.get('g1')!;
+  expect(legacy.records).toEqual({ 2: { uid: 'other', durationMs: 1200 } });
+  expect(legacy.personal).toEqual({ other: { 2: { uid: 'other', durationMs: 1200 } } });
+  const stepV2 = store.spire_floor_records.get('step-v2_g1')!;
+  expect(stepV2.records).toEqual({ '1:2': { uid: 'other', durationMs: 800 } });
+  expect(stepV2.personal).toEqual({ other: { '1:2': { uid: 'other', durationMs: 800 } } });
+  expect(stepV2.participantUids).toEqual(['other']);
+  expect(JSON.stringify([legacy, stepV2])).not.toContain(STABLE);
+  expect(store.spire_groups.get('g1')!.liveMemberCount).toBe(1);
+});
+
