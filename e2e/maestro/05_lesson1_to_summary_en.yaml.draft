appId: app.phraseman
---
- runFlow: _prelude_home_en.yaml
- tapOn:
    text: "Start|Continue lesson 1"
- extendedWaitUntil:
    visible: "Start from the beginning|Continue"
    timeout: 40000
- tapOn:
    text: "Start from the beginning|Continue"
- repeat:
    times: 90
    commands:
      - runFlow:
          when:
            visible:
              id: "lesson1-next"
          commands:
            - tapOn:
                id: "lesson1-next"
      - runFlow:
          when:
            visible:
              id: "lesson1-word-option-correct"
          commands:
            - tapOn:
                id: "lesson1-word-option-correct"
      - runFlow:
          when:
            visible: "Tap to see more"
          commands:
            - tapOn: "Tap to see more"
      - runFlow:
          when:
            visible:
              id: "lesson1-check"
          commands:
            - tapOn:
                id: "lesson1-check"
      - runFlow:
          when:
            visible:
              id: "lesson1-typed-input"
          commands:
            - copyTextFrom:
                id: "lesson1-expected-answer"
            - tapOn:
                id: "lesson1-typed-input"
            - inputText: ${maestro.copiedText}
            - pressKey: Enter
      - waitForAnimationToEnd:
          timeout: 2000
