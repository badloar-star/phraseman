                'lesson_progress_v2::fr::79',
                'lesson_progress_v2::fr::lesson79_best_score',
                'lesson_progress_v2::fr::lesson79_pass_count',
                'lesson_progress_v2::fr::lesson79_progress',
                'lesson_progress_v2::fr::lesson79_cellIndex',
                'lesson80_best_score',
                'lesson80_pass_count',
                'lesson80_progress',
                'lesson80_cellIndex',
                'lesson_progress_v2::fr::80',
                'lesson_progress_v2::fr::lesson80_best_score',
                'lesson_progress_v2::fr::lesson80_pass_count',
                'lesson_progress_v2::fr::lesson80_progress',
                'lesson_progress_v2::fr::lesson80_cellIndex',
                // Server-authoritative level exams: English legacy keys and French scoped keys.
                'level_exam_A1_pct',
                'level_exams_v2::fr::level_exam_A1_pct',
                'level_exam_A1_best_pct',
                'level_exams_v2::fr::level_exam_A1_best_pct',
                'level_exam_A1_passed',
                'level_exams_v2::fr::level_exam_A1_passed',
                'level_exam_A1_pass_count',
                'level_exams_v2::fr::level_exam_A1_pass_count',
                'level_exam_A1_completed_at',
                'level_exams_v2::fr::level_exam_A1_completed_at',
                'level_exam_A2_pct',
                'level_exams_v2::fr::level_exam_A2_pct',
                'level_exam_A2_best_pct',
                'level_exams_v2::fr::level_exam_A2_best_pct',
                'level_exam_A2_passed',
                'level_exams_v2::fr::level_exam_A2_passed',
                'level_exam_A2_pass_count',
                'level_exams_v2::fr::level_exam_A2_pass_count',
                'level_exam_A2_completed_at',
                'level_exams_v2::fr::level_exam_A2_completed_at',
                'level_exam_B1_pct',
                'level_exams_v2::fr::level_exam_B1_pct',
                'level_exam_B1_best_pct',
                'level_exams_v2::fr::level_exam_B1_best_pct',
                'level_exam_B1_passed',
                'level_exams_v2::fr::level_exam_B1_passed',
                'level_exam_B1_pass_count',
                'level_exams_v2::fr::level_exam_B1_pass_count',
                'level_exam_B1_completed_at',
                'level_exams_v2::fr::level_exam_B1_completed_at',
                'level_exam_B2_pct',
                'level_exams_v2::fr::level_exam_B2_pct',
                'level_exam_B2_best_pct',
                'level_exams_v2::fr::level_exam_B2_best_pct',
                'level_exam_B2_passed',
                'level_exams_v2::fr::level_exam_B2_passed',
                'level_exam_B2_pass_count',
                'level_exams_v2::fr::level_exam_B2_pass_count',
                'level_exam_B2_completed_at',
                'level_exams_v2::fr::level_exam_B2_completed_at',
                'level_exam_C1_pct',
                'level_exams_v2::fr::level_exam_C1_pct',
                'level_exam_C1_best_pct',
                'level_exams_v2::fr::level_exam_C1_best_pct',
                'level_exam_C1_passed',
                'level_exams_v2::fr::level_exam_C1_passed',
                'level_exam_C1_pass_count',
                'level_exams_v2::fr::level_exam_C1_pass_count',
                'level_exam_C1_completed_at',
                'level_exams_v2::fr::level_exam_C1_completed_at',
                'level_exam_C2_pct',
                'level_exams_v2::fr::level_exam_C2_pct',
                'level_exam_C2_best_pct',
                'level_exams_v2::fr::level_exam_C2_best_pct',
                'level_exam_C2_passed',
                'level_exams_v2::fr::level_exam_C2_passed',
                'level_exam_C2_pass_count',
                'level_exams_v2::fr::level_exam_C2_pass_count',
                'level_exam_C2_completed_at',
                'level_exams_v2::fr::level_exam_C2_completed_at',
                'level_exam_final_pct',
                'level_exams_v2::fr::level_exam_final_pct',
                'level_exam_final_best_pct',
                'level_exams_v2::fr::level_exam_final_best_pct',
                'level_exam_final_passed',
                'level_exams_v2::fr::level_exam_final_passed',
                'level_exam_final_pass_count',
                'level_exams_v2::fr::level_exam_final_pass_count',
                'level_exam_final_completed_at',
                'level_exams_v2::fr::level_exam_final_completed_at',
              ]);
    }

    function newUserDocOwnerMatchesAuth(userId) {
      return isAdmin()
        || isOwner(userId)
        || (
          request.auth != null
          && !exists(/databases/$(database)/documents/account_deletion_auth_markers/$(request.auth.uid))
          && request.resource.data.keys().hasAny(['firebaseAuthUid'])
          && request.resource.data.firebaseAuthUid is string
          && request.resource.data.firebaseAuthUid == request.auth.uid
        );
    }

    // Create-вариант premium-гарда. На create нет resource (старого документа), поэтому
    // diff невозможен — проверяем НАЛИЧИЕ запрещённых ключей в самом новом progress.
    // Закрывает дыру: раньше allow create не звал premium-гард, и кастомный клиент мог
    // при ПЕРВОМ создании users/{id} сразу вписать vip_until/premium_plan и выдать себе
    // доступ (легальный клиент эти поля в progress не пишет — cloud_sync.ts вырезает
    // PREMIUM_PROGRESS_KEYS из исходящего патча, см. строку ~1379).
    function newDocHasNoPremiumWrites() {
      return isAdmin()
        || !request.resource.data.get('progress', {})
              .keys().hasAny(blockedPremiumProgressKeys());
    }

    // â”€â”€ Referral: Ð·Ð°Ð¿Ð¸ÑÑŒ Ñ‚Ð¾Ð»ÑŒÐºÐ¾ CF; Ñ‡Ñ‚ÐµÐ½Ð¸Ðµ â€” Ð¿Ð°Ð½ÐµÐ»ÑŒ admin (custom claim admin) â”€
    match /referral_codes/{code} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /referral_owners/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // Чтение клиентом — только через callable referralListMyInvites (CF проверяет auth_links).
    // Прямой клиентский read закрыт; запись — только Admin SDK (referralApply/referralClaimVipReward).
    match /referral_attributions/{id} {
      allow read: if isAdmin();
      allow update: if isAdmin();
      allow create, delete: if false;
    }

    // â”€â”€ User data â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    // ÐšÐ¾Ñ€Ð½ÐµÐ²Ð¾Ð¹ users/{userId}: Ñ‚Ð¾Ð»ÑŒÐºÐ¾ Ð²Ð»Ð°Ð´ÐµÐ»ÐµÑ†/Ð°Ð´Ð¼Ð¸Ð½. ÐŸÐ¾Ð´Ð´ÐµÑ€Ð¶Ð¸Ð²Ð°ÐµÐ¼ Ð¾Ð±Ðµ ÑÑ…ÐµÐ¼Ñ‹:
    //  - userId == request.auth.uid
    //  - stableId-Ð´Ð¾ÐºÑƒÐ¼ÐµÐ½Ñ‚ Ñ Ð¿Ð¾Ð»ÐµÐ¼ firebaseAuthUid == request.auth.uid
    // ÐœÐ¾Ð´ÐµÑ€Ð°Ñ†Ð¸Ñ/Ð±Ð°Ð½/Ñ€ÐµÐ¿Ð¾Ñ€Ñ‚Ñ‹: Ñ‚Ð¾Ð»ÑŒÐºÐ¾ isAdmin() (ÑÐ¼. admin/index.html, email+claim).
    match /account_deletion_tombstones/{userId} {
      allow read, write: if false;
    }

    match /account_deletion_auth_markers/{authUid} {
      allow read: if request.auth != null && request.auth.uid == authUid;
      allow write: if false;
    }

    // Recovery secrets, rate-limit state, and audit events are server-only.
    // Cloud Functions use the Admin SDK, which bypasses Firestore Rules.
    match /auth_recovery_codes/{document=**} {
      allow read, write: if false;
    }

    match /auth_recovery_rate_limits/{document=**} {
      allow read, write: if false;
    }

    match /auth_recovery_events/{document=**} {
      allow read, write: if false;
    }

    match /auth_recovery_challenges/{document=**} {
      allow read, write: if false;
    }

    match /auth_recovery_delivery_intents/{document=**} {
      allow read, write: if false;
    }

    match /auth_recovery_idempotency/{document=**} {
      allow read, write: if false;
    }

    match /auth_recovery_clean_rate_limits/{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      // read: владелец/админ ИЛИ документа ещё нет (пустое чтение безопасно и
      // не валит клиентскую транзакцию входа на новом localStableId — см.
      // userDocMissing выше). delete остаётся строго для владельца/админа.
      allow read: if userDocOwnerMatchesAuth(userId) || userDocMissing(userId);
      allow delete: if userDocOwnerMatchesAuth(userId) && userDocHasNoServerIdentity();
      // Клиент может обновлять свой документ, но не может трогать premium/VIP поля
      // и баланс осколков (shards). Их пишет только Admin SDK через Cloud Functions.
      allow update: if userDocOwnerMatchesAuth(userId)
        && accountDeletionNotPending(userId)
        && hasNoServerIdentityWrites()
        && progressHasNoPremiumWrites()
        && hasNoShardWrites()
        && hasNoProgressAuthorityMarkerWrites();
      allow create: if newUserDocOwnerMatchesAuth(userId)
        && accountDeletionNotPending(userId)
        && newDocHasNoServerIdentityWrites()
        && newDocHasNoPremiumWrites()
        && newDocHasNoShardWrites()
        && newDocHasNoServerScoreWrites()
        && newDocHasNoProgressAuthorityMarkerWrites();

      match /community_seller_inbox/{eventId} {
        allow read, write: if false;
      }

      // Durable roulette credits and the server-owned migration marker are
      // written only by Cloud Functions through Admin SDK. Clients consume the
      // callable projection instead of reading or mutating ledger documents.
      match /referral_spin_credit_ledger/{creditId} {
        allow read: if false;
        allow create, update, delete: if false;
      }

      // Инбокс решений по идеям. Создаёт только сервер (adminDecideUserIdea, Admin SDK).
      // Владелец читает свои решения (приложение показывает модалку на старте) и может
      // пометить seen — но не создавать/удалять и не подменять текст/решение.
      match /idea_inbox/{eventId} {
        allow read: if userDocOwnerMatchesAuth(userId);
        allow update: if userDocOwnerMatchesAuth(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen', 'seenAt']);
        allow create, delete: if false;
      }

      match /shard_log/{logId} {
        allow read, create: if userDocOwnerMatchesAuth(userId);
        allow update, delete: if false;
      }

      match /reward_claims/{claimId} {
        allow read, create: if userDocOwnerMatchesAuth(userId);
        allow update, delete: if false;
      }

      match /tournament_receipts/{receiptId} {
        allow read: if userDocOwnerMatchesAuth(userId);
        allow write: if false;
      }

      // Idempotency receipts for shardsApplyDelta are written only by Admin SDK.
      // Clients must not pre-create a receipt to bypass a spend operation.
      match /shard_operation_receipts/{opId} {
        allow read, write: if false;
      }

      // UTC-day anti-farm budgets for shardsApplyDelta. Admin SDK only.
      match /shard_earn_daily_counters/{dayKey} {
        allow read, write: if false;
      }

      // Append-only журнал V2 access-звёзд (биржа монет→звёзд). Только Admin SDK.
      match /v2_star_journal/{entryId} {
        allow read, write: if false;
      }

      // Маркеры активации промокодов. Пишет ТОЛЬКО сервер (promoCodeRedeem, Admin SDK).
      // Владелец может прочитать (приложение видит, что код уже активирован), но не
      // создавать/менять — иначе обход «один код на юзера» и самовыдача премиума.
      match /promo_redemptions/{code} {
        allow read: if userDocOwnerMatchesAuth(userId);
        allow create, update, delete: if false;
      }

      match /app_message_states/{messageId} {
        allow read, create, update, delete: if userDocOwnerMatchesAuth(userId);
      }

      // Персональные сообщения (ответы на репорты с наградой к клейму). Пишет ТОЛЬКО
      // сервер: adminReplyToReport создаёт, claimReportReward переключает claimed —
      // открытая клиентская запись позволила бы накрутить shards повторным клеймом.
      match /user_messages/{messageId} {
        allow read: if userDocOwnerMatchesAuth(userId);
        allow create, update, delete: if false;
      }

      match /shard_rewards/{rewardId} {
        allow read:   if userDocOwnerMatchesAuth(userId);
        allow update: if userDocOwnerMatchesAuth(userId) && request.resource.data.seen == true;
        // Реальные награды (friend_gift и пр.) пишет только Admin SDK из CF в обход rules.
        // Клиенту разрешена лишь QA-симуляция с обязательной меткой qa == true —
        // UI помечает такие записи «(QA)», подделать «настоящий» подарок себе нельзя.
        allow create: if userDocOwnerMatchesAuth(userId) && request.resource.data.qa == true;
        allow delete: if false;
      }

      match /league_week_results/{weekId} {
        // Пишет только leagueFinalizeCron (Admin SDK, в обход rules).
        // Клиент читает чтобы показать честный итог недели вместо локального пересчёта.
        allow read:   if userDocOwnerMatchesAuth(userId);
        allow write:  if false;
      }
    }

    // â”€â”€ Arena profiles â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /arena_profiles/{userId} {
      allow read, write: if false;

      match /match_history/{matchId} {
        allow read, write: if false;
      }
    }

    // â”€â”€ Leaderboard â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /leaderboard/{userId} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin();
      allow delete: if userDocOwnerMatchesAuth(userId);
    }

    // Top Helpers board projection. Written ONLY by Cloud Function adminReplyToReport
    // and scripts/reply_to_reports.mjs (Admin SDK) when a report is confirmed; clients
    // read the top-10 (same read policy as leaderboard). No client writes (anti-cheat).
    match /top_helpers/{userId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /public_profiles/{userId} {
      allow read: if request.auth != null;
      allow create, update: if canonicalUserMatchesAuth(userId);
      allow delete: if userDocOwnerMatchesAuth(userId);
    }

    // Public aggregate percentile thresholds written by Cloud Functions.
    match /leaderboard_stats/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Friend activity likes: server-owned writes, client-readable counters.
    match /users/{userId}/friend_activity_like_daily_limits/{dayId} {
      allow read: if canonicalUserMatchesAuth(userId);
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId}/activity_like_stats/{docId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId}/activity_likes_received/{likeId} {
      allow read: if canonicalUserMatchesAuth(userId);
      allow create, update, delete: if isAdmin();
    }

    // Единый центр событий (колокольчик на главной): пишут только cloud functions.
    // Владелец читает, помечает прочитанным (только read/readAt/updatedAt) и удаляет.
    match /users/{userId}/notifications/{notificationId} {
      allow read: if canonicalUserMatchesAuth(userId);
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        canonicalUserMatchesAuth(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt', 'updatedAt'])
      );
      allow delete: if isAdmin() || canonicalUserMatchesAuth(userId);
    }

    // â”€â”€ Banned users â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    // Legacy/bundled flashcard marketplace metadata. Clients query only
    // published packs; writes stay server/admin-only.
    match /card_packs/{packId} {
      allow read: if isAdmin() || resource.data.status == 'published';
      allow create, update, delete: if isAdmin();
    }

    match /banned_users/{docId} {
      allow read:  if isAdmin() || (request.auth != null && request.auth.uid == docId);
      allow write: if isAdmin();
    }

    // â”€â”€ Admin config (alerts settings, admin-only) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    // admin_config/alerts holds Telegram alert settings (chatId, enabled, types).
    // Read/write only by admin from the panel. The alert Cloud Functions use the
    // Admin SDK (bypasses rules) to read config and write bookkeeping fields.
    match /admin_config/{docId} {
      allow read, write: if isAdmin();
    }

    // Remote Config changelog — admin-only audit trail of config saves.
    match /remote_config_history/{docId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // â”€â”€ User warnings â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /user_warnings/{docId} {
      allow read:   if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // â”€â”€ User reports (Ð¶Ð°Ð»Ð¾Ð±Ñ‹ Ð½Ð° Ð´Ñ€ÑƒÐ³Ð¸Ñ… Ð¿Ð¾Ð»ÑŒÐ·Ð¾Ð²Ð°Ñ‚ÐµÐ»ÐµÐ¹) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /user_reports/{docId} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    // ── AI safety flags (self-harm/suicide/abuse detected in AI dialogue) ──
    // Пишет ТОЛЬКО сервер (Admin SDK обходит правила); читать/обрабатывать — только admin.
    match /safety_flags/{docId} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    // ── Возраст + согласия (для accountability/учёта в админке) ──
    // Документ ключуется stableId; владелец (его authUid привязан к users/{stableId})
    // может писать свой; читать агрегаты — только admin.
    match /user_consents/{userId} {
      allow read: if isAdmin() || isOwner(userId) || stableUserMatchesAuth(userId);
      allow write: if isOwner(userId) || stableUserMatchesAuth(userId);
    }

    // â”€â”€ Community pack reports (UGC content moderation, Apple Guideline 1.2) â”€â”€
    // Ð›ÑŽÐ±Ð¾Ð¹ Ð°Ð²Ñ‚Ð¾Ñ€Ð¸Ð·Ð¾Ð²Ð°Ð½Ð½Ñ‹Ð¹ ÑŽÐ·ÐµÑ€ Ð¼Ð¾Ð¶ÐµÑ‚ Ð¿Ð¾Ð¶Ð°Ð»Ð¾Ð²Ð°Ñ‚ÑŒÑÑ Ð½Ð° community-Ð¿Ð°Ðº;
    // Ñ‡Ð¸Ñ‚Ð°Ñ‚ÑŒ/Ð¼Ð¾Ð´ÐµÑ€Ð¸Ñ€Ð¾Ð²Ð°Ñ‚ÑŒ â€” Ñ‚Ð¾Ð»ÑŒÐºÐ¾ admin (Ñ‡ÐµÑ€ÐµÐ· admin/index.html â†’ custom claim).
    match /community_pack_reports/{docId} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    // â”€â”€ Error reports (Ð±Ð°Ð³-Ñ€ÐµÐ¿Ð¾Ñ€Ñ‚Ñ‹) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /error_reports/{docId} {
      allow create: if isAdmin();
      allow read, update, delete: if isAdmin();
    }

    match /app_errors/{docId} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    match /app_activity/{docId} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    match /subscription_cancel_surveys/{docId} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    match /website_contact_inbox/{docId} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    match /website_contact_rate_limits/{docId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /site_stats/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /site_stats_rate_limits/{docId} {
      allow read, delete: if isAdmin();
      allow create, update: if false;
    }

    // Website checkout admin surface (admin/site.html). The public /start/
    // paywall reads prices through the webPrices Cloud Function; browser writes
    // are admin-only.
    match /web_checkout/{docId} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }

    match /web_premium_orders/{orderId} {
      allow read, update: if isAdmin();
      allow create, delete: if false;
    }

    match /email_contacts/{docId} {
      allow read, update, delete: if isAdmin();
      allow create: if false;
    }

    match /email_campaigns/{docId} {
      allow read, update, delete: if isAdmin();
      allow create: if false;
    }

    match /client_report_rate_limits/{docId} {
      allow read, create, update, delete: if isAdmin();
    }

    // User ideas: created only via submitUserIdea (Admin SDK), moderated by admin.
    match /user_ideas/{docId} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    match /user_idea_rate_limits/{docId} {
      allow read, create, update, delete: if isAdmin();
    }

    // â”€â”€ Ð“Ð»Ð¾Ð±Ð°Ð»ÑŒÐ½Ñ‹Ðµ Ð¾Ð´Ð½Ð¾Ñ€Ð°Ð·Ð¾Ð²Ñ‹Ðµ Ð¼Ð¾Ð´Ð°Ð»ÐºÐ¸ (Ð°Ð´Ð¼Ð¸Ð½-Ñ€Ð°ÑÑÑ‹Ð»ÐºÐ° Ð´Ð»Ñ Ð²ÑÐµÑ… Ð¿Ð¾Ð»ÑŒÐ·Ð¾Ð²Ð°Ñ‚ÐµÐ»ÐµÐ¹) â”€â”€
    match /global_broadcast_modals/{docId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    function appMessagePollVoteOk(messageId, userId) {
      let message = get(/databases/$(database)/documents/app_messages/$(messageId)).data;
      return userDocOwnerMatchesAuth(userId)
        && message.active == true
        && (!message.keys().hasAny(['expiresAtMs']) || message.expiresAtMs > request.time.toMillis())
        && message.keys().hasAny(['poll'])
        && message.poll is map
        && message.poll.keys().hasAny(['optionIds'])
        && message.poll.optionIds is list
        && request.resource.data.keys().hasOnly(['messageId', 'userId', 'optionId', 'updatedAtMs'])
        && request.resource.data.messageId == messageId
        && request.resource.data.userId == userId
        && request.resource.data.optionId is string
        && request.resource.data.optionId in message.poll.optionIds
        && (request.resource.data.updatedAtMs is int || request.resource.data.updatedAtMs is float)
        && request.resource.data.updatedAtMs > 0
        && request.resource.data.updatedAtMs < 10000000000000;
    }

    // Remote Config: admin-tuned runtime flags (limits, energy, A/B split).
    // Read by any signed-in client (remote_config_client.ts); written only from
    // the admin panel (custom claim admin). Docs: `app`, `paywall_ab`.
    match /remote_config/{docId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // Воронка пейвол-эксперимента (app/paywall_funnel.ts → admin/paywall_ab.html).
    // Клиент только создаёт компактные события фиксированной формы; читает админ.
    match /paywall_funnel/{docId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['step', 'variant', 'context', 'plan', 'obColor', 'price', 'day', 'ts', 'uidh', 'dev', 'expireAt'])
        && request.resource.data.step in ['shown', 'cta_click', 'trial_started', 'purchase_completed', 'purchase_failed', 'purchase_cancelled', 'restore_completed', 'close']
        && request.resource.data.variant in ['v1', 'v2', 'A', 'B', 'C', 'D', 'E', 'F', 'G']
        && request.resource.data.context is string
        && request.resource.data.context.size() <= 40
        && (request.resource.data.plan == null || request.resource.data.plan in ['monthly', 'yearly', 'lifetime'])
        && (request.resource.data.obColor == null || request.resource.data.obColor in ['blue', 'green', 'main'])
        && (request.resource.data.price == null || (request.resource.data.price is string && request.resource.data.price.size() <= 24))
        && request.resource.data.day is string
        && request.resource.data.day.size() == 10
        && (request.resource.data.ts is int || request.resource.data.ts is float)
        && request.resource.data.uidh is string
        && request.resource.data.uidh.size() <= 16
        && request.resource.data.dev is bool;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /app_messages/{messageId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();

      match /reactions/{userId} {
        allow read: if isAdmin();
        allow create, update: if userDocOwnerMatchesAuth(userId)
          && request.resource.data.keys().hasOnly(['messageId', 'userId', 'reaction', 'updatedAtMs'])
          && request.resource.data.messageId == messageId
          && request.resource.data.userId == userId
          && request.resource.data.reaction in ['like', 'dislike'];
        allow delete: if isAdmin() || userDocOwnerMatchesAuth(userId);
      }

      match /poll_votes/{userId} {
        allow read: if isAdmin();
        allow create, update: if appMessagePollVoteOk(messageId, userId);
        allow delete: if isAdmin() || userDocOwnerMatchesAuth(userId);
      }

      match /fixed_poll_votes/{userId} {
        allow read: if isAdmin();
        allow create, update, delete: if false;
      }
    }

    match /review_promo_claims/{docId} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    match /vip_survey_responses/{userId} {
      allow read: if isAdmin() || userDocOwnerMatchesAuth(userId);
      allow create, update, delete: if isAdmin();
    }

    // Опросы за осколки (shard-survey). Все записи идут через callable (Admin SDK
    // обходит rules); прямой клиентский доступ запрещён. Админка читает конфиги/
    // ответы/агрегаты напрямую под isAdmin(). Rate-limits — только сервер.
    match /shard_surveys/{surveyId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /shard_survey_responses/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /shard_survey_stats/{surveyId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /shard_survey_rate_limits/{uid} {
      allow read, write: if false;
    }

    match /daily_phrases/{phraseId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    match /daily_phrase_save_counts/{phraseId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    match /daily_phrase_saves/{saveId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // â”€â”€ Arena sessions â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /arena_sessions/{sessionId} {
      allow read, write: if false;
    }

    // â”€â”€ Session players â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /session_players/{docId} {
      allow read, write: if false;
    }

    // â”€â”€ Arena rooms (friend invite flow) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /arena_rooms/{roomId} {
      allow read, write: if false;
    }

    // â”€â”€ Arena invites (legacy friend-invite docs) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    // Ð Ð°Ð·Ñ€ÐµÑˆÐ°ÐµÐ¼ Ñ‚Ð¾Ð»ÑŒÐºÐ¾ ÑÐ¼ÐµÐ½Ñƒ ÑÑ‚Ð°Ñ‚ÑƒÑÐ° Ð¸ Ñ‚Ð¾Ð»ÑŒÐºÐ¾ ÑƒÑ‡Ð°ÑÑ‚Ð½Ð¸ÐºÐ°Ð¼ Ð¸Ð½Ð²Ð°Ð¹Ñ‚Ð°.
    match /arena_invites/{inviteId} {
      allow read, write: if false;
    }

    // â”€â”€ Arena computed per-user match results â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /arena_session_results/{resultId} {
      allow read, write: if false;
    }

    // â”€â”€ Matchmaking queue â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    // Ð¢Ð¾Ð»ÑŒÐºÐ¾ Ð¿Ð¾Ð»Ñ Ð¾Ñ‡ÐµÑ€ÐµÐ´Ð¸: Ð±ÐµÐ· sessionId/matchedAt (Ð¸Ñ… Ð¿Ð¸ÑˆÐµÑ‚ Ñ‚Ð¾Ð»ÑŒÐºÐ¾ CF).
    // Ð”Ð¾ÐºÑƒÐ¼ÐµÐ½Ñ‚: matchmaking_queue/{userId} â€” id ÑÐ¾Ð²Ð¿Ð°Ð´Ð°ÐµÑ‚ Ñ userId.
    function matchmakingQueueDocOk(entryId) {
      let d = request.resource.data;
      return d.userId is string
        && d.userId == request.auth.uid
        && entryId == d.userId
        // RN/JS ÑˆÐ»Ñ‘Ñ‚ Ñ‡Ð°ÑÑ‚Ð¾ double; ÐºÐ°Ðº joinedAt â€” Ð¿Ñ€Ð¸Ð½Ð¸Ð¼Ð°ÐµÐ¼ int | float.
        && (d.size is int || d.size is float)
        && (d.size == 2 || d.size == 4)
        // ÐšÐ»Ð¸ÐµÐ½Ñ‚ (RN/JS) Ñ‡Ð°ÑÑ‚Ð¾ ÑˆÐ»Ñ‘Ñ‚ millis ÐºÐ°Ðº number/double â€” ÑÑ‚Ñ€Ð¾Ð³Ð¸Ð¹ is int Ð»Ð¾Ð¼Ð°Ð» join.
        && (d.joinedAt is int || d.joinedAt is float)
        && d.joinedAt > 0
        && d.joinedAt < 10000000000000
        && d.rankTier is string
        && d.keys().hasOnly([
          'userId', 'rankTier', 'size', 'joinedAt',
          'rankIndex', 'searchRange', 'expoPushToken', 'displayName'
        ])
        && (!('rankIndex' in d) || ((d.rankIndex is int || d.rankIndex is float) && d.rankIndex >= 0 && d.rankIndex <= 23))
        && (!('searchRange' in d) || ((d.searchRange is int || d.searchRange is float) && d.searchRange >= 1 && d.searchRange <= 8))
        && (!('expoPushToken' in d) || d.expoPushToken is string)
        && (!('displayName' in d) || d.displayName is string);
    }

    match /matchmaking_queue/{entryId} {
      allow read, write: if false;
    }

    match /arena_questions/{qId} {
      allow read, write: if false;
    }

    // Retired Arena server-owned collections remain sealed while historical
    // records are retained for account-deletion cleanup and audit continuity.
    match /arena_question_history/{userId} {
      allow read, write: if false;
    }

    match /arena_question_pool_publications/{publicationId} {
      allow read, write: if false;
    }

    match /arena_hill_player_wins/{winId} {
      allow read, write: if false;
    }

    match /arena_hill_throne_rewards/{dayKey} {
      allow read, write: if false;
    }


    // â”€â”€ Name index (unique nickname reservation) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /name_index/{nameKey} {
      allow read:  if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // Friend code reverse index. Doc id = 6-char code; data = { uid, createdAt }.
    match /friend_code_index/{code} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // Friend requests: users/{targetUid}/friend_requests/{senderUid}.
    match /users/{targetUid}/friend_requests/{senderUid} {
      allow read: if canonicalUserMatchesAuth(targetUid) || canonicalUserMatchesAuth(senderUid);
      allow create: if request.auth != null
        && canonicalUserMatchesAuth(senderUid)
        && targetUid != senderUid
        && !exists(/databases/$(database)/documents/banned_users/$(senderUid))
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is number
        && (!request.resource.data.keys().hasAny(['fromName'])
          || (request.resource.data.fromName is string
            && request.resource.data.fromName.size() > 0
            && request.resource.data.fromName.size() <= 40));
      allow update: if canonicalUserMatchesAuth(targetUid)
        && request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['accepted', 'declined'];
      allow delete: if canonicalUserMatchesAuth(targetUid) || canonicalUserMatchesAuth(senderUid);
    }

    // Friends list: users/{ownerUid}/friends/{friendUid}.
    // Read is scoped to the list owner OR the friend named in the doc (whose id is
    // their own uid) — the latter keeps legitimate reverse-edge reads
    // users/{friendUid}/friends/{myUid} working (friend-list dedupe/repair, arena
    // invites). A blanket `request.auth != null` here let ANY signed-in user
    // enumerate every user's whole social graph + friend display names (IDOR).
    match /users/{ownerUid}/friends/{friendUid} {
      allow read: if canonicalUserMatchesAuth(ownerUid)
        || canonicalUserMatchesAuth(friendUid)
        || isAdmin();
      allow create: if request.auth != null && ownerUid != friendUid && (
        canonicalUserMatchesAuth(ownerUid) ||
        (canonicalUserMatchesAuth(friendUid) &&
         exists(/databases/$(database)/documents/users/$(friendUid)/friend_requests/$(ownerUid)) &&
         get(/databases/$(database)/documents/users/$(friendUid)/friend_requests/$(ownerUid)).data.status in ['pending', 'accepted'])
      );
      allow update: if false;
      allow delete: if canonicalUserMatchesAuth(ownerUid) || canonicalUserMatchesAuth(friendUid);
    }

    // Reverse auth-edge so a friend can be addressed inside rules by their AUTH uid.
    // Firestore rules cannot map request.auth.uid -> the requester's stableId (no reverse
    // index), so a friend reading users/{owner}/my_events cannot be verified directly.
    // Fix: the READER self-registers users/{ownerUid}/friend_auth_edges/{readerAuthUid}
    // before reading the feed. The create-gate proves all three of:
    //   (a) request.auth.uid == readerAuthUid        — you can only register yourself;
    //   (b) the reader truly owns the claimed stableId (forward firebaseAuthUid check);
    //   (c) the owner->reader friendship edge exists  — they really are friends
    //       (that edge can only have been created via the validated accept flow above).
    // readerStableId is supplied in the doc body so the rule can name the friendship edge.
    match /users/{ownerUid}/friend_auth_edges/{readerAuthUid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == readerAuthUid
        && request.resource.data.readerStableId is string
        && exists(/databases/$(database)/documents/users/$(request.resource.data.readerStableId))
        && get(/databases/$(database)/documents/users/$(request.resource.data.readerStableId)).data.firebaseAuthUid == request.auth.uid
        && exists(/databases/$(database)/documents/users/$(ownerUid)/friends/$(request.resource.data.readerStableId));
      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid == readerAuthUid;
    }

    // Friend activity feed: users/{stableUid}/my_events/{eventId}.
    // Readable by: the owner, an admin, or a confirmed friend (via friend_auth_edges above).
    match /users/{userId}/my_events/{eventId} {
      allow read: if canonicalUserMatchesAuth(userId)
        || isAdmin()
        || (request.auth != null
            && exists(/databases/$(database)/documents/users/$(userId)/friend_auth_edges/$(request.auth.uid)));
      allow create, update, delete: if isAdmin();
    }

    // Fan-out лента активности (пишет ТОЛЬКО сервер, feed_fanout.ts; Admin SDK rules обходит).
    match /users/{userId}/feed/{eventId} {
      allow read: if canonicalUserMatchesAuth(userId) || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Лог спинов рулетки Plus (пишет ТОЛЬКО сервер, referral_spin.ts).
    match /users/{userId}/referral_spins/{spinId} {
      allow read: if canonicalUserMatchesAuth(userId) || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // â”€â”€ League / clubs (Ð½ÐµÐ´ÐµÐ»ÑŒÐ½Ñ‹Ðµ Ð¼Ð¸Ð½Ð¸-Ð³Ñ€ÑƒÐ¿Ð¿Ñ‹) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    // ÐšÐ»Ð¸ÐµÐ½Ñ‚: ÐºÐ°Ðº leaderboard â€” Ð²Ð¾ÑˆÐµÐ´ÑˆÐ¸Ðµ Ð¿Ð¾Ð»ÑŒÐ·Ð¾Ð²Ð°Ñ‚ÐµÐ»Ð¸. ÐÐ´Ð¼Ð¸Ð½ÐºÐ° index.html: ÑÐ¿Ð¸ÑÐ¾Ðº Ð³Ñ€ÑƒÐ¿Ð¿.
    match /league_groups/{groupId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // â”€â”€ Auth links (Google/Apple â†’ stable_id mapping) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    // Doc id = providerUid (Google sub / Apple sub).
    // Ð˜ÑÐ¿Ð¾Ð»ÑŒÐ·ÑƒÐµÑ‚ÑÑ Ð¿Ñ€Ð¸ Ð»Ð¾Ð³Ð¸Ð½Ðµ Ð½Ð° Ð½Ð¾Ð²Ð¾Ð¼ ÑƒÑÑ‚Ñ€Ð¾Ð¹ÑÑ‚Ð²Ðµ: query auth_links/{providerUid}
    // Ñ‡Ñ‚Ð¾Ð±Ñ‹ Ð²Ð¾ÑÑÑ‚Ð°Ð½Ð¾Ð²Ð¸Ñ‚ÑŒ stable_id Ð¸ Ð¿Ð¾Ð´Ñ‚ÑÐ½ÑƒÑ‚ÑŒ Ð¿Ñ€Ð¾Ð³Ñ€ÐµÑÑ.
    match /auth_links/{providerUid} {
      function ownsAuthLinkDoc() {
        return request.auth != null
          && request.auth.uid == providerUid
          && !exists(/databases/$(database)/documents/account_deletion_auth_markers/$(request.auth.uid));
      }

      // The app only needs to read the link for the provider account that is
      // currently signed in. Broad authenticated reads expose account mappings.
      allow read: if isAdmin() || ownsAuthLinkDoc();
      // Identity anchors are server-owned. Browser clients, including admins,
      // must use a callable; Admin SDK writes bypass Firestore Rules.
      allow create, update, delete: if false;

    }

    // ÐÐ³Ñ€ÐµÐ³Ð°Ñ‚Ñ‹ Ð´Ð»Ñ UI (ÑÑ‡Ñ‘Ñ‚Ñ‡Ð¸Ðº Ð¾Ñ‡ÐµÑ€ÐµÐ´Ð¸ Ð°Ñ€ÐµÐ½Ñ‹ â€” Ð¿Ð¸ÑˆÐµÑ‚ Ñ‚Ð¾Ð»ÑŒÐºÐ¾ Cloud Function)
    match /app_meta/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // â”€â”€ Admin audit log â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /admin_log/{docId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /telegram_premium_orders/{orderId} {
      allow read: if isAdmin();
      allow update: if isAdmin();
      allow create, delete: if false;
    }

    // Dead-letter необработанных Telegram-апдейтов (в т.ч. оплат). Пишет ТОЛЬКО
    // Cloud Function через Admin SDK. Клиент сюда не лезет; админ может читать/чистить.
    match /telegram_premium_dead_letter/{docId} {
      allow read, update: if isAdmin();
      allow create, delete: if false;
    }

    match /telegram_premium_bot/{docId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // â”€â”€ Community (UGC) packs â€” Ð·Ð°Ð¿Ð¸ÑÑŒ Ñ‚Ð¾Ð»ÑŒÐºÐ¾ Ñ‡ÐµÑ€ÐµÐ· Cloud Functions â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /community_packs/{packId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /community_pack_submissions/{submissionId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /community_pack_drafts/{draftId} {
      allow read, write: if false;
    }

    match /community_pack_purchases/{purchaseId} {
      allow read, update: if isAdmin();
      allow create, delete: if false;
    }

    match /community_pack_ratings/{ratingId} {
      allow read, write: if false;
    }

    // Arena ghost challenges: async shareable arena replays.
    match /arena_ghost_challenges/{challengeId} {
      allow read, write: if false;
    }

    match /arena_hill_thrones/{dayKey} {
      allow read, write: if false;
    }

    match /arena_hill_attempts/{attemptId} {
      allow read, write: if false;
    }

    // ── Сезоны Арены ───────────────────────────────────────────────────────────
    // Сезонный лидерборд (топ-100): читать всем, ПИСАТЬ только сервер (Admin SDK —
    // и PvP onArenaSessionFinished, и бот-CF arenaBotMatchRecord). Клиент не пишет
    // вообще — как и в arena_profiles (анти-накрутка SR/ранга).
    match /arena_season_leaderboard/{seasonId}/entries/{uid} {
      allow read, write: if false;
    }
    // Мета сезона, источники наград (claims), зал славы — только сервер.
    match /arena_seasons/{seasonId} {
      allow read, write: if false;
    }
    match /arena_season_claims/{claimId} {
      allow read, write: if false;
    }
    match /arena_season_hall/{seasonId} {
      allow read, write: if false;
    }

    match /arena_club_events/{eventId} {
      allow read, write: if false;
    }

    match /arena_club_contributions/{contributionId} {
      allow read, write: if false;
    }

    match /arena_rooms_live/{roomCode} {
      allow read, write: if false;
    }

    match /arena_room_runs/{runId} {
      allow read, write: if false;
    }

    // ── Arena room members (lobby participants) ────────────────────────────────
    // Все записи создаёт/обновляет Cloud Function (Admin SDK).
    // Клиент читает участников своей комнаты.
    match /arena_room_members/{memberId} {
      allow read, write: if false;
    }

    match /arena_pulse_events/{eventId} {
      allow read, write: if false;
    }

    match /league_chest_events/{eventId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /league_crowns/{crownId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /league_chest_claims/{claimId} {
      allow read: if isAdmin()
        || (request.auth != null && resource.data.authUid == request.auth.uid);
      allow write: if false;
    }

    // ── Explain like I'm five (Phase 5) ────────────────────────────────────────
    // Публичный кэш объяснений: ЛЮБОЙ может читать готовое объяснение напрямую (быстро,
    // без CF, 0 токенов), но писать КОНТЕНТ — ТОЛЬКО Admin SDK из Cloud Function (explainPhrase).
    // Клиент НИКОГДА не пишет публичный контент (инвариант аудита SECURITY_AUDIT_2026-06-07).
    // delete: isAdmin() — кнопка «Сбросить объяснение» в админке (раздел «Непонятно объяснили»):
    // удаление дока ⇒ следующий запрос фразы генерирует заново. Создавать/менять контент
    // из браузера (включая админа) по-прежнему НЕЛЬЗЯ.
    match /phrase_explanations/{phraseHash} {
      allow read: if true;
      allow create, update: if false;
      allow delete: if isAdmin();
    }

    // Объяснения вариантов упражнения «Выбери фразу» (explainChoice). Та же модель:
    // публичное чтение прогретого кэша ($0), запись только сервер (Admin SDK), удаление —
    // только админ (удаление дока ⇒ следующий ответ сгенерирует батч заново).
    match /choice_explanations/{choiceHash} {
      allow read: if true;
      allow create, update: if false;
      allow delete: if isAdmin();
    }
    match /choice_explain_billing/{docId} {
      allow read: if false;
      allow write: if false;
    }

    // Разбор ошибки урока: тёплый кэш. Публичное чтение прогретого кэша ($0),
    // запись только сервер (Admin SDK), удаление — админ (удаление дока ⇒
    // разбор сгенерится заново). Биллинг — только сервер.
    match /mistake_explanations/{mistakeHash} {
      allow read: if true;
      allow create, update: if false;
      allow delete: if isAdmin();
    }
    match /mistake_explain_billing/{docId} {
      allow read: if false;
      allow write: if false;
    }

    // Исторический кэш и биллинг удалённого Quiz остаются полностью закрытыми.
    // Retired-данные доступны только Admin SDK для обязательной серверной очистки.
    match /quiz_explanations/{quizHash} {
      allow read, write: if false;
    }
    match /quiz_explain_billing/{docId} {
      allow read: if false;
      allow write: if false;
    }

    // Компас: кэш тёплого комментария дня. Публично читается только готовый
    // серверный результат; клиентские записи запрещены, удаление доступно админу.
    match /compass_briefings/{hash} {
      allow read: if true;
      allow create, update: if false;
      allow delete: if isAdmin();
    }

    // Исторический биллинг голосовой части Компаса остаётся закрытым.
    match /compass_billing/{docId} {
      allow read: if false;
      allow write: if false;
    }

    // Внутренние CF-only коллекции фичи: бюджет/лимиты/биллинг. Всё пишет и читает только
    // сервер (Admin SDK). НЕ через isAdmin(): эти коллекции НЕ открыты admin-панели
    // (в отличие от referral_owners), поэтому read И write = false.
    match /explain_global_budget/{docId} {
      allow read: if false;
      allow write: if false;
    }
    match /explain_user_limits/{docId} {
      allow read: if false;
      allow write: if false;
    }
    match /explain_billing/{docId} {
      allow read: if false;
      allow write: if false;
    }

    // Произношение (scorePronunciationAttempt): лимиты/квоты/бюджет — только сервер (Admin SDK).
    // Защищают OpenAI-кошелёк: часовой rate-limit, дневная квота на юзера, глобальный потолок.
    match /pronunciation_score_rate_limits/{docId} {
      allow read: if false;
      allow write: if false;
    }
    match /pronunciation_score_daily_quota/{docId} {
      allow read: if false;
      allow write: if false;
    }
    match /pronunciation_global_budget/{docId} {
      allow read: if false;
      allow write: if false;
    }

    // Жалобы «Непонятно объяснили»: ПИШЕТ только CF submitExplainReport (Admin SDK), а
    // админ-панель ЧИТАЕТ и разбирает их (раздел «Непонятно объяснили») — паттерн user_reports.
    // explain_reports — счётчик «сколько РАЗНЫХ юзеров пожаловались» по фразе
    // (delete = админ сбрасывает счётчик после починки фразы).
    match /explain_reports/{docId} {
      allow read, delete: if isAdmin();
      allow create, update: if false;
    }
    // explain_report_entries — лента жалоб, по записи на каждую отправку
    // (update = пометить разобранной, delete = убрать мусор).
    match /explain_report_entries/{docId} {
      allow read, update, delete: if isAdmin();
      allow create: if false;
    }

    // Промокоды-награды: админ создаёт/правит из «Пульта», читает статистику.
    // Активация идёт через CF promoCodeRedeem (Admin SDK) — клиентам прямой доступ
    // не нужен и запрещён (нельзя подсмотреть/подменить rewardDays/usedCount).
    match /promo_codes/{code} {
      // Только админ. Не-админ запрещён дефолтным deny (и общим catch-all ниже).
      allow read, write: if isAdmin();
    }

    // â”€â”€ CATCH-ALL â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    // Agent Office is a server-owned control ledger. Canonical records are
    // reachable only through role-checked Cloud Functions using Admin SDK.
    match /agent_cases/{document=**} {
      allow read, write: if false;
    }
    match /agent_recommendations/{document=**} {
      allow read, write: if false;
    }
    match /agent_approvals/{document=**} {
      allow read, write: if false;
    }
    match /agent_tasks/{document=**} {
      allow read, write: if false;
    }
    match /agent_audit_events/{document=**} {
      allow read, write: if false;
    }
    match /agent_office_control/{document=**} {
      allow read, write: if false;
    }
    match /agent_telegram_tokens/{document=**} {
      allow read, write: if false;
    }
    match /agent_observation_receipts/{document=**} {
      allow read, write: if false;
    }
    match /agent_manager_agents/{document=**} {
      allow read, write: if false;
    }
    match /agent_manager_tasks/{document=**} {
      allow read, write: if false;
    }
    match /agent_manager_task_events/{document=**} {
      allow read, write: if false;
    }
    match /agent_manager_approvals/{document=**} {
      allow read, write: if false;
    }
    match /agent_manager_execution_jobs/{document=**} {
      allow read, write: if false;
    }
    match /agent_manager_inbox_links/{document=**} {
      allow read, write: if false;
    }
    match /agent_manager_telegram_tokens/{document=**} {
      allow read, write: if false;
    }
    match /agent_manager_telegram_publication_receipts/{document=**} {
      allow read, write: if false;
    }
    match /agent_manager_local_runner_pairings/{document=**} {
      allow read, write: if false;
    }
    match /agent_manager_local_runner_capabilities/{document=**} {
      allow read, write: if false;
    }
    match /agent_manager_local_runner_leases/{document=**} {
      allow read, write: if false;
    }
    match /agent_manager_support_draft_operations/{document=**} {
      allow read, write: if false;
    }

    // Биржа «монеты → звёзды»: курс, история и журнал сделок — строго серверные.
    match /economy/{document=**} {
      allow read, write: if false;
    }
    match /economy_exchange_history/{document=**} {
      allow read, write: if false;
    }
    match /coin_exchange_trades/{document=**} {
      allow read, write: if false;
    }
    // Журнал разовой миграции осколков→монет — строго серверный.
    match /coin_migrations/{document=**} {
      allow read, write: if false;
    }

    match /{collection}/{document=**} {
      allow read, write: if isAdmin()
        && collection != 'users'
        && collection != 'auth_links'
        && collection != 'account_deletion_tombstones'
        && collection != 'account_deletion_auth_markers'
        && collection != 'account_deletion_permanent_denials'
        && collection != 'account_identity_owner_map'
        && collection != 'account_merge_outbox'
        && collection != 'revenuecat_premium_events'
        && collection != 'revenuecat_premium_lineages'
        && collection != 'revenuecat_premium_denials'
        && collection != 'auth_recovery_codes'
        && collection != 'auth_recovery_rate_limits'
        && collection != 'auth_recovery_events'
        && collection != 'auth_recovery_challenges'
        && collection != 'auth_recovery_delivery_intents'
        && collection != 'auth_recovery_idempotency'
        && collection != 'auth_recovery_clean_rate_limits'
        && collection != 'agent_cases'
        && collection != 'agent_recommendations'
        && collection != 'agent_approvals'
        && collection != 'agent_tasks'
        && collection != 'agent_audit_events'
        && collection != 'agent_office_control'
        && collection != 'agent_telegram_tokens'
        && collection != 'agent_observation_receipts'
        && collection != 'agent_manager_agents'
        && collection != 'agent_manager_tasks'
        && collection != 'agent_manager_task_events'
        && collection != 'agent_manager_approvals'
        && collection != 'agent_manager_execution_jobs'
        && collection != 'agent_manager_inbox_links'
        && collection != 'agent_manager_telegram_tokens'
        && collection != 'agent_manager_telegram_publication_receipts'
        && collection != 'agent_manager_local_runner_pairings'
        && collection != 'agent_manager_local_runner_capabilities'
        && collection != 'agent_manager_local_runner_leases'
        && collection != 'agent_manager_support_draft_operations'
        && collection != 'economy'
        && collection != 'economy_exchange_history'
        && collection != 'coin_exchange_trades'
        && collection != 'coin_migrations'
        && collection != 'tournamentSchedule'
        && collection != 'tournamentRooms'
        && collection != 'tournamentTasks'
        && collection != 'tournamentSeasons'
        && collection != 'tournamentBank'
        && collection != 'botProfiles'
        // Retired Quiz/Arena collections remain sealed even for browser admins.
        // Firestore overlapping matches are OR-combined, so every retired root
        // must also be excluded from this legacy compatibility catch-all.
        && collection != 'arena_profiles'
        && collection != 'arena_sessions'
        && collection != 'session_players'
        && collection != 'arena_rooms'
        && collection != 'arena_invites'
        && collection != 'arena_session_results'
        && collection != 'matchmaking_queue'
        && collection != 'arena_questions'
        && collection != 'arena_question_history'
        && collection != 'arena_question_pool_publications'
        && collection != 'arena_ghost_challenges'
        && collection != 'arena_hill_thrones'
        && collection != 'arena_hill_attempts'
        && collection != 'arena_hill_player_wins'
        && collection != 'arena_hill_throne_rewards'
        && collection != 'arena_season_leaderboard'
        && collection != 'arena_seasons'
        && collection != 'arena_season_claims'
        && collection != 'arena_season_hall'
        && collection != 'arena_club_events'
        && collection != 'arena_club_contributions'
        && collection != 'arena_rooms_live'
        && collection != 'arena_room_runs'
        && collection != 'arena_room_members'
        && collection != 'arena_pulse_events'
        && collection != 'quiz_explanations'
        && collection != 'quiz_explain_billing';
    }
    // Legacy browser-admin compatibility. These rules mirror only operations
    // that admin/legacy.html performs directly; do not replace them with a
    // recursive or prefix-wide admin grant.
    match /admin_digest_runs/{runId} {
      allow list: if isAdmin();
    }
    match /admin_digests/{dayKey} {
      allow get: if isAdmin();
    }
    match /support_inbox/{messageId} {
      allow list: if isAdmin();
    }
    match /admin_push_jobs/{jobId} {
      allow list, create: if isAdmin();
    }
    match /revenuecat_premium_events/{eventId} {
      allow list: if isAdmin();
    }
    match /account_deletion_permanent_denials/{denialId} {
      allow read, write: if false;
    }
    match /account_identity_owner_map/{aliasId} {
      allow read, write: if false;
    }
    match /account_merge_outbox/{mergeId} {
      allow read, write: if false;
    }
    match /revenuecat_premium_lineages/{docId} {
      allow read, write: if false;
    }
    match /revenuecat_premium_denials/{docId} {
      allow read, write: if false;
    }
    match /revenuecat_shard_transactions/{transactionId} {
      allow list: if isAdmin();
    }
    match /users_dedup_archive/{userId} {
      allow create, update: if isAdmin();
    }
    match /adminContentDrafts/fr/quiz/{version} {
      allow create, update: if isAdmin();
    }
    match /adminContentRollbacks/fr/quiz/{version} {
      allow create, update: if isAdmin();
    }

    // Legacy admin collection-group queries need a collection-group match;
    // the nested users/{userId}/... rules continue to govern document writes.
    match /{path=**}/app_message_states/{messageId} {
      allow list: if isAdmin();
    }
    match /{path=**}/promo_redemptions/{code} {
      allow list: if isAdmin();
    }

    // Learning V2 Content Studio authoring state is callable/Admin-SDK only.
    // Firestore allow expressions are OR-combined across overlapping matches,
    // so these exact deny blocks rely on the final catch-all also being deny-only.
    match /content_mode_templates/{docId} {
      allow read, write: if false;
    }
    match /content_mode_template_draft_revisions/{docId} {
      allow read, write: if false;
    }
    match /content_mode_template_versions/{docId} {
      allow read, write: if false;
    }
    match /content_mode_template_lifecycle/{docId} {
      allow read, write: if false;
    }
    match /content_season_drafts/{docId} {
      allow read, write: if false;
    }
    match /content_season_revisions/{docId} {
      allow read, write: if false;
    }
    match /content_season_lifecycle/{docId} {
      allow read, write: if false;
    }
    match /content_episode_drafts/{docId} {
      allow read, write: if false;
    }
    match /content_episode_revisions/{docId} {
      allow read, write: if false;
    }
    match /content_episode_lifecycle/{docId} {
      allow read, write: if false;
    }
    match /content_studio_review_queue/{docId} {
      allow read, write: if false;
    }
    match /content_studio_localization_units/{docId} {
      allow read, write: if false;
    }
    match /content_studio_review_receipts/{docId} {
      allow read, write: if false;
    }
    match /content_studio_validation_receipts/{docId} {
      allow read, write: if false;
    }
    match /content_studio_waivers/{docId} {
      allow read, write: if false;
    }
    match /content_studio_preview_sessions/{docId} {
      allow read, write: if false;
    }
    match /content_studio_preview_receipts/{docId} {
      allow read, write: if false;
    }
    match /content_app_support_manifests/{docId} {
      allow read, write: if false;
    }

    // Learning V2 delayed evidence is server-owned. Clients must use the
    // callable; direct reads/writes would bypass assignment, timing and
    // idempotency checks. Admin SDK writes are unaffected by these rules.
    match /learning_v2_assignments/{docId} {
      allow read, write: if false;
    }
    match /learning_v2_launches/{docId} {
      allow read, write: if false;
    }
    match /learning_v2_timing_receipts/{docId} {
      allow read, write: if false;
    }
    match /learning_v2_failure_receipts/{docId} {
      allow read, write: if false;
    }
    match /learning_v2_receipt_operations/{docId} {
      allow read, write: if false;
    }

    // ── Турниры (Фаза 1 MVP, спека docs/tournaments/2026-07-21-tournaments-mode-spec.md) ──
    // Все записи — только через Cloud Functions (Admin SDK). Клиенты читают
    // комнаты/сезон/банк/ботов; задания отдаёт только сервер по seed.
    // Compatibility for rooms deployed before participantAuthUids existed.
    // The fixed room cap is 16, so exact indexed checks preserve document
    // listeners for real participants without granting a collection-wide read.
    function legacyTournamentHasPlayerId(room, uid) {
      return (room.players.size() > 0 && room.players[0].isBot == false && room.players[0].id == uid)
        || (room.players.size() > 1 && room.players[1].isBot == false && room.players[1].id == uid)
        || (room.players.size() > 2 && room.players[2].isBot == false && room.players[2].id == uid)
        || (room.players.size() > 3 && room.players[3].isBot == false && room.players[3].id == uid)
        || (room.players.size() > 4 && room.players[4].isBot == false && room.players[4].id == uid)
        || (room.players.size() > 5 && room.players[5].isBot == false && room.players[5].id == uid)
        || (room.players.size() > 6 && room.players[6].isBot == false && room.players[6].id == uid)
        || (room.players.size() > 7 && room.players[7].isBot == false && room.players[7].id == uid)
        || (room.players.size() > 8 && room.players[8].isBot == false && room.players[8].id == uid)
        || (room.players.size() > 9 && room.players[9].isBot == false && room.players[9].id == uid)
        || (room.players.size() > 10 && room.players[10].isBot == false && room.players[10].id == uid)
        || (room.players.size() > 11 && room.players[11].isBot == false && room.players[11].id == uid)
        || (room.players.size() > 12 && room.players[12].isBot == false && room.players[12].id == uid)
        || (room.players.size() > 13 && room.players[13].isBot == false && room.players[13].id == uid)
        || (room.players.size() > 14 && room.players[14].isBot == false && room.players[14].id == uid)
        || (room.players.size() > 15 && room.players[15].isBot == false && room.players[15].id == uid);
    }

    function isLegacyTournamentParticipant(room) {
      return request.auth != null
        && room.players is list
        && (legacyTournamentHasPlayerId(room, request.auth.uid)
          || (exists(/databases/$(database)/documents/auth_links/$(request.auth.uid))
            && legacyTournamentHasPlayerId(
              room,
              get(/databases/$(database)/documents/auth_links/$(request.auth.uid)).data.stable_id
            )));
    }

    match /tournamentSchedule/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /tournamentRooms/{roomId} {
      // зачем: зрители (решение владельца 2026-07-26) — любой вошедший может
      // смотреть табло идущего турнира. Это безопасно: правильные ответы лежат
      // в закрытой подколлекции taskSecrets, а сам документ комнаты содержит
      // только имена, аватары, очки и состояние. Зритель не отнимает место у
      // игрока: смотреть можно лишь ПОСЛЕ закрытия входа (состояния round/
      // table/final), пока лобби открыто — только играть.
      allow read: if request.auth != null
        && (resource.data.state in ['scheduled', 'lobby']
          || resource.data.state.matches('round[1-4]')
          || resource.data.state.matches('table[1-3]')
          || resource.data.state in ['final', 'results']
          || (resource.data.get('participantAuthUidsComplete', false) == true
            && request.auth.uid in resource.data.get('participantAuthUids', []))
          || (resource.data.get('participantAuthUidsComplete', false) != true
            && (request.auth.uid in resource.data.get('participantAuthUids', [])
              || isLegacyTournamentParticipant(resource.data))));
      allow write: if false;
    }
    match /tournamentRooms/{roomId}/taskSecrets/{taskId} {
      allow read, write: if false;
    }
    // зачем 2026-07-27 (владелец: «анимации эмодзи нет, как было задумано на
    // макетах — чтобы они отправлялись, улетали вверх и все их видели»):
    // реакция это ОДИН документ на игрока, а не запись на каждый тап. Игрок
    // перезаписывает свой док, остальные видят изменение через подписку —
    // так стоимость не растёт от частоты тапов (кулдаун держит и клиент).
    // Пишет только сам автор и только в свой документ; чужой перебить нельзя.
    // Читают все, кому открыта комната, — реакции не секрет, ответы лежат
    // в закрытой taskSecrets и сюда не попадают.
    match /tournamentRooms/{roomId}/reactions/{authUid} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/tournamentRooms/$(roomId));
      allow write: if request.auth != null
        && request.auth.uid == authUid
        && request.resource.data.keys().hasOnly(['emoji', 'atMs', 'name'])
        && request.resource.data.emoji is string
        && request.resource.data.emoji.size() <= 8
        && request.resource.data.atMs is int;
    }
    match /tournamentTasks/{taskId} {
      allow read, write: if false;
    }
    match /tournamentSeasons/{weekId} {
      allow read: if request.auth != null;
      allow write: if false;
      match /entries/{uid} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }
    match /tournamentBank/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /botProfiles/{botId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /users/{uid}/reward_claims/{claimId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /users/{uid}/tournament_receipts/{receiptId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
