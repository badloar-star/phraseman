 "phrases": [
  {
   "id": "en-classic-r1:20.01",
   "target": "I need a pen.",
   "ru": "Мне нужна ручка.",
   "uk": "Мені потрібна ручка."
  },
  {
   "id": "en-classic-r1:20.02",
   "target": "I need an envelope.",
   "ru": "Мне нужен конверт.",
   "uk": "Мені потрібен конверт."
  },
  {
   "id": "en-classic-r1:20.03",
   "target": "She has a receipt.",
   "ru": "У нее есть квитанция.",
   "uk": "У неї є чек."
  },
  {
   "id": "en-classic-r1:20.04",
   "target": "He has an appointment.",
   "ru": "У него назначена встреча.",
   "uk": "У нього зустріч."
  },
  {
   "id": "en-classic-r1:20.05",
   "target": "We need a taxi.",
   "ru": "Нам нужно такси.",
   "uk": "Нам потрібне таксі."
  },
  {
   "id": "en-classic-r1:20.06",
   "target": "I have an idea.",
   "ru": "У меня есть идея.",
   "uk": "У мене є ідея."
  },
  {
   "id": "en-classic-r1:20.07",
   "target": "She wants a sandwich.",
   "ru": "Она хочет сэндвич.",
   "uk": "Вона хоче сендвіч."
  },
  {
   "id": "en-classic-r1:20.08",
   "target": "He ordered an omelette.",
   "ru": "Он заказал омлет.",
   "uk": "Він замовив омлет."
  },
  {
   "id": "en-classic-r1:20.09",
   "target": "They rented a flat.",
   "ru": "Они сняли квартиру.",
   "uk": "Вони орендували квартиру."
  },
  {
   "id": "en-classic-r1:20.10",
   "target": "We bought an umbrella.",
   "ru": "Мы купили зонт.",
   "uk": "Ми купили парасольку."
  },
  {
   "id": "en-classic-r1:20.11",
   "target": "I bought a lamp. The lamp is broken.",
   "ru": "Я купил лампу. Лампа сломана.",
   "uk": "Я купив лампу. Лампа зламана."
  },
  {
   "id": "en-classic-r1:20.12",
   "target": "I found a key. The key is rusty.",
   "ru": "Я нашел ключ. Ключ ржавый.",
   "uk": "Я знайшов ключ. Ключ іржавий."
  },
  {
   "id": "en-classic-r1:20.13",
   "target": "She ordered a salad. The salad was cold.",
   "ru": "Она заказала салат. Салат был холодным.",
   "uk": "Вона замовила салат. Салат був холодний."
  },
  {
   "id": "en-classic-r1:20.14",
   "target": "We saw a flat. The flat had a balcony.",
   "ru": "Мы посмотрели квартиру. В квартире был балкон.",
   "uk": "Ми подивилися квартиру. У квартирі був балкон."
  },
  {
   "id": "en-classic-r1:20.15",
   "target": "He opened a parcel. The parcel was empty.",
   "ru": "Он открыл посылку. Посылка была пустой.",
   "uk": "Він відкрив посилку. Посилка була порожня."
  },
  {
   "id": "en-classic-r1:20.16",
   "target": "I read a notice. The notice was in English.",
   "ru": "Я прочитал объявление. Объявление было на английском языке.",
   "uk": "Я прочитав оголошення. Оголошення було англійською мовою."
  },
  {
   "id": "en-classic-r1:20.17",
   "target": "She bought an alarm clock. The clock is loud.",
   "ru": "Она купила будильник. Часы громко звенят.",
   "uk": "Вона купила будильник. Годинник гучний."
  },
  {
   "id": "en-classic-r1:20.18",
   "target": "We booked a taxi. The taxi came early.",
   "ru": "Мы заказали такси. Такси приехало раньше времени.",
   "uk": "Ми замовили таксі. Таксі приїхало рано."
  },
  {
   "id": "en-classic-r1:20.19",
   "target": "I wrote a letter. The letter is on your desk.",
   "ru": "Я написал письмо. Письмо лежит у тебя на столе.",
   "uk": "Я написав листа. Лист лежить на твоєму столі."
  },
  {
   "id": "en-classic-r1:20.20",
   "target": "He found an envelope. The envelope was sealed.",
   "ru": "Он нашел конверт. Конверт был запечатан.",
   "uk": "Він знайшов конверт. Конверт був запечатаний."
  },
  {
   "id": "en-classic-r1:20.21",
   "target": "The lift in our building is slow.",
   "ru": "Лифт в нашем здании работает медленно.",
   "uk": "Ліфт у нашому будинку повільний."
  },
  {
   "id": "en-classic-r1:20.22",
   "target": "The bus outside is ours.",
   "ru": "Автобус, который стоит на улице, — наш.",
   "uk": "Автобус, що стоїть надворі, — наш."
  },
  {
   "id": "en-classic-r1:20.23",
   "target": "The coffee you made is lovely.",
   "ru": "Кофе, который вы приготовили, восхитителен.",
   "uk": "Кава, яку ви приготували, чудова."
  },
  {
   "id": "en-classic-r1:20.24",
   "target": "The water in this bottle is cold.",
   "ru": "Вода в этой бутылке холодная.",
   "uk": "Вода в цій пляшці холодна."
  },
  {
   "id": "en-classic-r1:20.25",
   "target": "The seat by the door is free.",
   "ru": "Место у двери свободно.",
   "uk": "Місце біля дверей вільне."
  },
  {
   "id": "en-classic-r1:20.26",
   "target": "The driver of our taxi was helpful.",
   "ru": "Водитель нашего такси был любезен.",
   "uk": "Водій нашого таксі був люб'язним."
  },
  {
   "id": "en-classic-r1:20.27",
   "target": "The price on the label is wrong.",
   "ru": "Цена на этикетке указана неверно.",
   "uk": "Ціна на етикетці неправильна."
  },
  {
   "id": "en-classic-r1:20.28",
   "target": "The bread on the table is fresh.",
   "ru": "Хлеб на столе свежий.",
   "uk": "Хліб на столі свіжий."
  },
  {
   "id": "en-classic-r1:20.29",
   "target": "The book in my bag is yours.",
   "ru": "Книга в моей сумке ваша.",
   "uk": "Книга в моїй сумці ваша."
  },
  {
   "id": "en-classic-r1:20.30",
   "target": "The shoes in the window are on sale.",
   "ru": "Обувь в витрине продается со скидкой.",
   "uk": "Взуття у вітрині продається зі знижкою."
  },
  {
   "id": "en-classic-r1:20.31",
   "target": "I drink water with lunch.",
   "ru": "Я пью воду во время обеда.",
   "uk": "Я п'ю воду під час обіду."
  },
  {
   "id": "en-classic-r1:20.32",
   "target": "Coffee keeps me awake.",
   "ru": "Кофе не дает мне уснуть.",
   "uk": "Кава не дає мені заснути."
  },
  {
   "id": "en-classic-r1:20.33",
   "target": "Children need sleep.",
   "ru": "Детям нужен сон.",
   "uk": "Дітям потрібен сон."
  },
  {
   "id": "en-classic-r1:20.34",
   "target": "My sister likes dogs.",
   "ru": "Моей сестре нравятся собаки.",
   "uk": "Моя сестра любить собак."
  },
  {
   "id": "en-classic-r1:20.35",
   "target": "Rice takes time to cook.",
   "ru": "Рис долго готовится.",
   "uk": "Рис готується довго."
  },
  {
   "id": "en-classic-r1:20.36",
   "target": "We usually travel by train.",
   "ru": "Обычно мы путешествуем на поезде.",
   "uk": "Ми зазвичай подорожуємо поїздом."
  },
  {
   "id": "en-classic-r1:20.37",
   "target": "He walks to work.",
   "ru": "Он ходит на работу пешком.",
   "uk": "Він ходить на роботу пішки."
  },
  {
   "id": "en-classic-r1:20.38",
   "target": "They have breakfast at home.",
   "ru": "Они завтракают дома.",
   "uk": "Вони снідають вдома."
  },
  {
   "id": "en-classic-r1:20.39",
   "target": "She listens to music on the bus.",
   "ru": "Она слушает музыку в автобусе.",
   "uk": "Вона слухає музику в автобусі."
  },
  {
   "id": "en-classic-r1:20.40",
   "target": "I buy fruit at the market.",
   "ru": "Я покупаю фрукты на рынке.",
   "uk": "Я купую фрукти на ринку."
  },
  {
   "id": "en-classic-r1:20.41",
   "target": "We need a hotel for the night.",
   "ru": "Нам нужна гостиница на ночь.",
   "uk": "Нам потрібен готель на ніч."
  },
  {
   "id": "en-classic-r1:20.42",
   "target": "Is the hotel near the station?",
   "ru": "Гостиница находится рядом со станцией?",
   "uk": "Готель поруч зі станцією?"
  },
  {
   "id": "en-classic-r1:20.43",
   "target": "I had an egg for breakfast.",
   "ru": "Я съел яйцо на завтрак.",
   "uk": "Я з'їв яйце на сніданок."
  },
  {
   "id": "en-classic-r1:20.44",
   "target": "The eggs in the fridge are fresh.",
   "ru": "Яйца в холодильнике свежие.",
   "uk": "Яйця в холодильнику свіжі."
  },
  {
   "id": "en-classic-r1:20.45",
   "target": "He wears a uniform at work.",
   "ru": "Он носит униформу на работе.",
   "uk": "Він носить уніформу на роботі."
  },
  {
   "id": "en-classic-r1:20.46",
   "target": "The meeting lasts an hour.",
   "ru": "Встреча длится час.",
   "uk": "Зустріч триває годину."
  },
  {
   "id": "en-classic-r1:20.47",
   "target": "She speaks English with her customers.",
   "ru": "Она говорит по-английски со своими клиентами.",
   "uk": "Вона розмовляє англійською зі своїми клієнтами."
  },
  {
   "id": "en-classic-r1:20.48",
   "target": "Do you want the last slice?",
   "ru": "Хотите последний кусок?",
