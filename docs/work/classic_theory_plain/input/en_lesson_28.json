 "phrases": [
  {
   "id": "en-classic-r1:28.01",
   "target": "I cut myself.",
   "ru": "Я порезался.",
   "uk": "Я порізався."
  },
  {
   "id": "en-classic-r1:28.02",
   "target": "She hurt herself.",
   "ru": "Она поранилась.",
   "uk": "Вона поранилася."
  },
  {
   "id": "en-classic-r1:28.03",
   "target": "He blamed himself.",
   "ru": "Он винил себя.",
   "uk": "Він звинувачував себе."
  },
  {
   "id": "en-classic-r1:28.04",
   "target": "We introduced ourselves.",
   "ru": "Мы представились.",
   "uk": "Ми представилися."
  },
  {
   "id": "en-classic-r1:28.05",
   "target": "They introduced themselves.",
   "ru": "Они представились.",
   "uk": "Вони представилися."
  },
  {
   "id": "en-classic-r1:28.06",
   "target": "You can help yourself.",
   "ru": "Можете угощаться.",
   "uk": "Можете пригощатися."
  },
  {
   "id": "en-classic-r1:28.07",
   "target": "The cat washed itself.",
   "ru": "Кошка умылась.",
   "uk": "Кіт помився."
  },
  {
   "id": "en-classic-r1:28.08",
   "target": "I saw myself in the mirror.",
   "ru": "Я увидел себя в зеркале.",
   "uk": "Я побачив себе в дзеркалі."
  },
  {
   "id": "en-classic-r1:28.09",
   "target": "She taught herself English.",
   "ru": "Она самостоятельно выучила английский.",
   "uk": "Вона сама вивчила англійську."
  },
  {
   "id": "en-classic-r1:28.10",
   "target": "He looked at himself in the window.",
   "ru": "Он посмотрел на себя в окне.",
   "uk": "Він подивився на себе у вікні."
  },
  {
   "id": "en-classic-r1:28.11",
   "target": "I made myself a sandwich.",
   "ru": "Я сделал себе бутерброд.",
   "uk": "Я зробив собі бутерброд."
  },
  {
   "id": "en-classic-r1:28.12",
   "target": "She poured herself some water.",
   "ru": "Она налила себе воды.",
   "uk": "Вона налила собі води."
  },
  {
   "id": "en-classic-r1:28.13",
   "target": "He cut himself a slice of bread.",
   "ru": "Он отрезал себе ломтик хлеба.",
   "uk": "Він відрізав собі шматочок хліба."
  },
  {
   "id": "en-classic-r1:28.14",
   "target": "We got ourselves a map.",
   "ru": "Мы взяли себе карту.",
   "uk": "Ми взяли собі карту."
  },
  {
   "id": "en-classic-r1:28.15",
   "target": "They booked themselves a room.",
   "ru": "Они забронировали себе номер.",
   "uk": "Вони забронювали собі кімнату."
  },
  {
   "id": "en-classic-r1:28.16",
   "target": "I reminded myself to bring the receipt.",
   "ru": "Я напомнил себе взять квитанцию.",
   "uk": "Я нагадав собі взяти чек."
  },
  {
   "id": "en-classic-r1:28.17",
   "target": "She asked herself a useful question.",
   "ru": "Она задала себе полезный вопрос.",
   "uk": "Вона поставила собі корисне запитання."
  },
  {
   "id": "en-classic-r1:28.18",
   "target": "He promised himself a day off.",
   "ru": "Он пообещал себе выходной.",
   "uk": "Він пообіцяв собі вихідний."
  },
  {
   "id": "en-classic-r1:28.19",
   "target": "We gave ourselves extra time.",
   "ru": "Мы выделили себе дополнительное время.",
   "uk": "Ми дали собі додатковий час."
  },
  {
   "id": "en-classic-r1:28.20",
   "target": "They found themselves a quiet table.",
   "ru": "Они нашли себе тихий столик.",
   "uk": "Вони знайшли собі тихий столик."
  },
  {
   "id": "en-classic-r1:28.21",
   "target": "I fixed the tap myself.",
   "ru": "Я сам починил кран.",
   "uk": "Я сам полагодив кран."
  },
  {
   "id": "en-classic-r1:28.22",
   "target": "She wrote the letter herself.",
   "ru": "Она сама написала письмо.",
   "uk": "Вона сама написала листа."
  },
  {
   "id": "en-classic-r1:28.23",
   "target": "He carried both boxes himself.",
   "ru": "Он сам перенёс обе коробки.",
   "uk": "Він сам переніс обидві коробки."
  },
  {
   "id": "en-classic-r1:28.24",
   "target": "We did the painting ourselves.",
   "ru": "Мы сами покрасили.",
   "uk": "Ми самі пофарбували."
  },
  {
   "id": "en-classic-r1:28.25",
   "target": "They built the shelter themselves.",
   "ru": "Они сами построили убежище.",
   "uk": "Вони самі збудували укриття."
  },
  {
   "id": "en-classic-r1:28.26",
   "target": "Did you make this yourself?",
   "ru": "Ты сам это сделал?",
   "uk": "Ти сам це зробив?"
  },
  {
   "id": "en-classic-r1:28.27",
   "target": "I want to hear it myself.",
   "ru": "Я хочу услышать это сам.",
   "uk": "Я хочу сам це почути."
  },
  {
   "id": "en-classic-r1:28.28",
   "target": "The manager checked the brakes herself.",
   "ru": "Менеджер сама проверила тормоза.",
   "uk": "Менеджер сама перевірила гальма."
  },
  {
   "id": "en-classic-r1:28.29",
   "target": "The driver checked the address himself.",
   "ru": "Водитель сам проверил адрес.",
   "uk": "Водій сам перевірив адресу."
  },
  {
   "id": "en-classic-r1:28.30",
   "target": "We saw the damage ourselves.",
   "ru": "Мы сами увидели повреждения.",
   "uk": "Ми самі бачили пошкодження."
  },
  {
   "id": "en-classic-r1:28.31",
   "target": "I went by myself.",
   "ru": "Я поехал один.",
   "uk": "Я їхав сам."
  },
  {
   "id": "en-classic-r1:28.32",
   "target": "She lives by herself.",
   "ru": "Она живет одна.",
   "uk": "Вона живе сама."
  },
  {
   "id": "en-classic-r1:28.33",
   "target": "He travelled by himself.",
   "ru": "Он ехал один.",
   "uk": "Він подорожував сам."
  },
  {
   "id": "en-classic-r1:28.34",
   "target": "We had the room to ourselves.",
   "ru": "Комната была в нашем распоряжении.",
   "uk": "Кімната була в нашому розпорядженні."
  },
  {
   "id": "en-classic-r1:28.35",
   "target": "They walked home by themselves.",
   "ru": "Они сами дошли до дома пешком.",
   "uk": "Вони самі дісталися додому пішки."
  },
  {
   "id": "en-classic-r1:28.36",
   "target": "Can your son dress himself?",
   "ru": "Ваш сын может одеться сам?",
   "uk": "Ваш син може сам одягнутися?"
  },
  {
   "id": "en-classic-r1:28.37",
   "target": "Please make yourself at home.",
   "ru": "Пожалуйста, чувствуйте себя как дома.",
   "uk": "Будь ласка, почувайтеся як вдома."
  },
  {
   "id": "en-classic-r1:28.38",
   "target": "Help yourselves to some fruit.",
   "ru": "Угощайтесь фруктами.",
   "uk": "Пригощайтеся фруктами."
  },
  {
   "id": "en-classic-r1:28.39",
   "target": "Do not burn yourself on the pan.",
   "ru": "Не обожгитесь о сковороду.",
   "uk": "Не обпеклися об сковороду."
  },
  {
   "id": "en-classic-r1:28.40",
   "target": "Did you hurt yourself when you fell?",
   "ru": "Ты поранился, когда упал?",
   "uk": "Ти поранився, коли впав?"
  },
  {
   "id": "en-classic-r1:28.41",
   "target": "We looked at each other.",
   "ru": "Мы посмотрели друг на друга.",
   "uk": "Ми подивилися одне на одного."
  },
  {
   "id": "en-classic-r1:28.42",
   "target": "We each looked at ourselves in the mirror.",
   "ru": "Каждый из нас посмотрел на себя в зеркало.",
   "uk": "Кожен із нас подивився на себе в дзеркало."
  },
  {
   "id": "en-classic-r1:28.43",
   "target": "They helped each other carry the boxes.",
   "ru": "Они помогали друг другу нести коробки.",
   "uk": "Вони допомагали одне одному нести коробки."
  },
  {
   "id": "en-classic-r1:28.44",
   "target": "They taught themselves to cook.",
   "ru": "Они научились готовить сами.",
   "uk": "Вони самі навчилися готувати."
  },
  {
   "id": "en-classic-r1:28.45",
   "target": "She cut the bread, not herself.",
   "ru": "Она порезала хлеб, а не себя.",
   "uk": "Вона порізала хліб, а не себе."
  },
  {
   "id": "en-classic-r1:28.46",
   "target": "I taught my brother, but he tested himself.",
   "ru": "Я научил своего брата, но он проверил себя.",
   "uk": "Я навчив брата, але він перевірив себе."
  },
  {
   "id": "en-classic-r1:28.47",
   "target": "The door closed by itself.",
   "ru": "Дверь закрылась сама.",
   "uk": "Двері зачинилися самі."
  },
  {
   "id": "en-classic-r1:28.48",
   "target": "The children made lunch by themselves.",
   "ru": "Дети сами приготовили обед.",
   "uk": "Діти самі приготували обід."
  },
  {
   "id": "en-classic-r1:28.49",
   "target": "I enjoyed myself at the concert.",
   "ru": "Мне понравилось на концерте.",
   "uk": "Мені сподобалося на концерті."
  },
  {
   "id": "en-classic-r1:28.50",
   "target": "Take care of yourself on the way home.",
   "ru": "Береги себя по дороге домой.",
   "uk": "Бережи себе дорогою додому."
  }
 ],
