+// зачем (координатор 14.10, каскад [TABS-RENDER], патч TABS_RENDER_4): tabScreens пересоздаётся на каждом переходе (physicalPageIdx/activeIdx),
+// и обёртки всех пяти панелей рендерились заново. Сторож: панели под React.memo, содержимое каждой вкладки — свой useMemo, зависящий только
+// от того, что меняет эту вкладку; граница TabPane для сторожа заморозки (tab_freeze_handoff_contract) не сдвинута.
+import { readSource } from './helpers/read_source';
+
+const source = readSource('app/(tabs)/_layout.tsx');
+
+function memoDeps(name: string): string[] {
+  const start = source.indexOf(`const ${name} = useMemo(`);
+  if (start < 0) throw new Error(`${name} not found`);
+  const close = source.indexOf(']);', start);
+  const open = source.lastIndexOf(', [', close);
+  return source.slice(open + 3, close).split(',').map((d) => d.trim()).filter(Boolean);
+}
+
+describe('tab panes do not re-render on a transition unless their own inputs change', () => {
+  it('pane wrappers are memoized after the TabPane/LessonsPaneBoundary definitions', () => {
+    expect(source).toContain('const TabPaneMemo = React.memo(TabPane);');
+    expect(source).toContain('const LessonsPaneBoundaryMemo = React.memo(LessonsPaneBoundary);');
+    // сторож заморозки режет исходник TabPane до «function LessonsPaneBoundary(» — memo стоит ниже обеих функций
+    expect(source.indexOf('const TabPaneMemo')).toBeGreaterThan(source.indexOf('\nfunction LessonsPaneBoundary('));
+  });
+
+  it('every tab is rendered through a memoized pane with memoized children', () => {
+    expect(source).toContain('<TabPaneMemo key="home" freezeWanted={freezeWanted(0)}>{homeContent}</TabPaneMemo>');
+    expect(source).toContain('<LessonsPaneBoundaryMemo');
+    expect(source).toContain('<TabPaneMemo key="video" freezeWanted={freezeWanted(2)}>{videoContent}</TabPaneMemo>');
+    expect(source).toContain('<TabPaneMemo key="community" freezeWanted={freezeWanted(3)}>{communityContent}</TabPaneMemo>');
+    expect(source).toContain('<TabPaneMemo key="settings" freezeWanted={freezeWanted(4)}>{settingsContent}</TabPaneMemo>');
+    expect(source).not.toMatch(/<TabPane key=/);
+  });
+
+  it('tab content depends only on what changes that tab (not on physicalPageIdx/activeIdx)', () => {
+    expect(memoDeps('homeContent')).toEqual(['homeFallbackStyle', 'openDevHub']);
+    expect(memoDeps('videoContent')).toEqual(['loadVideo']);
+    expect(memoDeps('communityContent')).toEqual(['loadCommunity']);
+    expect(memoDeps('settingsContent')).toEqual(['loadSettings']);
+    for (const name of ['homeContent', 'videoContent', 'communityContent', 'settingsContent']) {
+      expect(memoDeps(name)).not.toContain('physicalPageIdx');
+      expect(memoDeps(name)).not.toContain('activeIdx');
+    }
+    expect(source).toContain('const loadVideo = shouldLoadTabScreen(activeIdx, 2, mountedTabs);');
+  });
+});
