   "target": "The park is quiet in the afternoon.",
   "ru": "В парке тихо днем.",
   "uk": "У парку тихо вдень."
  },
  {
   "id": "en-classic-r1:08.36",
   "target": "My birthday is in June.",
   "ru": "Мой день рождения в июне.",
   "uk": "Мій день народження в червні."
  },
  {
   "id": "en-classic-r1:08.37",
   "target": "Our club meets in January.",
   "ru": "Наш клуб собирается в январе.",
   "uk": "Наш клуб зустрічається в січні."
  },
  {
   "id": "en-classic-r1:08.38",
   "target": "The new timetable starts in April.",
   "ru": "Новое расписание вступает в силу в апреле.",
   "uk": "Новий розклад починається у квітні."
  },
  {
   "id": "en-classic-r1:08.39",
   "target": "The garden is beautiful in autumn.",
   "ru": "Сад прекрасен осенью.",
   "uk": "Сад прекрасний восени."
  },
  {
   "id": "en-classic-r1:08.40",
   "target": "We take a break in the evening.",
   "ru": "Мы делаем перерыв вечером.",
   "uk": "Ми робимо перерву ввечері."
  },
  {
   "id": "en-classic-r1:08.41",
   "target": "I work every Monday.",
   "ru": "Я работаю каждый понедельник.",
   "uk": "Я працюю щопонеділка."
  },
  {
   "id": "en-classic-r1:08.42",
   "target": "She starts next week.",
   "ru": "Она начинает на следующей неделе.",
   "uk": "Вона починає наступного тижня."
  },
  {
   "id": "en-classic-r1:08.43",
   "target": "The film starts tonight.",
   "ru": "Фильм начинается сегодня вечером.",
   "uk": "Фільм починається сьогодні ввечері."
  },
  {
   "id": "en-classic-r1:08.44",
   "target": "I see him every morning.",
   "ru": "Я вижу его каждое утро.",
   "uk": "Я бачу його щоранку."
  },
  {
   "id": "en-classic-r1:08.45",
   "target": "The shop closes early today.",
