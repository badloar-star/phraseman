import Ionicons from '@expo/vector-icons/Ionicons';
import React, { memo } from 'react';
import { StyleSheet, Text, View } from 'react-native';
import { ACHIEVEMENT_CATALOG_V2 } from '../../app/achievement_catalog_v2';
import { achievementNameForLang } from '../../app/achievements';
import type { Lang } from '../../constants/i18n';
import type { ProfileCardShowcase as Showcase } from '../../shared/profile_card_showcase';
import AchievementArt from '../AchievementArt';
import type { ProfileCardLookTokens } from './profile_card_looks';
import { showcaseStreakLabel } from './profile_card_showcase_copy';

function ProfileCardShowcase({ value, tokens, lang }: Readonly<{ value: Showcase; tokens: ProfileCardLookTokens; lang: Lang }>) {
  return <View testID="profile-card-showcase" style={styles.root}>
    {value.showStreak ? <View style={styles.streak} testID="profile-card-showcase-streak">
      <Ionicons name="flame" size={17} color={tokens.rankText} />
      <Text style={[styles.streakText, { color: tokens.rankText }]}>{showcaseStreakLabel(lang, value.streakDays)}</Text>
    </View> : null}
    {value.awardIds.length > 0 ? <View style={styles.awards}>{value.awardIds.map((id) => {
      const award = ACHIEVEMENT_CATALOG_V2.find((item) => item.id === id);
      if (!award) return null;
      return <View key={id} style={styles.award} accessible accessibilityLabel={achievementNameForLang(award, lang)} testID={`profile-card-award-${id}`}>
        <AchievementArt achievementId={id} size={82} tintColor={tokens.rankText} />
        <Text style={[styles.label, { color: tokens.rankText }]} numberOfLines={2}>{achievementNameForLang(award, lang)}</Text>
      </View>;
    })}</View> : null}
  </View>;
}
export default memo(ProfileCardShowcase);
const styles = StyleSheet.create({
  root: { paddingHorizontal: 22, paddingTop: 10, paddingBottom: 4 },
  streak: { flexDirection: 'row', justifyContent: 'center', alignItems: 'center', gap: 7, paddingVertical: 6 },
  streakText: { fontSize: 14, fontWeight: '700', flexShrink: 1 },
  awards: { flexDirection: 'row', justifyContent: 'space-evenly', gap: 8, paddingTop: 8 },
  award: { flex: 1, alignItems: 'center', minWidth: 0 },
  label: { fontSize: 12, lineHeight: 16, fontWeight: '400', textAlign: 'center', marginTop: 4 },
});
