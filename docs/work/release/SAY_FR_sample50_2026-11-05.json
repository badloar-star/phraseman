  "uk": "льо діма́нш ну манжіо́н анса́нбль"
 },
 {
  "id": "fr:21:13",
  "fr": "La rue était vide quand Paul est sorti.",
  "ru": "ла рю етэ́ вид кан поль э сорти́",
  "uk": "ла рю ете́ від кан поль е сорті́"
 },
 {
  "id": "fr:22:19",
  "fr": "Le pull, je l’essaie.",
  "ru": "лё пюль жё лэсэ́",
  "uk": "льо пюль же лесе́"
 },
 {
  "id": "fr:23:11",
  "fr": "Je lui téléphone ce soir.",
  "ru": "жё люи телефо́н сэ суа́р",
  "uk": "же люі телефо́н се суа́р"
 },
 {
  "id": "fr:24:12",
  "fr": "Elle y habite avec sa sœur.",
  "ru": "эль и аби́т авэ́к са сёр",
  "uk": "ель і абі́т аве́к са сьор"
 },
 {
  "id": "fr:25:09",
  "fr": "J’en ai assez.",
  "ru": "жан э асе́",
  "uk": "жан е асе́"
 },
 {
  "id": "fr:26:27",
  "fr": "Tu cuisines mieux que moi.",
  "ru": "тю кюизи́н мьё́ кё муа́",
