+typedef NS_ENUM(NSInteger, EXAccountSQLiteLeaseAdmission) {
+  EXAccountSQLiteLeaseAdmissionAdmitted = 0,
+  EXAccountSQLiteLeaseAdmissionRevoked = 1,
+  EXAccountSQLiteLeaseAdmissionBusy = 2,
+  EXAccountSQLiteLeaseAdmissionUnsupported = 3,
+} NS_SWIFT_NAME(AccountSQLiteLeaseAdmission);
+
+NS_SWIFT_NAME(AccountSQLiteLeaseAtomic)
+@interface EXAccountSQLiteLeaseAtomic : NSObject
+
+@property(nonatomic, readonly, getter=isRevoked) BOOL revoked;
+@property(nonatomic, readonly, getter=isLockFree) BOOL lockFree;
+
+- (EXAccountSQLiteLeaseAdmission)beginOperation;
+- (void)finishOperation;
+- (EXAccountSQLiteLeaseAdmission)beginCommitWithToken:(uint64_t *)token
+  NS_SWIFT_NAME(beginCommit(token:));
+- (void)finishCommitWithToken:(uint64_t)token NS_SWIFT_NAME(finishCommit(token:));
+- (void)revoke;
+- (void)notifyWhenDrainedOn:(dispatch_queue_t)queue
+                      block:(dispatch_block_t)block NS_SWIFT_NAME(notifyWhenDrained(on:block:));
+
+@end
+
+NS_ASSUME_NONNULL_END
