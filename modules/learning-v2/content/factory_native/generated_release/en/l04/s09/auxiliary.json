        "en:lesson-04:session-09:intro1:r3": {
          "ru": "Перед одним специалистом нужно `a`: `a dentist`.",
          "uk": "Перед одним фахівцем потрібне `a`: `a dentist`."
        }
      }
    },
    {
      "interactionId": "en:lesson-04:session-09:intro2:q",
      "responseFeedbackById": {
        "en:lesson-04:session-09:intro2:r2": {
          "ru": "Библиотек несколько: `Are there libraries here?`.",
          "uk": "Бібліотек кілька: `Are there libraries here?`."
