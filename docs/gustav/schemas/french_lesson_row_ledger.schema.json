{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phraseman.local/gustav/french_lesson_row_ledger.schema.json",
  "title": "GUSTAV French Lesson Row Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "lessonId",
    "studyTarget",
    "sourceLocales",
    "sourceFile",
    "activationStatus",
    "activeAppSeedAllowed",
    "rows"
  ],
  "properties": {
    "schemaVersion": { "const": "gustav-french-lesson-row-ledger-v0" },
    "runId": { "type": "string", "minLength": 1 },
    "lessonId": { "type": "integer", "minimum": 1, "maximum": 32 },
    "studyTarget": { "const": "fr" },
    "sourceLocales": {
      "type": "array",
      "prefixItems": [
        { "const": "ru" },
        { "const": "uk" }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "sourceFile": { "type": "string", "minLength": 1 },
    "activationStatus": { "enum": ["blocked_pending_source_review", "approved_for_apply"] },
    "activeAppSeedAllowed": {
      "type": "boolean",
      "description": "Must stay false until every row has accepted source evidence and the runtime French source gate approves the lesson id."
    },
    "rows": {
      "type": "array",
      "minItems": 50,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "phraseId",
          "englishBase",
          "russianMeaning",
          "ukrainianMeaning",
          "proposedFrench",
          "wordsFr",
          "evidenceClaimIds",
          "requiredEvidence",
          "reviewerStatus",
          "activationStatus"
        ],
        "properties": {
          "phraseId": { "type": "string", "pattern": "^lesson\\d+_phrase_\\d+$" },
          "englishBase": { "type": "string", "minLength": 1 },
          "russianMeaning": { "type": "string", "minLength": 1 },
          "ukrainianMeaning": { "type": "string", "minLength": 1 },
          "proposedFrench": {
            "anyOf": [
              { "type": "null" },
              { "type": "string", "minLength": 1 }
            ]
          },
          "wordsFr": {
            "anyOf": [
              { "type": "null" },
              {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["text", "correct", "distractors", "category"],
                  "properties": {
                    "text": { "type": "string", "minLength": 1 },
                    "correct": { "type": "string", "minLength": 1 },
                    "distractors": {
                      "type": "array",
                      "items": { "type": "string" },
                      "minItems": 1
                    },
                    "category": { "type": "string", "minLength": 1 }
                  }
                }
              }
            ]
          },
          "evidenceClaimIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "requiredEvidence": {
            "type": "array",
            "items": {
              "enum": [
                "english_base_phrase_inventory",
                "bilingual_dictionary_or_parallel_source",
                "french_grammar_reference",
                "ru_uk_meaning_review",
                "lesson_order_review",
                "rich_intro_source_notes"
              ]
            },
            "minItems": 1
          },
          "reviewerStatus": {
            "enum": [
              "blocked_pending_source_review",
              "accepted",
              "needs_review",
              "rejected"
            ]
          },
          "activationStatus": { "enum": ["blocked", "approved_for_apply"] }
        }
      }
    }
  }
}
