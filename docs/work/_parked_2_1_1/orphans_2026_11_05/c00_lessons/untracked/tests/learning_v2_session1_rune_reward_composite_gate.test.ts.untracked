let mockLearningV2Hidden = false;

// Jest resolves transformed modules without the CLI gate's node:module hook.
// Keep the same mutable historical-only seam here: false for fixture creation,
// true before the public guard and real recovery are exercised.
jest.mock('../app/learning_v2_visibility_switch', () => {
  const actual = jest.requireActual('../app/learning_v2_visibility_switch');
  const mocked = {
    ...actual,
    isLearningV2Hidden: () => mockLearningV2Hidden,
  };
  Object.defineProperty(mocked, 'LEARNING_V2_HIDDEN', {
    enumerable: true,
    get: () => mockLearningV2Hidden,
  });
  return mocked;
});

import {
  createLearningV2OwnerRepositoryAsyncStorage,
  recoverPendingLearningV2SessionRuneRewardIntentsV1,
} from '../app/learning_v2_owner_repository_runtime';
import {
  beginAccountGeneration,
  invalidateAccountGeneration,
} from '../app/account_generation';
import { peekCurrentLearningV2WalletBalance } from '../app/learning_v2_wallet_balance_store';
import { deriveLearningV2EconomicAccountScopeHash } from '../modules/learning-v2/progress/economic_account_scope';
import { deriveProgressAccountScopeHash } from '../modules/learning-v2/progress/progress_account_scope';
import { deriveLearningV2SessionRuneRewardOperationIdV1 } from '../modules/learning-v2/progress/learning_session_rune_reward_composite_v1';
import { canonicalJsonV1, hashCanonicalBody } from '../modules/learning-v2/policies/decision_registry';
import {
  materializeHistoricalProtectedRuneRewardFixture,
  runLearningV2Session1RuneRewardCompositeGate,
} from './learning_v2_session1_rune_reward_composite_gate';

jest.setTimeout(180_000);

test('populated protected session-rune intent recovers under permanent-off and replays one ledger receipt', async () => {
  mockLearningV2Hidden = false;
  await runLearningV2Session1RuneRewardCompositeGate({
    // Historical-fixture boundary only: product source stays permanently true.
    isLearningV2Hidden: () => mockLearningV2Hidden,
  });

  const stableUid = 'historical-rune-recovery-owner';
  const accountToken = beginAccountGeneration(stableUid);
  const accountScopeHash = deriveLearningV2EconomicAccountScopeHash(stableUid);
  const fixture = materializeHistoricalProtectedRuneRewardFixture(
    accountScopeHash,
  );
  const operationId = deriveLearningV2SessionRuneRewardOperationIdV1(
    fixture.candidate,
  );
  const intentKey = `learning-v2:session-rune-reward-intent:v1:${accountScopeHash}:${encodeURIComponent(operationId)}`;
  const protectedKey = `learning_v2_rune_reward_intent_v1_${hashCanonicalBody({
    accountScopeHash,
    operationId,
  })}`;
  const intentRaw = canonicalJsonV1(fixture.intent);
  const protectedRaw = canonicalJsonV1(fixture.protectedReceipt);
  const intentValues = new Map([[intentKey, intentRaw]]);
  const protectedValues = new Map<string, string>();
  const ownerValues = new Map<string, string>();
  const intentStorage = {
    getAllKeys: async () => [...intentValues.keys()],
    getItem: async (key: string) => intentValues.get(key) ?? null,
    setItem: async (key: string, value: string) => { intentValues.set(key, value); },
    removeItem: async (key: string) => { intentValues.delete(key); },
  };
  const protectedReceiptStorage = {
    getItem: async (key: string) => protectedValues.get(key) ?? null,
    setItem: async (key: string, value: string) => { protectedValues.set(key, value); },
    removeItem: async (key: string) => { protectedValues.delete(key); },
  };
  const binding = Object.freeze({
    schemaVersion: 'learning-v2-account-binding.v2' as const,
    stableUid,
    accountGeneration: accountToken.generation,
    economicAccountScopeHash: accountScopeHash,
    progressAccountScopeHash: deriveProgressAccountScopeHash(
      stableUid,
      accountToken.generation,
    ),
  });
  const storage = createLearningV2OwnerRepositoryAsyncStorage(
    binding,
    accountToken,
    {
      getItem: async (key: string) => ownerValues.get(key) ?? null,
      setItem: async (key: string, value: string) => { ownerValues.set(key, value); },
      removeItem: async (key: string) => { ownerValues.delete(key); },
    },
  );
  const dependencies = {
    accountToken,
    storage,
    sessionRuneRewardIntentStorage: intentStorage,
    sessionRuneRewardProtectedReceiptStorage: protectedReceiptStorage,
  };

  mockLearningV2Hidden = true;
  const releasedClient = require(
    '../app/learning_v2_course_released_session_client_v3'
  ) as typeof import('../app/learning_v2_course_released_session_client_v3');
  await expect(releasedClient.prepareCurrentLearningV2CourseSessionV3({
    locator: {
      environment: 'production',
      targetLanguage: 'en',
      studyTarget: 'en',
      learnerSourceLocale: 'ru',
      seasonId: 'learning-v2',
      lessonOrdinal: 1,
      sessionOrdinal: 1,
    },
    sessionRunId: 'full-off-public-prepare-proof',
  })).rejects.toThrow('learning_v2_disabled_by_owner');

  await expect(
    recoverPendingLearningV2SessionRuneRewardIntentsV1(dependencies),
  ).resolves.toEqual({ applied: 0, replayed: 0, remaining: 1, failed: 1 });
  expect(peekCurrentLearningV2WalletBalance()).toBeNull();

  protectedValues.set(protectedKey, protectedRaw);
  await expect(
    recoverPendingLearningV2SessionRuneRewardIntentsV1(dependencies),
  ).resolves.toEqual({ applied: 1, replayed: 0, remaining: 0, failed: 0 });
  const appliedBalance = peekCurrentLearningV2WalletBalance();
  expect(appliedBalance?.balanceSubunits).toBeGreaterThan(0);
  expect(intentValues.size).toBe(0);
  expect(protectedValues.size).toBe(0);

  intentValues.set(intentKey, intentRaw);
  protectedValues.set(protectedKey, protectedRaw);
  await expect(
    recoverPendingLearningV2SessionRuneRewardIntentsV1(dependencies),
  ).resolves.toEqual({ applied: 0, replayed: 1, remaining: 0, failed: 0 });
  expect(peekCurrentLearningV2WalletBalance()).toEqual(appliedBalance);
  expect(intentValues.size).toBe(0);
  expect(protectedValues.size).toBe(0);

  invalidateAccountGeneration();
});
