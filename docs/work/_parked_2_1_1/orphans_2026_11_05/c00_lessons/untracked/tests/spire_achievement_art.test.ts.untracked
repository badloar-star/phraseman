import fs from 'node:fs';
import path from 'node:path';
import sharp from 'sharp';
import { SPIRE_ACHIEVEMENT_SLUGS } from '../modules/spire/achievement_progress';
import { getAchievementImageUrl } from '../constants/achievement_image_urls';
import { spireCollectibleCopy } from '../modules/spire/achievement_copy';
import { SPIRE_TIER_NAMES } from '../modules/spire/tier_names';

it('connects 12 compressed transparent images with exact catalog IDs and no nonexistent remote URLs', async () => {
  const root = process.cwd();
  const registry = fs.readFileSync(path.join(root, 'constants/spireAchievementImageAssets.ts'), 'utf8');
  const rows = JSON.parse(fs.readFileSync(path.join(root, 'content/spire-achievement-art/manifest.json'), 'utf8')) as Array<{ id: string; file: string }>;
  expect(rows.map(row => row.id)).toEqual(SPIRE_ACHIEVEMENT_SLUGS.map(slug => `spire_summit_${slug}`));
  for (const row of rows) {
    expect(registry).toContain(`${row.id}: require('../${row.file}')`);
    expect(getAchievementImageUrl(row.id)).toBeUndefined();
    const file = path.join(root, row.file);
    const meta = await sharp(file).metadata();
    expect(meta).toMatchObject({ format: 'webp', width: 640, height: 640, hasAlpha: true });
    const pixel = await sharp(file).extract({ left: 0, top: 0, width: 1, height: 1 }).raw().toBuffer();
    expect(pixel[3]).toBe(0);
  }
});

it('supplies name, condition and stage description in all interface languages', () => {
  for (const lang of Object.keys(SPIRE_TIER_NAMES) as Array<keyof typeof SPIRE_TIER_NAMES>) {
    for (const slug of SPIRE_ACHIEVEMENT_SLUGS) {
      for (const field of ['name', 'condition', 'desc'] as const) {
        const text = spireCollectibleCopy(`spire_summit_${slug}`, lang, field);
        expect(text?.length).toBeGreaterThan(5);
        if (lang !== 'ru' && lang !== 'uk') expect(text).not.toMatch(/[А-Яа-яЁё]/);
      }
    }
  }
});
