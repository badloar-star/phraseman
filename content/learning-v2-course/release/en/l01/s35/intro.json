  "learningOutcomeByLocale": {
    "ru": "`We are not` + слово о нас"
  },
  "pages": [
    {
      "pageOrdinal": 1,
      "pageId": "en:lesson-01:session-35:intro1",
      "kind": "concept",
      "titleByLocale": {
        "ru": "`not` встаёт после `are`"
      },
      "bodyByLocale": {
        "ru": "`we` — «мы». Скрепка при нём — `are`: `We are late` — «мы опаздываем».\n\nЧтобы получилось «не», добавляем `not`. Место у него жёсткое: сразу за `are`, перед словом о вас. Не перед `are`, не в конец — `We are not late`."
      },
      "question": {
        "interactionId": "en:lesson-01:session-35:intro1:q",
        "promptByLocale": {
          "ru": "Кто-то на ходу: «Мы же опаздываем?» Времени полно. Скажите, что нет."
        },
        "choicesByLocale": {
          "ru": [
            {
              "responseId": "en:lesson-01:session-35:intro1:r1",
              "text": "We are not late."
            },
            {
              "responseId": "en:lesson-01:session-35:intro1:r2",
              "text": "We not are late."
            },
            {
              "responseId": "en:lesson-01:session-35:intro1:r3",
              "text": "We are late not."
            }
          ]
        },
        "accessibilityLabelByLocale": {
          "ru": "Кто-то на ходу: «Мы же опаздываем?» Времени полно. Скажите, что нет."
        }
      }
    },
    {
      "pageOrdinal": 2,
      "pageId": "en:lesson-01:session-35:intro2",
      "kind": "formula",
      "titleByLocale": {
        "ru": "`sure` — «уверен»"
      },
      "bodyByLocale": {
        "ru": "`sure` — «уверен, знаю точно». `We are sure` — «мы уверены».\n\nОтрицание к нему пригодится чаще самого слова: `We are not sure` — «мы не уверены». Это вежливое «понятия не имею»: и правду не соврали, и виноватым никто не выглядит."
      },
      "question": {
        "interactionId": "en:lesson-01:session-35:intro2:q",
        "promptByLocale": {
          "ru": "Спрашивают, работает ли кафе через дорогу. Никто не знает. Ответьте за всех."
        },
        "choicesByLocale": {
          "ru": [
            {
              "responseId": "en:lesson-01:session-35:intro2:r1",
              "text": "We are not sure."
            },
            {
              "responseId": "en:lesson-01:session-35:intro2:r2",
              "text": "We no sure."
            },
            {
              "responseId": "en:lesson-01:session-35:intro2:r3",
              "text": "We are sure not."
            }
          ]
        },
        "accessibilityLabelByLocale": {
          "ru": "Спрашивают, работает ли кафе через дорогу. Никто не знает. Ответьте за всех."
        }
      }
    },
    {
      "pageOrdinal": 3,
      "pageId": "en:lesson-01:session-35:intro3",
      "kind": "trap",
      "titleByLocale": {
        "ru": "`wrong` — «неправ»"
      },
      "bodyByLocale": {
        "ru": "`wrong` — «неправ, ошибся». Сказал уверенно — и мимо.\n\nСлово это про человека, а не про дело: `We are wrong` — «мы ошибаемся», а не «у нас что-то сломалось». И спорить им можно за всю компанию сразу: `We are not wrong`."
      },
      "question": {
        "interactionId": "en:lesson-01:session-35:intro3:q",
        "promptByLocale": {
          "ru": "Вам говорят, что вы всё перепутали. Ничего вы не перепутали. Скажите это."
        },
        "choicesByLocale": {
          "ru": [
            {
              "responseId": "en:lesson-01:session-35:intro3:r1",
              "text": "We are not wrong."
            },
            {
              "responseId": "en:lesson-01:session-35:intro3:r2",
              "text": "We not wrong."
            },
            {
              "responseId": "en:lesson-01:session-35:intro3:r3",
              "text": "We are not late."
            }
          ]
        },
        "accessibilityLabelByLocale": {
          "ru": "Вам говорят, что вы всё перепутали. Ничего вы не перепутали. Скажите это."
        }
      }
    }
  ],
