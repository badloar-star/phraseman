  {
   "id": "en-classic-r1:22.01",
   "target": "Swimming helps me relax.",
   "ru": "Плавание помогает мне расслабиться.",
   "uk": "Плавання допомагає мені розслабитися."
  },
  {
   "id": "en-classic-r1:22.02",
   "target": "Walking saves money.",
   "ru": "Ходьба экономит деньги.",
   "uk": "Ходьба економить гроші."
  },
  {
   "id": "en-classic-r1:22.03",
   "target": "Cooking takes practice.",
   "ru": "Готовка требует практики.",
   "uk": "Приготування їжі вимагає практики."
  },
  {
   "id": "en-classic-r1:22.04",
   "target": "Reading on the bus makes me dizzy.",
   "ru": "Чтение в автобусе вызывает у меня головокружение.",
   "uk": "Читання в автобусі викликає у мене запаморочення."
  },
  {
   "id": "en-classic-r1:22.05",
   "target": "Driving in fog is difficult.",
   "ru": "Ездить в тумане сложно.",
   "uk": "Керувати автомобілем у тумані важко."
  },
  {
   "id": "en-classic-r1:22.06",
   "target": "Waiting outside is not much fun.",
   "ru": "Ожидание на улице не доставляет удовольствия.",
   "uk": "Чекати надворі не дуже весело."
  },
  {
   "id": "en-classic-r1:22.07",
   "target": "Learning a new route takes time.",
   "ru": "Изучение нового маршрута занимает время.",
   "uk": "Вивчення нового маршруту потребує часу."
  },
  {
   "id": "en-classic-r1:22.08",
   "target": "Sharing a flat costs less.",
   "ru": "Снимать квартиру вместе дешевле.",
   "uk": "Ділити квартиру коштує менше."
  },
  {
   "id": "en-classic-r1:22.09",
   "target": "Travelling light is easier.",
   "ru": "Путешествовать налегке проще.",
   "uk": "Подорожувати без багажу легше."
  },
  {
   "id": "en-classic-r1:22.10",
   "target": "Working nights suits my brother.",
   "ru": "Работа в ночную смену подходит моему брату.",
   "uk": "Робота вночі підходить моєму братові."
  },
  {
   "id": "en-classic-r1:22.11",
   "target": "I enjoy cooking for friends.",
   "ru": "Мне нравится готовить для друзей.",
   "uk": "Мені подобається готувати для друзів."
  },
  {
   "id": "en-classic-r1:22.12",
   "target": "She enjoys walking by the river.",
   "ru": "Ей нравится гулять у реки.",
   "uk": "Їй подобається гуляти біля річки."
  },
  {
   "id": "en-classic-r1:22.13",
   "target": "He avoids driving at night.",
   "ru": "Он избегает вождения ночью.",
   "uk": "Він уникає їздити за кермом вночі."
  },
  {
   "id": "en-classic-r1:22.14",
   "target": "We finished packing before lunch.",
   "ru": "Мы закончили собирать вещи до обеда.",
   "uk": "Ми закінчили пакувати речі до обіду."
  },
  {
   "id": "en-classic-r1:22.15",
   "target": "They stopped talking at the door.",
   "ru": "Они перестали разговаривать у двери.",
   "uk": "Вони перестали розмовляти біля дверей."
  },
  {
   "id": "en-classic-r1:22.16",
   "target": "I miss working with Anna.",
   "ru": "Я скучаю по работе с Анной.",
   "uk": "Я сумую за роботою з Анною."
  },
  {
   "id": "en-classic-r1:22.17",
   "target": "She keeps losing her keys.",
   "ru": "Она постоянно теряет ключи.",
   "uk": "Вона постійно губить ключі."
  },
  {
   "id": "en-classic-r1:22.18",
   "target": "Do you mind waiting here?",
   "ru": "Не могли бы вы подождать здесь?",
   "uk": "Ви не проти почекати тут?"
  },
  {
   "id": "en-classic-r1:22.19",
   "target": "He suggested sharing a taxi.",
   "ru": "Он предложил разделить такси.",
   "uk": "Він запропонував поїхати разом на таксі."
  },
  {
   "id": "en-classic-r1:22.20",
   "target": "We practise speaking after class.",
   "ru": "Мы практикуем разговорную речь после занятий.",
   "uk": "Ми практикуємо розмову після заняття."
  },
  {
   "id": "en-classic-r1:22.21",
   "target": "Thank you for helping me.",
   "ru": "Спасибо за помощь.",
   "uk": "Дякую за допомогу."
  },
  {
   "id": "en-classic-r1:22.22",
   "target": "She is good at fixing bikes.",
   "ru": "Она хорошо чинит велосипеды.",
   "uk": "Вона добре ремонтує велосипеди."
  },
  {
   "id": "en-classic-r1:22.23",
   "target": "I am tired of carrying this bag.",
   "ru": "Я устал носить эту сумку.",
   "uk": "Я втомився носити цю сумку."
  },
  {
   "id": "en-classic-r1:22.24",
   "target": "He is interested in learning English.",
   "ru": "Он заинтересован в изучении английского языка.",
   "uk": "Він зацікавлений у вивченні англійської мови."
  },
  {
   "id": "en-classic-r1:22.25",
   "target": "We talked about moving house.",
   "ru": "Мы говорили о переезде.",
   "uk": "Ми говорили про переїзд."
  },
  {
   "id": "en-classic-r1:22.26",
   "target": "She left without saying goodbye.",
   "ru": "Она ушла, не попрощавшись.",
   "uk": "Вона пішла, не попрощавшись."
  },
  {
   "id": "en-classic-r1:22.27",
   "target": "Check the date before paying.",
   "ru": "Проверьте дату перед оплатой.",
   "uk": "Перевірте дату перед оплатою."
  },
  {
   "id": "en-classic-r1:22.28",
   "target": "Wash your hands before cooking.",
   "ru": "Мойте руки перед приготовлением пищи.",
   "uk": "Мийте руки перед приготуванням їжі."
  },
  {
   "id": "en-classic-r1:22.29",
   "target": "After finishing work, I went home.",
   "ru": "После работы я пошел домой.",
   "uk": "Після закінчення роботи я пішов додому."
  },
  {
   "id": "en-classic-r1:22.30",
   "target": "I learnt the route by walking it.",
   "ru": "Я выучил маршрут пешком.",
   "uk": "Я вивчив маршрут, пройшовши його."
  },
  {
   "id": "en-classic-r1:22.31",
   "target": "I look forward to meeting you.",
   "ru": "Я с нетерпением жду встречи с вами.",
   "uk": "З нетерпінням чекаю зустрічі з вами."
  },
  {
   "id": "en-classic-r1:22.32",
   "target": "She is afraid of waking the baby.",
   "ru": "Она боится разбудить ребенка.",
   "uk": "Вона боїться розбудити дитину."
  },
  {
   "id": "en-classic-r1:22.33",
   "target": "He apologised for arriving late.",
   "ru": "Он извинился за опоздание.",
   "uk": "Він вибачився за те, що прийшов пізно."
  },
  {
   "id": "en-classic-r1:22.34",
   "target": "We saved money by taking the bus.",
   "ru": "Мы сэкономили деньги, поехав на автобусе.",
   "uk": "Ми заощадили гроші, поїхавши автобусом."
  },
  {
   "id": "en-classic-r1:22.35",
   "target": "She insisted on paying her share.",
   "ru": "Она настояла на том, чтобы заплатить свою долю.",
   "uk": "Вона наполягала на тому, щоб заплатити свою частку."
  },
  {
   "id": "en-classic-r1:22.36",
   "target": "Is this button for turning the screen off?",
   "ru": "Эта кнопка для выключения экрана?",
   "uk": "Ця кнопка призначена для вимкнення екрана?"
  },
  {
   "id": "en-classic-r1:22.37",
   "target": "He is thinking about changing jobs.",
   "ru": "Он подумывает о смене работы.",
   "uk": "Він думає про зміну роботи."
  },
  {
   "id": "en-classic-r1:22.38",
   "target": "They complained about waiting in the rain.",
   "ru": "Они жаловались на ожидание под дождем.",
   "uk": "Вони скаржилися на очікування під дощем."
  },
  {
   "id": "en-classic-r1:22.39",
   "target": "I am worried about missing the last train.",
   "ru": "Я боюсь опоздать на последний поезд.",
   "uk": "Я хвилююся, що пропущу останній поїзд."
  },
  {
   "id": "en-classic-r1:22.40",
   "target": "She thanked me for lending her a pen.",
   "ru": "Она поблагодарила меня за то, что я одолжил ей ручку.",
   "uk": "Вона подякувала мені за те, що я позичив їй ручку."
  },
  {
   "id": "en-classic-r1:22.41",
   "target": "Do you mind closing the door?",
   "ru": "Не могли бы вы закрыть дверь?",
   "uk": "Ви не проти зачинити двері?"
  },
  {
   "id": "en-classic-r1:22.42",
   "target": "We considered booking a later flight.",
   "ru": "Мы подумывали забронировать более поздний рейс.",
   "uk": "Ми розглядали можливість забронювати пізніший рейс."
  },
  {
   "id": "en-classic-r1:22.43",
   "target": "I cannot imagine living without a kitchen.",
   "ru": "Я не могу представить себе жизнь без кухни.",
   "uk": "Я не можу уявити життя без кухні."
  },
  {
   "id": "en-classic-r1:22.44",
   "target": "She admitted taking the wrong bag.",
   "ru": "Она призналась, что взяла не ту сумку.",
   "uk": "Вона зізналася, що взяла не ту сумку."
  },
  {
   "id": "en-classic-r1:22.45",
   "target": "He finished writing the address.",
   "ru": "Он закончил писать адрес.",
   "uk": "Він закінчив писати адресу."
  },
  {
   "id": "en-classic-r1:22.46",
   "target": "I prefer walking to waiting for the bus.",
   "ru": "Я предпочитаю ходить пешком, а не ждать автобус.",
   "uk": "Я волію йти пішки, ніж чекати на автобус."
  },
  {
   "id": "en-classic-r1:22.47",
   "target": "They avoided waking the baby.",
   "ru": "Они постарались не разбудить ребёнка.",
   "uk": "Вони постаралися не розбудити дитину."
  },
  {
   "id": "en-classic-r1:22.48",
   "target": "Try reading the number aloud.",
   "ru": "Попробуйте прочитать номер вслух.",
   "uk": "Спробуйте прочитати номер вголос."
  },
  {
   "id": "en-classic-r1:22.49",
   "target": "I remember locking the front door.",
   "ru": "Я помню, как запер входную дверь.",
   "uk": "Я пам'ятаю, як замкнув вхідні двері."
  },
  {
   "id": "en-classic-r1:22.50",
   "target": "We stopped to buy water, then carried on walking.",
   "ru": "Мы остановились, чтобы купить воды, а затем продолжили идти.",
   "uk": "Ми зупинилися, щоб купити води, а потім продовжили йти."
