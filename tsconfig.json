{
  "//": "zachem (audit 2026-08-23): проверка типов падала по памяти на 4 ГБ и не работала ВООБЩЕ. Причина: include '**/*.ts' затягивал временные копии рабочего дерева (.codex-tmp, .worktrees, .claude/worktrees) — 57136 файлов TS против 2195 реальных, в 26 раз больше проекта. Git их игнорирует, а компилятор нет. НЕ убирать эти exclude: без них полная проверка типов снова станет невозможной, и придётся городить срезы вроде tsconfig.arena.json.",
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "functions",
    "docs/motion-handoff",
    "tests",
    "_archive",
    // Historical Learning V2 evidence copies and retired DE Task 6c CLIs are not app/runtime sources.
    "content/learning-v2-course/curriculum/de/_archive_2026-10-15",
    "content/learning-v2-course/outputs/**/source-snapshot",
    "scripts/build_learning_v2_de_task6c_l02_capture_archive_v3.ts",
    "scripts/build_learning_v2_de_task6c_l02_capture_predicate_v3.ts",
    "scripts/capture_learning_v2_de_task6c_l02_identity_sources_v4.ts",
    "scripts/inspect_learning_v2_de_task6c_l02_identity_capture_v4.ts",
    "scripts/learning-v2-de-task6c-four-noun-review-attempt-gate.ts",
    "scripts/prepare_learning_v2_de_task6c_l02_capture_v2.ts",
    "scripts/produce_learning_v2_de_task6c_l02_capture_v3.ts",
    "scripts/verify_learning_v2_de_task6c_l02_capture_transport_v2.ts",
    "scripts/verify_learning_v2_de_task6c_l02_remote_governance_v1.ts",
    "docs/reports",
    "docs/design",
    "subscription-recovery",
    "tmp",
    "node_modules",
    ".codex-tmp",
    ".worktrees",
    ".claude/worktrees",
    ".expo/web-build"
  ]
}
