{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phraseman.local/gustav/source_graph.schema.json",
  "title": "GUSTAV Source Graph Minimal Schema",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "graphId",
    "generatedAt",
    "repoRoot",
    "inputRef",
    "baseStudyTarget",
    "supportedSourceLocalesObserved",
    "studyTargetsObserved",
    "lessons",
    "introScreens",
    "phrases",
    "words",
    "quizzes",
    "prepositionPacks",
    "flashcards",
    "dailyPhrases",
    "personalPractice",
    "surfaces",
    "sourceFiles",
    "generatedFiles",
    "unresolved",
    "validation"
  ],
  "properties": {
    "schemaVersion": { "const": "gustav-source-graph-v0" },
    "graphId": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string" },
    "repoRoot": { "type": "string", "minLength": 1 },
    "inputRef": {
      "type": "object",
      "additionalProperties": true,
      "required": ["gitStatusSummary"],
      "properties": {
        "gitCommit": { "type": "string" },
        "gitStatusSummary": { "type": "string" },
        "atlasGeneratedAt": { "type": "string" }
      }
    },
    "baseStudyTarget": { "const": "en" },
    "supportedSourceLocalesObserved": {
      "type": "array",
      "items": { "enum": ["ru", "uk", "es", "pt-BR", "vi", "id", "tr", "pl"] },
      "uniqueItems": true
    },
    "studyTargetsObserved": {
      "type": "array",
      "items": { "enum": ["en", "fr", "de", "es"] },
      "uniqueItems": true
    },
    "lessons": { "type": "array" },
    "introScreens": { "type": "array" },
    "phrases": { "type": "array" },
    "words": { "type": "array" },
    "quizzes": { "type": "array" },
    "prepositionPacks": { "type": "array" },
    "flashcards": { "type": "array" },
    "dailyPhrases": { "type": "array" },
    "personalPractice": { "type": "array" },
    "surfaces": { "type": "array" },
    "sourceFiles": { "type": "array" },
    "generatedFiles": { "type": "array" },
    "unresolved": { "type": "array" },
    "validation": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "verdict",
        "totalLessons",
        "totalPhrases",
        "totalIntroScreens",
        "totalQuizzes",
        "totalPersonalPracticeNodes",
        "totalSurfaces",
        "unresolvedBlockers",
        "unresolvedHighRisks",
        "generatedFileUnknowns",
        "sourceLocaleTargetConfusions",
        "notes"
      ],
      "properties": {
        "verdict": { "enum": ["PASS", "HOLD", "BLOCK"] },
        "totalLessons": { "type": "integer", "minimum": 0 },
        "totalPhrases": { "type": "integer", "minimum": 0 },
        "totalIntroScreens": { "type": "integer", "minimum": 0 },
        "totalQuizzes": { "type": "integer", "minimum": 0 },
        "totalPersonalPracticeNodes": { "type": "integer", "minimum": 0 },
        "totalSurfaces": { "type": "integer", "minimum": 0 },
        "unresolvedBlockers": { "type": "integer", "minimum": 0 },
        "unresolvedHighRisks": { "type": "integer", "minimum": 0 },
        "generatedFileUnknowns": { "type": "integer", "minimum": 0 },
        "sourceLocaleTargetConfusions": { "type": "integer", "minimum": 0 },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
