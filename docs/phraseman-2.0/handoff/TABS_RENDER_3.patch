+++ b/tests/tabs_layout_memo_contract.test.ts
@@ -0,0 +1,22 @@
+// зачем (координатор 14.10, каскад [TABS-RENDER], патч TABS_RENDER_3): TabLayout подписан на usePathname (редирект турниров) и на каждую смену
+// маршрута создавал новый <ReleasedTabLayout/> — разметка вкладок рендерилась «от родителя». Сторож: разметка без пропсов и под React.memo.
+import { readSource } from './helpers/read_source';
+
+const source = readSource('app/(tabs)/_layout.tsx');
+
+describe('tabs layout is memoized against parent re-renders', () => {
+  it('ReleasedTabLayout takes no props, so memo always bails out on a parent render', () => {
+    expect(source).toContain('function ReleasedTabLayout() {');
+    expect(source).toContain('const ReleasedTabLayoutMemo = React.memo(ReleasedTabLayout);');
+  });
+
+  it('TabLayout renders the memoized layout inside the layout:tabs probe', () => {
+    const start = source.indexOf('export default function TabLayout()');
+    expect(start).toBeGreaterThan(0);
+    const body = source.slice(start);
+    expect(body).toContain('<TabRenderProbe id="layout:tabs"><ReleasedTabLayoutMemo /></TabRenderProbe>');
+    expect(body).not.toContain('<ReleasedTabLayout />');
+    // редирект турниров остаётся на родителе
+    expect(body).toContain('isDisabledTournamentTabPath(pathname)');
+  });
+});
