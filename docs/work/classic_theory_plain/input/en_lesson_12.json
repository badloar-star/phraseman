 "phrases": [
  {
   "id": "en-classic-r1:12.01",
   "target": "I went home early.",
   "ru": "Я ушел домой раньше.",
   "uk": "Я пішов додому раніше."
  },
  {
   "id": "en-classic-r1:12.02",
   "target": "She went to the bank.",
   "ru": "Она пошла в банк.",
   "uk": "Вона пішла до банку."
  },
  {
   "id": "en-classic-r1:12.03",
   "target": "We took the bus home.",
   "ru": "Мы поехали домой на автобусе.",
   "uk": "Ми поїхали додому автобусом."
  },
  {
   "id": "en-classic-r1:12.04",
   "target": "He took my coat by mistake.",
   "ru": "Он по ошибке взял мое пальто.",
   "uk": "Він помилково взяв моє пальто."
  },
  {
   "id": "en-classic-r1:12.05",
   "target": "I bought fresh bread.",
   "ru": "Я купил свежий хлеб.",
   "uk": "Я купив свіжий хліб."
  },
  {
   "id": "en-classic-r1:12.06",
   "target": "They bought the last two tickets.",
   "ru": "Они купили последние два билета.",
   "uk": "Вони купили два останні квитки."
  },
  {
   "id": "en-classic-r1:12.07",
   "target": "She brought a spare key.",
   "ru": "Она принесла запасной ключ.",
   "uk": "Вона принесла запасний ключ."
  },
  {
   "id": "en-classic-r1:12.08",
   "target": "I brought you a towel.",
   "ru": "Я принес тебе полотенце.",
   "uk": "Я приніс тобі рушник."
  },
  {
   "id": "en-classic-r1:12.09",
   "target": "We found a quiet cafe.",
   "ru": "Мы нашли тихое кафе.",
   "uk": "Ми знайшли тихе кафе."
  },
  {
   "id": "en-classic-r1:12.10",
   "target": "He found his wallet downstairs.",
   "ru": "Он нашел свой кошелек внизу.",
   "uk": "Він знайшов свій гаманець внизу."
  },
  {
   "id": "en-classic-r1:12.11",
   "target": "I left my glasses at work.",
   "ru": "Я оставил свои очки на работе.",
   "uk": "Я залишив окуляри на роботі."
  },
  {
   "id": "en-classic-r1:12.12",
   "target": "She lost her bus pass.",
   "ru": "Она потеряла свой проездной на автобус.",
   "uk": "Вона загубила свій проїзний на автобус."
  },
  {
   "id": "en-classic-r1:12.13",
   "target": "We caught the early train.",
   "ru": "Мы сели на ранний поезд.",
   "uk": "Ми сіли на ранній поїзд."
  },
  {
   "id": "en-classic-r1:12.14",
   "target": "They got home at nine.",
   "ru": "Они вернулись домой в девять.",
   "uk": "Вони повернулися додому о дев'ятій."
  },
  {
   "id": "en-classic-r1:12.15",
   "target": "He gave me a lift.",
   "ru": "Он подвёз меня.",
   "uk": "Він мене підвіз."
  },
  {
   "id": "en-classic-r1:12.16",
   "target": "I met your sister yesterday.",
   "ru": "Я вчера встретил твою сестру.",
   "uk": "Я вчора зустрів твою сестру."
  },
  {
   "id": "en-classic-r1:12.17",
   "target": "She saw my message.",
   "ru": "Она видела моё сообщение.",
   "uk": "Вона побачила моє повідомлення."
  },
  {
   "id": "en-classic-r1:12.18",
   "target": "We heard the alarm.",
   "ru": "Мы услышали сигнал тревоги.",
   "uk": "Ми чули сигналізацію."
  },
  {
   "id": "en-classic-r1:12.19",
   "target": "I paid the bill online.",
   "ru": "Я оплатил счёт онлайн.",
   "uk": "Я оплатив рахунок онлайн."
  },
  {
   "id": "en-classic-r1:12.20",
   "target": "He sent me the address of the clinic.",
   "ru": "Он прислал мне адрес клиники.",
   "uk": "Він надіслав мені адресу клініки."
  },
  {
   "id": "en-classic-r1:12.21",
   "target": "She put the parcel by the door.",
   "ru": "Она положила посылку у двери.",
   "uk": "Вона поклала посилку біля дверей."
  },
  {
   "id": "en-classic-r1:12.22",
   "target": "I read the sign twice.",
   "ru": "Я дважды прочитал надпись.",
   "uk": "Я двічі прочитав напис."
  },
  {
   "id": "en-classic-r1:12.23",
   "target": "We ate lunch outside.",
   "ru": "Мы пообедали на улице.",
   "uk": "Ми обідали надворі."
  },
  {
   "id": "en-classic-r1:12.24",
   "target": "He drank the last of the milk.",
   "ru": "Он допил остатки молока.",
   "uk": "Він допив останнє молоко."
  },
  {
   "id": "en-classic-r1:12.25",
   "target": "They made a cake together.",
   "ru": "Они вместе испекли торт.",
   "uk": "Вони разом спекли торт."
  },
  {
   "id": "en-classic-r1:12.26",
   "target": "She wrote the price on the box.",
   "ru": "Она написала цену на коробке.",
   "uk": "Вона написала ціну на коробці."
  },
  {
   "id": "en-classic-r1:12.27",
   "target": "I forgot my password.",
   "ru": "Я забыл свой пароль.",
   "uk": "Я забув пароль."
  },
  {
   "id": "en-classic-r1:12.28",
   "target": "We chose the cheaper room.",
   "ru": "Мы выбрали более дешевый номер.",
   "uk": "Ми обрали дешевший номер."
  },
  {
   "id": "en-classic-r1:12.29",
   "target": "He broke his glasses.",
   "ru": "Он разбил свои очки.",
   "uk": "Він розбив окуляри."
  },
  {
   "id": "en-classic-r1:12.30",
   "target": "The glass fell off the shelf.",
   "ru": "Стакан упал с полки.",
   "uk": "Склянка впала з полиці."
  },
  {
   "id": "en-classic-r1:12.31",
   "target": "Did you find your keys?",
   "ru": "Ты нашёл свои ключи?",
   "uk": "Ти знайшов свої ключі?"
  },
  {
   "id": "en-classic-r1:12.32",
   "target": "Did she bring the charger?",
   "ru": "Она принесла зарядное устройство?",
   "uk": "Вона принесла зарядний пристрій?"
  },
  {
   "id": "en-classic-r1:12.33",
   "target": "Did he send the photo?",
   "ru": "Он отправил фото?",
   "uk": "Він надіслав фотографію?"
  },
  {
   "id": "en-classic-r1:12.34",
   "target": "Did they catch the bus?",
   "ru": "Они успели на автобус?",
   "uk": "Вони встигли на автобус?"
  },
  {
   "id": "en-classic-r1:12.35",
   "target": "Did you see the sign?",
   "ru": "Ты видел знак?",
   "uk": "Ти бачив знак?"
  },
  {
   "id": "en-classic-r1:12.36",
   "target": "We did not find a parking space.",
   "ru": "Мы не нашли парковочное место.",
   "uk": "Ми не знайшли місця для паркування."
  },
  {
   "id": "en-classic-r1:12.37",
   "target": "She did not take my coat.",
   "ru": "Она не взяла мое пальто.",
   "uk": "Вона не взяла моє пальто."
  },
  {
   "id": "en-classic-r1:12.38",
   "target": "He did not break the lock.",
   "ru": "Он не сломал замок.",
   "uk": "Він не зламав замок."
  },
  {
   "id": "en-classic-r1:12.39",
   "target": "I did not forget your name.",
   "ru": "Я не забыл твоё имя.",
   "uk": "Я не забув твого імені."
  },
  {
   "id": "en-classic-r1:12.40",
   "target": "They did not get my message.",
   "ru": "Они не получили моего сообщения.",
   "uk": "Вони не отримали мого повідомлення."
  },
  {
   "id": "en-classic-r1:12.41",
   "target": "Where did you put the spare key?",
   "ru": "Куда ты положил запасной ключ?",
   "uk": "Куди ти поклав запасний ключ?"
  },
  {
   "id": "en-classic-r1:12.42",
   "target": "When did she leave the office?",
   "ru": "Когда она ушла из офиса?",
   "uk": "Коли вона вийшла з офісу?"
  },
  {
   "id": "en-classic-r1:12.43",
   "target": "Who took the last cup?",
   "ru": "Кто взял последнюю чашку?",
   "uk": "Хто взяв останню чашку?"
  },
  {
   "id": "en-classic-r1:12.44",
   "target": "Who did you meet at the station?",
   "ru": "Кого ты встретил на вокзале?",
   "uk": "Кого ти зустрів на вокзалі?"
  },
  {
   "id": "en-classic-r1:12.45",
   "target": "How much did the taxi cost?",
   "ru": "Сколько стоило такси?",
   "uk": "Скільки коштувало таксі?"
  },
  {
   "id": "en-classic-r1:12.46",
   "target": "I thought the pharmacy was open.",
   "ru": "Я думал, аптека открыта.",
   "uk": "Я думав, що аптека відкрита."
  },
  {
   "id": "en-classic-r1:12.47",
   "target": "She knew the street name.",
   "ru": "Она знала название улицы.",
   "uk": "Вона знала назву вулиці."
  },
  {
   "id": "en-classic-r1:12.48",
   "target": "We stood outside for ten minutes.",
   "ru": "Мы простояли на улице десять минут.",
   "uk": "Ми стояли надворі десять хвилин."
  },
  {
   "id": "en-classic-r1:12.49",
   "target": "He held the ladder for me.",
   "ru": "Он подержал для меня лестницу.",
   "uk": "Він потримав мені драбину."
  },
  {
   "id": "en-classic-r1:12.50",
   "target": "I told the driver my address.",
   "ru": "Я сказал водителю свой адрес.",
   "uk": "Я сказав водієві свою адресу."
  }
 ],
