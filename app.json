{
  "expo": {
    "name": "Phraseman",
    "owner": "badloar",
    "slug": "phraseman",
    "version": "1.5.41",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "phraseman",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": "1.5.41",
    "updates": {
      "enabled": true,
      "url": "https://u.expo.dev/87b454d9-0384-4213-8c26-fc12162e73d2",
      "checkAutomatically": "ON_LOAD",
      "assetPatternsToBeBundled": [
        "node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/*",
        "assets/fonts/*.ttf",
        "assets/images/app_backdrops/*",
        "assets/images/achievement_categories/*",
        "assets/images/arena_actions/*",
        "assets/images/arena/*",
        "assets/images/arena_match/*",
        "assets/images/arena_ranks/**/*",
        "assets/images/arena_tickets/*",
        "assets/images/achievements/*",
        "assets/images/avatars/*",
        "assets/images/daily_task_card_backdrops/**/*",
        "assets/images/daily_task_icons/**/*",
        "assets/images/energy/*",
        "assets/images/flashcard_backs/*",
        "assets/images/first_lesson_sheet/*",
        "assets/images/friends/*",
        "assets/images/home/*",
        "assets/images/header_glyphs/*",
        "assets/images/home_menu/*",
        "assets/images/league/league_crown.webp",
        "assets/images/league_bonus/*",
        "assets/images/lesson_cycle_end_modal/*",
        "assets/images/levels/league-v4-icons/*",
        "assets/images/levels/league-v4/*",
        "assets/images/levels/league-v5-heraldry/*.webp",
        "assets/images/levels/generated-v5-dalle/*.webp",
        "assets/images/levels/*.webp",
        "assets/images/lesson_intro/*",
        "assets/images/lessons/*",
        "assets/images/level_gifts/*",
        "assets/images/level_gift_reward_icons/*",
        "assets/images/messages/*",
        "assets/images/onboarding/*",
        "assets/images/paywalls/premium_hero/*",
        "assets/images/quizzes/level_cards/*",
        "assets/images/quizzes/level_logos/*",
        "assets/images/quizzes/theme_cards/*",
        "assets/images/quizzes/theme_logos/*",
        "assets/images/reward_modals/*",
        "assets/images/screen_backdrops/**/*",
        "assets/images/settings/*",
        "assets/images/shards/*",
        "assets/images/statistics/*.webp",
        "assets/images/statistics/cards/**/*",
        "assets/images/splash-icon.png",
        "assets/images/streak_freeze/*",
        "assets/images/streak_icons/*.webp",
        "assets/images/streak_icons/dark/*.webp",
        "assets/images/streak_icons/neon/*.webp",
        "assets/images/streak_icons/gold/*.webp",
        "assets/images/streak_icons/coral/*.webp",
        "assets/images/streak_icons/minimalLight/*.webp",
        "assets/images/streak_icons/minimalDark/*.webp",
        "assets/images/trainer_theme_icons/**/*"
      ]
    },
    "android": {
      "package": "app.phraseman",
      "googleServicesFile": "./google-services.json",
      "versionCode": 79,
      "allowBackup": true,
      "adaptiveIcon": {
        "backgroundColor": "#06141B",
        "foregroundImage": "./assets/images/icon.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "knowlyapps.com",
              "pathPrefix": "/phraseman/invite"
            },
            {
              "scheme": "https",
              "host": "knowlyapps.com",
              "pathPrefix": "/phraseman/duel"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "com.google.android.gms.permission.AD_ID"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_ADSERVICES_AD_ID",
        "android.permission.ACCESS_ADSERVICES_ATTRIBUTION",
        "android.permission.ACCESS_ADSERVICES_TOPICS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "ios": {
      "bundleIdentifier": "app.phraseman",
      "buildNumber": "79",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:knowlyapps.com"
      ],
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Inter",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Inter-Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Inter-SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/Inter-Bold.ttf",
                    "weight": 700
                  },
                  {
                    "path": "./assets/fonts/Inter-Black.ttf",
                    "weight": 900
                  }
                ]
              }
            ]
          },
          "ios": [
            "./assets/fonts/Inter-Regular.ttf",
            "./assets/fonts/Inter-SemiBold.ttf",
            "./assets/fonts/Inter-Bold.ttf",
            "./assets/fonts/Inter-Black.ttf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#101214",
          "dark": {
            "backgroundColor": "#101214"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-foreground.png",
          "color": "#06141B"
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/crashlytics",
      "./plugins/withIosFirebaseCrashlyticsUpload",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "buildReactNativeFromSource": true,
            "forceStaticLinking": [
              "RNFBApp",
              "RNFBAnalytics",
              "RNFBAppCheck",
              "RNFBAuth",
              "RNFBCrashlytics",
              "RNFBFirestore",
              "RNFBFunctions"
            ]
          },
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "useLegacyPackaging": true,
            "minSdkVersion": 24,
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a"
            ],
            "lintOptions": {
              "abortOnError": false
            },
            "extraProguardRules": "-keep class expo.modules.kotlin.** { *; }\n-keep class expo.modules.imagepicker.** { *; }\n-keep class expo.modules.applepayauthentication.** { *; }\n-keep class expo.modules.applesignin.** { *; }\n-keep class com.google.android.gms.auth.api.signin.** { *; }\n-keep class com.google.android.gms.common.api.** { *; }\n-keep class com.google.firebase.auth.** { *; }\n-keep class com.googlesignin.** { *; }\n-dontwarn expo.modules.kotlin.**\n-dontwarn expo.modules.imagepicker.**"
          }
        }
      ],
      "expo-secure-store",
      "expo-apple-authentication",
      "@react-native-google-signin/google-signin",
      "./plugins/withAndroidBackupRules",
      "./plugins/withAndroidLargeScreenSupport",
      "./plugins/withAndroidDevCleartext",
      "./plugins/withAndroidDevServer127",
      "./plugins/withAndroidDevClientAutoMetro",
      "./plugins/withAndroidSplashWindowBackground",
      "./plugins/withIosFirebaseEarlyConfigure"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "87b454d9-0384-4213-8c26-fc12162e73d2"
      }
    }
  }
}
