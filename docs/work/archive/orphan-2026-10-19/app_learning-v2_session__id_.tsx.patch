+/**
+ * Записывает «Продолжить» только после коммита настоящего экрана занятия.
+ * Подготовка материала и закрытие модалки в Lessons ещё могут закончиться без
+ * перехода, поэтому они намеренно не меняют Главную.
+ */
+function LearningV2DirectSessionArrival() {
+  const { studyTarget } = useStudyTarget();
+  const params = useLocalSearchParams<{
+    id?: string | string[];
+    previewMode?: string | string[];
+    lessonOrdinal?: string | string[];
+    sessionOrdinal?: string | string[];
+    releaseEnvironment?: string | string[];
+    releaseSeasonId?: string | string[];
+    runKind?: string | string[];
+  }>();
+  const recordedRouteRef = useRef<string | null>(null);
+  const sessionId = first(params.id);
+  const previewMode = first(params.previewMode);
+  const isAuthoringPreview = __DEV__ &&
+    (previewMode === "authoring_v1" || previewMode === "dev_unlocked_drafts_v1");
+  const coordinates = resolveLearningV2SessionRouteCoordinatesV1({
+    id: sessionId,
+    lessonOrdinal: first(params.lessonOrdinal),
+    sessionOrdinal: first(params.sessionOrdinal),
+  });
+
+  useEffect(() => {
+    if (isAuthoringPreview || !coordinates) return;
+    const routeKey = `${studyTarget}:${sessionId}:${coordinates.lessonOrdinal}:${coordinates.sessionOrdinal}:${first(params.runKind) ?? "initial"}`;
+    if (recordedRouteRef.current === routeKey) return;
+    recordedRouteRef.current = routeKey;
+    // useEffect runs after this route has committed; cancelled preparation never gets here.
+    rememberLearningV2LastLesson(studyTarget as RuntimeStudyTarget, coordinates.lessonOrdinal, "session_arrival");
+    recordHomeContinueV2(studyTarget as RuntimeStudyTarget, {
+      lessonOrdinal: coordinates.lessonOrdinal,
+      sessionOrdinal: coordinates.sessionOrdinal,
+      sessionId,
+      route: {
+        id: sessionId,
+        runtimeMode: "direct_v1",
+        previewOrigin: "course",
+        lessonOrdinal: String(coordinates.lessonOrdinal),
+        sessionOrdinal: String(coordinates.sessionOrdinal),
+        releaseEnvironment: first(params.releaseEnvironment) || "production",
+        releaseSeasonId: first(params.releaseSeasonId) || "learning-v2",
+        runKind: first(params.runKind) === "repeat" ? "repeat" : "initial",
+      },
+      atMs: Date.now(),
+    });
+  }, [coordinates, isAuthoringPreview, params.releaseEnvironment, params.releaseSeasonId, params.runKind, sessionId, studyTarget]);
+
+  return <LearningV2DirectSessionPlayerV1 />;
+}
