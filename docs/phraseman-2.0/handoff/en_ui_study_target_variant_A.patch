diff --git a/hooks/use_en_ui_study_target_migration.ts b/hooks/use_en_ui_study_target_migration.ts
new file mode 100644
--- /dev/null
+++ b/hooks/use_en_ui_study_target_migration.ts
@@ -0,0 +1,43 @@
+/**
+ * Миграция пары «интерфейс en + изучаю en» (вариант А, решение владельца — см. docs/phraseman-2.0/handoff/en_ui_study_target_variant_A.md).
+ *
+ * зачем: при английском интерфейсе английский не предлагается как язык изучения — старые уроки RU→EN человеку, не знающему русского,
+ * бессмысленны. Пара уже могла сохраниться (дефолт был `en`, смена интерфейса язык изучения не трогала, `study_target_v1` восстанавливается
+ * из облака). Тихо менять язык нельзя (русскоговорящий мог включить английский интерфейс «для погружения»), поэтому при следующем входе
+ * открываем экран выбора языка изучения — человек выбирает сам. Один раз за запуск процесса.
+ */
+import { useEffect, useRef } from 'react';
+import { router, usePathname } from 'expo-router';
+import { useLang } from '../components/LangContext';
+import { useStudyTarget } from '../components/StudyTargetContext';
+import { isStudyTargetAllowedForUi } from '../app/study_target';
+
+const LOG = '[EN-UI-STUDY-TARGET]';
+/** После первого кадра вкладок — не мешаем первому кадру и прогревам. */
+const PROMPT_DELAY_MS = 1200;
+
+let promptedThisProcess = false;
+
+export function useEnUiStudyTargetMigration(): void {
+  const { lang } = useLang();
+  const { studyTarget } = useStudyTarget();
+  const pathname = usePathname();
+  const timer = useRef<ReturnType<typeof setTimeout> | null>(null);
+
+  useEffect(() => {
+    if (promptedThisProcess) return undefined;
+    if (isStudyTargetAllowedForUi(studyTarget, lang)) return undefined;
+    if (pathname?.startsWith('/settings_language')) {
+      console.log(`${LOG} пара ui=${lang} target=${studyTarget} — уже на экране языков, шторку откроет он сам`);
+      return undefined;
+    }
+    console.log(`${LOG} пара ui=${lang} target=${studyTarget} не разрешена — через ${PROMPT_DELAY_MS} мс экран выбора языка изучения`);
+    timer.current = setTimeout(() => {
+      promptedThisProcess = true;
+      router.push({ pathname: '/settings_language', params: { chooseStudy: '1' } } as never);
+    }, PROMPT_DELAY_MS);
+    return () => {
+      if (timer.current) clearTimeout(timer.current);
+    };
+  }, [lang, studyTarget, pathname]);
+}
diff --git a/tests/en_ui_study_target_variant_a.test.ts b/tests/en_ui_study_target_variant_a.test.ts
new file mode 100644
--- /dev/null
+++ b/tests/en_ui_study_target_variant_a.test.ts
@@ -0,0 +1,36 @@
+// зачем (вариант А, решение владельца): при английском интерфейсе английский не предлагается как язык изучения — старые уроки RU→EN
+// англоязычному бессмысленны. Сторож: списки выбора без en при uiLang=en, онбординг требует выбор, пара en+en ведёт на экран выбора.
+import fs from 'node:fs';
+import path from 'node:path';
+import { isStudyTargetAllowedForUi, studyTargetsForSourceLocale } from '../app/study_target';
+
+const read = (rel: string) => fs.readFileSync(path.join(__dirname, '..', rel), 'utf8');
+
+describe('variant A: English is not a study target for the English interface', () => {
+  it('study language list drops en only for the English interface', () => {
+    expect(studyTargetsForSourceLocale('en')).not.toContain('en');
+    expect(studyTargetsForSourceLocale('en').length).toBeGreaterThan(0);
+    for (const lang of ['ru', 'uk', 'es', 'pt-BR', 'vi', 'id', 'tr', 'pl'] as const) {
+      expect(studyTargetsForSourceLocale(lang)).toContain('en');
+    }
+    expect(isStudyTargetAllowedForUi('en', 'en')).toBe(false);
+    expect(isStudyTargetAllowedForUi('es', 'en')).toBe(true);
+    expect(isStudyTargetAllowedForUi('en', 'ru')).toBe(true);
+  });
+
+  it('onboarding filters the language cards, keeps the language step and does not silently set English', () => {
+    const src = read('components/CleanOnboarding.tsx');
+    expect(src).toContain('LANGUAGE_OPTIONS.filter((item) => isStudyTargetAllowedForUi(item.id, lang))');
+    expect(src).toContain('withRequiredLanguageStep(');
+    expect(src).toContain("if (!isStudyTargetAllowedForUi('en', lang))");
+    expect(src).toContain('disabled={!isStudyTargetAllowedForUi(studyTarget, lang)}');
+  });
+
+  it('a saved en+en pair opens the study language chooser on next entry', () => {
+    const settings = read('app/settings_language.tsx');
+    expect(settings).toContain("useState(chooseStudy === '1')");
+    expect(settings).toContain('if (isStudyTargetAllowedForUi(studyTarget, lang as Lang)) return;');
+    const tabs = read('app/(tabs)/_layout.tsx');
+    expect(tabs).toContain('useEnUiStudyTargetMigration();');
+  });
+});
