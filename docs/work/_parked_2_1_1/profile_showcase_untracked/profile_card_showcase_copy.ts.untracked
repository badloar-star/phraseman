export function showcaseCopy(lang: Lang): Copy { return copies[lang] ?? en; }
export function showcaseStreakLabel(lang: Lang, count: number): string {
  const many = showcaseCopy(lang).streak;
  const forms: Partial<Record<Lang, readonly [string, string]>> = {
    ru: ['день в цепочке', 'дня в цепочке'], uk: ['день у серії', 'дні у серії'],
    pl: ['dzień z rzędu', 'dni z rzędu'], en: ['day in a row', many],
    es: ['día de racha', many], 'pt-BR': ['dia seguido', many],
  };
  const [one, few] = forms[lang] ?? [many, many];
  return `${count} ${pluralWord(lang, count, { one, few, many })}`;
}
