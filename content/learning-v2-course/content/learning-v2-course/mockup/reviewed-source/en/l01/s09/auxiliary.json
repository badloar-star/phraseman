        "en:lesson-01:session-09:intro2:r3": {
          "ru": "`are` потерялась. Полная фраза — три слова, и первые два всегда вместе.",
          "uk": "`are` загубилася. Повна фраза — три слова, і перші два завжди разом."
        }
      }
    },
