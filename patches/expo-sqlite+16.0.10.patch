+#import "AccountSQLiteLeaseAtomic.h"
+
+#import <stdatomic.h>
+
+static const uint64_t EXAccountSQLiteLeaseCommitting = 1u;
+static const uint64_t EXAccountSQLiteLeaseRevoked = 2u;
+static const uint64_t EXAccountSQLiteLeaseOperationUnit = 4u;
+static const uint64_t EXAccountSQLiteLeaseMaximumOperations = (1u << 30) - 1u;
+
+@implementation EXAccountSQLiteLeaseAtomic {
+  _Atomic(uint64_t) _state;
+  _Atomic(uint64_t) _nextCommitToken;
+  _Atomic(uint64_t) _commitOwner;
+  dispatch_group_t _drain;
+  BOOL _lockFree;
+}
+
+- (instancetype)init
+{
+  self = [super init];
+  if (self) {
+    atomic_init(&_state, 0u);
+    atomic_init(&_nextCommitToken, 0u);
+    atomic_init(&_commitOwner, 0u);
+    _lockFree = atomic_is_lock_free(&_state) &&
+      atomic_is_lock_free(&_nextCommitToken) && atomic_is_lock_free(&_commitOwner);
+    _drain = dispatch_group_create();
+  }
+  return self;
+}
+
+- (BOOL)isLockFree
+{
+  return _lockFree;
+}
+
+- (BOOL)isRevoked
+{
+  return (atomic_load_explicit(&_state, memory_order_acquire) & EXAccountSQLiteLeaseRevoked) != 0u;
+}
+
+- (EXAccountSQLiteLeaseAdmission)beginOperation
+{
+  if (!_lockFree) return EXAccountSQLiteLeaseAdmissionUnsupported;
+  dispatch_group_enter(_drain);
+  uint64_t current = atomic_load_explicit(&_state, memory_order_acquire);
+  for (;;) {
+    if ((current & EXAccountSQLiteLeaseRevoked) != 0u) {
+      dispatch_group_leave(_drain);
+      return EXAccountSQLiteLeaseAdmissionRevoked;
+    }
+    if ((current & EXAccountSQLiteLeaseCommitting) != 0u ||
+      (current >> 2u) >= EXAccountSQLiteLeaseMaximumOperations) {
+      dispatch_group_leave(_drain);
+      return EXAccountSQLiteLeaseAdmissionBusy;
+    }
+    if (atomic_compare_exchange_weak_explicit(
+          &_state, &current, current + EXAccountSQLiteLeaseOperationUnit,
+          memory_order_acq_rel, memory_order_acquire)) {
+      return EXAccountSQLiteLeaseAdmissionAdmitted;
+    }
+  }
+}
+
+- (void)finishOperation
+{
+  atomic_fetch_sub_explicit(&_state, EXAccountSQLiteLeaseOperationUnit, memory_order_acq_rel);
+  dispatch_group_leave(_drain);
+}
+
+- (EXAccountSQLiteLeaseAdmission)beginCommitWithToken:(uint64_t *)token
+{
+  if (!_lockFree || token == NULL) return EXAccountSQLiteLeaseAdmissionUnsupported;
+  dispatch_group_enter(_drain);
+  uint64_t owner = atomic_fetch_add_explicit(&_nextCommitToken, 1u, memory_order_relaxed) + 1u;
+  if (owner == 0u) {
+    dispatch_group_leave(_drain);
+    return EXAccountSQLiteLeaseAdmissionBusy;
+  }
+  uint64_t noOwner = 0u;
+  if (!atomic_compare_exchange_strong_explicit(
+        &_commitOwner, &noOwner, owner, memory_order_acq_rel, memory_order_acquire)) {
+    dispatch_group_leave(_drain);
+    return EXAccountSQLiteLeaseAdmissionBusy;
+  }
+  uint64_t current = atomic_load_explicit(&_state, memory_order_acquire);
+  for (;;) {
+    if ((current & EXAccountSQLiteLeaseRevoked) != 0u ||
+      (current & EXAccountSQLiteLeaseCommitting) != 0u ||
+      (current >> 2u) != 0u) {
+      atomic_store_explicit(&_commitOwner, 0u, memory_order_release);
+      dispatch_group_leave(_drain);
+      return (current & EXAccountSQLiteLeaseRevoked) != 0u
+        ? EXAccountSQLiteLeaseAdmissionRevoked : EXAccountSQLiteLeaseAdmissionBusy;
+    }
+    uint64_t next = (current | EXAccountSQLiteLeaseCommitting) + EXAccountSQLiteLeaseOperationUnit;
+    if (atomic_compare_exchange_weak_explicit(
+          &_state, &current, next, memory_order_acq_rel, memory_order_acquire)) {
+      *token = owner;
+      return EXAccountSQLiteLeaseAdmissionAdmitted;
+    }
+  }
+}
+
+- (void)finishCommitWithToken:(uint64_t)token
+{
+  uint64_t expectedOwner = token;
+  if (!atomic_compare_exchange_strong_explicit(
+        &_commitOwner, &expectedOwner, 0u, memory_order_acq_rel, memory_order_acquire)) return;
+  uint64_t current = atomic_load_explicit(&_state, memory_order_acquire);
+  for (;;) {
+    uint64_t next = (current & ~EXAccountSQLiteLeaseCommitting) - EXAccountSQLiteLeaseOperationUnit;
+    if (atomic_compare_exchange_weak_explicit(
+          &_state, &current, next, memory_order_acq_rel, memory_order_acquire)) break;
+  }
+  dispatch_group_leave(_drain);
+}
+
+- (void)revoke
+{
+  atomic_fetch_or_explicit(
+    &_state,
+    EXAccountSQLiteLeaseRevoked,
+    memory_order_acq_rel);
+}
+
+- (void)notifyWhenDrainedOn:(dispatch_queue_t)queue block:(dispatch_block_t)block
+{
+  dispatch_group_notify(_drain, queue, block);
+}
+
+@end
