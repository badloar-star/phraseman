  "uk": "поль е аріве́"
 },
 {
  "id": "fr:20:01",
  "fr": "J’habitais ici.",
  "ru": "жабитэ́ иси́",
  "uk": "жабіте́ ісі́"
 },
 {
  "id": "fr:21:01",
  "fr": "Je lisais quand tu as appelé.",
