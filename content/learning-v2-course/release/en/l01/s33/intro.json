              "responseId": "en:lesson-01:session-33:intro2:r2",
              "text": "We is hungry."
            },
            {
              "responseId": "en:lesson-01:session-33:intro2:r3",
              "text": "We are hungrys."
            }
          ]
        },
        "accessibilityLabelByLocale": {
          "ru": "Начальник спрашивает, чего вы все столпились у двери. Скажите, что вы голодные."
        }
      }
    },
    {
      "pageOrdinal": 3,
      "pageId": "en:lesson-01:session-33:intro3",
      "kind": "trap",
      "titleByLocale": {
        "ru": "`together` — «вместе»"
      },
      "bodyByLocale": {
        "ru": "`together` — «вместе», то есть одной компанией, а не по отдельности.\n\n`We are together` говорят и про столик в кафе, и про дорогу домой: одно слово закрывает всё, где вы не поодиночке. Само `together` не меняется никогда."
      },
      "question": {
