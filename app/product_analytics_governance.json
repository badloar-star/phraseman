{
  "schemaVersion": 1,
  "fields": {
    "schema_version": { "valueClass": "integer", "description": "Version of the governed event schema." },
    "event_id": { "valueClass": "opaque_id", "description": "Random event identifier without account identity." },
    "session_id": { "valueClass": "opaque_id", "description": "Random product session identifier." },
    "product_session_id": { "valueClass": "opaque_id", "description": "Legacy alias for the random product session identifier." },
    "screen_id": { "valueClass": "enum_code", "description": "Canonical allowlisted screen code." },
    "platform": { "valueClass": "enum_code", "description": "Allowlisted mobile platform." },
    "app_version": { "valueClass": "version", "description": "Application semantic version." },
    "build_number": { "valueClass": "version", "description": "Application store build number." },
    "study_target": { "valueClass": "enum_code", "description": "Allowlisted study-language target." },
    "occurred_at_ms": { "valueClass": "timestamp_ms", "description": "Client occurrence timestamp for skew diagnostics." },
    "duration_ms": { "valueClass": "duration_ms", "description": "Bounded observed duration." },
    "leave_reason": { "valueClass": "enum_code", "description": "Normalized screen-leave reason." },
    "lesson_attempt_id": { "valueClass": "opaque_id", "description": "Random identifier for one lesson attempt." },
    "lesson_id": { "valueClass": "integer", "description": "Stable numeric lesson identifier." },
    "phrase_index": { "valueClass": "integer", "description": "Zero-based lesson checkpoint; no phrase text." },
    "total_phrases": { "valueClass": "integer", "description": "Bounded lesson item count." },
    "total": { "valueClass": "integer", "description": "Legacy alias for bounded lesson item count." },
    "correct": { "valueClass": "boolean", "description": "Correctness flag without answer content." },
    "elapsed_ms": { "valueClass": "duration_ms", "description": "Bounded elapsed time for a lesson attempt." },
    "paywall_impression_id": { "valueClass": "opaque_id", "description": "Random identifier for one paywall impression." },
    "context": { "valueClass": "enum_code", "description": "Normalized paywall context." },
    "source": { "valueClass": "enum_code", "description": "Normalized product source code, not acquisition free text." },
    "plan": { "valueClass": "enum_code", "description": "Allowlisted billing plan code." },
    "paywall": { "valueClass": "enum_code", "description": "Allowlisted paywall variant." },
    "product_id": { "valueClass": "enum_code", "description": "Allowlisted store product identifier." },
    "error": { "valueClass": "enum_code", "description": "Normalized allowlisted error code; arbitrary error text and stack traces are forbidden." },
    "inventory_status": { "valueClass": "enum_code", "description": "Normalized product inventory status." },
    "monthly_available": { "valueClass": "boolean", "description": "Monthly package availability flag." },
    "yearly_available": { "valueClass": "boolean", "description": "Yearly package availability flag." },
    "lifetime_available": { "valueClass": "boolean", "description": "Lifetime package availability flag." },
    "lifetime_expected": { "valueClass": "boolean", "description": "Whether lifetime availability was expected." },
    "load_attempts": { "valueClass": "integer", "description": "Bounded inventory load attempt count." },
    "time_since_impression_ms": { "valueClass": "duration_ms", "description": "Bounded time since paywall impression." },
    "feature": { "valueClass": "enum_code", "description": "Allowlisted product feature code." },
    "screen": { "valueClass": "enum_code", "description": "Allowlisted product surface code." },
    "goal": { "valueClass": "enum_code", "description": "Allowlisted onboarding learning-goal code." },
    "level": { "valueClass": "enum_code", "description": "Allowlisted onboarding proficiency code." },
    "minutes": { "valueClass": "integer", "description": "Bounded selected daily-study minutes." },
    "target": { "valueClass": "enum_code", "description": "Allowlisted onboarding study-target code." },
    "plusSelected": { "valueClass": "boolean", "description": "Whether the onboarding premium option was selected." },
    "review_session_id": { "valueClass": "opaque_id", "description": "Random identifier for one local SRS review session." },
    "review_attempt_id": { "valueClass": "opaque_id", "description": "Random identifier for one displayed review card attempt." },
    "analytics_item_id": { "valueClass": "opaque_id", "description": "Random local SRS item identifier; never derived from content and never returned to Admin." },
    "review_mode": { "valueClass": "enum_code", "description": "Allowlisted SRS interaction mode." },
    "content_version": { "valueClass": "version", "description": "Known content version or legacy_unknown; never content text." },
    "response_time_ms": { "valueClass": "duration_ms", "description": "Bounded time from card readiness to its single evaluated answer." },
    "actual_delay_bucket": { "valueClass": "enum_code", "description": "Observed delay bucket since the previous review timestamp." },
    "due_status": { "valueClass": "enum_code", "description": "Observed timing relative to the previously scheduled due timestamp." },
    "previous_repetitions": { "valueClass": "integer", "description": "Bounded SRS repetition count before persistence." },
    "next_repetitions": { "valueClass": "integer", "description": "Bounded SRS repetition count after persistence." },
    "previous_interval_days": { "valueClass": "integer", "description": "Bounded scheduled interval before persistence." },
    "next_interval_days": { "valueClass": "integer", "description": "Bounded scheduled interval after persistence." },
    "previous_mastery_state": { "valueClass": "enum_code", "description": "Evidence-based mastery state before the review." },
    "next_mastery_state": { "valueClass": "enum_code", "description": "Evidence-based mastery state after the review." },
    "mastery_transition": { "valueClass": "enum_code", "description": "Evidence-based transition caused by the persisted review." },
    "planned_item_count": { "valueClass": "integer", "description": "Bounded number of cards planned for a review session." },
    "answered_item_count": { "valueClass": "integer", "description": "Bounded number of successfully persisted answers in a review session." },
    "correct_item_count": { "valueClass": "integer", "description": "Bounded number of correct persisted answers in a review session." },
    "completion_reason": { "valueClass": "enum_code", "description": "Allowlisted terminal reason for a completed review session." },
    "abandon_reason": { "valueClass": "enum_code", "description": "Allowlisted terminal reason for an abandoned review session." },
    "experiment_id": { "valueClass": "enum_code", "description": "Immutable governed experiment identifier." },
    "definition_version": { "valueClass": "integer", "description": "Immutable experiment definition version." },
    "variant_id": { "valueClass": "enum_code", "description": "Assigned experiment variant code." },
    "control_variant_id": { "valueClass": "enum_code", "description": "Predeclared experiment control variant." },
    "exposure_id": { "valueClass": "opaque_id", "description": "Random rendered-surface exposure identifier." },
    "surface": { "valueClass": "enum_code", "description": "Allowlisted experiment surface." },
    "config_revision": { "valueClass": "integer", "description": "Governed configuration revision at exposure." },
    "assignment_quality": { "valueClass": "enum_code", "description": "Frozen or excluded fallback assignment quality." },
    "operation": { "valueClass": "enum_code", "description": "Allowlisted product operation code." },
    "failure_code": { "valueClass": "enum_code", "description": "Normalized bounded failure code without raw error text." },
    "retryable": { "valueClass": "boolean", "description": "Whether the bounded operation may be retried." }
  },
  "fieldSets": {
    "session": ["schema_version", "event_id", "session_id", "screen_id", "platform", "app_version", "build_number", "study_target", "occurred_at_ms", "duration_ms", "leave_reason"],
    "lesson": ["schema_version", "event_id", "session_id", "lesson_attempt_id", "lesson_id", "phrase_index", "total_phrases", "correct", "elapsed_ms", "study_target", "occurred_at_ms"],
    "paywall": ["schema_version", "event_id", "session_id", "paywall_impression_id", "context", "source", "plan", "paywall", "product_id", "error", "inventory_status", "monthly_available", "yearly_available", "lifetime_available", "lifetime_expected", "load_attempts", "time_since_impression_ms", "study_target", "occurred_at_ms"],
    "activation": ["session_id", "feature", "screen", "goal", "level", "minutes", "target", "plusSelected"],
    "reviewAnswer": ["schema_version", "event_id", "session_id", "review_session_id", "review_attempt_id", "analytics_item_id", "lesson_id", "study_target", "source", "review_mode", "content_version", "correct", "response_time_ms", "actual_delay_bucket", "due_status", "previous_repetitions", "next_repetitions", "previous_interval_days", "next_interval_days", "previous_mastery_state", "next_mastery_state", "mastery_transition", "occurred_at_ms"],
    "reviewSession": ["schema_version", "event_id", "session_id", "review_session_id", "study_target", "review_mode", "planned_item_count", "answered_item_count", "correct_item_count", "duration_ms", "completion_reason", "abandon_reason", "occurred_at_ms"],
    "experimentExposure": ["schema_version", "event_id", "session_id", "experiment_id", "definition_version", "variant_id", "control_variant_id", "exposure_id", "surface", "config_revision", "assignment_quality", "app_version", "build_number", "occurred_at_ms"],
    "operationFailure": ["schema_version", "event_id", "session_id", "feature", "operation", "failure_code", "retryable", "app_version", "build_number", "occurred_at_ms"]
  },
  "events": [
    { "name": "product_session_start", "entity": "session", "warehouse": "product", "fieldSet": "session" },
    { "name": "product_session_resume", "entity": "session", "warehouse": "product", "fieldSet": "session" },
    { "name": "product_session_background", "entity": "session", "warehouse": "product", "fieldSet": "session" },
    { "name": "product_screen_view", "entity": "session", "warehouse": "product", "fieldSet": "session" },
    { "name": "product_screen_leave", "entity": "session", "warehouse": "product", "fieldSet": "session" },
    { "name": "lesson_start", "entity": "attempt", "warehouse": "product", "fieldSet": "lesson" },
    { "name": "lesson_complete", "entity": "attempt", "warehouse": "product", "fieldSet": "lesson" },
    { "name": "lesson_abandoned", "aliases": ["lesson_abandon"], "entity": "attempt", "warehouse": "product", "fieldSet": "lesson" },
    { "name": "lesson_answer", "entity": "attempt", "warehouse": "product", "fieldSet": "lesson" },
    { "name": "onboarding_complete", "entity": "app_instance", "warehouse": "product", "fieldSet": "activation" },
    { "name": "experiment_exposure", "entity": "impression", "warehouse": "product", "fieldSet": "experimentExposure" },
    { "name": "product_operation_failure", "entity": "event", "warehouse": "product", "fieldSet": "operationFailure" },
    { "name": "learning_review_session_start", "entity": "attempt", "warehouse": "product", "fieldSet": "reviewSession" },
    { "name": "learning_review_answer", "entity": "attempt", "warehouse": "product", "fieldSet": "reviewAnswer" },
    { "name": "learning_review_session_complete", "entity": "attempt", "warehouse": "product", "fieldSet": "reviewSession" },
    { "name": "learning_review_session_abandoned", "entity": "attempt", "warehouse": "product", "fieldSet": "reviewSession" },
    { "name": "paywall_view", "entity": "impression", "warehouse": "product", "fieldSet": "paywall" },
    { "name": "paywall_shown", "entity": "impression", "warehouse": "product", "fieldSet": "paywall" },
    { "name": "paywall_plan_select", "entity": "impression", "warehouse": "product", "fieldSet": "paywall" },
    { "name": "paywall_cta_click", "entity": "impression", "warehouse": "product", "fieldSet": "paywall" },
    { "name": "paywall_continue_free", "entity": "impression", "warehouse": "product", "fieldSet": "paywall" },
    { "name": "paywall_close", "entity": "impression", "warehouse": "product", "fieldSet": "paywall" },
    { "name": "premium_purchased", "entity": "impression", "warehouse": "product", "fieldSet": "paywall" },
    { "name": "purchase_started", "entity": "impression", "warehouse": "product", "fieldSet": "paywall" },
    { "name": "purchase_completed", "entity": "impression", "warehouse": "product", "fieldSet": "paywall" },
    { "name": "purchase_failed", "entity": "impression", "warehouse": "product", "fieldSet": "paywall" },
    { "name": "purchase_cancelled", "entity": "impression", "warehouse": "product", "fieldSet": "paywall" },
    { "name": "trial_started", "entity": "impression", "warehouse": "product", "fieldSet": "paywall" },
    { "name": "paywall_inventory_resolved", "entity": "impression", "warehouse": "product", "fieldSet": "paywall" },
    { "name": "paywall_exit_offer_shown", "entity": "impression", "warehouse": "product", "fieldSet": "paywall" },
    { "name": "paywall_exit_offer_accepted", "entity": "impression", "warehouse": "product", "fieldSet": "paywall" },
    { "name": "paywall_exit_offer_declined", "entity": "impression", "warehouse": "product", "fieldSet": "paywall" },
    { "name": "exit_trial_offer_shown", "entity": "impression", "warehouse": "product", "fieldSet": "paywall" },
    { "name": "exit_trial_offer_accepted", "entity": "impression", "warehouse": "product", "fieldSet": "paywall" },
    { "name": "exit_trial_offer_declined", "entity": "impression", "warehouse": "product", "fieldSet": "paywall" }
  ],
  "metrics": [
    { "id": "sessions.lifecycle.v1", "events": ["product_session_start", "product_session_resume", "product_session_background"], "rowKinds": ["session_summary"] },
    { "id": "screens.navigation.v1", "events": ["product_screen_view", "product_screen_leave"], "rowKinds": ["screen"] },
    { "id": "learning.lesson_outcomes.v1", "events": ["lesson_start", "lesson_complete", "lesson_abandoned"], "rowKinds": ["lesson", "learning_summary"] },
    { "id": "learning.checkpoint_quality.v1", "events": ["lesson_answer"], "rowKinds": ["learning_checkpoint"] },
    { "id": "conversion.behavioral_funnel.v1", "events": ["paywall_view", "paywall_shown", "paywall_plan_select", "paywall_cta_click", "paywall_continue_free", "paywall_close", "premium_purchased", "purchase_started", "purchase_completed", "purchase_failed", "purchase_cancelled", "trial_started", "paywall_exit_offer_shown", "paywall_exit_offer_accepted", "paywall_exit_offer_declined", "exit_trial_offer_shown", "exit_trial_offer_accepted", "exit_trial_offer_declined"], "rowKinds": ["conversion_context", "conversion_impression", "conversion_failure"] },
    { "id": "conversion.inventory_readiness.v1", "events": ["paywall_inventory_resolved"], "rowKinds": ["conversion_inventory"] },
    { "id": "acquisition.first_touch_channels.v1", "events": ["product_session_start"], "rowKinds": ["acquisition_channel"] },
    { "id": "activation.first_touch_funnel.v1", "events": ["onboarding_complete", "lesson_start", "lesson_complete", "product_session_start"], "rowKinds": ["activation_summary"] },
    { "id": "retention.firebase_first_touch.v1", "events": ["product_session_start"], "rowKinds": ["true_retention_day", "true_retention_summary", "active_day_bucket"] },
    { "id": "learning.review_outcomes.v1", "events": ["learning_review_session_start", "learning_review_answer", "learning_review_session_complete", "learning_review_session_abandoned"], "rowKinds": ["review_summary", "review_delay", "mastery_transition", "review_content", "review_session_summary", "weekly_effective_learner"] },
    { "id": "experiments.exposure.v1", "events": ["experiment_exposure"], "rowKinds": ["experiment_exposure"] },
    { "id": "reliability.operation_failure.v1", "events": ["product_operation_failure"], "rowKinds": ["operation_failure", "release_adoption"] }
  ]
}
