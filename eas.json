{
  "cli": {
    "version": ">= 18.7.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "environment": "production",
      "channel": "production",
      "autoIncrement": false,
      "env": {
        "EXPO_PUBLIC_APP_CHECK_REAL_ATTESTATION": "1",
        "EXPO_PUBLIC_STORE_RELEASE": "1",
        "EXPO_PUBLIC_AI_DIALOG_ENABLED": "true",
        "EXPO_PUBLIC_EXPLAIN_ENABLED": "true"
      }
    },
    "testflight-dev": {
      "environment": "production",
      "channel": "testflight-dev",
      "autoIncrement": false,
      "env": {
        "EXPO_PUBLIC_APP_CHECK_REAL_ATTESTATION": "1",
        "EXPO_PUBLIC_STORE_RELEASE": "0",
        "EXPO_PUBLIC_TESTFLIGHT_DEV_TOOLS": "1",
        "EXPO_PUBLIC_AI_DIALOG_ENABLED": "true",
        "EXPO_PUBLIC_EXPLAIN_ENABLED": "true"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./service-account.json"
      },
      "ios": {
        "ascAppId": "6764800879"
      }
    },
    "testflight-dev": {
      "ios": {
        "ascAppId": "6764800879"
      }
    }
  }
}
