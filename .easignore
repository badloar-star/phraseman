# Personal-plan listening audio now streams from Firebase Storage (plan-audio/**)
# and is disk-cached on device — see app/plan_audio_url_map.generated.ts. Keep the
# large local source set out of EAS, but ship the five Gavan day-1 clips that are
# still statically required as exact local fallbacks.
assets/audio/personal-plans-runtime/*
!assets/audio/personal-plans-runtime/gavan
assets/audio/personal-plans-runtime/gavan/*
!assets/audio/personal-plans-runtime/gavan/runtime
assets/audio/personal-plans-runtime/gavan/runtime/*
!assets/audio/personal-plans-runtime/gavan/runtime/gavan-d001-listen-audio
assets/audio/personal-plans-runtime/gavan/runtime/gavan-d001-listen-audio/*
!assets/audio/personal-plans-runtime/gavan/runtime/gavan-d001-listen-audio/gavan-d1-phrase-1.mp3
!assets/audio/personal-plans-runtime/gavan/runtime/gavan-d001-listen-audio/gavan-d1-phrase-2.mp3
!assets/audio/personal-plans-runtime/gavan/runtime/gavan-d001-listen-audio/gavan-d1-phrase-3.mp3
!assets/audio/personal-plans-runtime/gavan/runtime/gavan-d001-listen-audio/gavan-d1-phrase-4.mp3
!assets/audio/personal-plans-runtime/gavan/runtime/gavan-d001-listen-audio/gavan-d1-phrase-5.mp3

# Collectible card art now streams from Firebase Storage (collectible-images/**)
# and is disk-cached on device — see app/collectibles/collectible_image_url_map.generated.ts.
# The local webp are the regen/backup source (full-res q90), no longer bundled
# (removed from app.json assetPatternsToBeBundled; CollectibleArt uses URLs + SVG
# fallback). ~71 MB saved from every EAS upload archive.
assets/images/collectibles/dalli/

