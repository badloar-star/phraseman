   "target": "Elle les cherche.",
   "ru": "Она ищет их.",
   "uk": "Вона шукає їх."
  },
  {
   "id": "fr:22:10",
   "target": "Nous les attendons.",
   "ru": "Мы ждём их.",
   "uk": "Ми чекаємо на них."
  },
  {
   "id": "fr:22:11",
   "target": "La porte, je la ferme.",
   "ru": "Дверь — я её закрываю.",
   "uk": "Двері - я її закриваю."
  },
  {
   "id": "fr:22:12",
   "target": "Le sac, je le garde.",
   "ru": "Сумку я оставляю у себя.",
   "uk": "Сумку я залишаю у себе."
  },
  {
   "id": "fr:22:13",
   "target": "Les clés, je les prends.",
   "ru": "Ключи я беру с собой.",
   "uk": "Ключі я беру із собою."
  },
  {
   "id": "fr:22:14",
   "target": "La veste, je la range.",
   "ru": "Куртку я убираю на место.",
   "uk": "Куртку я прибираю на місце."
  },
  {
   "id": "fr:22:15",
   "target": "Le pain, je le coupe.",
   "ru": "Я режу хлеб.",
   "uk": "Я ріжу хліб."
  },
  {
   "id": "fr:22:16",
   "target": "Les verres, je les lave.",
   "ru": "Я мою стаканы.",
   "uk": "Я мию склянки."
  },
  {
   "id": "fr:22:17",
   "target": "Les billets, je les imprime.",
   "ru": "Я распечатываю билеты.",
   "uk": "Я друкую квитки."
  },
  {
   "id": "fr:22:18",
   "target": "La soupe, je la goûte.",
   "ru": "Суп — я его пробую.",
   "uk": "Суп - я його пробую."
  },
  {
   "id": "fr:22:19",
   "target": "Le pull, je l’essaie.",
   "ru": "Свитер — я его примеряю.",
   "uk": "Светр - я його приміряю."
  },
  {
   "id": "fr:22:20",
   "target": "Cette chanson, je l’écoute.",
   "ru": "Я слушаю эту песню.",
   "uk": "Я слухаю цю пісню."
  },
  {
   "id": "fr:22:21",
   "target": "Je ne le trouve pas.",
   "ru": "Я его не нахожу.",
   "uk": "Я його не знаходжу."
  },
  {
   "id": "fr:22:22",
   "target": "Elle ne la reconnaît pas.",
   "ru": "Она её не узнаёт.",
   "uk": "Вона її не впізнає."
  },
  {
   "id": "fr:22:23",
   "target": "Nous ne les voyons pas.",
   "ru": "Мы их не видим.",
   "uk": "Ми їх не бачимо."
  },
  {
   "id": "fr:22:24",
   "target": "On ne l’entend pas.",
   "ru": "Мы его не слышим.",
   "uk": "Ми його не чуємо."
  },
  {
   "id": "fr:22:25",
   "target": "Ils ne le prennent pas.",
   "ru": "Они его не берут.",
   "uk": "Вони його не беруть."
  },
  {
   "id": "fr:22:26",
   "target": "Tu les as ?",
   "ru": "Они у тебя есть?",
   "uk": "Вони у тебе є?"
  },
  {
   "id": "fr:22:27",
   "target": "Vous la voulez ?",
   "ru": "Вы её хотите?",
   "uk": "Ви її хочете?"
  },
  {
   "id": "fr:22:28",
   "target": "Est-ce que je peux le garder ?",
   "ru": "Можно я его оставлю себе?",
   "uk": "Можна я його залишу собі?"
  },
  {
   "id": "fr:22:29",
   "target": "Tu vas les chercher ?",
   "ru": "Ты собираешься их забрать?",
   "uk": "Ти збираєшся їх забрати?"
  },
  {
   "id": "fr:22:30",
   "target": "Je voudrais l’essayer.",
   "ru": "Я хотел бы его примерить.",
   "uk": "Я хотів би його приміряти."
  },
  {
   "id": "fr:22:31",
   "target": "Je vais la rappeler.",
   "ru": "Я ей перезвоню.",
   "uk": "Я передзвоню їй."
  },
  {
   "id": "fr:22:32",
   "target": "Nous allons le réparer.",
   "ru": "Мы собираемся его починить.",
   "uk": "Ми збираємося його відремонтувати."
  },
  {
   "id": "fr:22:33",
   "target": "Elle doit les rendre.",
   "ru": "Она должна их вернуть.",
   "uk": "Вона має їх повернути."
  },
  {
   "id": "fr:22:34",
   "target": "Tu peux la laisser ici.",
   "ru": "Ты можешь оставить её здесь.",
   "uk": "Ти можеш залишити її тут."
  },
  {
   "id": "fr:22:35",
   "target": "Le journal, je préfère le lire demain.",
