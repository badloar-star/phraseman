+/** Replay original dates: a crash between achievement persistence and history cannot lose the story. */
+async function replaySpireAchievementStories(states: readonly AchievementState[], token: AccountGenerationToken): Promise<boolean> {
+  const delivered = (result: Awaited<ReturnType<typeof recordStoryEvent>>) => result.recorded || result.reason === 'duplicate' || result.reason === 'expired';
+  for (const state of states) {
+    if ((!state.id.startsWith('spire_summit_') && !ACTIVITY_ACHIEVEMENT_IDS.has(state.id)) || !state.unlockedAt) continue;
+    if (!isCurrentAccountGeneration(token)) return false;
+    if (!delivered(await recordStoryEvent('achievement', { achievementId: state.id }, Date.parse(state.unlockedAt), { accountToken: token }))) return false;
+    const upgradedAt = spireAchievementUpgradedAt(state);
+    if (upgradedAt && isCurrentAccountGeneration(token)) {
+      if (!delivered(await recordStoryEvent('achievement', { achievementId: state.id, stage: 'upgraded' }, Date.parse(upgradedAt), { accountToken: token }))) return false;
+    }
+  }
+  return isCurrentAccountGeneration(token);
+}
