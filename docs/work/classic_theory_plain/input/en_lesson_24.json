 "phrases": [
  {
   "id": "en-classic-r1:24.01",
   "target": "I have lost my keys.",
   "ru": "Я потерял ключи.",
   "uk": "Я загубив свої ключі."
  },
  {
   "id": "en-classic-r1:24.02",
   "target": "She has found her card.",
   "ru": "Она нашла свою карту.",
   "uk": "Вона знайшла свою картку."
  },
  {
   "id": "en-classic-r1:24.03",
   "target": "We have finished lunch.",
   "ru": "Мы закончили обед.",
   "uk": "Ми закінчили обід."
  },
  {
   "id": "en-classic-r1:24.04",
   "target": "He has left the office.",
   "ru": "Он ушел из офиса.",
   "uk": "Він вийшов з офісу."
  },
  {
   "id": "en-classic-r1:24.05",
   "target": "They have missed the bus.",
   "ru": "Они опоздали на автобус.",
   "uk": "Вони запізнилися на автобус."
  },
  {
   "id": "en-classic-r1:24.06",
   "target": "I have sent the form.",
   "ru": "Я отправил форму.",
   "uk": "Я надіслав форму."
  },
  {
   "id": "en-classic-r1:24.07",
   "target": "She has renewed her passport.",
   "ru": "Она обновила свой паспорт.",
   "uk": "Вона поновила свій паспорт."
  },
  {
   "id": "en-classic-r1:24.08",
   "target": "We have booked our seats.",
   "ru": "Мы забронировали места.",
   "uk": "Ми забронювали місця."
  },
  {
   "id": "en-classic-r1:24.09",
   "target": "The kettle has boiled.",
   "ru": "Чайник закипел.",
   "uk": "Чайник закипів."
  },
  {
   "id": "en-classic-r1:24.10",
   "target": "Your parcel has arrived.",
   "ru": "Ваша посылка прибыла.",
   "uk": "Ваша посилка прибула."
  },
  {
   "id": "en-classic-r1:24.11",
   "target": "I have just parked the van.",
   "ru": "Я только что припарковал фургон.",
   "uk": "Я щойно припаркував фургон."
  },
  {
   "id": "en-classic-r1:24.12",
   "target": "She has just called back.",
   "ru": "Она только что перезвонила.",
   "uk": "Вона щойно передзвонила."
  },
  {
   "id": "en-classic-r1:24.13",
   "target": "We have just checked in.",
   "ru": "Мы только что заселились.",
   "uk": "Ми щойно зареєструвалися."
  },
  {
   "id": "en-classic-r1:24.14",
   "target": "He has already paid.",
   "ru": "Он уже заплатил.",
   "uk": "Він уже заплатив."
  },
  {
   "id": "en-classic-r1:24.15",
   "target": "They have already unpacked.",
   "ru": "Они уже распаковали вещи.",
   "uk": "Вони вже розпакували речі."
  },
  {
   "id": "en-classic-r1:24.16",
   "target": "I have already looked everywhere for my pass.",
   "ru": "Я уже везде искал свой пропуск.",
   "uk": "Я вже всюди шукав свою перепустку."
  },
  {
   "id": "en-classic-r1:24.17",
   "target": "We have not ordered yet.",
   "ru": "Мы еще не сделали заказ.",
   "uk": "Ми ще не замовили."
  },
  {
   "id": "en-classic-r1:24.18",
   "target": "She has not arrived yet.",
   "ru": "Она еще не приехала.",
   "uk": "Вона ще не приїхала."
  },
  {
   "id": "en-classic-r1:24.19",
   "target": "The bus has not left yet.",
   "ru": "Автобус еще не уехал.",
   "uk": "Автобус ще не поїхав."
  },
  {
   "id": "en-classic-r1:24.20",
   "target": "Have you finished yet?",
   "ru": "Вы уже закончили?",
   "uk": "Ви вже закінчили?"
  },
  {
   "id": "en-classic-r1:24.21",
   "target": "Have you ever worked nights?",
   "ru": "Вы когда-нибудь работали по ночам?",
   "uk": "Ви коли-небудь працювали вночі?"
  },
  {
   "id": "en-classic-r1:24.22",
   "target": "Has she ever lived abroad?",
   "ru": "Она когда-нибудь жила за границей?",
   "uk": "Вона коли-небудь жила за кордоном?"
  },
  {
   "id": "en-classic-r1:24.23",
   "target": "Have they ever missed a flight?",
   "ru": "Они когда-нибудь опаздывали на рейс?",
   "uk": "Вони коли-небудь пропускали рейс?"
  },
  {
   "id": "en-classic-r1:24.24",
   "target": "Have you ever tried this soup?",
   "ru": "Вы когда-нибудь пробовали этот суп?",
   "uk": "Ви коли-небудь куштували цей суп?"
  },
  {
   "id": "en-classic-r1:24.25",
   "target": "I have never driven a van.",
   "ru": "Я никогда не водил фургон.",
   "uk": "Я ніколи не водив фургон."
  },
  {
   "id": "en-classic-r1:24.26",
   "target": "He has never used a locker.",
   "ru": "Он никогда не пользовался шкафчиком.",
   "uk": "Він ніколи не користувався шафкою."
  },
  {
   "id": "en-classic-r1:24.27",
   "target": "We have moved house twice.",
   "ru": "Мы дважды переезжали.",
   "uk": "Ми двічі переїжджали."
  },
  {
   "id": "en-classic-r1:24.28",
   "target": "She has scanned the invoice twice.",
   "ru": "Она дважды сканировала счет.",
   "uk": "Вона двічі відсканувала рахунок."
  },
  {
   "id": "en-classic-r1:24.29",
   "target": "This is the first time I have stayed here.",
   "ru": "Я здесь впервые останавливаюсь.",
   "uk": "Я тут зупинився вперше."
  },
  {
   "id": "en-classic-r1:24.30",
   "target": "Have you met our new neighbour?",
   "ru": "Вы знакомы с нашим новым соседом?",
   "uk": "Ви познайомилися з нашим новим сусідом?"
  },
  {
   "id": "en-classic-r1:24.31",
   "target": "I have lived here for a year.",
   "ru": "Я живу здесь уже год.",
   "uk": "Я живу тут рік."
  },
  {
   "id": "en-classic-r1:24.32",
   "target": "She has worked here since March.",
   "ru": "Она работает здесь с марта.",
   "uk": "Вона працює тут з березня."
  },
  {
   "id": "en-classic-r1:24.33",
   "target": "We have known each other for years.",
   "ru": "Мы знакомы много лет.",
   "uk": "Ми знаємо одне одного багато років."
  },
  {
   "id": "en-classic-r1:24.34",
   "target": "He has had that bike since school.",
   "ru": "Этот велосипед у него со школы.",
   "uk": "У нього цей велосипед ще зі школи."
  },
  {
   "id": "en-classic-r1:24.35",
   "target": "They have been away for a week.",
   "ru": "Их нет уже неделю.",
   "uk": "Їх немає вже тиждень."
  },
  {
   "id": "en-classic-r1:24.36",
   "target": "The shop has been closed since Monday.",
   "ru": "Магазин закрыт с понедельника.",
   "uk": "Магазин закрито з понеділка."
  },
  {
   "id": "en-classic-r1:24.37",
   "target": "How long have you had this phone?",
   "ru": "Как давно у вас этот телефон?",
   "uk": "Як довго у вас цей телефон?"
  },
  {
   "id": "en-classic-r1:24.38",
   "target": "How long has she worked nights?",
   "ru": "Как долго она работает в ночную смену?",
   "uk": "Як довго вона працює вночі?"
  },
  {
   "id": "en-classic-r1:24.39",
   "target": "I have not seen Tom since Friday.",
   "ru": "Я не видел Тома с пятницы.",
   "uk": "Я не бачив Тома з п'ятниці."
  },
  {
   "id": "en-classic-r1:24.40",
   "target": "We have not had hot water for two days.",
   "ru": "У нас нет горячей воды уже два дня.",
   "uk": "Вже два дні в нас немає гарячої води."
  },
  {
   "id": "en-classic-r1:24.41",
   "target": "I lost my library pass yesterday.",
   "ru": "Я потерял свой абонемент в библиотеку вчера.",
   "uk": "Я втратив свій бібліотечний пропуск учора."
  },
  {
   "id": "en-classic-r1:24.42",
   "target": "I have lost my pass, so I cannot get in.",
   "ru": "Я потерял свой пропуск, поэтому не могу войти.",
   "uk": "Я загубив свій пропуск, тому не можу потрапити."
  },
  {
   "id": "en-classic-r1:24.43",
   "target": "She called at eight.",
   "ru": "Она звонила в восемь.",
   "uk": "Вона дзвонила о восьмій."
  },
  {
   "id": "en-classic-r1:24.44",
   "target": "She has called three times today.",
   "ru": "Она звонила три раза сегодня.",
   "uk": "Вона дзвонила тричі сьогодні."
  },
  {
   "id": "en-classic-r1:24.45",
   "target": "We booked the room last week.",
   "ru": "Мы забронировали номер на прошлой неделе.",
   "uk": "Ми забронювали номер минулого тижня."
  },
  {
   "id": "en-classic-r1:24.46",
   "target": "We have booked the room, so you can stop looking.",
   "ru": "Мы забронировали номер, так что можете прекратить поиски.",
   "uk": "Ми забронювали номер, тож можете перестати шукати."
  },
  {
   "id": "en-classic-r1:24.47",
   "target": "Did he pay yesterday?",
   "ru": "Он заплатил вчера?",
   "uk": "Він заплатив учора?"
  },
  {
   "id": "en-classic-r1:24.48",
   "target": "Has he paid yet?",
   "ru": "Он уже заплатил?",
   "uk": "Він вже заплатив?"
  },
  {
   "id": "en-classic-r1:24.49",
   "target": "I have just found the receipt you asked for.",
   "ru": "Я только что нашёл квитанцию, которую вы просили.",
   "uk": "Я щойно знайшов квитанцію, яку ви просили."
  },
  {
