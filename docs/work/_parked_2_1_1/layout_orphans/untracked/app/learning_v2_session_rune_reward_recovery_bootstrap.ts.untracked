import {
  isCurrentAccountGeneration,
  type AccountGenerationToken,
} from './account_generation';

export interface LearningV2SessionRuneRewardRecoveryResultV1 {
  readonly applied: number;
  readonly replayed: number;
  readonly remaining: number;
  readonly failed: number;
}

type RecoveryModuleV1 = Readonly<{
  recoverPendingLearningV2SessionRuneRewardIntentsV1(
    dependencies: Readonly<{ accountToken: AccountGenerationToken }>,
  ): Promise<LearningV2SessionRuneRewardRecoveryResultV1>;
}>;

const EMPTY_RECOVERY_RESULT = Object.freeze({
  applied: 0,
  replayed: 0,
  remaining: 0,
  failed: 0,
});

const isActiveCurrentAccount = (token: AccountGenerationToken): boolean =>
  token.phase === 'active' &&
  !!token.stableId &&
  isCurrentAccountGeneration(token, token.stableId);

export async function runLearningV2SessionRuneRewardRecoveryBootstrapV1(
  input: Readonly<{
    accountToken: AccountGenerationToken;
    loadRecovery?: () => Promise<RecoveryModuleV1>;
  }>,
): Promise<LearningV2SessionRuneRewardRecoveryResultV1> {
  if (!isActiveCurrentAccount(input.accountToken)) {
    return EMPTY_RECOVERY_RESULT;
  }
  const recovery = await (
    input.loadRecovery ??
    (() => import('./learning_v2_owner_repository_runtime'))
  )();
  // WHY: the lazy chunk may finish after an account switch. Recheck the exact
  // captured generation before even asking the old account's recovery to scan.
  if (!isActiveCurrentAccount(input.accountToken)) {
    return EMPTY_RECOVERY_RESULT;
  }
  return recovery.recoverPendingLearningV2SessionRuneRewardIntentsV1({
    accountToken: input.accountToken,
  });
}
