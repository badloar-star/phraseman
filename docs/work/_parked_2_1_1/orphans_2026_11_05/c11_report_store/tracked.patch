+    expect(saved.persisted).toBe(true);
+    expect(beforeWeekReplacement).toHaveBeenCalledWith(expect.objectContaining({ weekKey: WEEK, floor: 16, stepsCleared: 135 }));
+    expect(JSON.parse(store.data.get(key)!)).toMatchObject({ weekKey: '2026-W40' });
+  });
