 },
 {
  "id": "fr:28:12",
  "fr": "Pourriez-vous écrire votre nom ?",
  "ru": "пурье́ ву зекри́р вотр нон",
  "uk": "пурьє́ ву зекрі́р вотр нон"
 },
 {
  "id": "fr:29:11",
  "fr": "J’ai un voisin qui parle italien.",
  "ru": "жэ ён вуазэ́н ки парл итальэ́н",
  "uk": "же ен вуазе́н ки парл італьє́н"
 },
 {
  "id": "fr:30:09",
  "fr": "Il faut qu’elle soit prête.",
  "ru": "иль фо кэль суа прэт",
  "uk": "іль фо кель суа прет"
 },
 {
  "id": "fr:31:13",
  "fr": "Elle a relu la lettre qu’elle avait reçue.",
