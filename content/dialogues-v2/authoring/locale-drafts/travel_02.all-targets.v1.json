{"schemaVersion":"dialogue-v2-locale-draft.v1","status":"draft_not_releaseable","sourceScenarioId":"travel_02","targets":{"en":{"content":{"title":"Ask for the door code","briefing":"You are chatting in the Travel world. Ask politely for the door code and make sure you received it correctly.","completionTone":"brief, clear, and friendly"},"personas":[{"id":"niko"}],"objectives":[{"id":"objective_01","label":"Address them politely"},{"id":"objective_02","label":"Name the address or booking"},{"id":"objective_03","label":"Ask for the code"},{"id":"objective_04","label":"Ask when it will be available"},{"id":"objective_05","label":"Ask to repeat the digits"},{"id":"objective_06","label":"Confirm receipt"}]},"es":{"content":{"title":"Pedir el código de la puerta","briefing":"Estás chateando en el mundo «Viajes». Pide el código de la puerta con educación y confirma que lo recibiste bien.","completionTone":"breve, claro y amable"},"personas":[{"id":"niko"}],"objectives":[{"id":"objective_01","label":"Dirigirte con educación"},{"id":"objective_02","label":"Dar la dirección o reserva"},{"id":"objective_03","label":"Pedir el código"},{"id":"objective_04","label":"Preguntar cuándo estará disponible"},{"id":"objective_05","label":"Pedir que repita los dígitos"},{"id":"objective_06","label":"Confirmar la recepción"}]},"fr":{"content":{"title":"Demander le code de la porte","briefing":"Tu échanges des messages dans le monde «Voyages». Demande poliment le code de la porte et vérifie que tu l'as bien reçu.","completionTone":"bref, clair et chaleureux"},"personas":[{"id":"niko"}],"objectives":[{"id":"objective_01","label":"T'adresser poliment"},{"id":"objective_02","label":"Donner l'adresse ou la réservation"},{"id":"objective_03","label":"Demander le code"},{"id":"objective_04","label":"Demander quand il sera disponible"},{"id":"objective_05","label":"Faire répéter les chiffres"},{"id":"objective_06","label":"Confirmer la réception"}]},"de":{"content":{"title":"Nach dem Türcode fragen","briefing":"Du schreibst im Bereich „Reisen“. Bitte höflich um den Türcode und stelle sicher, dass du ihn richtig erhalten hast.","completionTone":"kurz, klar und freundlich"},"personas":[{"id":"niko"}],"objectives":[{"id":"objective_01","label":"Höflich ansprechen"},{"id":"objective_02","label":"Adresse oder Buchung nennen"},{"id":"objective_03","label":"Nach dem Code fragen"},{"id":"objective_04","label":"Fragen, wann er verfügbar ist"},{"id":"objective_05","label":"Um Wiederholung der Ziffern bitten"},{"id":"objective_06","label":"Den Erhalt bestätigen"}]}}}
