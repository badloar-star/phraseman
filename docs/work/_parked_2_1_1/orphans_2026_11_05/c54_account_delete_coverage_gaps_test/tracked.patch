+        participantUids: [STABLE, 'other'],
+        records: { '1:1': { uid: STABLE, durationMs: 700 }, '1:2': { uid: 'other', durationMs: 800 } },
+        personal: { [STABLE]: { '1:1': { uid: STABLE, durationMs: 700 } }, other: { '1:2': { uid: 'other', durationMs: 800 } } },
+      },
+    },
+  });
+
+  await removeFromSpireGroups(db, STABLE, stats());
+  await removeFromSpireGroups(db, STABLE, stats());
+
+  const stepV2 = store.spire_floor_records.get('step-v2_g1')!;
+  expect(stepV2.records).toEqual({ '1:2': { uid: 'other', durationMs: 800 } });
+  expect(stepV2.personal).toEqual({ other: { '1:2': { uid: 'other', durationMs: 800 } } });
+  expect(stepV2.participantUids).toEqual(['other']);
+  expect(JSON.stringify(stepV2)).not.toContain(STABLE);
+  expect(store.spire_groups.get('g1')!.liveMemberCount).toBe(1);
+});
