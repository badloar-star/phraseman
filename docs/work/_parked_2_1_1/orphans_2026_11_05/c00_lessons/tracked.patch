+export async function recordSpireAchievementFact(fact: SpireAchievementFact, token: AccountGenerationToken): Promise<boolean> {
+  const id = spireAchievementId(fact.tier);
+  if (!id || !token.stableId || !isCurrentAccountGeneration(token)) return false;
+  return enqueueAchievementOperation(token, async () => {
+    try {
+      const states = await loadAchievementStatesForTargetInternal(undefined, token, false);
+      if (!states.length || !isCurrentAccountGeneration(token)) return false;
+      const result = applySpireAchievementFact(states.find((row) => row.id === id), fact);
+      if (!result) {
+        return replaySpireAchievementStories(states.filter((row) => row.id === id), token);
+      }
+      const next = [...states.filter((row) => row.id !== id), result.state];
+      if (!await saveStates(next, undefined, token) || !isCurrentAccountGeneration(token)) return false;
+      void import('./cloud_sync').then(({ syncToCloud }) => {
+        if (isCurrentAccountGeneration(token)) return syncToCloud();
+      }).catch((error: unknown) => DebugLogger.error('achievements:spire_sync', error, 'warning'));
+      if (result.change) emitAppEvent('achievement_unlocked');
+      return replaySpireAchievementStories([result.state], token);
+    } catch (error) {
+      DebugLogger.error('achievements:spire_fact', error, 'critical');
+      return false;
+    }
+  }, false);
+}
+
+/** Evidence and unlocks are one persisted snapshot in the existing owner-serialized achievement queue. */
+export async function recordActivityAchievementFact(fact: ActivityFact, token: AccountGenerationToken): Promise<boolean> {
+  if (!token.stableId || !isCurrentAccountGeneration(token)) return false;
+  return enqueueAchievementOperation(token, async () => {
+    try {
+      const states = await loadAchievementStatesForTargetInternal(undefined, token, false);
+      if (!states.length || !isCurrentAccountGeneration(token)) return false;
+      const result = applyActivityFact(states, fact, Date.now());
+      if (result.changed) {
+        if (!await saveStates(result.states, undefined, token) || !isCurrentAccountGeneration(token)) return false;
+        void import('./cloud_sync').then(({syncToCloud}) => { if(isCurrentAccountGeneration(token)) return syncToCloud(); }).catch((error: unknown)=>DebugLogger.error('achievements:activity_sync',error,'warning'));
+        if (result.unlocked.length) emitAppEvent('achievement_unlocked');
+      }
+      return replaySpireAchievementStories(result.states.filter(row=>ACTIVITY_ACHIEVEMENT_IDS.has(row.id)),token);
+    } catch(error) { DebugLogger.error('achievements:activity_fact',error,'warning'); return false; }
+  },false);
+}
