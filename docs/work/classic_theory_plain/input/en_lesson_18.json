 "phrases": [
  {
   "id": "en-classic-r1:18.01",
   "target": "Come this way.",
   "ru": "Пройдите сюда.",
   "uk": "Проходьте сюди."
  },
  {
   "id": "en-classic-r1:18.02",
   "target": "Wait by the gate.",
   "ru": "Подождите у ворот.",
   "uk": "Зачекайте біля воріт."
  },
  {
   "id": "en-classic-r1:18.03",
   "target": "Close the window, please.",
   "ru": "Закройте окно, пожалуйста.",
   "uk": "Будь ласка, зачиніть вікно."
  },
  {
   "id": "en-classic-r1:18.04",
   "target": "Sit down here.",
   "ru": "Сядьте здесь.",
   "uk": "Сядьте сюди."
  },
  {
   "id": "en-classic-r1:18.05",
   "target": "Stand behind the line.",
   "ru": "Встаньте за линию.",
   "uk": "Станьте за лінією."
  },
  {
   "id": "en-classic-r1:18.06",
   "target": "Hold the handrail.",
   "ru": "Держитесь за поручень.",
   "uk": "Тримайтеся за поручень."
  },
  {
   "id": "en-classic-r1:18.07",
   "target": "Watch your step.",
   "ru": "Смотрите под ноги.",
   "uk": "Дивіться під ноги."
  },
  {
   "id": "en-classic-r1:18.08",
   "target": "Keep the door closed.",
   "ru": "Держите дверь закрытой.",
   "uk": "Тримайте двері зачиненими."
  },
  {
   "id": "en-classic-r1:18.09",
   "target": "Leave the key on the desk.",
   "ru": "Оставьте ключ на столе.",
   "uk": "Залиште ключ на столі."
  },
  {
   "id": "en-classic-r1:18.10",
   "target": "Put your bag under the seat.",
   "ru": "Положите сумку под сиденье.",
   "uk": "Покладіть сумку під сидіння."
  },
  {
   "id": "en-classic-r1:18.11",
   "target": "Do not touch the oven.",
   "ru": "Не прикасайтесь к духовке.",
   "uk": "Не торкайтеся духовки."
  },
  {
   "id": "en-classic-r1:18.12",
   "target": "Do not block the stairs.",
   "ru": "Не загораживайте лестницу.",
   "uk": "Не блокуйте сходи."
  },
  {
   "id": "en-classic-r1:18.13",
   "target": "Do not leave the tap running.",
   "ru": "Не оставляйте кран открытым.",
   "uk": "Не залишайте кран відкритим."
  },
  {
   "id": "en-classic-r1:18.14",
   "target": "Do not press the red button.",
   "ru": "Не нажимайте красную кнопку.",
   "uk": "Не натискайте червону кнопку."
  },
  {
   "id": "en-classic-r1:18.15",
   "target": "Do not forget your badge.",
   "ru": "Не забудьте свой пропуск.",
   "uk": "Не забудьте свій бейдж."
  },
  {
   "id": "en-classic-r1:18.16",
   "target": "Do not share the code.",
   "ru": "Не сообщайте код.",
   "uk": "Не повідомляйте код."
  },
  {
   "id": "en-classic-r1:18.17",
   "target": "Do not lift that box alone.",
   "ru": "Не поднимайте эту коробку в одиночку.",
   "uk": "Не піднімайте цю коробку самостійно."
  },
  {
   "id": "en-classic-r1:18.18",
   "target": "Do not feed the dog.",
   "ru": "Не кормите собаку.",
   "uk": "Не годуйте собаку."
  },
  {
   "id": "en-classic-r1:18.19",
   "target": "Do not open the parcel yet.",
   "ru": "Пока не открывайте посылку.",
   "uk": "Поки що не відкривайте посилку."
  },
  {
   "id": "en-classic-r1:18.20",
   "target": "Do not park in front of the gate.",
   "ru": "Не паркуйтесь перед воротами.",
   "uk": "Не паркуйтеся перед воротами."
  },
  {
   "id": "en-classic-r1:18.21",
   "target": "Please pass the towel.",
   "ru": "Пожалуйста, передайте полотенце.",
   "uk": "Будь ласка, передайте рушник."
  },
  {
   "id": "en-classic-r1:18.22",
   "target": "Please sign on this line.",
   "ru": "Пожалуйста, распишитесь на этой строке.",
   "uk": "Будь ласка, розпишіться на цій лінії."
  },
  {
   "id": "en-classic-r1:18.23",
   "target": "Please return the key at reception.",
   "ru": "Пожалуйста, верните ключ на ресепшен.",
   "uk": "Будь ласка, поверніть ключ на рецепції."
  },
  {
   "id": "en-classic-r1:18.24",
   "target": "Please switch your phone off.",
   "ru": "Пожалуйста, выключите телефон.",
   "uk": "Будь ласка, вимкніть телефон."
  },
  {
   "id": "en-classic-r1:18.25",
   "target": "Please keep your ticket.",
   "ru": "Пожалуйста, сохраните билет.",
   "uk": "Будь ласка, збережіть свій квиток."
  },
  {
   "id": "en-classic-r1:18.26",
   "target": "Please spell your surname.",
   "ru": "Пожалуйста, назовите свою фамилию по буквам.",
   "uk": "Будь ласка, продиктуйте своє прізвище по літерах."
  },
  {
   "id": "en-classic-r1:18.27",
   "target": "Please tell me your postcode.",
   "ru": "Пожалуйста, сообщите мне свой почтовый индекс.",
   "uk": "Будь ласка, скажіть мені свій поштовий індекс."
  },
  {
   "id": "en-classic-r1:18.28",
   "target": "Please speak a little louder.",
   "ru": "Пожалуйста, говорите немного громче.",
   "uk": "Будь ласка, говоріть трохи голосніше."
  },
  {
   "id": "en-classic-r1:18.29",
   "target": "Please save me a seat.",
   "ru": "Пожалуйста, оставьте мне место.",
   "uk": "Будь ласка, займіть мені місце."
  },
  {
   "id": "en-classic-r1:18.30",
   "target": "Please bring a copy of the receipt.",
   "ru": "Пожалуйста, возьмите с собой копию чека.",
   "uk": "Будь ласка, візьміть копію чека."
  },
  {
   "id": "en-classic-r1:18.31",
   "target": "Turn left at the lights.",
   "ru": "Поверните налево на светофоре.",
   "uk": "Поверніть ліворуч на світлофорі."
  },
  {
   "id": "en-classic-r1:18.32",
   "target": "Take the second exit.",
   "ru": "Воспользуйтесь вторым выездом.",
   "uk": "З'їдьте на другому виїзді."
  },
  {
   "id": "en-classic-r1:18.33",
   "target": "Cross at the crossing.",
   "ru": "Перейдите дорогу на пешеходном переходе.",
   "uk": "Перейдіть дорогу на переході."
  },
  {
   "id": "en-classic-r1:18.34",
   "target": "Go past the pharmacy.",
   "ru": "Пройдите мимо аптеки.",
   "uk": "Пройдіть повз аптеку."
  },
  {
   "id": "en-classic-r1:18.35",
   "target": "Follow the blue signs.",
   "ru": "Следуйте синим указателям.",
   "uk": "Ідіть за синіми вказівниками."
  },
  {
   "id": "en-classic-r1:18.36",
   "target": "Walk to the end of the road.",
   "ru": "Пройдите до конца улицы.",
   "uk": "Йдіть до кінця дороги."
  },
  {
   "id": "en-classic-r1:18.37",
   "target": "Use the entrance on the right.",
   "ru": "Воспользуйтесь входом справа.",
   "uk": "Скористайтеся входом праворуч."
  },
  {
   "id": "en-classic-r1:18.38",
   "target": "Push the door gently.",
   "ru": "Осторожно толкните дверь.",
   "uk": "Обережно натисніть на двері."
  },
  {
   "id": "en-classic-r1:18.39",
   "target": "Pull the handle towards you.",
   "ru": "Потяните ручку на себя.",
   "uk": "Потягніть ручку на себе."
  },
  {
   "id": "en-classic-r1:18.40",
   "target": "Ring the bell once.",
   "ru": "Позвоните в звонок один раз.",
   "uk": "Подзвоніть у дзвінок один раз."
  },
  {
   "id": "en-classic-r1:18.41",
   "target": "Let's take the early train.",
   "ru": "Давайте поедем ранним поездом.",
   "uk": "Давайте поїдемо раннім поїздом."
  },
  {
   "id": "en-classic-r1:18.42",
   "target": "Let's wait for the others.",
   "ru": "Подождем остальных.",
   "uk": "Давайте почекаємо на інших."
  },
  {
   "id": "en-classic-r1:18.43",
   "target": "Let's share a taxi.",
   "ru": "Давай возьмём одно такси на двоих.",
   "uk": "Давай візьмемо одне таксі на двох."
  },
  {
   "id": "en-classic-r1:18.44",
   "target": "Let's check the address first.",
   "ru": "Сначала проверим адрес.",
   "uk": "Давайте спочатку перевіримо адресу."
  },
  {
   "id": "en-classic-r1:18.45",
   "target": "Let's sit near the window.",
   "ru": "Сядем у окна.",
   "uk": "Давайте сядемо біля вікна."
  },
  {
   "id": "en-classic-r1:18.46",
   "target": "Let's not rush.",
   "ru": "Не будем спешить.",
   "uk": "Не поспішаймо."
  },
  {
   "id": "en-classic-r1:18.47",
   "target": "Let's not leave the bags here.",
   "ru": "Не будем оставлять здесь сумки.",
   "uk": "Не залишаймо тут сумки."
  },
  {
   "id": "en-classic-r1:18.48",
   "target": "Let's ask the driver.",
   "ru": "Давайте спросим водителя.",
   "uk": "Запитаємо водія."
  },
  {
   "id": "en-classic-r1:18.49",
   "target": "Let's try the side door.",
   "ru": "Давайте попробуем открыть боковую дверь.",
   "uk": "Спробуємо через бічні двері."
  },
  {
   "id": "en-classic-r1:18.50",
   "target": "Let's call before we leave.",
   "ru": "Давайте позвоним перед отъездом.",
   "uk": "Зателефонуємо перед виїздом."
