 "phrases": [
  {
   "id": "it:25:01",
   "target": "Ne voglio uno.",
   "ru": "Я хочу один из них.",
   "uk": "Я хочу один із них."
  },
  {
   "id": "it:25:02",
   "target": "Ne voglio due.",
   "ru": "Я хочу два из них.",
   "uk": "Я хочу два з них."
  },
  {
   "id": "it:25:03",
   "target": "Ne prendi uno.",
   "ru": "Ты берёшь один.",
   "uk": "Ти береш один."
  },
  {
   "id": "it:25:04",
   "target": "Ne prendi due.",
   "ru": "Ты берёшь два.",
   "uk": "Ти береш два."
  },
  {
   "id": "it:25:05",
   "target": "Lei ne tiene tre.",
   "ru": "Она оставляет себе три.",
   "uk": "Вона залишає собі три."
  },
  {
   "id": "it:25:06",
   "target": "Ne compriamo quattro.",
   "ru": "Мы покупаем четыре.",
   "uk": "Ми купуємо чотири."
  },
  {
   "id": "it:25:07",
   "target": "Ne vuole cinque?",
   "ru": "Вы хотите пять штук?",
   "uk": "Ви хочете п’ять штук?"
  },
  {
   "id": "it:25:08",
   "target": "Ne hanno sei.",
   "ru": "У них шесть.",
   "uk": "У них шість."
  },
  {
   "id": "it:25:09",
   "target": "Ne ho abbastanza.",
   "ru": "У меня их достаточно.",
   "uk": "У мене їх достатньо."
  },
  {
   "id": "it:25:10",
   "target": "Ne è rimasta una.",
   "ru": "Осталась одна.",
   "uk": "Залишилася одна."
  },
  {
   "id": "it:25:11",
   "target": "Di pane ne prendo un po’.",
   "ru": "Хлеба я возьму немного.",
   "uk": "Хліба я візьму небагато."
  },
  {
   "id": "it:25:12",
   "target": "Di formaggio ne mangia spesso.",
   "ru": "Она часто ест сыр.",
   "uk": "Вона часто їсть сир."
  },
  {
   "id": "it:25:13",
   "target": "Di mele ne comprerò un chilo.",
   "ru": "Куплю килограмм яблок.",
   "uk": "Я куплю кілограм яблук."
  },
  {
   "id": "it:25:14",
   "target": "Di uova ne prenderò sei.",
   "ru": "Возьму шесть яиц.",
   "uk": "Я візьму шість яєць."
  },
  {
   "id": "it:25:15",
   "target": "Di caffè ne beviamo al mattino.",
   "ru": "Мы пьем кофе по утрам.",
   "uk": "Ми п’ємо каву вранці."
  },
  {
   "id": "it:25:16",
   "target": "Di zuppa ne è rimasta una scodella.",
   "ru": "Осталась миска супа.",
   "uk": "Залишилася миска супу."
  },
  {
   "id": "it:25:17",
   "target": "Di miele ne aggiungo un cucchiaio.",
   "ru": "Мёда я добавлю ложку.",
   "uk": "Меду я додам ложку."
  },
  {
   "id": "it:25:18",
   "target": "Di riso ne prendo una ciotola.",
   "ru": "Я возьму одну миску риса.",
   "uk": "Я візьму одну миску рису."
  },
  {
   "id": "it:25:19",
   "target": "Di fragole ne vuole una vaschetta.",
   "ru": "Клубники она хочет один лоток.",
   "uk": "Полуниці вона хоче один лоток."
  },
  {
   "id": "it:25:20",
   "target": "Di burro ne uso pochissimo.",
   "ru": "Масла я использую совсем немного.",
   "uk": "Вершкового масла я використовую дуже мало."
  },
  {
   "id": "it:25:21",
   "target": "Non ne ho.",
   "ru": "У меня их нет.",
   "uk": "У мене їх немає."
  },
  {
   "id": "it:25:22",
   "target": "Non ne abbiamo più.",
   "ru": "У нас их больше нет.",
   "uk": "У нас їх більше немає."
  },
  {
   "id": "it:25:23",
   "target": "Non ne vuole.",
   "ru": "Она их не хочет.",
   "uk": "Вона їх не хоче."
  },
  {
   "id": "it:25:24",
   "target": "Non ne è rimasta nessuna.",
   "ru": "Не осталось ни одной.",
   "uk": "Не залишилося жодної."
  },
  {
   "id": "it:25:25",
   "target": "Non ne prendi mai?",
   "ru": "Ты их никогда не берёшь?",
   "uk": "Ти їх ніколи не береш?"
  },
  {
   "id": "it:25:26",
   "target": "Di bottiglie ne mettiamo due sullo scaffale.",
   "ru": "Мы ставим на полку две бутылки.",
   "uk": "Ми ставимо на полицю дві пляшки."
  },
  {
   "id": "it:25:27",
   "target": "Qui non ne trovano.",
   "ru": "Они их здесь не находят.",
   "uk": "Вони їх тут не знаходять."
  },
  {
   "id": "it:25:28",
   "target": "Non ne ha altri?",
   "ru": "У вас нет других?",
   "uk": "У вас немає інших?"
  },
  {
   "id": "it:25:29",
   "target": "Lui ne tiene solo uno.",
   "ru": "Он оставляет себе только один.",
   "uk": "Він залишає собі тільки один."
  },
  {
   "id": "it:25:30",
   "target": "Non ne bevo più la sera.",
   "ru": "Я больше не пью его по вечерам.",
   "uk": "Я більше не п’ю його вечорами."
  },
  {
   "id": "it:25:31",
   "target": "Ne ho comprate due.",
   "ru": "Я купил две.",
   "uk": "Я купив дві."
  },
  {
   "id": "it:25:32",
   "target": "Ne ha trovata una.",
   "ru": "Она нашла одну.",
   "uk": "Вона знайшла одну."
  },
  {
   "id": "it:25:33",
   "target": "Ne abbiamo prenotati tre.",
   "ru": "Мы зарезервировали три.",
   "uk": "Ми зарезервували три."
  },
  {
   "id": "it:25:34",
   "target": "Quanti ne hai ricevuti?",
   "ru": "Сколько ты их получил?",
   "uk": "Скільки ти їх одержав?"
  },
  {
   "id": "it:25:35",
   "target": "Ne abbiamo perso uno.",
   "ru": "Один мы потеряли.",
   "uk": "Ми втратили один."
  },
  {
   "id": "it:25:36",
   "target": "Ne porterò ancora.",
   "ru": "Я принесу ещё.",
   "uk": "Я принесу ще."
  },
  {
   "id": "it:25:37",
   "target": "Puoi portarne due?",
   "ru": "Можешь принести две штуки?",
   "uk": "Чи можеш принести дві штуки?"
  },
  {
   "id": "it:25:38",
   "target": "Ci servono dei cavi per il palco; dobbiamo ordinarne tre.",
   "ru": "Нам нужны кабели для сцены; нужно заказать три.",
   "uk": "Нам потрібні кабелі для сцени; нам потрібно замовити три."
  },
  {
   "id": "it:25:39",
   "target": "Dobbiamo ordinarne altri.",
   "ru": "Нам нужно заказать ещё.",
   "uk": "Нам потрібно замовити ще."
  },
  {
   "id": "it:25:40",
   "target": "Queste pile sono cariche: può tenerne la metà.",
   "ru": "Эти батареи заряжены; половину можете оставить себе.",
   "uk": "Ці батареї заряджені; ви можете залишити половину з них."
  },
  {
   "id": "it:25:41",
   "target": "Ho quattro biglietti e te ne do due.",
   "ru": "У меня четыре билета, и я даю тебе два.",
   "uk": "У мене чотири квитки, і я даю тобі два."
  },
  {
   "id": "it:25:42",
   "target": "Questi asciugamani sono puliti: puoi prenderne uno.",
   "ru": "Эти полотенца чистые, можешь взять одно.",
   "uk": "Ці рушники чисті, можеш узяти одне."
  },
  {
   "id": "it:25:43",
   "target": "Queste persiane sbattono per il vento, ne chiudo due.",
   "ru": "Эти ставни хлопают на ветру, я закрою две из них.",
   "uk": "Ці віконниці ляскають на вітрі, я закрию дві з них."
  },
  {
   "id": "it:25:44",
   "target": "Queste pere sono mature, ne vorrei tre.",
   "ru": "Эти груши спелые, я бы хотел три.",
   "uk": "Ці груші стиглі, я б хотів три."
  },
  {
   "id": "it:25:45",
   "target": "Mi piacciono questi panini e ne compro spesso.",
   "ru": "Мне нравятся эти булочки, я часто их покупаю.",
   "uk": "Мені подобаються ці булочки, і я часто їх купую."
  },
  {
   "id": "it:25:46",
   "target": "Mancano dei bicchieri: vado a prenderne altri.",
   "ru": "Не хватает стаканов, я пойду возьму ещё.",
   "uk": "Не вистачає склянок, я піду візьму ще."
  },
  {
   "id": "it:25:47",
   "target": "Questo tè è leggero: ne vuole ancora?",
   "ru": "Этот чай мягкий, хотите еще?",
   "uk": "Цей чай м’який, хочете ще?"
  },
  {
   "id": "it:25:48",
   "target": "Ho troppi scatoloni e ne regalerò qualcuno.",
   "ru": "У меня слишком много коробок, я отдам часть.",
   "uk": "У мене забагато коробок, і я деякі віддам."
  },
  {
   "id": "it:25:49",
   "target": "Abbiamo poco tempo e ne serve di più.",
   "ru": "У нас мало времени, и нам нужно больше.",
   "uk": "У нас мало часу, а нам потрібно більше."
  },
  {
