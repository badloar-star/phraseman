        "en:lesson-01:session-56:intro1:r3": {
          "ru": "Между `it` и словом-признаком нужна форма `is`.",
          "uk": "Між `it` і словом-ознакою потрібна форма `is`."
        }
      }
    },
    {
      "interactionId": "en:lesson-01:session-56:intro2:q",
      "responseFeedbackById": {
        "en:lesson-01:session-56:intro2:r2": {
