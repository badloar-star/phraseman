  {
   "id": "en-classic-r1:23.01",
   "target": "The gate is locked at night.",
   "ru": "Ворота запираются на ночь.",
   "uk": "Ворота замкнені на ніч."
  },
  {
   "id": "en-classic-r1:23.02",
   "target": "The rooms are cleaned daily.",
   "ru": "Комнаты убираются ежедневно.",
   "uk": "Кімнати прибираються щодня."
  },
  {
   "id": "en-classic-r1:23.03",
   "target": "The letters are collected at noon.",
   "ru": "Письма забирают в полдень.",
   "uk": "Листи забирають опівдні."
  },
  {
   "id": "en-classic-r1:23.04",
   "target": "The windows are checked every week.",
   "ru": "Окна проверяют каждую неделю.",
   "uk": "Вікна перевіряють щотижня."
  },
  {
   "id": "en-classic-r1:23.05",
   "target": "The milk is delivered in the morning.",
   "ru": "Молоко доставляют утром.",
   "uk": "Молоко доставляють вранці."
  },
  {
   "id": "en-classic-r1:23.06",
   "target": "The spare key is kept downstairs.",
   "ru": "Запасной ключ хранится внизу.",
   "uk": "Запасний ключ зберігається внизу."
  },
  {
   "id": "en-classic-r1:23.07",
   "target": "The tickets are sold online.",
   "ru": "Билеты продаются онлайн.",
   "uk": "Квитки продаються онлайн."
  },
  {
   "id": "en-classic-r1:23.08",
   "target": "The price is shown on the screen.",
   "ru": "Цена отображается на экране.",
   "uk": "Ціна відображається на екрані."
  },
  {
   "id": "en-classic-r1:23.09",
   "target": "The uniforms are washed on site.",
   "ru": "Униформу стирают на месте.",
   "uk": "Уніформу перуть на місці."
  },
  {
   "id": "en-classic-r1:23.10",
   "target": "The bill is sent by email.",
   "ru": "Счет высылается по электронной почте.",
   "uk": "Рахунок надсилають електронною поштою."
  },
  {
   "id": "en-classic-r1:23.11",
   "target": "The room was booked yesterday.",
   "ru": "Комната была забронирована вчера.",
   "uk": "Кімнату було заброньовано вчора."
  },
  {
   "id": "en-classic-r1:23.12",
   "target": "The seats by the aisle were reserved for us.",
   "ru": "Для нас были зарезервированы места у прохода.",
   "uk": "Місця біля проходу були зарезервовані для нас."
  },
  {
   "id": "en-classic-r1:23.13",
   "target": "The door was repaired on Friday.",
   "ru": "Дверь была отремонтирована в пятницу.",
   "uk": "Двері було відремонтовано в п'ятницю."
  },
  {
   "id": "en-classic-r1:23.14",
   "target": "The lights were switched off at ten.",
   "ru": "Свет выключили в десять.",
   "uk": "Світло вимкнули о десятій."
  },
  {
   "id": "en-classic-r1:23.15",
   "target": "My parcel was delivered next door.",
   "ru": "Мою посылку доставили в соседний дом.",
