 "phrases": [
  {
   "id": "en-classic-r1:15.01",
   "target": "This is my coat.",
   "ru": "Это моё пальто.",
   "uk": "Це моє пальто."
  },
  {
   "id": "en-classic-r1:15.02",
   "target": "This coat is mine.",
   "ru": "Это пальто моё.",
   "uk": "Це пальто моє."
  },
  {
   "id": "en-classic-r1:15.03",
   "target": "That is your bag.",
   "ru": "Это твоя сумка.",
   "uk": "Це твоя сумка."
  },
  {
   "id": "en-classic-r1:15.04",
   "target": "That bag is yours.",
   "ru": "Вон та сумка твоя.",
   "uk": "Он та сумка твоя."
  },
  {
   "id": "en-classic-r1:15.05",
   "target": "This is her key.",
   "ru": "Это её ключ.",
   "uk": "Це її ключ."
  },
  {
   "id": "en-classic-r1:15.06",
   "target": "This key is hers.",
   "ru": "Этот ключ её.",
   "uk": "Цей ключ її."
  },
  {
   "id": "en-classic-r1:15.07",
   "target": "Those are our seats.",
   "ru": "Это наши места.",
   "uk": "Це наші місця."
  },
  {
   "id": "en-classic-r1:15.08",
   "target": "These seats are ours.",
   "ru": "Эти места наши.",
   "uk": "Ці місця наші."
  },
  {
   "id": "en-classic-r1:15.09",
   "target": "These are their tickets.",
   "ru": "Это их билеты.",
   "uk": "Це їхні квитки."
  },
  {
   "id": "en-classic-r1:15.10",
   "target": "These tickets are theirs.",
   "ru": "Эти билеты принадлежат им.",
   "uk": "Ці квитки їхні."
  },
  {
   "id": "en-classic-r1:15.11",
   "target": "My gloves are wet.",
   "ru": "Мои перчатки мокрые.",
   "uk": "Мої рукавички мокрі."
  },
  {
   "id": "en-classic-r1:15.12",
   "target": "Your scarf is on the chair.",
   "ru": "Твой шарф лежит на стуле.",
   "uk": "Твій шарф на стільці."
  },
  {
   "id": "en-classic-r1:15.13",
   "target": "Her helmet is on the shelf.",
   "ru": "Ее шлем на полке.",
   "uk": "Її шолом на полиці."
  },
  {
   "id": "en-classic-r1:15.14",
   "target": "His jacket is in the hall.",
   "ru": "Его куртка в прихожей.",
   "uk": "Його куртка в коридорі."
  },
  {
   "id": "en-classic-r1:15.15",
   "target": "Our towels are still damp.",
   "ru": "Наши полотенца все еще влажные.",
   "uk": "Наші рушники ще вологі."
  },
  {
   "id": "en-classic-r1:15.16",
   "target": "Their boots are outside.",
   "ru": "Их ботинки снаружи.",
   "uk": "Їхні черевики надворі."
  },
  {
   "id": "en-classic-r1:15.17",
   "target": "I found my umbrella.",
   "ru": "Я нашел свой зонтик.",
   "uk": "Я знайшов свою парасольку."
  },
  {
   "id": "en-classic-r1:15.18",
   "target": "She lost her badge.",
   "ru": "Она потеряла свой бейдж.",
   "uk": "Вона загубила свій бейдж."
  },
  {
   "id": "en-classic-r1:15.19",
   "target": "He left his notebook here.",
   "ru": "Он оставил здесь свой блокнот.",
   "uk": "Він залишив тут свій блокнот."
  },
  {
   "id": "en-classic-r1:15.20",
   "target": "We checked our booking.",
   "ru": "Мы проверили наше бронирование.",
   "uk": "Ми перевірили наше бронювання."
  },
  {
   "id": "en-classic-r1:15.21",
   "target": "Whose coat is this?",
   "ru": "Чье это пальто?",
   "uk": "Чиє це пальто?"
  },
  {
   "id": "en-classic-r1:15.22",
   "target": "Whose keys are these?",
   "ru": "Чьи это ключи?",
   "uk": "Чиї це ключі?"
  },
  {
   "id": "en-classic-r1:15.23",
   "target": "Is this umbrella yours?",
   "ru": "Этот зонт твой?",
   "uk": "Ця парасолька твоя?"
  },
  {
   "id": "en-classic-r1:15.24",
   "target": "Are those gloves hers?",
   "ru": "Эти перчатки ее?",
   "uk": "Ці рукавички її?"
  },
  {
   "id": "en-classic-r1:15.25",
   "target": "Is the blue bike his?",
   "ru": "Синий велосипед его?",
   "uk": "Синій велосипед його?"
  },
  {
   "id": "en-classic-r1:15.26",
   "target": "Are the seats by the window ours?",
   "ru": "Места у окна наши?",
   "uk": "Місця біля вікна наші?"
  },
  {
   "id": "en-classic-r1:15.27",
   "target": "Is this booking theirs?",
   "ru": "Это их бронирование?",
   "uk": "Це бронювання їхнє?"
  },
  {
   "id": "en-classic-r1:15.28",
   "target": "Whose name is on the envelope?",
   "ru": "Чье имя на конверте?",
   "uk": "Чиє ім'я на конверті?"
  },
  {
   "id": "en-classic-r1:15.29",
   "target": "Is that your locker?",
   "ru": "Это твой шкафчик?",
   "uk": "Це твоя шафка?"
  },
  {
   "id": "en-classic-r1:15.30",
   "target": "Are these your headphones?",
   "ru": "Это твои наушники?",
   "uk": "Це твої навушники?"
  },
  {
   "id": "en-classic-r1:15.31",
   "target": "I have my ticket, but she needs hers.",
   "ru": "У меня есть свой билет, а ей нужен свой.",
   "uk": "У мене є мій квиток, але їй потрібен свій."
  },
  {
   "id": "en-classic-r1:15.32",
   "target": "Your bag is heavier than mine.",
   "ru": "Ваша сумка тяжелее моей.",
   "uk": "Ваша сумка важча за мою."
  },
  {
   "id": "en-classic-r1:15.33",
   "target": "His shift starts later than ours.",
   "ru": "Его смена начинается позже нашей.",
   "uk": "Його зміна починається пізніше за нашу."
  },
  {
   "id": "en-classic-r1:15.34",
   "target": "Our door is blue; theirs is green.",
   "ru": "Наша дверь синяя, их — зелёная.",
   "uk": "Наші двері сині; їхні – зелені."
  },
  {
   "id": "en-classic-r1:15.35",
   "target": "I know my postcode, but not yours.",
   "ru": "Я знаю свой почтовый индекс, но не ваш.",
   "uk": "Я знаю свій поштовий індекс, але не ваш."
  },
  {
   "id": "en-classic-r1:15.36",
   "target": "Her bike is older than his.",
   "ru": "Её велосипед старше его.",
   "uk": "Її велосипед старіший за його."
  },
  {
   "id": "en-classic-r1:15.37",
   "target": "Your towel is dry; mine is wet.",
   "ru": "Ваше полотенце сухое, моё мокрое.",
   "uk": "Ваш рушник сухий; мій мокрий."
  },
  {
   "id": "en-classic-r1:15.38",
   "target": "We brought our own cups.",
   "ru": "Мы принесли свои чашки.",
   "uk": "Ми принесли свої власні чашки."
  },
  {
   "id": "en-classic-r1:15.39",
   "target": "They forgot their own bags.",
   "ru": "Они забыли свои сумки.",
   "uk": "Вони забули свої сумки."
  },
  {
   "id": "en-classic-r1:15.40",
   "target": "She has her own desk.",
   "ru": "У неё свой стол.",
   "uk": "У неї свій власний стіл."
  },
  {
   "id": "en-classic-r1:15.41",
   "target": "Please use your own charger.",
   "ru": "Пожалуйста, используйте своё зарядное устройство.",
   "uk": "Будь ласка, користуйтеся своїм власним зарядним пристроєм."
  },
  {
   "id": "en-classic-r1:15.42",
   "target": "Is that your sister's coat?",
   "ru": "Это пальто вашей сестры?",
   "uk": "Це пальто вашої сестри?"
  },
  {
   "id": "en-classic-r1:15.43",
   "target": "This is my brother's helmet.",
   "ru": "Это шлем моего брата.",
   "uk": "Це шолом мого брата."
  },
  {
   "id": "en-classic-r1:15.44",
   "target": "The children's boots are by the door.",
   "ru": "Ботинки детей стоят у двери.",
   "uk": "Дитячі черевики біля дверей."
  },
  {
   "id": "en-classic-r1:15.45",
   "target": "Our neighbour's gate is open.",
   "ru": "Ворота нашего соседа открыты.",
   "uk": "Ворота нашого сусіда відчинені."
  },
  {
   "id": "en-classic-r1:15.46",
   "target": "I have the driver's number.",
   "ru": "У меня есть номер водителя.",
   "uk": "У мене є номер водія."
  },
  {
   "id": "en-classic-r1:15.47",
   "target": "My seat is free, but yours is taken.",
   "ru": "Мое место свободно, а ваше занято.",
   "uk": "Моє місце вільне, але ваше зайняте."
  },
  {
   "id": "en-classic-r1:15.48",
   "target": "His name is on the label, not hers.",
   "ru": "На этикетке написано его имя, а не ее.",
   "uk": "Його ім'я на етикетці, а не її."
  },
  {
   "id": "en-classic-r1:15.49",
   "target": "Their keys work, but ours do not.",
   "ru": "Их ключи работают, а наши нет.",
   "uk": "Їхні ключі працюють, а наші ні."
  },
  {
   "id": "en-classic-r1:15.50",
   "target": "I think this umbrella is yours.",
   "ru": "Думаю, этот зонт твой.",
   "uk": "Я думаю, що ця парасолька твоя."
  }
 ],
