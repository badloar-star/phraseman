  },
  {
   "id": "it:22:05",
   "target": "La conosci.",
   "ru": "Ты её знаешь.",
   "uk": "Ти її знаєш."
  },
  {
   "id": "it:22:06",
   "target": "Li conosci.",
   "ru": "Ты их знаешь.",
   "uk": "Ти знаєш їх."
  },
  {
   "id": "it:22:07",
   "target": "Lei lo cerca.",
   "ru": "Она ищет его.",
   "uk": "Вона шукає його."
  },
  {
   "id": "it:22:08",
   "target": "Lei la cerca.",
   "ru": "Она ищет её.",
   "uk": "Вона шукає її."
  },
  {
   "id": "it:22:09",
   "target": "Lei li cerca.",
   "ru": "Она ищет их.",
   "uk": "Вона шукає їх."
  },
  {
   "id": "it:22:10",
   "target": "Li aspettiamo.",
   "ru": "Мы ждём их.",
   "uk": "Ми чекаємо на них."
  },
  {
   "id": "it:22:11",
   "target": "La porta, la chiudo io.",
   "ru": "Дверь — я её закрываю.",
   "uk": "Двері - я її закриваю."
  },
  {
   "id": "it:22:12",
   "target": "La borsa, la tengo io.",
   "ru": "Сумку я оставляю у себя.",
   "uk": "Сумку я залишаю у себе."
  },
  {
   "id": "it:22:13",
   "target": "Le chiavi, le porto con me.",
   "ru": "Ключи я беру с собой.",
   "uk": "Ключі я беру із собою."
  },
  {
   "id": "it:22:14",
   "target": "La giacca, la metto via.",
   "ru": "Куртку я убираю на место.",
   "uk": "Куртку я прибираю на місце."
  },
  {
   "id": "it:22:15",
   "target": "Il pane, lo taglio io.",
   "ru": "Я режу хлеб.",
   "uk": "Я ріжу хліб."
  },
  {
   "id": "it:22:16",
   "target": "I bicchieri, li lavo io.",
   "ru": "Я мою стаканы.",
   "uk": "Я мию склянки."
  },
  {
   "id": "it:22:17",
   "target": "I biglietti, li stampo io.",
   "ru": "Я распечатываю билеты.",
   "uk": "Я друкую квитки."
  },
  {
   "id": "it:22:18",
   "target": "La zuppa, l’assaggio io.",
   "ru": "Суп — я его пробую.",
   "uk": "Суп - я його пробую."
  },
  {
   "id": "it:22:19",
   "target": "Il maglione, lo provo io.",
   "ru": "Свитер — я его примеряю.",
   "uk": "Светр - я його приміряю."
  },
  {
   "id": "it:22:20",
   "target": "Questa canzone, l’ascolto io.",
   "ru": "Я слушаю эту песню.",
   "uk": "Я слухаю цю пісню."
  },
  {
   "id": "it:22:21",
   "target": "Non lo trovo.",
   "ru": "Я его не нахожу.",
   "uk": "Я його не знаходжу."
  },
  {
   "id": "it:22:22",
   "target": "Lei non la riconosce.",
   "ru": "Она её не узнаёт.",
   "uk": "Вона її не впізнає."
  },
  {
   "id": "it:22:23",
   "target": "Non li vediamo.",
   "ru": "Мы их не видим.",
   "uk": "Ми їх не бачимо."
  },
  {
   "id": "it:22:24",
   "target": "Non lo sentiamo.",
   "ru": "Мы его не слышим.",
   "uk": "Ми його не чуємо."
  },
  {
   "id": "it:22:25",
   "target": "Loro non lo prendono.",
   "ru": "Они его не берут.",
   "uk": "Вони його не беруть."
  },
  {
   "id": "it:22:26",
   "target": "Ce li hai?",
   "ru": "Они у тебя есть?",
   "uk": "Вони у тебе є?"
  },
  {
   "id": "it:22:27",
   "target": "La vuole?",
   "ru": "Вы её хотите?",
   "uk": "Ви її хочете?"
  },
  {
   "id": "it:22:28",
   "target": "Posso tenerlo?",
   "ru": "Можно я его оставлю себе?",
   "uk": "Можна, я його залишу собі?"
  },
  {
   "id": "it:22:29",
   "target": "Il fascicolo, lo porto io in ufficio.",
   "ru": "Папку с документами я сам отнесу в офис.",
   "uk": "Папку з документами я сам віднесу до офісу."
  },
  {
   "id": "it:22:30",
   "target": "Vorrei provarlo.",
   "ru": "Я хотел бы его примерить.",
   "uk": "Я хотів би його приміряти."
  },
  {
   "id": "it:22:31",
   "target": "La richiamerò.",
   "ru": "Я ей перезвоню.",
   "uk": "Я передзвоню їй."
  },
  {
   "id": "it:22:32",
   "target": "Abbiamo intenzione di ripararlo.",
   "ru": "Мы собираемся его починить.",
   "uk": "Ми збираємося його відремонтувати."
  },
  {
   "id": "it:22:33",
   "target": "Lei deve restituirli.",
   "ru": "Она должна их вернуть.",
   "uk": "Вона має їх повернути."
  },
  {
   "id": "it:22:34",
   "target": "Puoi lasciarla qui.",
   "ru": "Ты можешь оставить её здесь.",
   "uk": "Ти можеш залишити її тут."
  },
  {
   "id": "it:22:35",
   "target": "Il giornale, preferisco leggerlo domani.",
   "ru": "Я предпочитаю завтра почитать газету.",
   "uk": "Я волію почитати газету завтра."
  },
  {
   "id": "it:22:36",
   "target": "Possiamo comprarli online.",
   "ru": "Мы можем купить их онлайн.",
   "uk": "Ми можемо купити їх онлайн."
  },
  {
   "id": "it:22:37",
   "target": "La moneta, puoi lasciarla sul pianerottolo.",
   "ru": "Монету ты можешь оставить на лестничной площадке.",
   "uk": "Монету ти можеш залишити на сходовому майданчику."
  },
  {
   "id": "it:22:38",
   "target": "Può metterli lì.",
   "ru": "Можете положить их туда.",
   "uk": "Можете покласти їх туди."
  },
  {
   "id": "it:22:39",
   "target": "Questo cavo, ho intenzione di collegarlo.",
   "ru": "Я собираюсь подключить этот кабель.",
   "uk": "Я збираюся підключити цей кабель."
  },
  {
   "id": "it:22:40",
   "target": "Vuole tenerla al fresco.",
   "ru": "Она хочет хранить её в прохладе.",
   "uk": "Вона хоче зберігати її в прохолоді."
  },
  {
   "id": "it:22:41",
   "target": "Queste foto, le mostro a mia sorella.",
   "ru": "Я показываю эти фотографии своей сестре.",
   "uk": "Я показую ці фотографії своїй сестрі."
  },
  {
   "id": "it:22:42",
   "target": "Questo indirizzo, lo scrivo sulla ricevuta.",
   "ru": "Я пишу этот адрес на чеке.",
   "uk": "Я пишу цю адресу на чеку."
  },
  {
   "id": "it:22:43",
   "target": "Il tuo messaggio, lo leggo sull’autobus.",
   "ru": "Твоё сообщение я читаю в автобусе.",
   "uk": "Твоє повідомлення я читаю в автобусі."
  },
  {
   "id": "it:22:44",
   "target": "Questo caricabatterie, lo presto a Paolo.",
   "ru": "Эту зарядку я одалживаю Паоло.",
   "uk": "Цю зарядку я позичаю Паоло."
  },
  {
   "id": "it:22:45",
   "target": "I guanti, li metto in tasca.",
   "ru": "Я кладу перчатки в карман.",
   "uk": "Я кладу рукавички в кишеню."
  },
  {
   "id": "it:22:46",
   "target": "La batteria, la ricarico al mattino.",
   "ru": "Я заряжаю батарею утром.",
   "uk": "Я заряджаю акумулятор вранці."
  },
  {
   "id": "it:22:47",
   "target": "La crostata, la dividiamo dopo cena.",
   "ru": "Пирог мы разделим после ужина.",
   "uk": "Пиріг ми розділимо після вечері."
  },
  {
   "id": "it:22:48",
   "target": "Il pacco, lo ritiriamo allo sportello.",
   "ru": "Посылку мы забираем в окошке выдачи.",
   "uk": "Посилку ми забираємо у віконці видачі."
  },
  {
   "id": "it:22:49",
   "target": "Il mio portafoglio elettronico, lo uso quando viaggio.",
   "ru": "Я использую свой электронный кошелек, когда путешествую.",
