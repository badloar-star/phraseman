    {
      "interactionId": "en:lesson-02:session-11:intro1:q",
      "responseFeedbackById": {
        "en:lesson-02:session-11:intro1:r2": {
          "ru": "Это значит, что дело может подождать. Здесь оно срочное.",
          "uk": "Це означає, що справа може зачекати. Тут вона термінова."
        },
        "en:lesson-02:session-11:intro1:r3": {
          "ru": "Речь об одном деле — написать адрес: `It's urgent`.",
          "uk": "Йдеться про одну справу — написати адресу: `It's urgent`."
        }
      }
    },
    {
      "interactionId": "en:lesson-02:session-11:intro2:q",
      "responseFeedbackById": {
        "en:lesson-02:session-11:intro2:r2": {
          "ru": "С `it` нужно `is`: `Is it urgent?`.",
          "uk": "З `it` потрібно `is`: `Is it urgent?`."
        },
        "en:lesson-02:session-11:intro2:r3": {
          "ru": "После `Is` идёт `it`, затем `urgent`.",
          "uk": "Після `Is` йде `it`, потім `urgent`."
        }
      }
    },
    {
      "interactionId": "en:lesson-02:session-11:intro3:q",
      "responseFeedbackById": {
        "en:lesson-02:session-11:intro3:r2": {
          "ru": "Без `not` получается «Срочно». Здесь можно подождать.",
          "uk": "Без `not` виходить «Терміново». Тут можна зачекати."
        },
        "en:lesson-02:session-11:intro3:r3": {
          "ru": "Между `It` и `not` нужно `is`.",
          "uk": "Між `It` і `not` потрібно `is`."
        }
      }
    }
  ],
