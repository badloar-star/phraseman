        "en:lesson-01:session-35:intro1:r3": {
          "ru": "`asleep` — «сплю». Здесь причина отмены — болезнь: `ill`.",
          "uk": "`asleep` — «сплю». Тут причина скасування — хвороба: `ill`."
        }
      }
    },
