+test('failed orphan record scrub keeps the participant index discoverable for retry', async () => {
+  const { db, store } = makeDb({
+    spire_floor_records: {
+      'step-v2_g1': {
+        version: 'step-record-v2', participantUids: [STABLE],
+        records: { '1:1': { uid: STABLE, durationMs: 700 } },
+        personal: { [STABLE]: { '1:1': { uid: STABLE, durationMs: 700 } } },
+      },
+    },
+  });
+  const runTransaction = db.runTransaction.bind(db);
+  let failOnce = true;
+  (db as unknown as { runTransaction: typeof db.runTransaction }).runTransaction = async (work) => {
+    if (failOnce) { failOnce = false; throw new Error('injected_record_scrub_failure'); }
+    return runTransaction(work);
+  };
+
+  await expect(removeFromSpireGroups(db, STABLE, stats())).rejects.toThrow('injected_record_scrub_failure');
+  expect(store.spire_floor_records.get('step-v2_g1')!.participantUids).toEqual([STABLE]);
+
+  await removeFromSpireGroups(db, STABLE, stats());
+  expect(JSON.stringify(store.spire_floor_records.get('step-v2_g1'))).not.toContain(STABLE);
+});
+
+test('a finish racing after the pre-removal scrub is caught after membership removal', async () => {
+  let injectFinish = false;
+  let store!: Record<string, Map<string, Data>>;
+  const fixture = makeDb({
+    spire_groups: { g1: { liveMemberCount: 2, members: { [STABLE]: { name: 'Аня' }, other: { name: 'Bob' } } } },
+    spire_floor_records: {
+      'step-v2_g1': {
+        version: 'step-record-v2', participantUids: [STABLE, 'other'],
+        records: { '1:2': { uid: 'other', durationMs: 800 } },
+        personal: { [STABLE]: { '1:1': { uid: STABLE, durationMs: 900 } }, other: { '1:2': { uid: 'other', durationMs: 800 } } },
+      },
+    },
+  }, { beforeBatchCommit: () => {
+    if (injectFinish) return;
+    injectFinish = true;
+    const record = store.spire_floor_records.get('step-v2_g1')!;
+    record.participantUids = [STABLE, 'other'];
+    record.records = { ...(record.records as Data), '1:1': { uid: STABLE, durationMs: 700 } };
+    record.personal = { ...(record.personal as Data), [STABLE]: { '1:1': { uid: STABLE, durationMs: 700 } } };
+  } });
+  store = fixture.store;
+
+  await removeFromSpireGroups(fixture.db, STABLE, stats());
+
+  const record = store.spire_floor_records.get('step-v2_g1')!;
+  expect(JSON.stringify(record)).not.toContain(STABLE);
+  expect(record.participantUids).toEqual(['other']);
+  expect(store.spire_groups.get('g1')!.members).toEqual({ other: { name: 'Bob' } });
+});
