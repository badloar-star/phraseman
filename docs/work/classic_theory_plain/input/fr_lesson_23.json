  {
   "id": "fr:23:10",
   "target": "Léa leur répond.",
   "ru": "Леа им отвечает.",
   "uk": "Леа відповідає їм."
  },
  {
   "id": "fr:23:11",
   "target": "Je lui téléphone ce soir.",
   "ru": "Я позвоню ей сегодня вечером.",
   "uk": "Я зателефоную їй сьогодні ввечері."
  },
  {
   "id": "fr:23:12",
   "target": "Nous leur téléphonons demain.",
   "ru": "Мы позвоним им завтра.",
   "uk": "Ми зателефонуємо їм завтра."
  },
  {
   "id": "fr:23:13",
   "target": "Elle lui envoie un message.",
   "ru": "Она отправляет ему сообщение.",
   "uk": "Вона надсилає йому повідомлення."
