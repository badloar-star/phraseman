rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // â”€â”€ Helpers â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    function isOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && !exists(/databases/$(database)/documents/account_deletion_auth_markers/$(request.auth.uid));
    }

    function isAdmin() {
      return request.auth != null
        && request.auth.token.keys().hasAny(['admin'])
        && request.auth.token.admin == true;
    }

    function canReadAdminAuditLog() {
      return isAdmin()
        && (
          !request.auth.token.keys().hasAny(['adminRole'])
          || request.auth.token.adminRole == 'owner'
          || request.auth.token.adminRole == 'admin'
        );
    }

    // These roots are callable/Admin-SDK only. Keep this as a compact,
    // code-owned namespace guard: a long chain of collection inequalities can
    // exceed the Firestore Rules expression-complexity limit, while exact deny
    // matches alone cannot override the overlapping browser-admin catch-all.
    function isServerOwnedContentStudioRoot(collection) {
      return collection.matches('content_(mode|season|episode|studio)_.*')
        || collection == 'content_app_support_manifests'
        || collection == 'content_decision_registries'
        || collection == 'content_factory_stages'
        || collection == 'content_v2_owner_episode_confirmations'
        || collection.matches('content_v2_unified_course_release_(heads|roots)(_v3)?')
        || collection.matches('content_language_profile_.*')
        || collection.matches('content_(speech|voice_generation)_profile_.*')
        || collection == 'content_v2_repository_auth'
        || collection == 'content_v2_voice_human_reviews'
        || collection.matches('content_v2_stage_(repository_commits|candidate_pins)')
        || collection.matches('content_v2_(required_session|season_release|activity_auxiliary_release|activity_learner_core_release|activity_server_evaluator_release)_.*');
    }

    // Existing tournament roots plus semantic-review state and unpublished v11
    // bundles are excluded from the browser-admin catch-all. One exact regex
    // keeps the expression below Firestore Rules' complexity ceiling.
    function isBrowserAdminExcludedTournamentRoot(collection) {
      return collection.matches('(tournamentSchedule|tournamentRooms|tournamentTasks|tournamentSeasons|tournamentBank|botProfiles|tournament_semantic_jobs|tournament_semantic_review_receipts|tournament_pool_v11_bundles)');
    }

    // Support correspondence, sealed delivery operations, broadcast mutations,
    // Telegram review state, and the automation switch are callable/Admin-SDK only. Keeping this list in
    // one helper also keeps the legacy browser-admin catch-all below the Rules
    // expression-complexity ceiling.
    // зачем (2026-08-26): четыре коллекции отзывов закрыты от браузерной админки —
    // читать/писать их можно только через аудируемые callable. Вынесены в helper, а не
    // дописаны в цепочку `collection != ...` ниже: цепочка переросла лимит
    // «Expression is too complex to evaluate safely» и правила перестали компилироваться.
    // зачем (2026-08-26): цепочка `collection != ...` в legacy-catch-all ниже переросла
    // лимит Firestore «Expression is too complex to evaluate safely» — правила перестали
    // компилироваться, и деплой встал. Три однородных семейства свёрнуты в helper'ы.
    // Списки взяты 1:1 из цепочки, поведение не меняется.
    //
    // ВНИМАНИЕ: arena_v2_* сюда НЕ входят намеренно — это ЖИВАЯ Арена, её в цепочке
    // исключений не было. Regex ниже требует, чтобы после 'arena_' шёл не 'v2_'.
    function isRetiredArenaRoot(collection) {
      return collection.matches('arena_(profiles|sessions|rooms|rooms_live|invites|session_results|questions|question_history|question_pool_publications|ghost_challenges|pulse_events)')
        || collection.matches('arena_hill_(thrones|attempts|player_wins|throne_rewards)')
        || collection.matches('arena_season(s|_leaderboard|_claims|_hall)')
        || collection.matches('arena_club_(events|contributions)')
        || collection.matches('arena_room_(runs|members)');
    }

    function isServerOwnedAgentRoot(collection) {
      return collection.matches('agent_(cases|recommendations|approvals|tasks|audit_events|office_control|telegram_tokens|observation_receipts)')
        || collection.matches('agent_manager_(agents|tasks|task_events|approvals|execution_jobs|inbox_links|telegram_tokens|telegram_publication_receipts|support_draft_operations)')
        || collection.matches('agent_manager_local_runner_(pairings|capabilities|leases)');
    }

    function isServerOwnedAuthRoot(collection) {
      return collection == 'auth_links'
        || collection.matches('auth_recovery_(codes|rate_limits|events|challenges|delivery_intents|idempotency|clean_rate_limits)');
    }

    function isServerOwnedFeedbackRoot(collection) {
      return collection.matches('(feedback_entries|feedback_summary_cache|feedback_submission_quotas)')
        || collection == 'max_voice_feedback';
    }

    function isServerOwnedSupportRoot(collection) {
      return collection.matches('support_auto_reply_(reservations|counters)')
        || collection.matches('support_telegram_(reviews|edit_sessions|reply_jobs)')
        || collection.matches('support_reply_(operations|batches)')
        || collection == 'support_inbox'
        || collection == 'support_conversations'
        || collection == 'support_email_message_index'
        || collection.matches('(admin_command_operations|global_broadcast_modals)')
        || collection == 'admin_config';
    }

    function isActiveYoutubeSnapshot(version) {
      return request.auth != null
        && exists(/databases/$(database)/documents/youtube_catalog/public)
        && get(/databases/$(database)/documents/youtube_catalog/public).data.activeVersion == version;
    }

    function isReadyYoutubeSnapshot(version) {
      return isActiveYoutubeSnapshot(version)
        && exists(/databases/$(database)/documents/youtube_catalog_snapshots/$(version))
        && get(/databases/$(database)/documents/youtube_catalog_snapshots/$(version)).data.status == 'ready';
    }

    function stableUserMatchesAuth(stableUid) {
      return request.auth != null
        && !exists(/databases/$(database)/documents/account_deletion_auth_markers/$(request.auth.uid))
        && exists(/databases/$(database)/documents/users/$(stableUid))
        && get(/databases/$(database)/documents/users/$(stableUid)).data.keys().hasAny(['firebaseAuthUid'])
        && get(/databases/$(database)/documents/users/$(stableUid)).data.firebaseAuthUid == request.auth.uid;
    }

    function authLinkMapsToUser(userId) {
      return request.auth != null
        && !exists(/databases/$(database)/documents/account_deletion_auth_markers/$(request.auth.uid))
        && exists(/databases/$(database)/documents/auth_links/$(request.auth.uid))
        && get(/databases/$(database)/documents/auth_links/$(request.auth.uid)).data.stable_id == userId;
    }

    function canonicalUserMatchesAuth(stableUid) {
      return stableUserMatchesAuth(stableUid);
    }

    function userDocOwnerMatchesAuth(userId) {
      return isAdmin() || isOwner(userId) || stableUserMatchesAuth(userId) || authLinkMapsToUser(userId);
    }

    // Personal-economy journal writes are device persistence, not an admin
    // capability. An admin-claim token may write only when it is also the
    // canonical owner of this exact user document.
    function personalEconomyOwnerMatchesAuth(userId) {
      return isOwner(userId) || stableUserMatchesAuth(userId) || authLinkMapsToUser(userId);
    }

    function personalEconomyAccountActive(userId) {
      return request.auth != null
        && !exists(/databases/$(database)/documents/account_deletion_auth_markers/$(request.auth.uid))
        && !exists(/databases/$(database)/documents/account_deletion_tombstones/$(userId));
    }

    // Документа users/{userId} ещё нет в базе. Чтение НЕсуществующего дока ничего
    // не раскрывает (там нечего читать — Firestore вернёт пустой снапшот), но БЕЗ
    // явного разрешения движок отдаёт PERMISSION_DENIED, если ни одна ветка
    // userDocOwnerMatchesAuth не сработала. На свежей установке клиент сначала
    // получает НОВЫЙ анонимный stable_id, которого ещё нет в users; старый клиент
    // 1.5.41 в транзакции входа делает tx.get(users/{новый localStableId}) — этот
    // denied read валит ВСЮ транзакцию (transaction_[firestore/unknown]) и вход
    // рвётся → пользователю кажется, что создался новый аккаунт. Разрешаем read
    // отсутствующего дока любому аутентифицированному: безопасно (пустота), и
    // транзакция доходит до конца, после чего клиент свапается на привязанный
    // stable_id и тянет настоящий прогресс. Существующие чужие доки по-прежнему
    // закрыты (эта ветка ложна, если документ существует).
    function userDocMissing(userId) {
      return request.auth != null
        && !exists(/databases/$(database)/documents/account_deletion_auth_markers/$(request.auth.uid))
        && !exists(/databases/$(database)/documents/users/$(userId));
    }

    function accountDeletionNotPending(userId) {
      return isAdmin()
        || (
          request.auth != null
          && !exists(/databases/$(database)/documents/account_deletion_auth_markers/$(request.auth.uid))
          && !exists(/databases/$(database)/documents/account_deletion_tombstones/$(userId))
        );
    }

    // Identity ownership is server-authoritative. These fields are written only
    // by Cloud Functions through Admin SDK, which bypasses Firestore Rules.
    // There is deliberately no isAdmin() exception: a browser-admin token is
    // still an untrusted client credential and must use an audited callable.
    function serverOwnedUserIdentityFields() {
      return [
        'firebaseAuthUid',
        'linkedAuth',
        'identityHidden',
        'canonicalStableId',
        'duplicateOfStableId',
        'anon_merge_claim',
        'identityCanonicalizedAt',
        'identityMergedAt',
        'identityCleanupAt',
        'identityCleanupReason',
        'levelSpinMergePending',
        'mistakePracticeMergePending',
      ];
    }

    function hasNoServerIdentityWrites() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(serverOwnedUserIdentityFields());
    }

    function newDocHasNoServerIdentityWrites() {
      return !request.resource.data.keys().hasAny(serverOwnedUserIdentityFields());
    }

    function userDocHasNoServerIdentity() {
      return !resource.data.keys().hasAny(serverOwnedUserIdentityFields());
    }

    // Флаг, который CF progressSubmitEvent/progressMigrateSnapshot выставляет
    // при первом серверном событии. Пока флага нет — старый клиент может писать
    // XP/streak/progress напрямую (плавный переход без force-update).
    function isProgressServerAuthoritative() {
      return resource.data.get('progressServerAuthoritative', false) == true;
    }

    // Личный shard-баланс принадлежит клиентскому журналу. Ни обычный клиент,
    // ни browser-admin credential не может менять legacy projection в users/*.
    // Админка и соревнования подтверждают только immutable external events через
    // audited Cloud Functions; Admin SDK bypass правил не является разрешением
    // возвращать server-authoritative wallet writes.
    function hasNoShardWrites() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'shards',
          'shards_updated_at_ms',
          'shards_updated_op',
          'shards_updated_reason',
          'shards_admin_override_at',
          // V2 кошелёк access-звёзд (биржа монет→звёзд) — пишет только сервер.
          'v2_access_stars',
          'v2_access_stars_updated_at_ms',
          // Разовая миграция осколков→монет 20:1 — пишет только сервер.
          'coins_migration_v1',
          'coins_migration_v1_record',
          // Единый баланс звёзд (владелец 2026-08-12, D-05/D-06). Пишет ТОЛЬКО
          // сервер через functions/src/stars_ledger.ts. Клиент читает и никогда
          // не пишет: звезда — общая валюта приложения, а не локальный счётчик.
          'stars',
        ]);
    }

    // Create-вариант shard-гарда. На create нет resource (старого документа), поэтому
    // diff невозможен — проверяем НАЛИЧИЕ топ-уровневых shard-полей в самом новом
    // документе. Закрывает дыру: allow create не звал hasNoShardWrites, и кастомный
    // клиент мог при ПЕРВОМ создании users/{id} вписать shards:99999 себе.
    // Легальный клиент и browser-admin никогда не создают legacy shard projection.
    // Perk-поля (gift_xp_multiplier/chain_shield/arena_extra_plays_today) сюда НЕ
    // включены намеренно: они клиент-владеемые, синкаются легально из AsyncStorage
    // (см. cloud_sync.ts SYNC_KEYS) — блокировка сломала бы первый легальный синк.
    function newDocHasNoShardWrites() {
      return !request.resource.data.keys().hasAny([
          'shards',
          'shards_updated_at_ms',
          'shards_updated_op',
          'shards_updated_reason',
          'shards_admin_override_at',
          // V2 кошелёк access-звёзд (биржа монет→звёзд) — пишет только сервер.
          'v2_access_stars',
          'v2_access_stars_updated_at_ms',
          // Разовая миграция осколков→монет 20:1 — пишет только сервер.
          'coins_migration_v1',
          'coins_migration_v1_record',
          // Единый баланс звёзд (владелец 2026-08-12, D-05/D-06). Пишет ТОЛЬКО
          // сервер через functions/src/stars_ledger.ts. Клиент читает и никогда
          // не пишет: звезда — общая валюта приложения, а не локальный счётчик.
          'stars',
        ]);
    }

    // Gift perk grants and consumes are server-authoritative. Legitimate
    // consumption goes through friendConsumeChainShield; level, league,
    // season, friend, broadcast and admin producers all commit via Admin SDK.
    function hasNoServerGiftPerkWrites() {
      return (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'chain_shield',
          'gift_xp_multiplier',
          'club_gift_free_boost_v1'
        ])
        && !request.resource.data.get('progress', {}).diff(resource.data.get('progress', {})).affectedKeys().hasAny([
          'chain_shield',
          'gift_xp_multiplier',
          'club_gift_free_boost_v1'
        ])
      );
    }

    function newDocHasNoServerGiftPerkWrites() {
      return (
        !request.resource.data.keys().hasAny(['chain_shield', 'gift_xp_multiplier', 'club_gift_free_boost_v1'])
        && !request.resource.data.get('progress', {}).keys().hasAny(['chain_shield', 'gift_xp_multiplier', 'club_gift_free_boost_v1'])
      );
    }

    // Server progress shadow/cutover markers are never client-owned. Allowing an
    // owner to write them would let a modified client manufacture an authoritative
    // baseline and permanently inflate XP on the next progress event.
    function hasNoProgressAuthorityMarkerWrites() {
      return isAdmin()
        || !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'progressServerState',
          'progressServerAuthoritative',
          'progressServerCutoverAt',
          'progressMigratedAt',
          'levelSpinServerState',
        ]);
    }

    function newDocHasNoProgressAuthorityMarkerWrites() {
      return isAdmin()
        || !request.resource.data.keys().hasAny([
          'progressServerState',
          'progressServerAuthoritative',
          'progressServerCutoverAt',
          'progressMigratedAt',
          'levelSpinServerState',
        ]);
    }

    // Level Spin accounting is callable-only, including for browser admins.
    // Admin SDK bypasses Rules, so legitimate server writes are unaffected.
    function hasNoLevelRewardSpinWrites() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'levelSpinServerState',
          'levelSpinMergePending'
        ])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['progress'])
          || !request.resource.data.get('progress', {})
            .diff(resource.data.get('progress', {}))
            .affectedKeys().hasAny(['level_reward_spin_balance'])
        );
    }

    function newDocHasNoLevelRewardSpinWrites() {
      return !request.resource.data.keys().hasAny(['levelSpinServerState', 'levelSpinMergePending'])
        && !request.resource.data.get('progress', {}).keys().hasAny(['level_reward_spin_balance']);
    }

    function newDocHasNoServerScoreWrites() {
      return isAdmin()
        || !request.resource.data.get('progress', {}).keys().hasAny([
          'user_total_xp',
          'user_prev_xp',
          'user_level',
          'weekly_xp',
          'weekly_xp_period_start',
          'week_points',
          'week_points_v2',
          'streak_count',
          'last_active_date',
          'streak_last_date',
        ]);
    }

    // Ключи внутри progress, которые клиент не имеет права записывать.
    // Пишутся только Admin SDK (RevenueCat webhook, Telegram активация, admin grant)
    // ИЛИ админом через admin-панель (custom claim admin==true).
    // Админ исключён намеренно: ручная выдача/отзыв VIP в admin/index.html и
    // admin/testers.html идёт через клиентский web SDK (updateDoc) и подчиняется
    // этим правилам. До добавления этой функции админ уже имел полный update-доступ
    // (userDocOwnerMatchesAuth → isAdmin), поэтому исключение не ослабляет защиту —
    // оно лишь сохраняет существующее поведение. От обычных юзеров premium-поля
    // по-прежнему закрыты.
    // Единый список premium/VIP/server-only ключей в progress, которые клиент писать не вправе.
    // Вынесен в функцию, чтобы update- и create-гарды (progressHasNoPremiumWrites /
    // newDocHasNoPremiumWrites) проверяли РОВНО один и тот же набор и не рассинхронились.
    function blockedPremiumProgressKeys() {
      return [
        // Premium/VIP entitlement: only Admin SDK through Cloud Functions may write.
        'premium_plan',
        'premium_expiry',
        'premium_rc_product_id',
        'premium_rc_period_type',
        'premium_rc_store',
        'premium_rc_environment',
        'premium_rc_event_type',
        'premium_rc_updated_at',
        'premium_rc_expiry_ms',
        'premium_rc_purchased_at_ms',
        'premium_rc_cancelled_at',
        'premium_rc_active_lineage',
        'premium_rc_reconcile_needed',
        'admin_premium_override',
        'premium_admin_grant_at',
        'had_premium_ever',
        'vip_active',
        'vip_plan',
        'vip_from',
        'vip_until',
        'vip_admin_override',
        'vip_admin_grant_at',
        'vip_migrated_from_admin_grant_at',
        'intro_access_until_ms',
        'intro_access_granted_at_ms',
        'loyalty_gift_until_ms',
        'loyalty_gift_granted_at_ms',
        // Маркеры источника VIP-выдачи (пишет только сервер — реферал/промокод).
        // Клиенту незачем их трогать; блокируем, чтобы аналитика не подделывалась.
        'referral_vip_last_source',
        'promo_vip_last_code',
        // Live-маркер «урок 1 пройден живым событием» (progressSubmitEvent). По нему
        // referralApply мгновенно квалифицирует приглашённого — подделка клиентом дала бы
        // бесплатный VIP, поэтому блокируем ВСЕГДА (как premium), а не только после миграции.
        'lesson1_pass_live',
        'lesson_progress_v2::fr::lesson1_pass_live',
        // Collectibles: server-only, always blocked regardless of migration flag.
        'collectibles_owned_v1',
        'collectibles_state_v1',
        // Profile card LEVEL: a public prestige badge bought with shards. Only the
        // profileCardUpgrade Cloud Function (Admin SDK) may raise it, so a tampered
        // client can't forge Pro for free. Theme/motion/focus are legacy mirrors.
        'profile_card_level',
        // Survey completion timestamp is written only by submitShardSurvey (Admin SDK).
        'shard_survey_last_at_ms',
        // Immutable production purchase facts observed by the achievement engine.
        // Only the RevenueCat webhook may set them; restore/admin/trial client state cannot.
        'achievement_access_plus_paid_v1',
        'achievement_access_pro_paid_v1',
        // Прокруты рулетки Plus: начисляет/списывает ТОЛЬКО сервер
        // (referralClaimSpin / referralSpin, Admin SDK) — клиент не должен себе их рисовать.
        'referral_spin_credits',
        'level_reward_spin_balance',
        'referral_spins_total',
        'referral_spin_ledger_version',
        'referral_spin_ledger_migrated_at_ms',
      ];
    }

    function progressHasNoPremiumWrites() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['progress'])
        || !request.resource.data.get('progress', {})
              .diff(resource.data.get('progress', {}))
              .affectedKeys().hasAny(blockedPremiumProgressKeys())
           && !request.resource.data.get('progress', {})
                      .diff(resource.data.get('progress', {}))
                      .affectedKeys().hasAny([
                'user_total_xp',
                'user_prev_xp',
                'user_level',
                'weekly_xp',
                'weekly_xp_period_start',
                'week_points',
                'week_points_v2',
                'streak_count',
                'last_active_date',
                'streak_last_date',
                'unlocked_lessons',
                'lesson_progress_v2::fr::unlocked_lessons',
                // Server-authoritative lessons: English legacy keys and French scoped keys.
                'lesson1_best_score',
                'lesson1_pass_count',
                'lesson1_progress',
                'lesson1_cellIndex',
                'lesson_progress_v2::fr::1',
                'lesson_progress_v2::fr::lesson1_best_score',
                'lesson_progress_v2::fr::lesson1_pass_count',
                'lesson_progress_v2::fr::lesson1_progress',
                'lesson_progress_v2::fr::lesson1_cellIndex',
                'lesson2_best_score',
                'lesson2_pass_count',
                'lesson2_progress',
                'lesson2_cellIndex',
                'lesson_progress_v2::fr::2',
                'lesson_progress_v2::fr::lesson2_best_score',
                'lesson_progress_v2::fr::lesson2_pass_count',
                'lesson_progress_v2::fr::lesson2_progress',
                'lesson_progress_v2::fr::lesson2_cellIndex',
                'lesson3_best_score',
                'lesson3_pass_count',
                'lesson3_progress',
                'lesson3_cellIndex',
                'lesson_progress_v2::fr::3',
                'lesson_progress_v2::fr::lesson3_best_score',
                'lesson_progress_v2::fr::lesson3_pass_count',
                'lesson_progress_v2::fr::lesson3_progress',
                'lesson_progress_v2::fr::lesson3_cellIndex',
                'lesson4_best_score',
                'lesson4_pass_count',
                'lesson4_progress',
                'lesson4_cellIndex',
