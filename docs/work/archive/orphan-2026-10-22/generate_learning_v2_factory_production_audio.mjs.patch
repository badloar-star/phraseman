+export function createPlan(root, parsed) {
+  const outputDir = path.resolve(root, "assets/audio/learning-v2/factory-production-v1");
+  const manifestPath = path.join(outputDir, "manifest.json");
+  const sourceFiles = parsed.sessions.map((sessionId) => resolveLearner(root, sessionId));
+  const transcripts = collectTranscripts(sourceFiles);
+  const validatedManifest = loadAndValidateManifest(root, manifestPath);
+  const targets = [...transcripts].sort().flatMap((transcript) =>
+    AUDIO_SETTINGS.voices.map((voiceId) => Object.freeze({ transcript, voiceId })),
+  );
+  const missing = targets.filter((target) => !validatedManifest.known.has(coordinateKey(target.transcript, target.voiceId)));
+  const estimatedWords = missing.reduce((sum, target) => sum + target.transcript.split(/\s+/u).filter(Boolean).length, 0);
+  const estimatedAudioMinutes = estimatedWords / 145;
+  return Object.freeze({
+    root,
+    outputDir,
+    manifestPath,
+    sourceFiles,
+    transcripts,
+    targets,
+    missing,
+    validatedManifest,
+    estimatedAudioMinutes,
+    estimatedCostUsd: Math.max(0.01, estimatedAudioMinutes * 0.03),
+  });
