  {
   "id": "fr:23:14",
   "target": "Il leur envoie une photo.",
   "ru": "Он отправляет им фотографию.",
   "uk": "Він надсилає їм фотографію."
  },
  {
   "id": "fr:23:15",
   "target": "Je lui prête mon stylo.",
   "ru": "Я одалживаю ему свою ручку.",
   "uk": "Я позичаю йому свою ручку."
  },
  {
   "id": "fr:23:16",
   "target": "Tu leur prêtes des chaises.",
