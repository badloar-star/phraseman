{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phraseman.local/gustav/evidence_ledger.schema.json",
  "title": "GUSTAV Evidence Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "createdAt", "studyTarget", "sourceLocales", "claims"],
  "properties": {
    "schemaVersion": { "const": "gustav-evidence-ledger-v0" },
    "runId": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string" },
    "studyTarget": { "enum": ["en", "fr", "de", "es"] },
    "sourceLocales": {
      "type": "array",
      "items": { "enum": ["ru", "uk", "es", "pt-BR", "vi", "id", "tr", "pl"] },
      "minItems": 1,
      "uniqueItems": true
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claimId",
          "claim",
          "claimType",
          "usedFor",
          "sourceType",
          "sourceName",
          "copyrightSafeSummary",
          "confidence",
          "limitations",
          "agentId",
          "reviewerStatus"
        ],
        "properties": {
          "claimId": { "type": "string", "minLength": 1 },
          "claim": { "type": "string", "minLength": 1 },
          "claimType": {
            "enum": [
              "grammar_rule",
              "curriculum_order",
              "cefr_level",
              "learner_error",
              "translation_warning",
              "quiz_design",
              "pronunciation",
              "usage_naturalness",
              "product_constraint",
              "app_existing_behavior"
            ]
          },
          "usedFor": {
            "enum": [
              "lesson_order",
              "lesson_objective",
              "intro_screen",
              "phrase_generation",
              "quiz_generation",
              "personal_practice",
              "storage_architecture",
              "runtime_architecture",
              "audit"
            ]
          },
          "sourceType": {
            "enum": [
              "official_reference",
              "dictionary",
              "grammar_reference",
              "cefr_reference",
              "course_comparison",
              "academic_or_linguistic",
              "app_source",
              "app_test",
              "manual_product_decision"
            ]
          },
          "sourceName": { "type": "string", "minLength": 1 },
          "sourceUrl": { "type": "string" },
          "citation": { "type": "string" },
          "accessDate": { "type": "string" },
          "copyrightSafeSummary": { "type": "string", "minLength": 1 },
          "directQuote": { "type": "string" },
          "confidence": { "enum": ["high", "medium", "low"] },
          "limitations": {
            "type": "array",
            "items": { "type": "string" }
          },
          "agentId": { "type": "string", "minLength": 1 },
          "reviewerStatus": { "enum": ["unreviewed", "accepted", "needs_review", "rejected"] }
        }
      }
    }
  }
}
