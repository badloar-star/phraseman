    function newUserDocOwnerMatchesAuth(userId) {
      return isAdmin()
        || isOwner(userId)
        || (
          request.auth != null
          && request.resource.data.keys().hasAny(['firebaseAuthUid'])
          && request.resource.data.firebaseAuthUid is string
          && request.resource.data.firebaseAuthUid == request.auth.uid
        );
    }

    // â”€â”€ Referral: Ð·Ð°Ð¿Ð¸ÑÑŒ Ñ‚Ð¾Ð»ÑŒÐºÐ¾ CF; Ñ‡Ñ‚ÐµÐ½Ð¸Ðµ â€” Ð¿Ð°Ð½ÐµÐ»ÑŒ admin (custom claim admin) â”€
    match /referral_codes/{code} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /referral_owners/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // Чтение клиентом — только через callable referralListMyInvites (CF проверяет auth_links).
    // Прямой клиентский read закрыт; запись — только Admin SDK (referralApply/referralClaimVipReward).
    match /referral_attributions/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // â”€â”€ User data â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    // ÐšÐ¾Ñ€Ð½ÐµÐ²Ð¾Ð¹ users/{userId}: Ñ‚Ð¾Ð»ÑŒÐºÐ¾ Ð²Ð»Ð°Ð´ÐµÐ»ÐµÑ†/Ð°Ð´Ð¼Ð¸Ð½. ÐŸÐ¾Ð´Ð´ÐµÑ€Ð¶Ð¸Ð²Ð°ÐµÐ¼ Ð¾Ð±Ðµ ÑÑ…ÐµÐ¼Ñ‹:
    //  - userId == request.auth.uid
    //  - stableId-Ð´Ð¾ÐºÑƒÐ¼ÐµÐ½Ñ‚ Ñ Ð¿Ð¾Ð»ÐµÐ¼ firebaseAuthUid == request.auth.uid
    // ÐœÐ¾Ð´ÐµÑ€Ð°Ñ†Ð¸Ñ/Ð±Ð°Ð½/Ñ€ÐµÐ¿Ð¾Ñ€Ñ‚Ñ‹: Ñ‚Ð¾Ð»ÑŒÐºÐ¾ isAdmin() (ÑÐ¼. admin/index.html, email+claim).
    match /users/{userId} {
      allow read, delete: if userDocOwnerMatchesAuth(userId);
      // Клиент может обновлять свой документ, но не может трогать premium/VIP поля.
      // Их пишет только Admin SDK (RevenueCat webhook, Telegram bot, admin grant).
      allow update: if userDocOwnerMatchesAuth(userId) && progressHasNoPremiumWrites();
      allow create: if newUserDocOwnerMatchesAuth(userId);

      match /community_seller_inbox/{eventId} {
        allow read, write: if false;
      }

      match /shard_log/{logId} {
        allow read, create: if userDocOwnerMatchesAuth(userId);
        allow update, delete: if false;
      }

      match /reward_claims/{claimId} {
        allow read, create: if userDocOwnerMatchesAuth(userId);
        allow update, delete: if false;
      }

      match /app_message_states/{messageId} {
        allow read, create, update, delete: if userDocOwnerMatchesAuth(userId);
      }

      match /shard_rewards/{rewardId} {
        allow read:   if userDocOwnerMatchesAuth(userId);
        allow update: if userDocOwnerMatchesAuth(userId) && request.resource.data.seen == true;
        // Реальные награды (friend_gift и пр.) пишет только Admin SDK из CF в обход rules.
        // Клиенту разрешена лишь QA-симуляция с обязательной меткой qa == true —
        // UI помечает такие записи «(QA)», подделать «настоящий» подарок себе нельзя.
        allow create: if userDocOwnerMatchesAuth(userId) && request.resource.data.qa == true;
        allow delete: if false;
      }
    }

    // â”€â”€ Arena profiles â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /arena_profiles/{userId} {
      allow read:  if request.auth != null;
      allow write: if isOwner(userId);

      // Ð˜ÑÑ‚Ð¾Ñ€Ð¸Ñ Ð¼Ð°Ñ‚Ñ‡ÐµÐ¹: Ð¿Ð¸ÑˆÐµÑ‚ Ñ‚Ð¾Ð»ÑŒÐºÐ¾ Cloud Function (Admin); ÐºÐ»Ð¸ÐµÐ½Ñ‚ Ñ‚Ð¾Ð»ÑŒÐºÐ¾ Ñ‡Ð¸Ñ‚Ð°ÐµÑ‚.
      // Ð‘ÐµÐ· Ð¾Ñ‚Ð´ÐµÐ»ÑŒÐ½Ð¾Ð³Ð¾ match Ð¿Ð¾Ð´ÐºÐ¾Ð»Ð»ÐµÐºÑ†Ð¸Ñ Ð¿Ð¾ ÑƒÐ¼Ð¾Ð»Ñ‡Ð°Ð½Ð¸ÑŽ Ð·Ð°Ð¿Ñ€ÐµÑ‰ÐµÐ½Ð° â†’ ÑÐºÑ€Ð°Ð½ Ñ€ÐµÐ¹Ñ‚Ð¸Ð½Ð³Ð° Ð¿Ð°Ð´Ð°Ð» Ñ PERMISSION_DENIED.
      match /match_history/{matchId} {
        allow read: if request.auth != null;
        allow write, update, delete: if false;
      }
    }

    // â”€â”€ Leaderboard â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /leaderboard/{userId} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin();
      allow delete: if userDocOwnerMatchesAuth(userId);
    }

    match /public_profiles/{userId} {
      allow read: if request.auth != null;
      allow create, update: if canonicalUserMatchesAuth(userId);
      allow delete: if userDocOwnerMatchesAuth(userId);
    }

    // Public aggregate percentile thresholds written by Cloud Functions.
    match /leaderboard_stats/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Friend activity likes: server-owned writes, client-readable counters.
    match /users/{userId}/friend_activity_like_daily_limits/{dayId} {
      allow read: if canonicalUserMatchesAuth(userId);
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId}/activity_like_stats/{docId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId}/activity_likes_received/{likeId} {
      allow read: if canonicalUserMatchesAuth(userId);
      allow create, update, delete: if isAdmin();
    }

    // â”€â”€ Banned users â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    // Legacy/bundled flashcard marketplace metadata. Clients query only
    // published packs; writes stay server/admin-only.
    match /card_packs/{packId} {
      allow read: if resource.data.status == 'published';
      allow create, update, delete: if isAdmin();
    }

    match /banned_users/{docId} {
      allow read:  if isAdmin() || (request.auth != null && request.auth.uid == docId);
      allow write: if isAdmin();
    }

    // â”€â”€ Admin config (alerts settings, admin-only) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    // admin_config/alerts holds Telegram alert settings (chatId, enabled, types).
    // Read/write only by admin from the panel. The alert Cloud Functions use the
    // Admin SDK (bypasses rules) to read config and write bookkeeping fields.
    match /admin_config/{docId} {
      allow read, write: if isAdmin();
    }

    // Remote Config changelog — admin-only audit trail of config saves.
    match /remote_config_history/{docId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // â”€â”€ User warnings â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /user_warnings/{docId} {
      allow read:   if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // â”€â”€ User reports (Ð¶Ð°Ð»Ð¾Ð±Ñ‹ Ð½Ð° Ð´Ñ€ÑƒÐ³Ð¸Ñ… Ð¿Ð¾Ð»ÑŒÐ·Ð¾Ð²Ð°Ñ‚ÐµÐ»ÐµÐ¹) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /user_reports/{docId} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    // â”€â”€ Community pack reports (UGC content moderation, Apple Guideline 1.2) â”€â”€
    // Ð›ÑŽÐ±Ð¾Ð¹ Ð°Ð²Ñ‚Ð¾Ñ€Ð¸Ð·Ð¾Ð²Ð°Ð½Ð½Ñ‹Ð¹ ÑŽÐ·ÐµÑ€ Ð¼Ð¾Ð¶ÐµÑ‚ Ð¿Ð¾Ð¶Ð°Ð»Ð¾Ð²Ð°Ñ‚ÑŒÑÑ Ð½Ð° community-Ð¿Ð°Ðº;
    // Ñ‡Ð¸Ñ‚Ð°Ñ‚ÑŒ/Ð¼Ð¾Ð´ÐµÑ€Ð¸Ñ€Ð¾Ð²Ð°Ñ‚ÑŒ â€” Ñ‚Ð¾Ð»ÑŒÐºÐ¾ admin (Ñ‡ÐµÑ€ÐµÐ· admin/index.html â†’ custom claim).
    match /community_pack_reports/{docId} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    // â”€â”€ Error reports (Ð±Ð°Ð³-Ñ€ÐµÐ¿Ð¾Ñ€Ñ‚Ñ‹) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /error_reports/{docId} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    match /app_errors/{docId} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    match /app_activity/{docId} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    match /subscription_cancel_surveys/{docId} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    match /website_contact_inbox/{docId} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    match /website_contact_rate_limits/{docId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /site_stats/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /site_stats_rate_limits/{docId} {
      allow read, delete: if isAdmin();
      allow create, update: if false;
    }

    match /client_report_rate_limits/{docId} {
      allow read, create, update, delete: if isAdmin();
    }

    // â”€â”€ Ð“Ð»Ð¾Ð±Ð°Ð»ÑŒÐ½Ñ‹Ðµ Ð¾Ð´Ð½Ð¾Ñ€Ð°Ð·Ð¾Ð²Ñ‹Ðµ Ð¼Ð¾Ð´Ð°Ð»ÐºÐ¸ (Ð°Ð´Ð¼Ð¸Ð½-Ñ€Ð°ÑÑÑ‹Ð»ÐºÐ° Ð´Ð»Ñ Ð²ÑÐµÑ… Ð¿Ð¾Ð»ÑŒÐ·Ð¾Ð²Ð°Ñ‚ÐµÐ»ÐµÐ¹) â”€â”€
    match /global_broadcast_modals/{docId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    function appMessagePollVoteOk(messageId, userId) {
      let message = get(/databases/$(database)/documents/app_messages/$(messageId)).data;
      return userDocOwnerMatchesAuth(userId)
        && message.active == true
        && (!message.keys().hasAny(['expiresAtMs']) || message.expiresAtMs > request.time.toMillis())
        && message.keys().hasAny(['poll'])
        && message.poll is map
        && message.poll.keys().hasAny(['optionIds'])
        && message.poll.optionIds is list
        && request.resource.data.keys().hasOnly(['messageId', 'userId', 'optionId', 'updatedAtMs'])
        && request.resource.data.messageId == messageId
        && request.resource.data.userId == userId
        && request.resource.data.optionId is string
        && request.resource.data.optionId in message.poll.optionIds
        && (request.resource.data.updatedAtMs is int || request.resource.data.updatedAtMs is float)
        && request.resource.data.updatedAtMs > 0
        && request.resource.data.updatedAtMs < 10000000000000;
    }

    // Remote Config: admin-tuned runtime flags (limits, energy, A/B split).
    // Read by any signed-in client (remote_config_client.ts); written only from
    // the admin panel (custom claim admin). Docs: `app`, `paywall_ab`.
    match /remote_config/{docId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // Воронка пейвол-эксперимента (app/paywall_funnel.ts → admin/paywall_ab.html).
    // Клиент только создаёт компактные события фиксированной формы; читает админ.
    match /paywall_funnel/{docId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['step', 'variant', 'context', 'plan', 'day', 'ts', 'uidh', 'dev', 'expireAt'])
        && request.resource.data.step in ['shown', 'cta_click', 'trial_started', 'purchase_completed', 'close']
        && request.resource.data.variant in ['v1', 'v2', 'A', 'B', 'C']
        && request.resource.data.context is string
        && request.resource.data.context.size() <= 40
        && (request.resource.data.plan == null || request.resource.data.plan in ['monthly', 'yearly'])
        && request.resource.data.day is string
        && request.resource.data.day.size() == 10
        && (request.resource.data.ts is int || request.resource.data.ts is float)
        && request.resource.data.uidh is string
        && request.resource.data.uidh.size() <= 16
        && request.resource.data.dev is bool;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /app_messages/{messageId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();

      match /reactions/{userId} {
        allow read: if isAdmin();
        allow create, update: if userDocOwnerMatchesAuth(userId)
          && request.resource.data.keys().hasOnly(['messageId', 'userId', 'reaction', 'updatedAtMs'])
          && request.resource.data.messageId == messageId
          && request.resource.data.userId == userId
          && request.resource.data.reaction in ['like', 'dislike'];
        allow delete: if isAdmin() || userDocOwnerMatchesAuth(userId);
      }

      match /poll_votes/{userId} {
        allow read: if isAdmin();
        allow create, update: if appMessagePollVoteOk(messageId, userId);
        allow delete: if isAdmin() || userDocOwnerMatchesAuth(userId);
      }
    }

    match /review_promo_claims/{docId} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    match /vip_survey_responses/{userId} {
      allow read: if isAdmin() || userDocOwnerMatchesAuth(userId);
      allow create, update, delete: if isAdmin();
    }

    match /daily_phrases/{phraseId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    match /daily_phrase_save_counts/{phraseId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    match /daily_phrase_saves/{saveId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // â”€â”€ Arena sessions â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /arena_sessions/{sessionId} {
      allow read: if request.auth != null;
      // ÐšÐ»Ñ–Ñ”Ð½Ñ‚: Ñ„Ð¾Ñ€Ñ„ÐµÐ¹Ñ‚ (finished + forfeitedBy) ÑÐº Ñ€Ð°Ð½Ñ–ÑˆÐµ; Ð¿Ð¾Ð»Ñ pre-match Ð¾Ð½Ð¾Ð²Ð»ÑŽÑ” Ð»Ð¸ÑˆÐµ CF.
      // Ð ÐµÐ²Ð°Ð½Ñˆ: ÑƒÑ‡Ð°ÑÑ‚Ð½Ð¸Ðº Ð¼Ð°Ñ‚Ñ‡Ð° Ð¼Ð¾Ð¶ÐµÑ‚ Ð¿Ð¸ÑÐ°Ñ‚ÑŒ Ð² rematchOffer (status â€” Ñ‚Ð¾Ð»ÑŒÐºÐ¾ client-side accept/decline/cancel/expired,
      // ÑÐ¾Ð·Ð´Ð°Ð½Ð¸Ðµ pending Ñ‚Ð¾Ð¶Ðµ Ð´Ð¾Ð¿ÑƒÑÑ‚Ð¸Ð¼Ð¾).
      // Клиент может писать только forfeitedBy (свой uid) и rematchOffer.
      // state клиент НЕ может выставить — только CF (onArenaSessionFinished/Aborted).
      allow update: if request.auth != null
        && resource.data.playerIds.hasAny([request.auth.uid])
        && request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['forfeitedBy', 'rematchOffer'])
        && (!request.resource.data.keys().hasAny(['forfeitedBy'])
            || request.resource.data.forfeitedBy == request.auth.uid);
    }

    // â”€â”€ Session players â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /session_players/{docId} {
      // docId = {sessionId}_{playerId} — разрешаем читать только участникам той же сессии.
      allow read:   if request.auth != null
                    && resource.data.sessionId != null
                    && get(/databases/$(database)/documents/session_players/$(resource.data.sessionId + '_' + request.auth.uid)).data.sessionId == resource.data.sessionId;
      allow create: if false;
      allow update: if request.auth != null
        && resource.data.playerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['answers', 'lastSeen', 'lobbyChoice'])
        && (!('lobbyChoice' in request.resource.data) || request.resource.data.lobbyChoice in ['none', 'accept', 'decline']);
    }

    // â”€â”€ Arena rooms (friend invite flow) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /arena_rooms/{roomId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.hostId == request.auth.uid;
      allow update: if request.auth != null
        && (
          resource.data.hostId == request.auth.uid
          || request.resource.data.guestId == request.auth.uid
        )
        && request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['guestId', 'guestName', 'status', 'sessionId']);
    }

    // â”€â”€ Arena invites (legacy friend-invite docs) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    // Ð Ð°Ð·Ñ€ÐµÑˆÐ°ÐµÐ¼ Ñ‚Ð¾Ð»ÑŒÐºÐ¾ ÑÐ¼ÐµÐ½Ñƒ ÑÑ‚Ð°Ñ‚ÑƒÑÐ° Ð¸ Ñ‚Ð¾Ð»ÑŒÐºÐ¾ ÑƒÑ‡Ð°ÑÑ‚Ð½Ð¸ÐºÐ°Ð¼ Ð¸Ð½Ð²Ð°Ð¹Ñ‚Ð°.
    match /arena_invites/{inviteId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid;
      allow update: if request.auth != null
        && (resource.data.fromUid in [request.auth.uid]
        || resource.data.toUid in [request.auth.uid]
        || canonicalUserMatchesAuth(resource.data.friendStableUid))
        && request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['status']);
      allow delete: if false;
    }

    // â”€â”€ Arena computed per-user match results â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /arena_session_results/{resultId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // â”€â”€ Matchmaking queue â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    // Ð¢Ð¾Ð»ÑŒÐºÐ¾ Ð¿Ð¾Ð»Ñ Ð¾Ñ‡ÐµÑ€ÐµÐ´Ð¸: Ð±ÐµÐ· sessionId/matchedAt (Ð¸Ñ… Ð¿Ð¸ÑˆÐµÑ‚ Ñ‚Ð¾Ð»ÑŒÐºÐ¾ CF).
    // Ð”Ð¾ÐºÑƒÐ¼ÐµÐ½Ñ‚: matchmaking_queue/{userId} â€” id ÑÐ¾Ð²Ð¿Ð°Ð´Ð°ÐµÑ‚ Ñ userId.
    function matchmakingQueueDocOk(entryId) {
      let d = request.resource.data;
      return d.userId is string
        && d.userId == request.auth.uid
        && entryId == d.userId
        // RN/JS ÑˆÐ»Ñ‘Ñ‚ Ñ‡Ð°ÑÑ‚Ð¾ double; ÐºÐ°Ðº joinedAt â€” Ð¿Ñ€Ð¸Ð½Ð¸Ð¼Ð°ÐµÐ¼ int | float.
        && (d.size is int || d.size is float)
        && (d.size == 2 || d.size == 4)
        // ÐšÐ»Ð¸ÐµÐ½Ñ‚ (RN/JS) Ñ‡Ð°ÑÑ‚Ð¾ ÑˆÐ»Ñ‘Ñ‚ millis ÐºÐ°Ðº number/double â€” ÑÑ‚Ñ€Ð¾Ð³Ð¸Ð¹ is int Ð»Ð¾Ð¼Ð°Ð» join.
        && (d.joinedAt is int || d.joinedAt is float)
        && d.joinedAt > 0
        && d.joinedAt < 10000000000000
        && d.rankTier is string
        && d.keys().hasOnly([
          'userId', 'rankTier', 'size', 'joinedAt',
          'rankIndex', 'searchRange', 'expoPushToken', 'displayName'
        ])
        && (!('rankIndex' in d) || ((d.rankIndex is int || d.rankIndex is float) && d.rankIndex >= 0 && d.rankIndex <= 23))
        && (!('searchRange' in d) || ((d.searchRange is int || d.searchRange is float) && d.searchRange >= 1 && d.searchRange <= 8))
        && (!('expoPushToken' in d) || d.expoPushToken is string)
        && (!('displayName' in d) || d.displayName is string);
    }

    match /matchmaking_queue/{entryId} {
      // Только свою запись — чтобы не раскрывать push-токены и ники других игроков.
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && matchmakingQueueDocOk(entryId);
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && matchmakingQueueDocOk(entryId);
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /arena_questions/{qId} {
      allow read:  if request.auth != null;
      allow write: if false;
    }

    // â”€â”€ Name index (unique nickname reservation) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /name_index/{nameKey} {
      allow read:  if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // Friend code reverse index. Doc id = 6-char code; data = { uid, createdAt }.
    match /friend_code_index/{code} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // Friend requests: users/{targetUid}/friend_requests/{senderUid}.
    match /users/{targetUid}/friend_requests/{senderUid} {
      allow read: if canonicalUserMatchesAuth(targetUid) || canonicalUserMatchesAuth(senderUid);
      allow create: if request.auth != null
        && canonicalUserMatchesAuth(senderUid)
        && targetUid != senderUid
        && !exists(/databases/$(database)/documents/banned_users/$(senderUid))
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is number;
      allow update: if canonicalUserMatchesAuth(targetUid)
        && request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['accepted', 'declined'];
      allow delete: if canonicalUserMatchesAuth(targetUid) || canonicalUserMatchesAuth(senderUid);
    }

    // Friends list: users/{ownerUid}/friends/{friendUid}.
    match /users/{ownerUid}/friends/{friendUid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && ownerUid != friendUid && (
        canonicalUserMatchesAuth(ownerUid) ||
        (canonicalUserMatchesAuth(friendUid) &&
         exists(/databases/$(database)/documents/users/$(friendUid)/friend_requests/$(ownerUid)) &&
         get(/databases/$(database)/documents/users/$(friendUid)/friend_requests/$(ownerUid)).data.status in ['pending', 'accepted'])
      );
      allow update: if false;
      allow delete: if canonicalUserMatchesAuth(ownerUid) || canonicalUserMatchesAuth(friendUid);
    }

    // Friend activity feed: users/{stableUid}/my_events/{eventId}.
    match /users/{userId}/my_events/{eventId} {
      allow read: if canonicalUserMatchesAuth(userId) || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // â”€â”€ League / clubs (Ð½ÐµÐ´ÐµÐ»ÑŒÐ½Ñ‹Ðµ Ð¼Ð¸Ð½Ð¸-Ð³Ñ€ÑƒÐ¿Ð¿Ñ‹) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    // ÐšÐ»Ð¸ÐµÐ½Ñ‚: ÐºÐ°Ðº leaderboard â€” Ð²Ð¾ÑˆÐµÐ´ÑˆÐ¸Ðµ Ð¿Ð¾Ð»ÑŒÐ·Ð¾Ð²Ð°Ñ‚ÐµÐ»Ð¸. ÐÐ´Ð¼Ð¸Ð½ÐºÐ° index.html: ÑÐ¿Ð¸ÑÐ¾Ðº Ð³Ñ€ÑƒÐ¿Ð¿.
    match /league_groups/{groupId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // League chat UGC: live weekly room messages, moderation queue, reports.
    match /league_chat_messages/{messageId} {
      allow read: if isAdmin()
        || (
          request.auth != null
          && exists(/databases/$(database)/documents/league_chat_members/$(request.auth.uid)/rooms/$(resource.data.groupId))
        );
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /league_chat_moderation_queue/{itemId} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    match /league_chat_reports/{reportId} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    match /league_chat_bans/{userId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /league_chat_members/{authUid}/rooms/{groupId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == authUid);
      allow create, update, delete: if false;
    }

    // â”€â”€ Auth links (Google/Apple â†’ stable_id mapping) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    // Doc id = providerUid (Google sub / Apple sub).
    // Ð˜ÑÐ¿Ð¾Ð»ÑŒÐ·ÑƒÐµÑ‚ÑÑ Ð¿Ñ€Ð¸ Ð»Ð¾Ð³Ð¸Ð½Ðµ Ð½Ð° Ð½Ð¾Ð²Ð¾Ð¼ ÑƒÑÑ‚Ñ€Ð¾Ð¹ÑÑ‚Ð²Ðµ: query auth_links/{providerUid}
    // Ñ‡Ñ‚Ð¾Ð±Ñ‹ Ð²Ð¾ÑÑÑ‚Ð°Ð½Ð¾Ð²Ð¸Ñ‚ÑŒ stable_id Ð¸ Ð¿Ð¾Ð´Ñ‚ÑÐ½ÑƒÑ‚ÑŒ Ð¿Ñ€Ð¾Ð³Ñ€ÐµÑÑ.
    match /auth_links/{providerUid} {
      function ownsAuthLinkDoc() {
        return request.auth != null && request.auth.uid == providerUid;
      }

      function stableIdOwnedByThisAuth(stableId) {
        return stableId is string
          && stableId.size() > 0
          && stableUserMatchesAuth(stableId);
      }

      // The app only needs to read the link for the provider account that is
      // currently signed in. Broad authenticated reads expose account mappings.
      allow read: if isAdmin() || ownsAuthLinkDoc();

      // Create: Ð¿Ñ€Ð¸ Ð¿ÐµÑ€Ð²Ð¾Ð¼ login. Ð”Ð¾ÐºÑƒÐ¼ÐµÐ½Ñ‚ Ð´Ð¾Ð»Ð¶ÐµÐ½ ÑÑÑ‹Ð»Ð°Ñ‚ÑŒÑÑ Ð½Ð° providerUid Ð¸Ð· id
      // Ð¸ ÑÐ¾Ð´ÐµÑ€Ð¶Ð°Ñ‚ÑŒ stable_id Ñ‚ÐµÐºÑƒÑ‰ÐµÐ³Ð¾ ÑŽÐ·ÐµÑ€Ð° + provider.
      allow create: if ownsAuthLinkDoc()
        && request.resource.data.providerUid == providerUid
        && request.resource.data.stable_id is string
        && request.resource.data.stable_id.size() > 0
        && request.resource.data.provider in ['google', 'apple']
        && stableIdOwnedByThisAuth(request.resource.data.stable_id);

      // Update: Ð¿Ñ€Ð¸ relogin Ð¸Ð»Ð¸ swap Ð°ÐºÐºÐ°ÑƒÐ½Ñ‚Ð°. ÐœÐµÐ½ÑÐµÐ¼ Ñ‚Ð¾Ð»ÑŒÐºÐ¾ Ð±ÐµÐ»Ñ‹Ð¹ ÑÐ¿Ð¸ÑÐ¾Ðº Ð¿Ð¾Ð»ÐµÐ¹.
      // providerUid Ð¼ÐµÐ½ÑÑ‚ÑŒ Ð½ÐµÐ»ÑŒÐ·Ñ.
      allow update: if ownsAuthLinkDoc()
        && resource.data.providerUid == providerUid
        && request.resource.data.providerUid == providerUid
        && request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['stable_id', 'email', 'displayName', 'lastSignInAt', 'devicePlatform'])
        && (
          request.resource.data.stable_id == resource.data.stable_id
          || stableIdOwnedByThisAuth(request.resource.data.stable_id)
        );

      // Delete: Ñ‚Ð¾Ð»ÑŒÐºÐ¾ Ð°Ð´Ð¼Ð¸Ð½ (Ñ‡ÐµÑ€ÐµÐ· Ð¿Ð°Ð½ÐµÐ»ÑŒ) Ð¸Ð»Ð¸ Cloud Function Ð´Ð»Ñ revocation.
      allow delete: if isAdmin();
    }

    // ÐÐ³Ñ€ÐµÐ³Ð°Ñ‚Ñ‹ Ð´Ð»Ñ UI (ÑÑ‡Ñ‘Ñ‚Ñ‡Ð¸Ðº Ð¾Ñ‡ÐµÑ€ÐµÐ´Ð¸ Ð°Ñ€ÐµÐ½Ñ‹ â€” Ð¿Ð¸ÑˆÐµÑ‚ Ñ‚Ð¾Ð»ÑŒÐºÐ¾ Cloud Function)
    match /app_meta/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // â”€â”€ Admin audit log â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /admin_log/{docId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /telegram_premium_orders/{orderId} {
      allow read: if isAdmin();
      allow update: if isAdmin();
      allow create, delete: if false;
    }

    match /telegram_premium_bot/{docId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // â”€â”€ Community (UGC) packs â€” Ð·Ð°Ð¿Ð¸ÑÑŒ Ñ‚Ð¾Ð»ÑŒÐºÐ¾ Ñ‡ÐµÑ€ÐµÐ· Cloud Functions â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /community_packs/{packId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /community_pack_submissions/{submissionId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /community_pack_drafts/{draftId} {
      allow read, write: if false;
    }

    match /community_pack_purchases/{purchaseId} {
      allow read, write: if false;
    }

    match /community_pack_ratings/{ratingId} {
      allow read, write: if false;
    }

    // Arena ghost challenges: async shareable arena replays.
    match /arena_ghost_challenges/{challengeId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    match /arena_hill_thrones/{dayKey} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    match /arena_hill_attempts/{attemptId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /arena_club_events/{eventId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    match /arena_club_contributions/{contributionId} {
      allow read: if isAdmin()
        || (request.auth != null && resource.data.arenaUid == request.auth.uid);
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /arena_rooms_live/{roomCode} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    match /arena_room_runs/{runId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // ── Arena room members (lobby participants) ────────────────────────────────
    // Все записи создаёт/обновляет Cloud Function (Admin SDK).
    // Клиент читает участников своей комнаты.
    match /arena_room_members/{memberId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // ── Arena room chat ────────────────────────────────────────────────────────
    // Сообщения пишет только Cloud Function (после rate-limit + фильтрации).
    // Клиент читает только видимые сообщения (status==visible) своей комнаты.
    match /arena_room_chat/{roomCode}/messages/{msgId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // Rate-limit счётчики чата комнаты — только CF.
    match /arena_room_chat_rate/{authUid} {
      allow read: if request.auth != null && request.auth.uid == authUid;
      allow create, update, delete: if isAdmin();
    }

    match /arena_pulse_events/{eventId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    match /league_chest_events/{eventId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /league_crowns/{crownId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /league_chest_claims/{claimId} {
      allow read: if isAdmin()
        || (request.auth != null && resource.data.authUid == request.auth.uid);
      allow write: if false;
    }

    // ── Explain like I'm five (Phase 5) ────────────────────────────────────────
    // Публичный кэш объяснений: ЛЮБОЙ может читать готовое объяснение напрямую (быстро,
    // без CF, 0 токенов), но писать КОНТЕНТ — ТОЛЬКО Admin SDK из Cloud Function (explainPhrase).
    // Клиент НИКОГДА не пишет публичный контент (инвариант аудита SECURITY_AUDIT_2026-06-07).
    // delete: isAdmin() — кнопка «Сбросить объяснение» в админке (раздел «Непонятно объяснили»):
    // удаление дока ⇒ следующий запрос фразы генерирует заново. Создавать/менять контент
    // из браузера (включая админа) по-прежнему НЕЛЬЗЯ.
    match /phrase_explanations/{phraseHash} {
      allow read: if true;
      allow create, update: if false;
      allow delete: if isAdmin();
    }

    // Внутренние CF-only коллекции фичи: бюджет/лимиты/биллинг. Всё пишет и читает только
    // сервер (Admin SDK). НЕ через isAdmin(): эти коллекции НЕ открыты admin-панели
    // (в отличие от referral_owners), поэтому read И write = false.
    match /explain_global_budget/{docId} {
      allow read: if false;
      allow write: if false;
    }
    match /explain_user_limits/{docId} {
      allow read: if false;
      allow write: if false;
    }
    match /explain_billing/{docId} {
      allow read: if false;
      allow write: if false;
    }

    // Произношение (scorePronunciationAttempt): лимиты/квоты/бюджет — только сервер (Admin SDK).
    // Защищают OpenAI-кошелёк: часовой rate-limit, дневная квота на юзера, глобальный потолок.
    match /pronunciation_score_rate_limits/{docId} {
      allow read: if false;
      allow write: if false;
    }
    match /pronunciation_score_daily_quota/{docId} {
      allow read: if false;
      allow write: if false;
    }
    match /pronunciation_global_budget/{docId} {
      allow read: if false;
      allow write: if false;
    }

    // Жалобы «Непонятно объяснили»: ПИШЕТ только CF submitExplainReport (Admin SDK), а
    // админ-панель ЧИТАЕТ и разбирает их (раздел «Непонятно объяснили») — паттерн user_reports.
    // explain_reports — счётчик «сколько РАЗНЫХ юзеров пожаловались» по фразе
    // (delete = админ сбрасывает счётчик после починки фразы).
    match /explain_reports/{docId} {
      allow read, delete: if isAdmin();
      allow create, update: if false;
    }
    // explain_report_entries — лента жалоб, по записи на каждую отправку
    // (update = пометить разобранной, delete = убрать мусор).
    match /explain_report_entries/{docId} {
      allow read, update, delete: if isAdmin();
      allow create: if false;
    }

    // â”€â”€ CATCH-ALL â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
