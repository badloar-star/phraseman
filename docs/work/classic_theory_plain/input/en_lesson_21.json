 "phrases": [
  {
   "id": "en-classic-r1:21.01",
   "target": "Someone is at the door.",
   "ru": "Кто-то у двери.",
   "uk": "Хтось біля дверей."
  },
  {
   "id": "en-classic-r1:21.02",
   "target": "Something is burning.",
   "ru": "Что-то горит.",
   "uk": "Щось горить."
  },
  {
   "id": "en-classic-r1:21.03",
   "target": "Someone left a scarf here.",
   "ru": "Кто-то оставил здесь шарф.",
   "uk": "Хтось залишив тут шарф."
  },
  {
   "id": "en-classic-r1:21.04",
   "target": "Something fell off the shelf.",
   "ru": "Что-то упало с полки.",
   "uk": "Щось впало з полиці."
  },
  {
   "id": "en-classic-r1:21.05",
   "target": "I need someone to help.",
   "ru": "Мне нужен кто-то, кто поможет.",
   "uk": "Мені потрібен хтось, хто допоможе."
  },
  {
   "id": "en-classic-r1:21.06",
   "target": "She wants something warm.",
   "ru": "Она хочет чего-нибудь теплого.",
   "uk": "Вона хоче чогось теплого."
  },
  {
   "id": "en-classic-r1:21.07",
   "target": "Someone has my number.",
   "ru": "У кого-то есть мой номер.",
   "uk": "Хтось має мій номер."
  },
  {
   "id": "en-classic-r1:21.08",
   "target": "There is something in my shoe.",
   "ru": "В моей туфле что-то есть.",
   "uk": "Щось є в моєму черевику."
  },
  {
   "id": "en-classic-r1:21.09",
   "target": "I can hear someone upstairs.",
   "ru": "Я слышу кого-то наверху.",
   "uk": "Я чую когось нагорі."
  },
  {
   "id": "en-classic-r1:21.10",
   "target": "We need somewhere to sit.",
   "ru": "Нам нужно где-нибудь сесть.",
   "uk": "Нам потрібно десь сісти."
  },
  {
   "id": "en-classic-r1:21.11",
   "target": "Is anyone waiting here?",
   "ru": "Кто-нибудь ждет здесь?",
   "uk": "Хтось тут чекає?"
  },
  {
   "id": "en-classic-r1:21.12",
   "target": "Did anyone see my keys?",
   "ru": "Кто-нибудь видел мои ключи?",
   "uk": "Хтось бачив мої ключі?"
  },
  {
   "id": "en-classic-r1:21.13",
   "target": "Do you need anything else?",
   "ru": "Вам что-нибудь еще нужно?",
   "uk": "Вам ще щось потрібно?"
  },
  {
   "id": "en-classic-r1:21.14",
   "target": "Is anything missing?",
   "ru": "Что-нибудь пропало?",
   "uk": "Чогось не вистачає?"
  },
  {
   "id": "en-classic-r1:21.15",
   "target": "Can anyone hear me?",
   "ru": "Меня кто-нибудь слышит?",
   "uk": "Хтось мене чує?"
  },
  {
   "id": "en-classic-r1:21.16",
   "target": "Have you got anything smaller?",
   "ru": "У вас есть что-нибудь поменьше?",
   "uk": "У вас є щось менше?"
  },
  {
   "id": "en-classic-r1:21.17",
   "target": "Is there anywhere to park?",
   "ru": "Есть ли где-нибудь припарковаться?",
   "uk": "Чи є де припаркуватися?"
  },
  {
   "id": "en-classic-r1:21.18",
   "target": "Did you go anywhere yesterday?",
   "ru": "Вы куда-нибудь ходили вчера?",
   "uk": "Ви кудись ходили вчора?"
  },
  {
   "id": "en-classic-r1:21.19",
   "target": "Does anyone know the code?",
   "ru": "Кто-нибудь знает код?",
   "uk": "Хтось знає код?"
  },
  {
   "id": "en-classic-r1:21.20",
   "target": "Can I get you anything?",
   "ru": "Могу я вам что-нибудь предложить?",
   "uk": "Можна вам щось принести?"
  },
  {
   "id": "en-classic-r1:21.21",
   "target": "Nobody answered the phone.",
   "ru": "Никто не ответил на телефон.",
   "uk": "Ніхто не відповів на дзвінок."
  },
  {
   "id": "en-classic-r1:21.22",
   "target": "Nothing is open yet.",
   "ru": "Пока ничего не открыто.",
   "uk": "Ще нічого не відчинено."
  },
  {
   "id": "en-classic-r1:21.23",
   "target": "There is nowhere to sit.",
   "ru": "Сидеть негде.",
   "uk": "Немає де сісти."
  },
  {
   "id": "en-classic-r1:21.24",
   "target": "Nobody signed the form.",
   "ru": "Никто не подписал форму.",
   "uk": "Ніхто не підписав форму."
  },
  {
   "id": "en-classic-r1:21.25",
   "target": "Nothing happened after lunch.",
   "ru": "После обеда ничего не произошло.",
   "uk": "Нічого не сталося після обіду."
  },
  {
   "id": "en-classic-r1:21.26",
   "target": "I know nobody in this town.",
   "ru": "Я никого не знаю в этом городе.",
   "uk": "Я нікого не знаю в цьому місті."
  },
  {
   "id": "en-classic-r1:21.27",
   "target": "We have nothing to declare.",
   "ru": "Нам нечего декларировать.",
   "uk": "Нам нема чого декларувати."
  },
  {
   "id": "en-classic-r1:21.28",
   "target": "There is nothing on the label.",
   "ru": "На этикетке ничего нет.",
   "uk": "На етикетці нічого немає."
  },
  {
   "id": "en-classic-r1:21.29",
   "target": "Nobody told me the price.",
   "ru": "Никто не сказал мне цену.",
   "uk": "Ніхто не сказав мені ціну."
  },
  {
   "id": "en-classic-r1:21.30",
   "target": "The key was nowhere to be found.",
   "ru": "Ключа нигде не было.",
   "uk": "Ключа ніде не було."
  },
  {
   "id": "en-classic-r1:21.31",
   "target": "Everybody needs a ticket.",
   "ru": "Всем нужен билет.",
   "uk": "Усім потрібен квиток."
  },
  {
   "id": "en-classic-r1:21.32",
   "target": "Everything is ready now.",
   "ru": "Теперь всё готово.",
   "uk": "Тепер усе готове."
  },
  {
   "id": "en-classic-r1:21.33",
   "target": "Everyone has a seat.",
   "ru": "У каждого есть место.",
   "uk": "У кожного є місце."
  },
  {
   "id": "en-classic-r1:21.34",
   "target": "I checked everything twice.",
   "ru": "Я всё проверил дважды.",
   "uk": "Я все перевірив двічі."
  },
  {
   "id": "en-classic-r1:21.35",
   "target": "Everybody heard the bell.",
   "ru": "Все услышали звонок.",
   "uk": "Усі чули дзвінок."
  },
  {
   "id": "en-classic-r1:21.36",
   "target": "Everything fits in one bag.",
   "ru": "Всё помещается в одну сумку.",
   "uk": "Все поміщається в одну сумку."
  },
  {
   "id": "en-classic-r1:21.37",
   "target": "We looked everywhere for the receipt.",
   "ru": "Мы везде искали квитанцию.",
   "uk": "Ми всюди шукали квитанцію."
  },
  {
   "id": "en-classic-r1:21.38",
   "target": "Everyone has a ticket for the rehearsal.",
   "ru": "У всех есть билет на репетицию.",
   "uk": "У кожного є квиток на репетицію."
  },
  {
   "id": "en-classic-r1:21.39",
   "target": "Everything on this shelf is half price.",
   "ru": "Всё на этой полке продаётся за полцены.",
   "uk": "Все на цій полиці коштує півціни."
  },
  {
   "id": "en-classic-r1:21.40",
   "target": "I thanked everyone at the desk.",
   "ru": "Я поблагодарил всех за стойкой.",
   "uk": "Я подякував усім за стійкою."
  },
  {
   "id": "en-classic-r1:21.41",
   "target": "I did not see anyone downstairs.",
   "ru": "Я никого не увидел внизу.",
   "uk": "Я нікого не бачив внизу."
  },
  {
   "id": "en-classic-r1:21.42",
   "target": "She did not buy anything today.",
   "ru": "Она сегодня ничего не купила.",
   "uk": "Вона сьогодні нічого не купила."
  },
  {
   "id": "en-classic-r1:21.43",
   "target": "We did not go anywhere on Sunday.",
   "ru": "Мы никуда не ходили в воскресенье.",
   "uk": "Ми нікуди не ходили в неділю."
  },
  {
   "id": "en-classic-r1:21.44",
   "target": "There is nothing wrong with your ticket.",
   "ru": "С вашим билетом все в порядке.",
   "uk": "З вашим квитком все гаразд."
  },
  {
   "id": "en-classic-r1:21.45",
   "target": "Is there anything I should bring?",
   "ru": "Есть ли что-нибудь, что мне нужно взять с собой?",
   "uk": "Чи є щось, що мені слід принести?"
  },
  {
   "id": "en-classic-r1:21.46",
   "target": "Someone called, but nobody left a message.",
   "ru": "Кто-то звонил, но никто не оставил сообщения.",
   "uk": "Хтось дзвонив, але ніхто не залишив повідомлення."
  },
  {
   "id": "en-classic-r1:21.47",
   "target": "Everyone is here except Tom.",
   "ru": "Все здесь, кроме Тома.",
   "uk": "Усі тут, крім Тома."
  },
  {
   "id": "en-classic-r1:21.48",
   "target": "I need something to write on.",
   "ru": "Мне нужно что-нибудь, на чём можно писать.",
   "uk": "Мені потрібно щось, на чому можна писати."
  },
  {
   "id": "en-classic-r1:21.49",
   "target": "There is somewhere quiet upstairs.",
   "ru": "Наверху есть тихое место.",
   "uk": "Нагорі є тихе місце."
  },
  {
   "id": "en-classic-r1:21.50",
   "target": "Anyone can use the side entrance.",
   "ru": "Любой может воспользоваться боковым входом.",
   "uk": "Будь-хто може скористатися бічним входом."
  }
