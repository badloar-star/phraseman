    "textRU": "Схема: кто или что, затем no, затем форма estar, затем место. Не ставь no после глагола и не добавляй второй глагол.",
    "linesRU": [
      {
        "type": "text",
        "parts": [
          {
            "text": "(кто или что) + no + форма estar + место",
            "tone": "strong"
          }
        ]
      },
      {
        "type": "example",
