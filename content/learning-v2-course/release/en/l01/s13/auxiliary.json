        "en:lesson-01:session-13:intro1:r2": {
          "ru": "После `I` здесь нужно `am`; `are` используют с `you`.",
          "uk": "Після `I` тут потрібне `am`; `are` вживають із `you`."
        },
        "en:lesson-01:session-13:intro1:r3": {
          "ru": "После `I` нужно `am`. По-русски «я готов/готова» обходится без этого слова, а по-английски оно необходимо.",
          "uk": "Після `I` потрібне `am`. Українською «я готовий/готова» обходиться без цього слова, а англійською воно потрібне."
        }
      }
    },
    {
      "interactionId": "en:lesson-01:session-13:intro2:q",
      "responseFeedbackById": {
        "en:lesson-01:session-13:intro2:r2": {
          "ru": "После `you` здесь нужно `are`; `am` ставят после `I`.",
          "uk": "Після `you` тут потрібне `are`; `am` ставлять після `I`."
        },
        "en:lesson-01:session-13:intro2:r3": {
          "ru": "После `you` нужно `are`: You are young.",
          "uk": "Після `you` потрібне `are`: You are young."
        }
      }
    },
    {
      "interactionId": "en:lesson-01:session-13:intro3:q",
      "responseFeedbackById": {
        "en:lesson-01:session-13:intro3:r2": {
          "ru": "`are` уехало от `you`. Про себя — `am`.",
          "uk": "`are` поїхало від `you`. Про себе — `am`."
        },
        "en:lesson-01:session-13:intro3:r3": {
          "ru": "Так спрашивают, а не рассказывают. В рассказе `I` идёт первым.",
          "uk": "Так питають, а не розповідають. У розповіді `I` іде першим."
        }
      }
