  {
   "id": "fr:23:18",
   "target": "Vous leur indiquez la sortie.",
   "ru": "Вы показываете им выход.",
   "uk": "Ви показуєте їм вихід."
  },
  {
   "id": "fr:23:19",
   "target": "On lui apporte un verre d’eau.",
   "ru": "Они приносят ему стакан воды.",
   "uk": "Вони приносять йому склянку води."
