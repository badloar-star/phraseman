  {
   "id": "en-classic-r1:23.22",
   "target": "Are the drinks included?",
   "ru": "Напитки включены?",
   "uk": "Чи включено напої?"
  },
  {
   "id": "en-classic-r1:23.23",
   "target": "Is this seat taken?",
   "ru": "Это место занято?",
   "uk": "Чи це місце зайняте?"
  },
  {
   "id": "en-classic-r1:23.24",
   "target": "Was your bag checked?",
   "ru": "Вашу сумку проверили?",
   "uk": "Вашу сумку перевірили?"
  },
  {
   "id": "en-classic-r1:23.25",
   "target": "Were the forms signed?",
   "ru": "Были ли подписаны формы?",
   "uk": "Чи були підписані форми?"
  },
  {
   "id": "en-classic-r1:23.26",
   "target": "Where is the spare key kept?",
   "ru": "Где хранится запасной ключ?",
   "uk": "Де зберігається запасний ключ?"
  },
  {
   "id": "en-classic-r1:23.27",
   "target": "When are the bins collected?",
   "ru": "Когда вывозят мусор?",
   "uk": "Коли вивозять сміття?"
